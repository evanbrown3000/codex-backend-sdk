[Unit]
Description=Cognilode TaskFlow phase controller recurrence
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/Projects/codex-backend-sdk/scripts/cognilode-taskflow-phase-controller-service
EnvironmentFile=%h/.config/cognilode/taskflow-phase-controller.env
Restart=on-failure
RestartSec=15
TimeoutStopSec=20
NoNewPrivileges=true

[Install]
WantedBy=default.target
