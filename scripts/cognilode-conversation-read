#!/usr/bin/env python3
"""Read hosted, Codex and historical conversations through one CLI, with delta cursors.

Hosted agents are read from the conversation service. Codex is read from the
verified Google Drive delta store. This is a logical reader, not another copy
of either corpus. A cursor is bound to the exact visible prefix; a changed
prefix asks the caller to refresh rather than silently omitting history.
"""
from __future__ import annotations

import argparse
import base64
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import subprocess
import sys
from pathlib import Path
from typing import Any


HERE = Path(__file__).resolve().parent
DEFAULT_DRIVE_READER = Path(os.environ.get(
    "COGNILODE_DRIVE_READBACK_SCRIPT",
    "/home/evan/.local/share/cognilode/memory-stock-runtime/deploy/conversation-vacuum/canonical_full_readback.py",
))
DEFAULT_HISTORICAL_READER = Path(os.environ.get(
    "COGNILODE_HISTORICAL_S3_READER",
    "/home/evan/.local/share/cognilode/memory-stock-runtime/scripts/historical_s3_conversation.py",
))


def _load_script(path: Path, name: str) -> Any:
    if not path.is_file():
        raise FileNotFoundError(f"conversation reader unavailable: {path}")
    # The Drive reader is deployed as a script beside transport helpers, with
    # Memory Stock's package in the checkout's src/ directory. Keep those
    # import roots for its lazy imports when read_full_conversation runs.
    import_roots = [path.parent]
    for parent in path.parents:
        source_root = parent / "src"
        if (source_root / "memory_stock").is_dir():
            import_roots.append(source_root)
            break
    for root in reversed(import_roots):
        location = str(root)
        if location not in sys.path:
            sys.path.insert(0, location)
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


def read_conversation(provider: str, conversation_id: str, *, drive_reader: Path = DEFAULT_DRIVE_READER,
                      historical_reader: Path = DEFAULT_HISTORICAL_READER) -> dict:
    if provider in {"historical-s3", "historical_s3"}:
        if not historical_reader.is_file():
            raise FileNotFoundError(f"historical conversation reader unavailable: {historical_reader}")
        completed = subprocess.run([sys.executable, str(historical_reader), "read", conversation_id, "--json"],
                                   text=True, capture_output=True, check=True, timeout=120)
        result = json.loads(completed.stdout)
        rendered = result.get("rendered_markdown")
        rows = result.get("events")
        if (result.get("schema") != "memory_stock.historical_s3_delta_read.v1"
            or result.get("changed") is not True or result.get("reset_required") is not False
            or result.get("conversation_id") != conversation_id
            or result.get("provider") != "historical-s3" or not isinstance(rendered, str)
            or not isinstance(rows, list) or len(rows) != result.get("message_count")
            or hashlib.sha256(rendered.encode("utf-8")).hexdigest() != result.get("rendered_sha256")):
            raise ValueError("historical S3 readback identity, coverage or hash mismatch")
        events = []
        for row in rows:
            if not isinstance(row, dict) or not row.get("node_id") or row.get("role") not in {
                "user", "assistant", "system", "developer", "tool"} or not isinstance(row.get("text"), str):
                raise ValueError("historical S3 event is malformed")
            events.append({"id": str(row["node_id"]), "role": str(row["role"]),
                           "text": row["text"],
                           "occurred_at_utc": str(row.get("format_and_time") or "").rsplit(" · ", 1)[-1],
                           "parent_node_id": row.get("parent_node_id")})
        return {"provider": "historical-s3", "conversation_id": conversation_id,
                "source": "s3_dynamodb_historical_stock", "events": events,
                "coverage": result["coverage"], "all_provider_events_known": False,
                "source_receipt": result["source_receipt"], "rendered_sha256": result["rendered_sha256"]}
    if provider in {"chatgpt", "chatgpt.com", "gemini.com", "anthropic.com", "claude.com"}:
        hosted_provider = "chatgpt.com" if provider == "chatgpt" else provider
        sender = _load_script(HERE / "cognilode-b4pt0r-chatmode", "cognilode_conversation_sender_read")
        result = sender.operator_memory_post({
            "operation": "read", "provider": hosted_provider, "conversation_id": conversation_id,
        })
        conversation = result.get("conversation") or {}
        if conversation.get("conversation_id") != conversation_id or conversation.get("provider") != hosted_provider:
            raise ValueError("hosted conversation identity mismatch")
        raw = conversation.get("events")
        if not isinstance(raw, list):
            raise ValueError("hosted conversation has no event list")
        events = []
        for index, row in enumerate(raw):
            if not isinstance(row, dict) or not isinstance(row.get("content"), str):
                raise ValueError("incomplete hosted conversation event")
            events.append({
                "id": str(row.get("id") or index), "role": str(row.get("role") or "unknown"),
                "text": row["content"], "occurred_at_utc": row.get("created_at") or "",
            })
        return {"provider": hosted_provider, "conversation_id": conversation_id,
                "source": "hosted_conversation_service", "events": events,
                # This store certifies the admitted prompt/response hashes, but
                # does not claim that every provider-side branch was ingested.
                "coverage": "admitted_events_only",
                "all_provider_events_known": all(row.get("source_content_complete") is True
                                                 for row in raw)}

    if provider in {"codex", "openai-codex", "modified_codex", "modified-codex"}:
        # The Drive reader shares the installed Memory Stock reconciliation
        # package, which may not already be on this CLI's PYTHONPATH.
        package_root = drive_reader.resolve().parents[2] / "src"
        if package_root.is_dir() and str(package_root) not in sys.path:
            sys.path.insert(0, str(package_root))
        reader = _load_script(drive_reader, "cognilode_drive_conversation_read")
        result = reader.read_full_conversation(provider, conversation_id)
        if not result.get("complete_text") or result.get("conversation_id") != conversation_id:
            raise ValueError("Drive conversation readback incomplete or identity mismatch")
        events = [{
            "id": str(row["event_id"]), "role": str(row["role"]),
            "text": str(row["text"]), "occurred_at_utc": row.get("occurred_at_utc") or "",
        } for row in result["reconciled_events"]]
        return {"provider": provider, "conversation_id": conversation_id,
                "source": "google_drive_normalized_deltas", "events": events,
                "coverage": "all_admitted_drive_deltas",
                "all_provider_events_known": False,
                "remote_delta_objects": result["remote_delta_objects"]}

    raise ValueError("unsupported conversation provider")


def _prefix_digest(events: list[dict], count: int) -> str:
    rows = [[e["id"], e["role"], hashlib.sha256(e["text"].encode("utf-8")).hexdigest()]
            for e in events[:count]]
    return hashlib.sha256(json.dumps(rows, ensure_ascii=False, separators=(",", ":")).encode("utf-8")).hexdigest()


def _cursor(provider: str, conversation_id: str, events: list[dict], count: int) -> str:
    value = {"v": 1, "provider": provider, "conversation_id": conversation_id,
             "count": count, "prefix_sha256": _prefix_digest(events, count)}
    return base64.urlsafe_b64encode(json.dumps(value, sort_keys=True, separators=(",", ":")).encode()).decode().rstrip("=")


def delta_view(result: dict, since: str = "") -> dict:
    events = result["events"]
    start = 0
    if since:
        try:
            cursor = json.loads(base64.urlsafe_b64decode(since + "=" * (-len(since) % 4)))
        except (ValueError, UnicodeDecodeError) as exc:
            raise ValueError("invalid conversation cursor") from exc
        if (cursor.get("v") != 1 or cursor.get("provider") != result["provider"]
                or cursor.get("conversation_id") != result["conversation_id"]):
            raise ValueError("conversation cursor belongs to another conversation")
        start = cursor.get("count")
        if not isinstance(start, int) or start < 0 or start > len(events):
            raise ValueError("conversation prefix changed; refresh full conversation")
        if cursor.get("prefix_sha256") != _prefix_digest(events, start):
            raise ValueError("conversation prefix changed; refresh full conversation")
    return {**{k: v for k, v in result.items() if k != "events"},
            "total_events": len(events), "new_events": len(events) - start,
            "events": events[start:],
            "next_cursor": _cursor(result["provider"], result["conversation_id"], events, len(events))}


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--provider", required=True)
    parser.add_argument("--conversation-id", required=True)
    parser.add_argument("--since", default="", help="opaque next_cursor from a prior read")
    parser.add_argument("--drive-reader", type=Path, default=DEFAULT_DRIVE_READER)
    parser.add_argument("--historical-reader", type=Path, default=DEFAULT_HISTORICAL_READER)
    parser.add_argument("--format", choices=("json", "markdown"), default="json")
    args = parser.parse_args()
    result = delta_view(read_conversation(args.provider, args.conversation_id,
                                          drive_reader=args.drive_reader,
                                          historical_reader=args.historical_reader), args.since)
    if args.format == "json":
        print(json.dumps(result, ensure_ascii=False))
    else:
        print(f"# {result['provider']}/{result['conversation_id']}\n")
        print(f"Source: {result['source']} · coverage: {result['coverage']} · "
              f"all provider events known: {result['all_provider_events_known']} · "
              f"new: {result['new_events']} / {result['total_events']}\n")
        for event in result["events"]:
            print(f"## {event['role']} {event['occurred_at_utc']}\n\n{event['text']}\n")
        print(f"<!-- next_cursor: {result['next_cursor']} -->")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
