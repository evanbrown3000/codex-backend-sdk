#!/usr/bin/env python3
"""Continuously adopt centrally recorded ChatGPT Chat-mode work products.

The collector owns provider reads and downloads. This process consumes only
completed collector records, validates their ZIPs, and gives each unique work
product to an installed Codex worker for its external effect. It never sends a
ChatGPT prompt or infers completion from a transport receipt.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import sqlite3
import subprocess
import tempfile
import time
import zipfile


class NeedsRevision(RuntimeError):
    """The delivered work needs a new ChatGPT implementation turn."""


def log(kind: str, **fields: object) -> None:
    print(json.dumps({"at": time.time(), "kind": kind, **fields}, sort_keys=True), flush=True)


def digest(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as src:
        for part in iter(lambda: src.read(1024 * 1024), b""):
            h.update(part)
    return h.hexdigest()


def verify_zip(path: Path, expected: str) -> str:
    if not path.is_file() or path.stat().st_size > 20 * 1024 * 1024:
        raise ValueError("missing or oversized work ZIP")
    if digest(path) != expected:
        raise ValueError("download SHA-256 mismatch")
    with zipfile.ZipFile(path) as archive:
        entries = archive.infolist()
        if len(entries) > 10000 or sum(row.file_size for row in entries) > 200 * 1024 * 1024:
            raise ValueError("ZIP expansion limit")
        names: set[str] = set()
        instructions = []
        for row in entries:
            rel = PurePosixPath(row.filename)
            if rel.is_absolute() or ".." in rel.parts or not rel.parts or row.filename in names:
                raise ValueError("unsafe or duplicate ZIP path")
            if (row.external_attr >> 16) & 0o170000 == 0o120000:
                raise ValueError("symlinks are not accepted in work ZIP")
            names.add(row.filename)
            if rel.name == "EXTERNAL_EFFECT_INSTRUCTIONS.md":
                instructions.append(row.filename)
        if len(instructions) != 1:
            raise ValueError("work ZIP requires one EXTERNAL_EFFECT_INSTRUCTIONS.md")
        manifests = [name for name in names if PurePosixPath(name).name == "MANIFEST.json"]
        if len(manifests) > 1:
            raise ValueError("ambiguous work manifest")
        if manifests:
            manifest = json.loads(archive.read(manifests[0]))
            for item in manifest.get("files", []):
                if not isinstance(item, dict) or not item.get("path") or not item.get("sha256"):
                    raise ValueError("invalid work manifest entry")
                member = str(item["path"])
                if member not in names:
                    prefix = str(PurePosixPath(manifests[0]).parent)
                    member = str(PurePosixPath(prefix) / member)
                if member not in names or hashlib.sha256(archive.read(member)).hexdigest() != item["sha256"]:
                    raise ValueError("work manifest SHA-256 mismatch")
        return instructions[0]


def records(roots: list[Path]):
    for root in roots:
        if root.is_dir():
            yield from root.rglob("*.collected.json")


def products(roots: list[Path], path_maps: list[tuple[Path, Path]]):
    seen: set[str] = set()
    for record_path in records(roots):
        try:
            record = json.loads(record_path.read_text(encoding="utf-8"))
            if not record.get("complete"):
                continue
            result = record.get("result") or {}
            if not (result.get("central_conversation_store") or {}).get("ok"):
                continue
            for row in result.get("downloaded_files") or []:
                if not isinstance(row, dict) or not str(row.get("name") or "").lower().endswith(".zip"):
                    continue
                sha = str(row.get("sha256") or "")
                if len(sha) != 64 or sha in seen:
                    continue
                seen.add(sha)
                artifact = Path(str(row.get("path") or ""))
                if not artifact.is_file():
                    for old, new in path_maps:
                        try:
                            translated = new / artifact.relative_to(old)
                        except ValueError:
                            continue
                        if translated.is_file():
                            artifact = translated
                            break
                if not artifact.is_file():
                    stem = record_path.name.removesuffix(".collected.json")
                    for folder in (stem + ".downloads", stem + ".files"):
                        candidate = record_path.with_name(folder) / str(row.get("name") or "")
                        if candidate.is_file():
                            artifact = candidate
                            break
                prompt = str(record.get("prompt") or "").lower()
                priorities = (
                    ("successor-engine", 100), ("native-work-adoption", 95),
                    ("recursive-taskflow", 90), ("plan-conversion", 85),
                    ("project-plan-population", 80), ("unified-conversations", 75),
                    ("secretary-routing", 70), ("failover-deployment", 65),
                )
                priority = next((value for label, value in priorities if label in prompt), 0)
                yield priority, sha, artifact, record_path
        except (OSError, ValueError, TypeError):
            continue


def database(path: Path) -> sqlite3.Connection:
    path.parent.mkdir(parents=True, exist_ok=True)
    db = sqlite3.connect(path)
    db.execute("PRAGMA journal_mode=WAL")
    db.execute("CREATE TABLE IF NOT EXISTS products (sha TEXT PRIMARY KEY, state TEXT NOT NULL, attempts INTEGER NOT NULL DEFAULT 0, next_at REAL NOT NULL DEFAULT 0, source TEXT, error TEXT, effect TEXT)")
    db.commit()
    return db


def mirror_s3(path: Path, sha: str, bucket: str, aws: str) -> str:
    if not bucket:
        raise RuntimeError("shared attachment S3 bucket is not configured")
    key = f"chatmode-work-products/sha256/{sha}.zip"
    with tempfile.TemporaryDirectory(prefix="chatmode-adoption-readback-") as temp:
        subprocess.run([aws, "s3api", "put-object", "--bucket", bucket, "--key", key,
                        "--body", str(path), "--server-side-encryption", "AES256",
                        "--metadata", "sha256=" + sha], check=True, stdout=subprocess.DEVNULL, timeout=180)
        readback = Path(temp) / "work.zip"
        subprocess.run([aws, "s3api", "get-object", "--bucket", bucket, "--key", key,
                        str(readback)], check=True, stdout=subprocess.DEVNULL, timeout=180)
        if digest(readback) != sha:
            raise RuntimeError("shared S3 work-product readback mismatch")
    return f"s3://{bucket}/{key}"


def adopt(sha: str, path: Path, source: Path, *, state: Path, shared_uri: str,
          codex: str, checkout: Path, timeout: int) -> dict:
    instruction_member = verify_zip(path, sha)
    work = state / "work" / sha
    work.mkdir(parents=True, exist_ok=True)
    with zipfile.ZipFile(path) as archive:
        archive.extractall(work)
    instructions = work / instruction_member
    effect_path = work / "EXTERNAL_EFFECT_RESULT.json"
    prompt = (
        "You are the installed Codex external-effect worker for a ChatGPT.com Chat-mode "
        "work product. The ChatGPT agent did the implementation in its native sandbox. "
        "Read the attached work ZIP after its verified extraction, especially "
        f"{instructions}. Apply and deploy its actual code in the containerized company "
        "checkout, publish to the project's Git repository when authorized, and carry "
        "out the specified external effects. Do not stop at an archive, report, audit, "
        "test result, or transport receipt. Do not manually send another ChatGPT prompt. "
        "If this packet conflicts with existing live sends, use a side-by-side cutover. "
        f"Work ZIP SHA-256: {sha}. Shared copy: {shared_uri}. "
        f"Source collector record: {source}. "
        f"Write {effect_path} as JSON with effect_observed=true and concrete evidence "
        "only after independently reading back the actual effect. If the effect cannot "
        "yet be achieved, write effect_observed=false and the next recovery action."
    )
    prompt_path = work / "external_effect_prompt.txt"
    prompt_path.write_text(prompt, encoding="utf-8")
    output_path = work / "codex-last-message.txt"
    with prompt_path.open("rb") as stream, (work / "codex.log").open("ab") as output:
        run = subprocess.run([codex, "exec", "--dangerously-bypass-approvals-and-sandbox",
                              "--output-last-message", str(output_path), "-"], stdin=stream,
                             stdout=output, stderr=subprocess.STDOUT, cwd=checkout, timeout=timeout,
                             check=False)
    if run.returncode:
        raise RuntimeError(f"installed Codex worker exited {run.returncode}")
    if not effect_path.is_file():
        raise NeedsRevision("worker produced no external-effect result")
    effect = json.loads(effect_path.read_text(encoding="utf-8"))
    if effect.get("effect_observed") is not True or not effect.get("evidence"):
        raise NeedsRevision("worker did not prove an external effect")
    return {"sha256": sha, "shared_uri": shared_uri, "effect": effect, "source_record": str(source),
            "at": time.time()}


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--source", action="append", type=Path, required=True)
    parser.add_argument("--state", type=Path, required=True)
    parser.add_argument("--bucket", default=os.environ.get("COGNILODE_TASKFLOW_ATTACHMENT_S3_BUCKET", ""))
    parser.add_argument("--codex", default=os.environ.get("COGNILODE_CODEX_BIN", "codex"))
    parser.add_argument("--aws", default=os.environ.get("COGNILODE_AWS_CLI", "aws"))
    parser.add_argument("--checkout", type=Path, required=True)
    parser.add_argument("--path-map", action="append", default=[],
                        help="Map an artifact path prefix written by another host: OLD=NEW")
    parser.add_argument("--interval", type=int, default=45)
    parser.add_argument("--worker-timeout", type=int, default=3600)
    parser.add_argument("--min-codex-gap", type=int, default=600)
    args = parser.parse_args()
    path_maps = []
    for value in args.path_map:
        if "=" not in value:
            parser.error("--path-map must be OLD=NEW")
        old, new = value.split("=", 1)
        path_maps.append((Path(old), Path(new)))
    args.state.mkdir(parents=True, exist_ok=True)
    db = database(args.state / "adoption.sqlite3")
    db.execute("CREATE TABLE IF NOT EXISTS service_state (key TEXT PRIMARY KEY, value TEXT NOT NULL)")
    db.commit()
    while True:
        pending = sorted(products(args.source, path_maps), key=lambda item: (-item[0], -item[3].stat().st_mtime))
        for _, sha, path, source in pending:
            row = db.execute("SELECT state, attempts, next_at FROM products WHERE sha=?", (sha,)).fetchone()
            if row and (row[0] in ("complete", "quarantined", "needs_revision") or float(row[2]) > time.time()):
                continue
            try:
                verify_zip(path, sha)
            except ValueError as exc:
                db.execute("INSERT INTO products(sha,state,attempts,next_at,source,error) VALUES(?,?,?,?,?,?) "
                           "ON CONFLICT(sha) DO UPDATE SET state=excluded.state, next_at=0, error=excluded.error",
                           (sha, "quarantined", int(row[1]) if row else 0, 0, str(source), str(exc)[:300]))
                db.commit()
                log("work_product_quarantined", sha256=sha, error=str(exc)[:180])
                continue
            last = db.execute("SELECT value FROM service_state WHERE key='last_codex_start'").fetchone()
            if last and time.time() - float(last[0]) < args.min_codex_gap:
                break
            attempts = int(row[1]) + 1 if row else 1
            db.execute("INSERT INTO products(sha,state,attempts,next_at,source) VALUES(?,?,?,?,?) "
                       "ON CONFLICT(sha) DO UPDATE SET state=excluded.state, attempts=excluded.attempts, next_at=excluded.next_at, source=excluded.source",
                       (sha, "running", attempts, time.time() + args.worker_timeout, str(source)))
            db.commit()
            try:
                shared_uri = mirror_s3(path, sha, args.bucket, args.aws)
                db.execute("INSERT INTO service_state(key,value) VALUES('last_codex_start',?) "
                           "ON CONFLICT(key) DO UPDATE SET value=excluded.value", (str(time.time()),))
                db.commit()
                effect = adopt(sha, path, source, state=args.state, shared_uri=shared_uri,
                               codex=args.codex, checkout=args.checkout, timeout=args.worker_timeout)
                receipt = args.state / "effects" / (sha + ".json")
                receipt.parent.mkdir(parents=True, exist_ok=True)
                receipt.write_text(json.dumps(effect, sort_keys=True, indent=2) + "\n")
                db.execute("UPDATE products SET state='complete', next_at=0, error=NULL, effect=? WHERE sha=?",
                           (str(receipt), sha))
                log("work_effect_complete", sha256=sha, receipt=str(receipt))
            except NeedsRevision as exc:
                feedback = args.state / "feedback" / (sha + ".json")
                feedback.parent.mkdir(parents=True, exist_ok=True)
                feedback.write_text(json.dumps({"work_sha256": sha, "source_record": str(source),
                                                "state": "needs_revision", "reason": str(exc),
                                                "at": time.time()}, sort_keys=True) + "\n")
                db.execute("UPDATE products SET state='needs_revision', next_at=0, error=? WHERE sha=?",
                           (str(exc)[:300], sha))
                log("work_revision_needed", sha256=sha, feedback=str(feedback))
            except ValueError as exc:
                db.execute("UPDATE products SET state='quarantined', next_at=0, error=? WHERE sha=?",
                           (f"{type(exc).__name__}:{str(exc)[:300]}", sha))
                log("work_product_quarantined", sha256=sha, error=str(exc)[:180])
            except Exception as exc:
                delay = min(3600, 60 * 2 ** min(attempts, 6))
                db.execute("UPDATE products SET state='retry', next_at=?, error=? WHERE sha=?",
                           (time.time() + delay, f"{type(exc).__name__}:{str(exc)[:300]}", sha))
                log("work_effect_retry", sha256=sha, attempts=attempts, retry_after=delay,
                    error=f"{type(exc).__name__}:{str(exc)[:180]}")
            db.commit()
        counts = dict(db.execute("SELECT state, COUNT(*) FROM products GROUP BY state").fetchall())
        summary = {"at": time.time(), "states": counts, "pending_records": len(pending)}
        tmp = args.state / "status.tmp"
        tmp.write_text(json.dumps(summary, sort_keys=True) + "\n")
        tmp.replace(args.state / "status.json")
        time.sleep(max(10, args.interval))


if __name__ == "__main__":
    raise SystemExit(main())
