#!/usr/bin/env python3
"""Continuously admit custody outbox events to Agent Memory."""
from __future__ import annotations

import argparse
import fcntl
import json
import os
from pathlib import Path
import signal
import time

import requests

from codex_backend_sdk.agent_memory import AgentMemoryClient

STOP = False


def stop(_signal, _frame):
    global STOP
    STOP = True


def atomic_cursor(path: Path, value: int) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + f".{os.getpid()}.partial")
    temporary.write_text(str(value) + "\n", encoding="utf-8")
    os.replace(temporary, path)


def publish_event(memory: AgentMemoryClient, event: dict) -> None:
    """Route semantic conversations and operational facts to their native planes.

    The provider outbox intentionally interleaves complete conversation
    observations with request/lease/queue/artifact lifecycle events.  Sending
    every record to the conversation parser discarded the operational stream
    and, worse, placed valid conversation observations behind those rejected
    rows.  The two Agent Memory surfaces are both idempotent: conversation
    observations are content addressed and inventory events retain event IDs.
    """
    schema = str(event.get("schema") or "")
    if schema == "memory_stock.conversation_observation.v1" or isinstance(
        event.get("messages"), list
    ):
        memory.ingest(event)
        return
    memory.admit_inventory(event)


def cycle(
    outbox: Path, cursor_path: Path, memory: AgentMemoryClient, *, maximum: int = 512,
) -> int:
    if not outbox.is_file():
        return 0
    try:
        offset = int(cursor_path.read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        offset = 0
    size = outbox.stat().st_size
    if offset < 0 or offset > size:
        offset = 0
    admitted = 0
    with outbox.open("rb") as stream:
        stream.seek(offset)
        while True:
            start = stream.tell()
            line = stream.readline()
            if not line:
                break
            if not line.endswith(b"\n"):
                break
            try:
                event = json.loads(line)
                if not isinstance(event, dict):
                    raise ValueError("event is not an object")
                publish_event(memory, event)
            except requests.HTTPError as exc:
                status = int(exc.response.status_code) if exc.response is not None else 0
                if status not in {400, 404, 409, 422}:
                    stream.seek(start)
                    break
                dead = cursor_path.with_name("agent-memory.dead-letter.jsonl")
                with dead.open("ab") as output:
                    output.write(line)
                    output.flush()
                    os.fsync(output.fileno())
                atomic_cursor(cursor_path, stream.tell())
                continue
            except (OSError, ValueError, json.JSONDecodeError):
                dead = cursor_path.with_name("agent-memory.dead-letter.jsonl")
                with dead.open("ab") as output:
                    output.write(line)
                    output.flush()
                    os.fsync(output.fileno())
                atomic_cursor(cursor_path, stream.tell())
                continue
            except Exception:
                stream.seek(start)
                break
            atomic_cursor(cursor_path, stream.tell())
            admitted += 1
            if admitted >= maximum:
                break
    return admitted


def recover_dead_letters(
    dead: Path, cursor_path: Path, memory: AgentMemoryClient, *, maximum: int = 64,
) -> int:
    """Continuously re-admit legacy rows that were routed to the wrong plane."""
    if not dead.is_file():
        return 0
    try:
        offset = int(cursor_path.read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        offset = 0
    size = dead.stat().st_size
    if offset < 0 or offset > size:
        offset = 0
    admitted = 0
    with dead.open("rb") as stream:
        stream.seek(offset)
        while admitted < maximum:
            start = stream.tell()
            line = stream.readline()
            if not line or not line.endswith(b"\n"):
                break
            try:
                event = json.loads(line)
                if not isinstance(event, dict):
                    raise ValueError("event is not an object")
                publish_event(memory, event)
            except requests.HTTPError as exc:
                status = int(exc.response.status_code) if exc.response is not None else 0
                if status not in {400, 404, 409, 422}:
                    stream.seek(start)
                    break
                # A permanently invalid historical row cannot block later
                # recoverable conversation or inventory events.
            except (OSError, ValueError, json.JSONDecodeError):
                pass
            except Exception:
                stream.seek(start)
                break
            atomic_cursor(cursor_path, stream.tell())
            admitted += 1
    return admitted


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--outbox", type=Path, default=Path(os.environ.get(
        "B4PT0R_PROVIDER_EVENT_OUTBOX", "/runtime/provider-events/outbox.jsonl"
    )))
    parser.add_argument("--cursor", type=Path, default=Path(os.environ.get(
        "B4PT0R_PROVIDER_EVENT_CURSOR", "/runtime/provider-events/agent-memory.cursor"
    )))
    parser.add_argument("--interval", type=float, default=10.0)
    args = parser.parse_args()
    args.cursor.parent.mkdir(parents=True, exist_ok=True)
    ownership = args.cursor.with_suffix(args.cursor.suffix + ".publisher.lock").open("a+")
    try:
        fcntl.flock(ownership.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    memory = AgentMemoryClient(use_broker=False)
    while not STOP:
        cycle(args.outbox, args.cursor, memory)
        recover_dead_letters(
            args.cursor.with_name("agent-memory.dead-letter.jsonl"),
            args.cursor.with_name("agent-memory.dead-letter-recovery.cursor"),
            memory,
        )
        for _ in range(max(1, int(args.interval * 2))):
            if STOP:
                break
            time.sleep(0.5)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
