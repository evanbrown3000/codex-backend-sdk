#!/usr/bin/env python3
"""Read hosted, Codex and historical conversations through one CLI, with delta cursors.

Hosted agents are read from the conversation service. Codex is read from the
verified Google Drive delta store. This is a logical reader, not another copy
of either corpus. A cursor is bound to the exact visible prefix; a changed
prefix asks the caller to refresh rather than silently omitting history.
"""
from __future__ import annotations

import argparse
import base64
from contextlib import contextmanager
import fcntl
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any


HERE = Path(__file__).resolve().parent
DEFAULT_DRIVE_READER = Path(os.environ.get(
    "COGNILODE_DRIVE_READBACK_SCRIPT",
    "/home/evan/.local/share/cognilode/memory-stock-runtime/deploy/conversation-vacuum/canonical_full_readback.py",
))
DEFAULT_HISTORICAL_READER = Path(os.environ.get(
    "COGNILODE_HISTORICAL_S3_READER",
    "/home/evan/.local/share/cognilode/memory-stock-runtime/scripts/historical_s3_conversation.py",
))


def _load_script(path: Path, name: str) -> Any:
    if not path.is_file():
        raise FileNotFoundError(f"conversation reader unavailable: {path}")
    # The Drive reader is deployed as a script beside transport helpers, with
    # Memory Stock's package in the checkout's src/ directory. Keep those
    # import roots for its lazy imports when read_full_conversation runs.
    import_roots = [path.parent]
    for parent in path.parents:
        source_root = parent / "src"
        if (source_root / "memory_stock").is_dir():
            import_roots.append(source_root)
            break
    for root in reversed(import_roots):
        location = str(root)
        if location not in sys.path:
            sys.path.insert(0, location)
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


def _codex_d1_messages(raw: list[dict], capture: dict) -> tuple[list[dict], str]:
    """Rejoin D1 transport segments into source messages and check source hashes."""
    try:
        ordered = sorted(raw, key=lambda row: int(row["index"]))
        if [int(row["index"]) for row in ordered] != list(range(len(ordered))):
            raise ValueError("Codex D1 segment indices differ")
        if capture.get("source_event_count") != len(ordered):
            raise ValueError("Codex D1 source segment count differs")
        manifest = capture.get("source_message_segments")
        if manifest is None:
            # Older admissions predate the manifest. Equal source-message and
            # segment counts prove there was no split, but cannot recheck the
            # original message-order hash independently.
            if (capture.get("source_full_message_count") != len(ordered)
                or capture.get("source_has_segmented_messages") is True):
                raise ValueError("Codex D1 legacy admission may contain unjoined segments")
            return ([{"id": str(row.get("id") or index), "role": str(row["role"]),
                      "text": str(row["content"]), "occurred_at_utc": row.get("created_at") or ""}
                     for index, row in enumerate(ordered)],
                    "admitted_codex_rollout_legacy_unsplit_drive_unverified")
        if not isinstance(manifest, list) or len(manifest) != capture.get("source_full_message_count"):
            raise ValueError("Codex D1 source message manifest differs")
        messages = []
        digest_rows = []
        cursor = 0
        for item in manifest:
            if not isinstance(item, dict) or item.get("segment_start") != cursor:
                raise ValueError("Codex D1 source segment order differs")
            count = item.get("segment_count")
            ids = item.get("segment_source_ids")
            role = item.get("role")
            if (not isinstance(count, int) or count < 1 or not isinstance(ids, list)
                or len(ids) != count or any(not isinstance(value, str) or not value for value in ids)
                or role not in {"user", "assistant"}):
                raise ValueError("Codex D1 source segment manifest is malformed")
            pieces = ordered[cursor:cursor + count]
            if len(pieces) != count or any(row.get("role") != role or not isinstance(row.get("content"), str)
                                           for row in pieces):
                raise ValueError("Codex D1 segment role or coverage differs")
            text = "".join(row["content"] for row in pieces)
            full_sha = hashlib.sha256(text.encode("utf-8")).hexdigest()
            if full_sha != item.get("content_sha256"):
                raise ValueError("Codex D1 reconstructed message SHA-256 differs")
            ordinal = item.get("source_ordinal")
            if not isinstance(ordinal, int):
                raise ValueError("Codex D1 source ordinal is malformed")
            messages.append({"id": ids[0], "role": role, "text": text,
                             "occurred_at_utc": pieces[0].get("created_at") or "",
                             "source_segment_ids": ids})
            digest_rows.append([role, text, full_sha, ordinal])
            cursor += count
        if cursor != len(ordered) or capture.get("source_has_segmented_messages") != any(
                item["segment_count"] > 1 for item in manifest):
            raise ValueError("Codex D1 segment coverage differs")
        full_digest = hashlib.sha256(json.dumps(digest_rows, ensure_ascii=False,
            sort_keys=True, separators=(",", ":")).encode("utf-8")).hexdigest()
        if full_digest != capture.get("source_full_messages_sha256"):
            raise ValueError("Codex D1 original message-order SHA-256 differs")
        return messages, "admitted_codex_rollout_messages_drive_unverified"
    except (KeyError, TypeError) as exc:
        raise ValueError("Codex D1 source message manifest is incomplete") from exc


def read_conversation(provider: str, conversation_id: str, *, drive_reader: Path = DEFAULT_DRIVE_READER,
                      historical_reader: Path = DEFAULT_HISTORICAL_READER) -> dict:
    if provider in {"historical-s3", "historical_s3"}:
        if not historical_reader.is_file():
            raise FileNotFoundError(f"historical conversation reader unavailable: {historical_reader}")
        completed = subprocess.run([sys.executable, str(historical_reader), "read", conversation_id, "--json"],
                                   text=True, capture_output=True, check=True, timeout=120)
        result = json.loads(completed.stdout)
        rendered = result.get("rendered_markdown")
        rows = result.get("events")
        if (result.get("schema") != "memory_stock.historical_s3_delta_read.v1"
            or result.get("changed") is not True or result.get("reset_required") is not False
            or result.get("conversation_id") != conversation_id
            or result.get("provider") != "historical-s3" or not isinstance(rendered, str)
            or not isinstance(rows, list) or len(rows) != result.get("message_count")
            or hashlib.sha256(rendered.encode("utf-8")).hexdigest() != result.get("rendered_sha256")):
            raise ValueError("historical S3 readback identity, coverage or hash mismatch")
        events = []
        for row in rows:
            if not isinstance(row, dict) or not row.get("node_id") or row.get("role") not in {
                "user", "assistant", "system", "developer", "tool"} or not isinstance(row.get("text"), str):
                raise ValueError("historical S3 event is malformed")
            events.append({"id": str(row["node_id"]), "role": str(row["role"]),
                           "text": row["text"],
                           "occurred_at_utc": str(row.get("format_and_time") or "").rsplit(" · ", 1)[-1],
                           "parent_node_id": row.get("parent_node_id")})
        return {"provider": "historical-s3", "conversation_id": conversation_id,
                "source": "s3_dynamodb_historical_stock", "events": events,
                "coverage": result["coverage"], "all_provider_events_known": False,
                "source_receipt": result["source_receipt"], "rendered_sha256": result["rendered_sha256"]}
    if provider in {"chatgpt", "chatgpt.com", "gemini.com", "anthropic.com", "claude.com", "codex-d1"}:
        hosted_provider = ({"chatgpt": "chatgpt.com", "codex-d1": "openai-codex"}.get(provider, provider))
        sender = _load_script(HERE / "cognilode-b4pt0r-chatmode", "cognilode_conversation_sender_read")
        result = sender.operator_memory_post({
            "operation": "read", "provider": hosted_provider, "conversation_id": conversation_id,
        })
        conversation = result.get("conversation") or {}
        if conversation.get("conversation_id") != conversation_id or conversation.get("provider") != hosted_provider:
            raise ValueError("hosted conversation identity mismatch")
        raw = conversation.get("events")
        if not isinstance(raw, list):
            raise ValueError("hosted conversation has no event list")
        events = []
        for index, row in enumerate(raw):
            if not isinstance(row, dict) or not isinstance(row.get("content"), str):
                raise ValueError("incomplete hosted conversation event")
            events.append({
                "id": str(row.get("id") or index), "role": str(row.get("role") or "unknown"),
                "text": row["content"], "occurred_at_utc": row.get("created_at") or "",
            })
        d1_codex = provider == "codex-d1"
        capture = conversation.get("capture") or {}
        if d1_codex and (capture.get("source_kind") != "codex_rollout"
                         or capture.get("drive_verified") is not False
                         or not capture.get("source_sha256")):
            raise ValueError("Codex D1 interim source receipt is incomplete")
        coverage = "admitted_events_only"
        if d1_codex:
            events, coverage = _codex_d1_messages(raw, capture)
        return {"provider": hosted_provider, "conversation_id": conversation_id,
                "source": ("hosted_d1_codex_interim" if d1_codex else "hosted_conversation_service"),
                "events": events,
                # This store certifies the admitted prompt/response hashes, but
                # does not claim that every provider-side branch was ingested.
                "coverage": coverage,
                "all_provider_events_known": (False if d1_codex else all(row.get("source_content_complete") is True
                                                 for row in raw)),
                **({"source_receipt": capture} if d1_codex else {})}

    if provider in {"codex", "openai-codex", "modified_codex", "modified-codex"}:
        # The Drive reader shares the installed Memory Stock reconciliation
        # package, which may not already be on this CLI's PYTHONPATH.
        package_root = drive_reader.resolve().parents[2] / "src"
        if package_root.is_dir() and str(package_root) not in sys.path:
            sys.path.insert(0, str(package_root))
        reader = _load_script(drive_reader, "cognilode_drive_conversation_read")
        result = reader.read_full_conversation(provider, conversation_id)
        if not result.get("complete_text") or result.get("conversation_id") != conversation_id:
            raise ValueError("Drive conversation readback incomplete or identity mismatch")
        events = [{
            "id": str(row["event_id"]), "role": str(row["role"]),
            "text": str(row["text"]), "occurred_at_utc": row.get("occurred_at_utc") or "",
        } for row in result["reconciled_events"]]
        return {"provider": provider, "conversation_id": conversation_id,
                "source": "google_drive_normalized_deltas", "events": events,
                "coverage": "all_admitted_drive_deltas",
                "all_provider_events_known": False,
                "remote_delta_objects": result["remote_delta_objects"]}

    raise ValueError("unsupported conversation provider")


def _prefix_digest(events: list[dict], count: int) -> str:
    rows = [[e["id"], e["role"], hashlib.sha256(e["text"].encode("utf-8")).hexdigest()]
            for e in events[:count]]
    return hashlib.sha256(json.dumps(rows, ensure_ascii=False, separators=(",", ":")).encode("utf-8")).hexdigest()


def _cursor(provider: str, conversation_id: str, events: list[dict], count: int) -> str:
    value = {"v": 1, "provider": provider, "conversation_id": conversation_id,
             "count": count, "prefix_sha256": _prefix_digest(events, count)}
    return base64.urlsafe_b64encode(json.dumps(value, sort_keys=True, separators=(",", ":")).encode()).decode().rstrip("=")


def delta_view(result: dict, since: str = "") -> dict:
    events = result["events"]
    start = 0
    if since:
        try:
            cursor = json.loads(base64.urlsafe_b64decode(since + "=" * (-len(since) % 4)))
        except (ValueError, UnicodeDecodeError) as exc:
            raise ValueError("invalid conversation cursor") from exc
        if (cursor.get("v") != 1 or cursor.get("provider") != result["provider"]
                or cursor.get("conversation_id") != result["conversation_id"]):
            raise ValueError("conversation cursor belongs to another conversation")
        start = cursor.get("count")
        if not isinstance(start, int) or start < 0 or start > len(events):
            raise ValueError("conversation prefix changed; refresh full conversation")
        if cursor.get("prefix_sha256") != _prefix_digest(events, start):
            raise ValueError("conversation prefix changed; refresh full conversation")
    return {**{k: v for k, v in result.items() if k != "events"},
            "total_events": len(events), "new_events": len(events) - start,
            "events": events[start:],
            "next_cursor": _cursor(result["provider"], result["conversation_id"], events, len(events))}


def remembered_cursor_path(root: Path, reader_id: str, provider: str, conversation_id: str) -> Path:
    if not reader_id or len(reader_id) > 160:
        raise ValueError("reader ID must be a nonempty bounded name")
    key = hashlib.sha256(json.dumps([reader_id, provider, conversation_id],
                                    ensure_ascii=False, separators=(",", ":")).encode()).hexdigest()
    return root / (key + ".json")


@contextmanager
def remembered_cursor_lock(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    lock = path.with_suffix(".lock")
    with lock.open("a+b") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(handle, fcntl.LOCK_UN)


def load_remembered_cursor(path: Path, reader_id: str, provider: str, conversation_id: str) -> str:
    if not path.is_file():
        return ""
    row = json.loads(path.read_text(encoding="utf-8"))
    if ([row.get("reader_id"), row.get("provider"), row.get("conversation_id")]
            != [reader_id, provider, conversation_id] or not isinstance(row.get("cursor"), str)):
        raise ValueError("remembered conversation cursor identity mismatch")
    return row["cursor"]


def save_remembered_cursor(path: Path, reader_id: str, provider: str,
                           conversation_id: str, cursor: str) -> None:
    row = {"reader_id": reader_id, "provider": provider,
           "conversation_id": conversation_id, "cursor": cursor}
    payload = json.dumps(row, ensure_ascii=False, sort_keys=True).encode("utf-8")
    with tempfile.NamedTemporaryFile(dir=path.parent, prefix=".cursor-", delete=False) as temp:
        tmp = Path(temp.name)
        os.fchmod(temp.fileno(), 0o600)
        temp.write(payload)
        temp.flush()
        os.fsync(temp.fileno())
    try:
        os.replace(tmp, path)
    finally:
        tmp.unlink(missing_ok=True)


def render_view(result: dict, output_format: str) -> None:
    if output_format == "json":
        print(json.dumps(result, ensure_ascii=False))
    else:
        print(f"# {result['provider']}/{result['conversation_id']}\n")
        print(f"Source: {result['source']} · coverage: {result['coverage']} · "
              f"all provider events known: {result['all_provider_events_known']} · "
              f"new: {result['new_events']} / {result['total_events']}\n")
        for event in result["events"]:
            print(f"## {event['role']} {event['occurred_at_utc']}\n\n{event['text']}\n")
        print(f"<!-- next_cursor: {result['next_cursor']} -->")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--provider", required=True)
    parser.add_argument("--conversation-id", required=True)
    parser.add_argument("--since", default="", help="opaque next_cursor from a prior read")
    parser.add_argument("--drive-reader", type=Path, default=DEFAULT_DRIVE_READER)
    parser.add_argument("--historical-reader", type=Path, default=DEFAULT_HISTORICAL_READER)
    parser.add_argument("--format", choices=("json", "markdown"), default="json")
    parser.add_argument("--remember", action="store_true",
                        help="show the full conversation once, then only unseen events for this reader")
    parser.add_argument("--reader-id", default=os.environ.get("COGNILODE_READER_ID", "default"))
    parser.add_argument("--cursor-root", type=Path, default=Path.home()/".local/state/cognilode/conversation-read-cursors")
    args = parser.parse_args()
    if args.remember and args.since:
        parser.error("--remember and --since cannot be combined")
    def read() -> dict:
        return read_conversation(args.provider, args.conversation_id,
                                 drive_reader=args.drive_reader,
                                 historical_reader=args.historical_reader)
    if args.remember:
        path=remembered_cursor_path(args.cursor_root, args.reader_id, args.provider, args.conversation_id)
        with remembered_cursor_lock(path):
            previous=load_remembered_cursor(path,args.reader_id,args.provider,args.conversation_id)
            source=read()
            try:
                result=delta_view(source,previous)
            except ValueError as exc:
                if "prefix changed" not in str(exc):
                    raise
                result=delta_view(source)
                result["cursor_reset_reason"]="source_prefix_changed"
            render_view(result,args.format)
            sys.stdout.flush()
            save_remembered_cursor(path,args.reader_id,args.provider,args.conversation_id,
                                   result["next_cursor"])
    else:
        render_view(delta_view(read(),args.since),args.format)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
