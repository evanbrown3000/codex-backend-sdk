#!/usr/bin/env python3
"""Recurring thin plan dispatch and Secretary reconciliation inside Docker."""
from __future__ import annotations

import os
from pathlib import Path
import subprocess
import sys
import time


SOURCE = Path(os.environ.get("COGNILODE_COMPANY_SOURCE_ROOT", "/runtime/source")) / "current"
PLAN_ROOT = Path(os.environ.get("COGNILODE_TASKFLOW_PLAN_ROOT", "/runtime/worker/rpe-runs"))


def run_once() -> None:
    runtime = SOURCE / "modified-codex-runtime" / "src"
    taskflow = SOURCE / "taskflow-orchestration-history" / "src"
    if not runtime.is_dir() or not taskflow.is_dir():
        print("TaskFlow runtime waiting for company source sync", flush=True)
        return
    env = os.environ.copy()
    env["PYTHONPATH"] = os.pathsep.join((str(runtime), str(taskflow), env.get("PYTHONPATH", "")))
    env["COGNILODE_TASKFLOW_DISPATCH_BIN"] = "/company/codex-backend-sdk/scripts/cognilode-taskflow-dispatch"
    env["COGNILODE_REPOSITORIES_ROOT"] = str(SOURCE)
    env["COGNILODE_AWS_CLI"] = "/usr/bin/aws"
    subprocess.run([sys.executable, "-m", "modified_codex.taskflow_secretary", "reconcile"],
                   env=env, check=False, timeout=240)
    for plan in sorted(PLAN_ROOT.glob("**/project.dispatch.plan")):
        if not plan.is_file():
            continue
        subprocess.run([sys.executable, "-m", "taskflow.dispatch", str(plan),
                        "--handler", "secretary=python3 -m modified_codex.taskflow_secretary submit",
                        "--parallel", "8"], env=env, check=False, timeout=240)


if __name__ == "__main__":
    while True:
        try:
            run_once()
        except Exception as error:
            print(f"TaskFlow worker pending: {type(error).__name__}: {error}", flush=True)
        time.sleep(max(30, int(os.environ.get("COGNILODE_TASKFLOW_SCAN_INTERVAL", "60"))))
