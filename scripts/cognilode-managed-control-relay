#!/usr/bin/env python3
"""Narrow managed-control relay using existing remote-shell credential custody.

This process runs only inside the host-networked remote-shell container. Host
callers submit typed actions; bearer capabilities remain in that container.
"""
from __future__ import annotations
import json, os, sys, urllib.request
from pathlib import Path

BASE=os.environ.get('COGNILODE_OPERATOR_URL','https://cognilode.com').rstrip('/')
TOKEN_FILE=Path(os.environ.get('COGNILODE_OPERATOR_TOKEN_FILE','/home/worker/.config/cognilode/operator-bearer'))
CUSTODY=Path(os.environ.get('COGNILODE_RELAY_NODE_FILE','/relay/node.json'))
REMOTE=os.environ.get('COGNILODE_REMOTE_SHELL_ENDPOINT',BASE+'/api/operator/remote-shell/mcp')

def post(url, token, payload, timeout=35):
    request=urllib.request.Request(url,data=json.dumps(payload,separators=(',',':')).encode(),
        headers={'Authorization':'Bearer '+token,'Content-Type':'application/json','Accept':'application/json'},method='POST')
    with urllib.request.urlopen(request,timeout=timeout) as response:
        return json.load(response)

def run(payload):
    if not isinstance(payload,dict): raise ValueError('request_must_be_object')
    action=str(payload.get('action') or '')
    args=payload.get('arguments') or {}
    if not isinstance(args,dict): raise ValueError('arguments_must_be_object')
    actor=str(payload.get('actor_id') or 'default')
    if len(actor)>160: raise ValueError('actor_id_too_long')
    if action in {'conversation_list','conversation_search','conversation_read'}:
        custody=json.loads(CUSTODY.read_text())
        body={'action':action.removeprefix('conversation_')}
        if action=='conversation_list':
            body.update(limit=max(1,min(100,int(args.get('limit',50)))),provider=str(args.get('provider') or 'chatgpt.com'))
            if args.get('cursor'): body['cursor']=str(args['cursor'])
        elif action=='conversation_search':
            query=str(args.get('query') or '').strip()
            if not query: raise ValueError('conversation_search_query_required')
            body.update(query=query,limit=max(1,min(100,int(args.get('limit',50)))),provider=str(args.get('provider') or 'chatgpt.com'))
        else:
            cid=str(args.get('conversation_id') or '').strip()
            if not cid: raise ValueError('conversation_read_id_required')
            body.update(conversation_id=cid,reader_id=str(args.get('reader_id') or actor),
                        after=args.get('after'),full=bool(args.get('full')),peek=bool(args.get('peek')),
                        projection=str(args.get('projection') or 'read-model'))
        value=post('http://127.0.0.1:8899/conversations',str(custody['mcp_bearer']),body)
        if value.get('ok') is not True: raise RuntimeError('central_conversation_read_failed')
        return {'ok':True,'action':action,'result':value}
    if action in {'environment_list','environment_current','environment_select'}:
        name={'environment_list':'node_list','environment_current':'route_get',
              'environment_select':'environment_select'}[action]
        arguments={'actor_id':actor}
        if action=='environment_select':
            eid=str(args.get('environment_id') or '').strip()
            if not eid: raise ValueError('environment_select_id_required')
            arguments['environment_id']=eid
        token=TOKEN_FILE.read_text().strip().removeprefix('Bearer ').strip()
        if not token: raise RuntimeError('operator_custody_capability_unavailable')
        request={'jsonrpc':'2.0','id':'managed-control','method':'tools/call',
                 'params':{'name':name,'arguments':arguments}}
        raw=post(REMOTE,token,request)
        if raw.get('error'): raise RuntimeError('operator_remote_shell_rejected_control_action')
        result=raw.get('result',raw)
        if isinstance(result,dict) and result.get('structuredContent') is not None:
            result=result['structuredContent']
        elif isinstance(result,dict) and isinstance(result.get('content'),list):
            blocks=result['content']
            if len(blocks)==1 and isinstance(blocks[0],dict):
                try: result=json.loads(blocks[0].get('text',''))
                except (TypeError,ValueError): pass
        if isinstance(result,dict) and result.get('error'):
            raise RuntimeError('operator_remote_shell_control_error')
        return {'ok':True,'action':action,'actor_id':actor,'result':result}
    raise ValueError('unsupported_managed_control_action')

if __name__=='__main__':
    try:
        print(json.dumps(run(json.loads(sys.stdin.readline())),separators=(',',':')))
    except Exception as exc:
        print(json.dumps({'ok':False,'error':'managed_control_relay_failed','detail':type(exc).__name__},separators=(',',':')))
        raise SystemExit(2)
