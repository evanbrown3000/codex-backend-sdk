#!/usr/bin/env python3
"""Keep the single hosted Chat-mode queue filled without a local turn ceiling."""
from __future__ import annotations

import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import subprocess
import socket
import sys
import threading
import time


def load(path: Path, name: str):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def emit(kind: str, **fields):
    print(json.dumps({"kind": kind, "at": time.time(), **fields}, sort_keys=True), flush=True)


def live_sender_count() -> int | None:
    """Count provider send processes, rather than stale D1 effect-pending rows."""
    provider_socket = os.environ.get("COGNILODE_PROVIDER_SOCKET", "").strip()
    if provider_socket:
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
                connection.settimeout(5)
                connection.connect(provider_socket)
                connection.sendall(b'{"operation":"active"}\n')
                with connection.makefile("r") as stream:
                    count = int(json.loads(stream.readline())["active"])
            return count if 0 <= count <= 1000 else None
        except (OSError, ValueError, KeyError, TypeError):
            return None
    try:
        result = subprocess.run(
            ["pgrep", "-fc", "cognilode-b4pt0r-chatmode --auth-source codex send"],
            capture_output=True, text=True, timeout=5, check=False,
        )
        count = int(result.stdout.strip())
        return count if 0 <= count <= 1000 else None
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def watch_provider(sender, provider: str, status_root: Path) -> None:
    """Each provider has an independent clock and retry cadence."""
    next_status_at = 0.0
    last_event = None
    while True:
        try:
            observed = live_sender_count() if provider == "chatgpt.com" else None
            include_status = time.monotonic() >= next_status_at
            request = {"operation": "rhythm_tick", "provider": provider,
                       "include_status": include_status}
            if observed is not None:
                request["provider_active_turns"] = observed
            result = sender.operator_memory_post(request, timeout=90)
            if include_status:
                next_status_at = time.monotonic() + 300
            status = result.get("scheduler_status")
            if not isinstance(status, dict) and include_status:
                # The existing tick already carries the next due time. Keep
                # that frontier visible while the matching site projection
                # rolls out; no second read or local scheduling authority.
                status = {"schema": "cognilode.rhythm_scheduler_status.v1",
                          "provider": provider, "observed_at_unix": time.time(),
                          "tick_status": result.get("status"),
                          "tick_reason": result.get("reason"),
                          "slot_index": result.get("slot_index"),
                          "projected_next_slot_at": result.get("due_at") or
                            ((result.get("clock") or {}).get("pacing") or {}).get("next_due_at"),
                          "rolling_24h": None,
                          "metric_state": "server_projection_pending"}
            if isinstance(status, dict):
                status_root.mkdir(parents=True, exist_ok=True)
                path = status_root / (provider.replace(".", "-") + ".json")
                temp = path.with_name(path.name + ".tmp")
                temp.write_text(json.dumps(status, sort_keys=True) + "\n", encoding="utf-8")
                os.replace(temp, path)
            job = result.get("job") or {}
            event_key = (result.get("status"), result.get("reason"),
                         result.get("slot_index"), job.get("id"))
            if event_key != last_event and result.get("status") != "not_due":
                emit("hosted_queue_tick", provider=provider,
                     status=result.get("status"), reason=result.get("reason"),
                     slot_index=result.get("slot_index"), due_at=result.get("due_at"),
                     job_id=job.get("id"))
                next_status_at = 0.0  # The next scheduled tick captures the new frontier.
            last_event = event_key
        except Exception as exc:
            emit("hosted_queue_tick_retry", provider=provider,
                 error=f"{type(exc).__name__}:{str(exc)[:200]}")
        time.sleep(10)


def main() -> int:
    here = Path(__file__).resolve().parent
    sender = load(here / "cognilode-b4pt0r-chatmode", "cognilode_floor_sender")
    requested = os.environ.get("COGNILODE_HOSTED_RHYTHM_PROVIDERS", "chatgpt.com")
    providers = tuple(dict.fromkeys(value.strip() for value in requested.split(",") if value.strip()))
    allowed = {"chatgpt.com", "gemini.com", "claude.com", "anthropic.com"}
    if not providers or any(provider not in allowed for provider in providers):
        raise SystemExit("invalid hosted rhythm provider list")
    status_root = Path(os.environ.get("COGNILODE_RHYTHM_STATUS_ROOT",
                                   str(Path.home() / ".local/share/cognilode/rhythm-status")))
    threads = []
    for provider in providers:
        thread = threading.Thread(target=watch_provider, args=(sender, provider, status_root),
                                  daemon=False, name="rhythm-" + provider)
        thread.start()
        threads.append(thread)
    for thread in threads:
        thread.join()
    return 0


if __name__ == "__main__":
    sys.exit(main())
