[Unit]
Description=Cognilode ChatGPT chat-mode actuator (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/cognilode/chatmode-queue-worker.env
ExecStart=%h/Projects/codex-backend-sdk/scripts/cognilode-chatmode-queue-worker --device-id %i --interval 60
Restart=always
RestartSec=15
CPUQuota=25%
MemoryMax=1G
NoNewPrivileges=true

[Install]
WantedBy=default.target
