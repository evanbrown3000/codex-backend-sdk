#!/usr/bin/env python3
"""AWS CLI credential_process backed by the central scoped company broker."""
from __future__ import annotations

import json
import os
from pathlib import Path
import sys
from cognilode_central_http import request_json

BASE = os.environ.get('COGNILODE_OPERATOR_URL', 'https://cognilode.com').rstrip('/')
TOKEN_FILE = Path(os.environ.get('COGNILODE_OPERATOR_TOKEN_FILE',
    '/home/worker/.config/cognilode/operator-bearer'))
PURPOSE = os.environ.get('COGNILODE_AWS_PURPOSE', '').strip()


def main() -> int:
    if PURPOSE not in {'artifact-read', 'artifact-write', 'secrets-read', 'secrets-write'}:
        raise RuntimeError('scoped AWS purpose is required')
    token = TOKEN_FILE.read_text().strip().removeprefix('Bearer ').strip()
    if not token:
        raise RuntimeError('company operator grant is missing')
    value = request_json(BASE, '/api/operator/aws-session', token,
        body={'purpose': PURPOSE}, timeout=45)
    if not value.get('ok') or not isinstance(value.get('credentials'), dict):
        raise RuntimeError('central scoped AWS session unavailable')
    print(json.dumps(value['credentials'], separators=(',', ':')))
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except Exception as error:
        print(f'company AWS credentials unavailable: {error}', file=sys.stderr)
        raise SystemExit(1)
