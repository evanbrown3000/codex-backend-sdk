"""Container-only relay node for company source, Codex, and artifact operations."""
import hmac, json, os, secrets, signal, socket, subprocess, threading, time, urllib.request
from pathlib import Path
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

with Path(os.environ.get('COGNILODE_RELAY_NODE_FILE','/relay/node.json')).open(encoding='utf-8') as source:
    CUSTODY=json.load(source)
BEARER=str(CUSTODY['mcp_bearer'])
NODE_ID=str(CUSTODY['node_id'])
NODE_TOKEN=str(CUSTODY['node_token'])
ENVIRONMENT_ID=os.environ.get('COGNILODE_ENVIRONMENT_ID',NODE_ID)
if not all((BEARER,NODE_ID,NODE_TOKEN)):
    raise RuntimeError('company relay custody is incomplete')
CENTRAL=str(CUSTODY.get('central_url') or 'https://cognilode.com').rstrip('/')
PORT=int(os.environ.get('COGNILODE_MCP_PORT','8899'))
WORKSPACE=os.environ.get('COGNILODE_WORKSPACE','/runtime/source/current')
HB_STATUS=os.environ.get('COGNILODE_HEARTBEAT_STATUS','')
MAX_OUTPUT=4*1024*1024
PROCESSES={}; LOCK=threading.RLock()

def write_hb(ok, **extra):
    if not HB_STATUS: return
    obj={'ok':bool(ok),'node_id':NODE_ID,'time':time.time(),**extra}
    try:
        os.makedirs(os.path.dirname(HB_STATUS),exist_ok=True)
        tmp=HB_STATUS+'.tmp'
        with open(tmp,'w') as f: json.dump(obj,f,separators=(',',':'))
        os.replace(tmp,HB_STATUS)
    except Exception: pass

class Proc:
    def __init__(self, argv, cwd=None, pipe_stdin=False):
        if not isinstance(argv,list) or not argv or not all(isinstance(x,str) for x in argv): raise ValueError('argv must be a non-empty string array')
        self.id='company-'+secrets.token_hex(12); self.events=[]; self.seq=0; self.lock=threading.RLock()
        self.proc=subprocess.Popen(argv,cwd=cwd or WORKSPACE,stdin=subprocess.PIPE if pipe_stdin else subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,start_new_session=True,bufsize=0)
        threading.Thread(target=self._collect,daemon=True).start()
    def _collect(self):
        while True:
            b=self.proc.stdout.read(4096)
            if not b: break
            with self.lock:
                self.seq+=1; self.events.append((self.seq,b))
                total=sum(len(x[1]) for x in self.events)
                while total>MAX_OUTPUT and self.events:
                    total-=len(self.events[0][1]); self.events.pop(0)
        self.proc.wait()
    def read(self,after=0,max_bytes=262144,wait_ms=0):
        deadline=time.monotonic()+min(max(wait_ms,0),9000)/1000
        while time.monotonic()<deadline:
            with self.lock:
                if self.seq>after or self.proc.poll() is not None: break
            time.sleep(.05)
        with self.lock:
            chunks=[(n,b) for n,b in self.events if n>after]; out=[]; size=0
            for n,b in chunks:
                room=max_bytes-size
                if room<=0: break
                out.append((n,b[:room])); size+=len(out[-1][1])
                if len(b)>room: break
            last=out[-1][0] if out else after
            return {'output':b''.join(b for _,b in out).decode('utf-8','replace'),'next_seq':last,'truncated':bool(chunks and (not out or last!=chunks[-1][0] or size>=max_bytes)),'exited':self.proc.poll() is not None,'closed':self.proc.poll() is not None,'exit_code':self.proc.poll(),'failure':None}

def tool(name,a):
    if name in ('shell_start','shell_execute'):
        cwd=a.get('cwd') or WORKSPACE
        if not os.path.isdir(cwd): raise ValueError('cwd does not exist')
        with LOCK:
            if sum(p.proc.poll() is None for p in PROCESSES.values())>=16: raise RuntimeError('process capacity reached')
            p=Proc(a.get('argv'),cwd,bool(a.get('pipe_stdin'))); PROCESSES[p.id]=p
        if name=='shell_start': return {'ok':True,'process_id':p.id,'running':True}
        timeout=max(1,min(int(a.get('timeout_seconds') or 30),900)); deadline=time.monotonic()+timeout
        while p.proc.poll() is None and time.monotonic()<deadline: time.sleep(.05)
        r=p.read(0,262144,0)
        return {'ok':r['exit_code'] in (None,0),'process_id':p.id,'running':not r['exited'],**r}
    p=PROCESSES.get(a.get('process_id'))
    if not p: raise ValueError('process_id not found')
    if name=='shell_poll': return {'ok':True,'process_id':p.id,'running':p.proc.poll() is None,**p.read(int(a.get('after_seq') or 0),min(262144,max(1,int(a.get('max_bytes') or 262144))),int(a.get('wait_ms') or 0))}
    if name=='shell_write':
        if p.proc.stdin is None: raise ValueError('stdin is not piped')
        b=str(a.get('text') or '').encode(); p.proc.stdin.write(b); p.proc.stdin.flush(); return {'ok':True,'process_id':p.id,'bytes_written':len(b)}
    if name=='shell_terminate':
        if p.proc.poll() is None: os.killpg(p.proc.pid,signal.SIGTERM)
        return {'ok':True,'process_id':p.id,'terminated':True}
    raise ValueError('unknown tool')

def heartbeat():
    while True:
        try:
            try:
                with socket.create_connection(('127.0.0.1',8799),timeout=1):
                    codex_ready=True
            except OSError:
                codex_ready=False
            body=json.dumps({'node_id':NODE_ID,'environment_id':ENVIRONMENT_ID,'image':'company-docker','codex_exec_server':codex_ready,'network_public':True,'network_local':True}).encode()
            req=urllib.request.Request(CENTRAL+'/api/operator/remote-shell/heartbeat',data=body,method='POST',headers={'Authorization':'Bearer '+NODE_TOKEN,'Content-Type':'application/json','User-Agent':'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36','Accept':'application/json,text/plain,*/*','Origin':CENTRAL,'Referer':CENTRAL+'/'})
            with urllib.request.urlopen(req,timeout=12) as r:
                write_hb(200<=r.status<300,http_status=r.status)
        except Exception as e:
            write_hb(False,error=type(e).__name__+': '+str(e)[:300])
        time.sleep(30)

class H(BaseHTTPRequestHandler):
    def log_message(self,*_): pass
    def sendj(self,x,status=200):
        b=json.dumps(x,separators=(',',':')).encode(); self.send_response(status); self.send_header('Content-Type','application/json'); self.send_header('Content-Length',str(len(b))); self.end_headers(); self.wfile.write(b)
    def do_GET(self):
        if self.path=='/healthz': return self.sendj({'ok':True,'node_id':NODE_ID,'workspace':WORKSPACE,'container':True})
        self.sendj({'error':'not found'},404)
    def do_POST(self):
        if self.path!='/mcp': return self.sendj({'error':'not found'},404)
        if not hmac.compare_digest(self.headers.get('Authorization',''),'Bearer '+BEARER): return self.sendj({'error':'unauthorized'},401)
        payload={}
        try:
            n=int(self.headers.get('Content-Length','0'))
            if n<1 or n>65536: raise ValueError('invalid request length')
            payload=json.loads(self.rfile.read(n)); method=payload.get('method'); rid=payload.get('id')
            if method=='initialize': result={'protocolVersion':'2025-06-18','capabilities':{'tools':{}},'serverInfo':{'name':'cognilode-company-remote-shell','version':'3.0.0'}}
            elif method=='tools/list': result={'tools':[{'name':x,'description':x,'inputSchema':{'type':'object'}} for x in ('shell_execute','shell_start','shell_poll','shell_write','shell_terminate')]}
            elif method=='tools/call':
                v=tool(payload.get('params',{}).get('name',''),payload.get('params',{}).get('arguments') or {})
                result={'content':[{'type':'text','text':json.dumps(v)}],'isError':not v.get('ok',False)}
            else: return self.sendj({'jsonrpc':'2.0','id':rid,'error':{'code':-32601,'message':'unknown method'}})
            self.sendj({'jsonrpc':'2.0','id':rid,'result':result})
        except Exception as e:
            self.sendj({'jsonrpc':'2.0','id':payload.get('id'),'result':{'content':[{'type':'text','text':json.dumps({'error':str(e)})}],'isError':True}})

if __name__=='__main__':
    os.makedirs(WORKSPACE,exist_ok=True); threading.Thread(target=heartbeat,daemon=True).start(); ThreadingHTTPServer.allow_reuse_address=True; ThreadingHTTPServer(('0.0.0.0',PORT),H).serve_forever()
