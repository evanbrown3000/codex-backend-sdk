#!/usr/bin/env python3
"""Admit a durable JSON batch to the single provider rhythm queue in parallel.

This runner is deliberately an admission client, not a second provider sender.
The central queue owns provider timing and the B4PT0R queue actuator owns every
credential-bearing mutation.
"""
from __future__ import annotations

import argparse
from concurrent.futures import ThreadPoolExecutor, as_completed
import hashlib
import json
from pathlib import Path
import sys
import uuid
import os

from codex_backend_sdk.bridge_provider import ProviderCommandClient


SDK_ROOT = Path(__file__).resolve().parent.parent


def run(_cli: str, root: Path, item: dict) -> dict:
    job_id = str(item.get("id") or uuid.uuid4())
    job = root / job_id
    job.mkdir(parents=True, exist_ok=True)
    prompt_text = str(item["prompt"])
    prompt_identity = hashlib.sha256(prompt_text.encode("utf-8")).hexdigest()
    request_id = str(uuid.uuid5(
        uuid.NAMESPACE_URL, "b4pt0r-batch:" + job_id + ":" + prompt_identity
    ))
    client = ProviderCommandClient(timeout=120)
    try:
        result = client.send_chatgpt(
            prompt=prompt_text,
            conversation_id=item.get("conversation_id"),
            parent_message_id=item.get("parent_message_id"),
            model=str(item.get("model") or "gpt-5-6-thinking"),
            effort=str(item.get("effort") or "xhigh"),
            attachments=tuple(str(Path(value).resolve()) for value in item.get("attachments") or ()),
            request_id=request_id,
            project=str(item.get("project") or "unified-b4pt0r"),
            role=str(item.get("role") or "automated-provider-worker"),
            source=str(item.get("source") or "b4pt0r-batch"),
            prompt_authority=str(item.get("prompt_authority") or "interactive_operator"),
            priority=item.get("priority"),
            decisionx=item.get("decisionx") if isinstance(item.get("decisionx"), dict) else None,
        )
    except Exception as exc:
        if isinstance(exc, RuntimeError) and str(exc) == "idempotency_conflict":
            # This batch is intake, not a second execution authority.  A
            # conflict means the stable batch identity already has a durable
            # central queue row; the rhythm actuator owns its later lifecycle.
            result = {"ok": True, "queued": True, "idempotent_existing": True,
                      "request_id": request_id}
        else:
            result = {"ok": False, "error": type(exc).__name__, "message": str(exc)}
    temporary = (job / "queue-admission.json.tmp")
    temporary.write_text(json.dumps(result, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.replace(temporary, job / "queue-admission.json")
    return {"id": job_id, "returncode": 0 if result.get("queued") else 1,
            "queue_job_id": result.get("job_id")}


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("batch", type=Path)
    parser.add_argument("--state-root", type=Path, required=True)
    parser.add_argument("--cli", default="b4pt0r")
    args = parser.parse_args()
    items = json.loads(args.batch.read_text(encoding="utf-8"))
    args.state_root.mkdir(parents=True, exist_ok=True)
    results = []
    with ThreadPoolExecutor(max_workers=max(1, len(items))) as pool:
        futures = [pool.submit(run, args.cli, args.state_root, item) for item in items]
        for future in as_completed(futures):
            result = future.result()
            results.append(result)
            print(json.dumps(result, separators=(",", ":")), flush=True)
    (args.state_root / "batch-result.json").write_text(
        json.dumps(results, indent=2) + "\n", encoding="utf-8")
    return 0 if all(row["returncode"] == 0 for row in results) else 1


if __name__ == "__main__":
    raise SystemExit(main())
