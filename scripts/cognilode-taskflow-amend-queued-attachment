#!/usr/bin/env python3
"""CAS-add one hash-verified ZIP to an existing queued Chat-mode TaskFlow job.

This only mutates D1 attachment refs. The existing job, prompt, plan, due time,
rhythm slot and provider send custody remain under their incumbent owners.
"""
from __future__ import annotations

import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import shutil
import stat
import sys
import tempfile
import zipfile


HERE = Path(__file__).resolve().parent
SHA256 = re.compile(r"[0-9a-f]{64}\Z")
MAX_ZIP_BYTES = 20 * 1024 * 1024
MAX_UNCOMPRESSED_BYTES = 100 * 1024 * 1024


def _load(path: Path, name: str):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _validated_zip(path: Path, expected_sha256: str) -> None:
    if (not SHA256.fullmatch(expected_sha256) or not path.is_file() or path.is_symlink()
        or not 0 < path.stat().st_size <= MAX_ZIP_BYTES or _sha256(path) != expected_sha256):
        raise ValueError("attachment ZIP path, size, or SHA-256 differs")
    with zipfile.ZipFile(path) as archive:
        infos = archive.infolist()
        if (not infos or len(infos) > 5000
            or sum(info.file_size for info in infos) > MAX_UNCOMPRESSED_BYTES
            or len({info.filename for info in infos}) != len(infos)
            or any(Path(info.filename).is_absolute() or ".." in Path(info.filename).parts
                   or "\\" in info.filename or info.flag_bits & 1
                   or stat.S_ISLNK(info.external_attr >> 16) for info in infos)
            or archive.testzip() is not None):
            raise ValueError("attachment ZIP members are invalid or unbounded")


def _stage_exact(source: Path, target: Path, expected_sha256: str) -> None:
    if target.exists():
        if not target.is_file() or target.is_symlink() or _sha256(target) != expected_sha256:
            raise ValueError("stable attachment path already holds different bytes")
        return
    target.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=target.parent, delete=False) as temporary:
        temporary_path = Path(temporary.name)
        try:
            with source.open("rb") as stream:
                shutil.copyfileobj(stream, temporary, length=1024 * 1024)
            temporary.flush()
            os.fsync(temporary.fileno())
        except Exception:
            temporary_path.unlink(missing_ok=True)
            raise
    try:
        if _sha256(temporary_path) != expected_sha256:
            raise ValueError("stable attachment copy SHA-256 differs")
        os.chmod(temporary_path, 0o644)
        try:
            os.link(temporary_path, target)
        except FileExistsError:
            if not target.is_file() or _sha256(target) != expected_sha256:
                raise ValueError("stable attachment path changed concurrently")
    finally:
        temporary_path.unlink(missing_ok=True)


def amend(args, *, sender=None, controller=None) -> dict:
    for key in ("zip_sha256", "expected_prompt_sha256", "expected_plan_sha256",
                "expected_original_sha256"):
        if not SHA256.fullmatch(getattr(args, key)):
            raise ValueError(f"{key} must be an exact lowercase SHA-256")
    if args.zip.is_symlink():
        raise ValueError("attachment ZIP source cannot be a symlink")
    source = args.zip.resolve()
    target = args.stage_path
    if not target.is_absolute() or target.is_symlink() or not args.name.strip() or len(args.name) > 240:
        raise ValueError("stable attachment path or display name is invalid")
    _validated_zip(source, args.zip_sha256)
    if sender is None:
        sender = _load(HERE / "cognilode-b4pt0r-chatmode", "taskflow_attachment_sender")
    if controller is None:
        controller = _load(HERE / "cognilode-taskflow-phase-controller", "taskflow_attachment_controller")
    read = {"operation": "get_job", "job_id": args.job_id}
    before = sender.operator_memory_post(read).get("job") or {}
    if (before.get("id") != args.job_id or before.get("state") != "queued"
        or before.get("rhythm_slot_index") is not None or before.get("provider") != "chatgpt.com"
        or before.get("prompt_author") != "taskflow_plan"
        or before.get("project") != args.project or before.get("taskflow_step") != args.step
        or before.get("phase") != "chatgpt_sandbox"
        or before.get("prompt_sha256") != args.expected_prompt_sha256
        or before.get("plan_revision") != args.expected_plan_sha256):
        raise ValueError("queued TaskFlow job identity or preclaim fence differs")
    original = list(before.get("attachment_refs") or [])
    if not any(isinstance(row, dict) and row.get("sha256") == args.expected_original_sha256
               for row in original):
        raise ValueError("original TaskFlow attachment SHA-256 differs")
    _stage_exact(source, target, args.zip_sha256)
    previous_bucket = os.environ.get("COGNILODE_TASKFLOW_ATTACHMENT_S3_BUCKET")
    os.environ["COGNILODE_TASKFLOW_ATTACHMENT_S3_BUCKET"] = args.bucket
    try:
        ref = controller.portable_attachment_ref(target, args.zip_sha256)
    finally:
        if previous_bucket is None:
            os.environ.pop("COGNILODE_TASKFLOW_ATTACHMENT_S3_BUCKET", None)
        else:
            os.environ["COGNILODE_TASKFLOW_ATTACHMENT_S3_BUCKET"] = previous_bucket
    ref.update(name=args.name, kind="taskflow_research_supplement")
    if ref.get("mirrors") != [f"s3://{args.bucket}/taskflow-artifacts/sha256/{args.zip_sha256}.zip"]:
        raise ValueError("private exact-SHA attachment mirror missing")
    existing = [row for row in original if isinstance(row, dict) and row.get("sha256") == args.zip_sha256]
    if existing and existing != [ref]:
        raise ValueError("queued job already has a different ref for this ZIP SHA-256")
    mutation = sender.operator_memory_post({
        "operation": "amend_queued_job_attachments", "job_id": args.job_id,
        "expected_prompt_sha256": args.expected_prompt_sha256,
        "expected_plan_revision": args.expected_plan_sha256,
        "expected_attachment_sha256": args.expected_original_sha256,
        "attachment_ref": ref,
    })
    after = sender.operator_memory_post(read).get("job") or {}
    for key in ("id", "prompt", "prompt_sha256", "plan_revision", "due_at", "priority",
                "project", "taskflow_step", "phase", "assigned_employee", "reason"):
        if after.get(key) != before.get(key):
            raise ValueError(f"queue job {key} changed during attachment amendment")
    after_refs = after.get("attachment_refs") or []
    if not isinstance(after_refs, list) or after_refs[:len(original)] != original:
        raise ValueError("original queued attachments changed")
    expected_refs = original if existing else [*original, ref]
    if after_refs != expected_refs:
        raise ValueError("new attachment failed exact D1 reread")
    return {"job_id": args.job_id, "state": after.get("state"),
            "idempotent": bool(mutation.get("idempotent")),
            "prompt_sha256": after["prompt_sha256"], "plan_revision": after["plan_revision"],
            "attachment_count": len(after_refs), "attachment": ref}


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--job-id", required=True)
    parser.add_argument("--project", required=True)
    parser.add_argument("--step", required=True)
    parser.add_argument("--zip", type=Path, required=True)
    parser.add_argument("--zip-sha256", required=True)
    parser.add_argument("--stage-path", type=Path, required=True)
    parser.add_argument("--bucket", required=True)
    parser.add_argument("--name", required=True)
    parser.add_argument("--expected-prompt-sha256", required=True)
    parser.add_argument("--expected-plan-sha256", required=True)
    parser.add_argument("--expected-original-sha256", required=True)
    print(json.dumps(amend(parser.parse_args()), sort_keys=True))


if __name__ == "__main__":
    main()
