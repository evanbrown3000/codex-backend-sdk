#!/usr/bin/env python3
"""Search the shared D1 FTS and historical title index without copying stock.

The two hit groups have different retrieval scopes and scores; they are never
merged into a fictitious global ranking. Read a hit with cognilode-conversation-read.
"""
from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import subprocess
import sys
from pathlib import Path


HERE = Path(__file__).resolve().parent
DEFAULT_HISTORICAL_READER = Path(
    "/home/evan/.local/share/cognilode/memory-stock-runtime/scripts/historical_s3_conversation.py"
)


def _with_read_coordinates(rows: list[dict], identity_field: str) -> list[dict]:
    """Expose the existing provider identity for a direct unified-reader call.

    Search hits are candidates, not proof of complete source or Drive custody;
    the reader checks those properties when the caller opens a hit.
    """
    output = []
    for raw in rows:
        row = dict(raw)
        provider, separator, conversation_id = str(row.get(identity_field) or "").partition(":")
        if separator and provider and conversation_id:
            row["provider"] = provider
            row["conversation_id"] = conversation_id
            row["read_args"] = {"provider": provider, "conversation_id": conversation_id}
        output.append(row)
    return output


def hosted_search(query: str, limit: int) -> dict:
    path = HERE / "cognilode-b4pt0r-chatmode"
    loader = importlib.machinery.SourceFileLoader("cognilode_sender_for_search", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    result = module.operator_memory_post({"operation": "search", "q": query, "limit": limit})
    if result.get("ok") is not True or not isinstance(result.get("segments"), list) or not isinstance(result.get("turns"), list):
        raise ValueError("hosted full-text search response is incomplete")
    return {"scope": "d1_indexed_cross_provider_segments_and_turns",
            "source_coverage": "D1 search hits; original and Drive completeness require unified reader verification",
            "segments": _with_read_coordinates(result["segments"], "source_key"),
            "turns": _with_read_coordinates(result["turns"], "conversation_key")}


def historical_search(query: str, limit: int, reader: Path) -> dict:
    if not reader.is_file():
        raise FileNotFoundError("historical S3 reader is unavailable")
    run = subprocess.run([sys.executable, str(reader), "search", query, "--limit", str(limit)],
                         text=True, capture_output=True, check=True, timeout=120)
    result = json.loads(run.stdout)
    if (result.get("schema") != "memory_stock.historical_s3_metadata_search.v1"
        or result.get("scope") != "title_or_conversation_id_only"
        or not isinstance(result.get("rows"), list)):
        raise ValueError("historical metadata search response is incomplete")
    return {"scope": result["scope"], "rows": result["rows"]}


def search(query: str, limit: int, source: str, historical_reader: Path) -> dict:
    if not query.strip() or not 1 <= limit <= 100:
        raise ValueError("query must be nonempty and limit must be 1–100")
    groups = {}
    for name, fn in (
        ("hosted", lambda: hosted_search(query, limit)),
        ("historical_s3", lambda: historical_search(query, limit, historical_reader)),
    ):
        if source not in {"all", name}:
            continue
        try:
            groups[name] = {"ok": True, **fn()}
        except Exception as exc:
            # One unavailable transport should not erase the other group's hits.
            groups[name] = {"ok": False, "error": type(exc).__name__}
    return {"schema": "cognilode.conversation_search.v1", "query": query,
            "limit_per_source": limit, "groups": groups,
            "at_least_one_source_succeeded": any(group["ok"] for group in groups.values())}


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--query", required=True)
    parser.add_argument("--limit", type=int, default=20)
    parser.add_argument("--source", choices=("all", "hosted", "historical_s3"), default="all")
    parser.add_argument("--historical-reader", type=Path, default=DEFAULT_HISTORICAL_READER)
    args = parser.parse_args()
    result = search(args.query, args.limit, args.source, args.historical_reader)
    print(json.dumps(result, ensure_ascii=False))
    return 0 if result["at_least_one_source_succeeded"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
