[Unit]
Description=Continuously refreshed local dashboard for the shared prompt queue
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/Projects/codex-backend-sdk/scripts/cognilode-prompt-queue serve --interval 15 --port 8769 --output %h/.local/share/cognilode/prompt-queue-live.md
Restart=always
RestartSec=15
CPUQuota=10%
MemoryMax=256M

[Install]
WantedBy=default.target
