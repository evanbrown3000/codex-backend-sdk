#!/usr/bin/env python3
import os, sys, json
from pathlib import Path
os.environ.setdefault("TOKIO_WORKER_THREADS", "2")
os.environ.setdefault("RAYON_NUM_THREADS", "2")
os.environ.setdefault("UV_THREADPOOL_SIZE", "2")
# This launcher is used only inside the already isolated company container.
if not Path("/.dockerenv").exists():
    raise SystemExit("company container launcher requires Docker isolation")
if "--candidates-json" in sys.argv:
    path=Path(sys.argv[sys.argv.index("--candidates-json")+1])
    candidates=json.loads(path.read_text())
    for candidate in candidates:
        if candidate.get("family") in {"installed_codex", "modified_codex"}:
            candidate.setdefault("metadata", {})["sandbox_mode"]="danger-full-access"
            candidate["metadata"]["outer_isolation"]="company-container"
    path.write_text(json.dumps(candidates, indent=2)+"\n")
from modified_codex.assignment_secretary import main
raise SystemExit(main())
