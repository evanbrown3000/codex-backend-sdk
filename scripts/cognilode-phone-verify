#!/usr/bin/env python3
"""Read-only phone prerequisite probe before its D1 actuator is enabled."""
from __future__ import annotations

import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import sys

SCRIPTS = Path(__file__).resolve().parent
BUCKET = "cognilode-conversation-visibility-362928919715-us-west-2"


def load(name: str, path: Path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


def main() -> int:
    if len(sys.argv) != 2 or not re.fullmatch(r"[0-9a-f]{64}", sys.argv[1]):
        raise SystemExit("Usage: cognilode-phone-verify EXISTING_PRIVATE_ZIP_SHA256")
    sender = load("phone_verify_sender", SCRIPTS / "cognilode-b4pt0r-chatmode")
    rhythm = sender.operator_memory_post({"operation": "rhythm_read"})
    if rhythm.get("ok") is not True or rhythm.get("initialized") is not True:
        raise RuntimeError("central D1 rhythm readback unavailable")
    os.environ["COGNILODE_TASKFLOW_ATTACHMENT_S3_BUCKET"] = BUCKET
    worker = load("phone_verify_worker", SCRIPTS / "cognilode-chatmode-queue-worker")
    digest = sys.argv[1]
    staged = worker._stage_remote_attachment(f"s3://{BUCKET}/taskflow-artifacts/sha256/{digest}.zip", digest)
    if hashlib.sha256(staged.read_bytes()).hexdigest() != digest:
        raise RuntimeError("private ZIP exact bytes differ from requested SHA-256")
    print(json.dumps({"ok": True, "central_rhythm_readback": True,
                      "private_zip_sha256_verified": digest, "actuator_started": False}))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
