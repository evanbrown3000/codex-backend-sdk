#!/usr/bin/env python3
"""Keep the pinned company Codex release installed in a shared Docker volume."""
from __future__ import annotations

import os
import json
from pathlib import Path
import platform
import subprocess
import time


PIN = os.environ["COGNILODE_CODEX_SOURCE_COMMIT"]
SOURCE = Path(os.environ.get("COGNILODE_COMPANY_SOURCE_ROOT", "/runtime/source")) / "current/cognilode-codex"
RELEASE = Path(os.environ.get("COGNILODE_CODEX_INSTALL_ROOT", "/codex"))
TARGET = f"{platform.system().lower()}-{platform.machine().lower()}"
LOOKUP = RELEASE / "metadata" / f"lookup-{PIN}-{TARGET}.json"


def build_capacity_bytes() -> int:
    values = []
    try:
        for line in Path("/proc/meminfo").read_text().splitlines():
            if line.startswith("MemTotal:"):
                values.append(int(line.split()[1]) * 1024)
                break
    except (OSError, ValueError, IndexError):
        pass
    for path in ("/sys/fs/cgroup/memory.max", "/sys/fs/cgroup/memory/memory.limit_in_bytes"):
        try:
            raw = Path(path).read_text().strip()
            if raw != "max":
                values.append(int(raw))
        except (OSError, ValueError):
            pass
    return min(values) if values else 0


def run_once() -> None:
    if not (SOURCE / ".git").is_dir():
        return
    real_source = SOURCE.resolve()
    actual = subprocess.run(["git", "-c", f"safe.directory={real_source}", "-C", str(SOURCE),
                             "rev-parse", "HEAD"], capture_output=True, text=True, timeout=30)
    if actual.returncode or actual.stdout.strip() != PIN:
        return
    installed = RELEASE / "releases" / PIN / "codex"
    if (installed.is_file() and os.access(installed, os.X_OK) and
            (RELEASE / "bin/codex").is_file() and
            (RELEASE / "bin/central-rollouts").is_file()):
        return
    # Shared custody gets first chance to install the exact pinned release.
    # An inaccessible bucket must not trigger an independent low-memory build.
    if not LOOKUP.is_file():
        return
    try:
        lookup = json.loads(LOOKUP.read_text())
    except (OSError, ValueError):
        return
    if lookup.get("pin") != PIN or lookup.get("target") != TARGET or lookup.get("state") != "missing":
        return
    minimum = int(os.environ.get("COGNILODE_CODEX_MIN_BUILD_MEMORY_BYTES", str(5 * 1024 ** 3)))
    if build_capacity_bytes() < minimum:
        return
    env = os.environ.copy()
    env["COGNILODE_CODEX_SOURCE"] = str(SOURCE)
    env["COGNILODE_CODEX_INSTALL_ROOT"] = str(RELEASE)
    # The source-sync checkout belongs to the non-root company UID while this
    # isolated builder runs as root. Git canonicalizes the symlink before its
    # ownership check; grant only the resolved pinned checkout as safe.
    env["GIT_CONFIG_COUNT"] = "1"
    env["GIT_CONFIG_KEY_0"] = "safe.directory"
    env["GIT_CONFIG_VALUE_0"] = str(real_source)
    subprocess.run([str(SOURCE / "cognilode/host-client/build-install-container-codex")],
                   env=env, check=True, timeout=7200)
    print(f"Codex release ready {PIN}", flush=True)


if __name__ == "__main__":
    while True:
        try:
            run_once()
        except Exception as error:
            print(f"Codex release pending: {type(error).__name__}: {error}", flush=True)
        time.sleep(max(60, int(os.environ.get("COGNILODE_CODEX_BUILD_INTERVAL", "300"))))
