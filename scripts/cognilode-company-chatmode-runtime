#!/usr/bin/env python3
"""Supervise event-driven provider work inside the standard company container."""
from __future__ import annotations

import os
import fcntl
import hashlib
from pathlib import Path
import signal
import shutil
import subprocess
import sys
import threading
import time

HERE = Path(__file__).resolve().parent
STOP = False


def stop(_signal, _frame):
    global STOP
    STOP = True


def active_source() -> Path:
    """Resolve the runner from the synchronized source frontier.

    The container is intentionally long lived because it owns provider state.
    Source generations are immutable and the ``current`` link advances.  The
    supervisor observes that link and drains the old batch runner before using
    the next generation, avoiding both stale code and interrupted provider
    mutations.
    """
    configured = os.environ.get("COGNILODE_B4PT0R_SDK_ROOT")
    root = Path(configured) if configured else HERE.parent
    return root.resolve()


def release_revision(source: Path) -> str:
    """Identify the provider-custody SDK release.

    ComputerUseX is intentionally not part of this outer generation.  Its
    provider workers already load the moving domain source through PYTHONPATH
    and the inner batch supervisor rotates only the affected actuator.  Making
    every browser-adapter publication restart this outer population coupled
    otherwise independent provider clocks and let a long ChatGPT turn withhold
    Gemini/Claude capacity during a safe adapter update.
    """
    identities = [source.name]
    for variable, fallback in (
        ("COGNILODE_UNIVERSE_STORAGE_ROOT", "/runtime/source/current/universe-storage"),
    ):
        dependency = Path(os.environ.get(variable, fallback)).resolve()
        identities.append(dependency.name if dependency.exists() else "missing")
    digest = hashlib.sha256("|".join(identities).encode()).hexdigest()[:16]
    return f"{source.name}-{digest}"


def release_for(source: Path) -> tuple[Path, Path]:
    """Build one immutable CLI environment for a synchronized SDK revision."""
    release_root = Path(os.environ.get(
        # Keep the lock-aware immutable releases in their own generation.
        # Bootstrap containers may still be draining a pre-lock supervisor
        # against the legacy root; sharing paths with those processes lets an
        # old supervisor remove a newly completed environment.
        "COGNILODE_B4PT0R_RELEASE_ROOT", "/runtime/b4pt0r-releases/locked-v3-computerusex"
    ))
    # Converged checkouts are content-addressed directories.  Their embedded
    # git metadata may share a moving branch with other checkouts, so
    # ``git rev-parse HEAD`` can name a newer revision than the files in this
    # directory.  Key the runtime to the immutable directory identity.
    revision = release_revision(source)
    release = release_root / revision
    cli = release / "bin" / "b4pt0r"
    marker = release / ".complete"
    release_root.mkdir(parents=True, exist_ok=True)
    with (release_root / ".release-build.lock").open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if cli.is_file() and marker.is_file():
            # A predecessor generation may have prepared this revision with an
            # older builder.  A completeness marker therefore proves atomic
            # publication, not that dependencies introduced by the candidate
            # source are present.  Validate the release with the candidate's
            # own requirements before adopting it; rebuilding here makes a
            # release-builder repair self-applying instead of requiring a
            # manual venv mutation or another synthetic source revision.
            required = ["ijson", "curl_cffi"] if (
                source / "scripts" / "cognilode-chatmode-export-backfill"
            ).is_file() else []
            if not required:
                return source / "scripts" / "b4pt0r-com-batch-daemon", cli
            probe = subprocess.run(
                [str(release / "bin" / "python"), "-c",
                 "; ".join(f"import {name}" for name in required)],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
            if probe.returncode == 0:
                return source / "scripts" / "b4pt0r-com-batch-daemon", cli
            marker.unlink(missing_ok=True)
        # Python virtual environments are not relocatable: generated console
        # scripts retain the absolute interpreter path.  Build directly at the
        # immutable revision path and publish only by writing ``.complete``.
        # The surrounding lock prevents readers from observing a concurrent
        # build, while absence of the marker makes interrupted builds disposable.
        if release.exists():
            shutil.rmtree(release)
        builder = Path(os.environ.get("COGNILODE_VENV_PYTHON", "/usr/local/bin/python3"))
        if not builder.is_file():
            builder = Path(sys.executable)
        subprocess.run([str(builder), "-m", "venv", "--clear", str(release)],
                       check=True, timeout=300)
        universe = Path(os.environ.get(
            "COGNILODE_UNIVERSE_STORAGE_ROOT", "/runtime/source/current/universe-storage"
        )).resolve()
        computerusex = Path(os.environ.get(
            "COGNILODE_COMPUTERUSEX_PROJECT_ROOT",
            "/runtime/source/current/automation-computeruse-vision",
        )).resolve()
        # Source generations normally change company code, not the third-party
        # dependency set.  Seed the new, non-relocatable venv from the newest
        # complete environment, then overlay synchronized domain sources.  It
        # removes a network/build-backend round trip from every commit while
        # retaining a full pip bootstrap for the first generation.
        base_cli = latest_complete_cli()
        if base_cli is not None:
            base_release = base_cli.parent.parent
            base_sites = sorted(base_release.glob("lib/python*/site-packages"))
            new_sites = sorted(release.glob("lib/python*/site-packages"))
            if not base_sites or not new_sites:
                raise RuntimeError("immutable release site-packages unavailable")
            shutil.copytree(base_sites[-1], new_sites[-1], dirs_exist_ok=True)
            overlays = [(source / "codex_backend_sdk", new_sites[-1] / "codex_backend_sdk"),
                        (source / "filelock", new_sites[-1] / "filelock")]
            if universe.is_dir():
                overlays.append((universe / "src" / "universe_storage", new_sites[-1] / "universe_storage"))
            if computerusex.is_dir():
                overlays.append((computerusex / "src" / "computerusex", new_sites[-1] / "computerusex"))
            for origin, destination in overlays:
                if origin.is_dir():
                    if destination.exists():
                        shutil.rmtree(destination)
                    shutil.copytree(origin, destination)
            cli.write_text(
                f"#!{release / 'bin' / 'python'}\n"
                "from codex_backend_sdk.cli import main\n"
                "raise SystemExit(main())\n", encoding="utf-8",
            )
            cli.chmod(0o755)
        else:
            install = [str(release / "bin" / "python"), "-m", "pip", "install",
                       "--no-cache-dir", str(source)]
            if universe.is_dir():
                install.append(str(universe))
            subprocess.run(install, check=True, timeout=900)
        if computerusex.is_dir() and base_cli is None:
            # ComputerUseX is an internal source dependency whose optional
            # domain packages are not all published on PyPI.  Installing its
            # declared dependency graph makes a cold-start release impossible
            # before those source domains have converged.  The provider
            # actuator needs the synchronized ComputerUseX modules and the
            # SDK's already-installed runtime libraries, so install the source
            # package without asking PyPI to resolve unrelated internal names.
            subprocess.run([
                str(release / "bin" / "python"), "-m", "pip", "install",
                "--no-cache-dir", "--no-deps", str(computerusex),
            ], check=True, timeout=300)
            # The hosted-provider adapter imports ComputerUseX's MCP surface
            # directly. ComputerUseX is installed without its internal domain
            # dependencies above, so install the one public runtime extra that
            # surface actually requires rather than discovering it after a
            # scheduler-authorized provider effect has begun.
            subprocess.run([
                str(release / "bin" / "python"), "-m", "pip", "install",
                "--no-cache-dir", "mcp>=1.0,<2", "filelock>=3.13,<4",
            ], check=True, timeout=300)
        # The recovered privacy-export adapter is deliberately streaming and
        # depends on ijson.  Most generations seed site-packages from the
        # previous immutable release, so changing pyproject metadata alone
        # does not add a newly required runtime dependency.  Install it into
        # the candidate release before publishing the completeness marker.
        if (source / "scripts" / "cognilode-chatmode-export-backfill").is_file():
            probe = subprocess.run(
                [str(release / "bin" / "python"), "-c", "import ijson, curl_cffi"],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
            if probe.returncode:
                subprocess.run([
                    str(release / "bin" / "python"), "-m", "pip", "install",
                    "--no-cache-dir", "ijson>=3.2,<4", "curl-cffi>=0.7,<1",
                ], check=True, timeout=300)
        (release / ".complete").write_text(revision + "\n", encoding="utf-8")
    return source / "scripts" / "b4pt0r-com-batch-daemon", release / "bin" / "b4pt0r"


def launch_prepared(runner: Path, cli: Path) -> subprocess.Popen:
    environment = os.environ.copy()
    environment["B4PT0R_CLI"] = str(cli)
    environment["COMPUTERUSEX_SKIP_IMPORT_GUARDS"] = "1"
    # A self-exec inherits the retiring generation's fence identity. Reusing
    # it makes the successor batch exit on the predecessor's generation lock
    # precisely while that predecessor is draining a long provider turn.
    environment["COGNILODE_GENERATION_FENCE_IDENTITY"] = hashlib.sha256(
        (str(runner.resolve()) + "|" + str(cli.resolve())).encode()
    ).hexdigest()
    environment.setdefault(
        "COMPUTERUSEX_RUNTIME_ROOT",
        "/home/worker/.local/share/cognilode/computerusex",
    )
    return subprocess.Popen(
        [sys.executable, str(runner)], env=environment, start_new_session=True
    )


def launch_clock(source: Path, cli: Path) -> subprocess.Popen:
    """Run the one Area-2 clock caller outside actuator generations."""
    watcher = source / "scripts" / "cognilode-chatmode-floor-watcher"
    interpreter = cli.parent / "python"
    return subprocess.Popen(
        [str(interpreter), str(watcher)], env=os.environ.copy(), start_new_session=True
    )


def stop_clock(process: subprocess.Popen) -> None:
    if process.poll() is not None:
        return
    process.terminate()
    try:
        process.wait(timeout=30)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait()


def replace_supervisor(source: Path, draining_pids: list[int] | None = None) -> None:
    """Continue supervision with the synchronized generation's own code."""
    supervisor = (source / "scripts" / "cognilode-company-chatmode-runtime").resolve()
    # Source convergence may advance the Git worktree in place, so equal
    # filesystem paths do not imply equal executable generations.
    environment = os.environ.copy()
    environment.setdefault(
        "COMPUTERUSEX_RUNTIME_ROOT",
        "/home/worker/.local/share/cognilode/computerusex",
    )
    inherited = [int(value) for value in environment.get(
        "COGNILODE_DRAINING_PROVIDER_PIDS", ""
    ).split(",") if value.strip().isdigit()]
    inherited.extend(draining_pids or [])
    environment["COGNILODE_DRAINING_PROVIDER_PIDS"] = ",".join(
        str(value) for value in sorted(set(inherited))
    )
    os.execve(sys.executable, [sys.executable, str(supervisor)], environment)


def source_revision(source: Path) -> str:
    # Converged checkouts are named by immutable revision. Their embedded git
    # metadata may share a moving branch and cannot identify these files.
    return release_revision(source)


def launch(source: Path) -> subprocess.Popen:
    return launch_prepared(*release_for(source))


def latest_complete_cli() -> Path | None:
    """Return an already published CLI so cold starts keep custody live.

    Building the moving source frontier can take minutes.  A container restart
    must not leave the provider queue without an actuator during that build.
    Completed immutable releases are safe bootstrap executables; the normal
    frontier preparation below replaces them after the current release exists.
    """
    configured = Path(os.environ.get(
        "COGNILODE_B4PT0R_RELEASE_ROOT", "/runtime/b4pt0r-releases/locked-v3-computerusex"
    ))
    # A release-root generation is intentionally changed when dependency
    # composition changes.  Cold-start custody must nevertheless use the newest
    # completed predecessor while the first release in the new root is built.
    # Searching sibling generation roots is safe because only `.complete`
    # immutable environments qualify; it also prevents a compose/container
    # restart from leaving every provider queue without an actuator for minutes.
    roots = [configured]
    parent = configured.parent
    if parent.is_dir():
        roots.extend(path for path in parent.iterdir() if path.is_dir() and path != configured)
    candidates = []
    for root in roots:
        for marker in root.glob("*/.complete"):
            cli = marker.parent / "bin" / "b4pt0r"
            if cli.is_file():
                candidates.append((marker.stat().st_mtime_ns, cli))
    return max(candidates, default=(0, None))[1]


def prepare_frontier() -> tuple[Path, Path, Path]:
    """Build toward the moving source frontier without stopping provider work.

    Several agents may publish close together.  Intermediate revisions remain
    valid immutable history, but custody must not drain and restart once per
    commit.  Keep the incumbent worker live while releases build and only
    return when the prepared revision is still the current frontier.
    """
    while True:
        candidate = active_source()
        runner, cli = release_for(candidate)
        if active_source() == candidate:
            return candidate, runner, cli


def _reap(pid: int) -> None:
    try:
        os.waitpid(pid, 0)
    except ChildProcessError:
        pass


def _descendant_has_provider_broker(pid: int) -> bool:
    frontier = [pid]
    seen: set[int] = set()
    while frontier:
        current = frontier.pop()
        if current in seen:
            continue
        seen.add(current)
        try:
            root = Path("/proc") / str(current)
            command = (root / "cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace")
            children = (root / "task" / str(current) / "children").read_text().split()
        except OSError:
            continue
        if "codex_backend_sdk.provider_broker" in command:
            return True
        frontier.extend(int(value) for value in children if value.isdigit())
    return False


_OBSOLETE_BROKERLESS_SINCE: dict[int, float] = {}


def reap_obsolete_batch_generations(active_revision: str, current_pid: int) -> None:
    """Retire leaked old supervisors/actuators after their turn has drained.

    Early supervisor generations left provider actuators reparented to PID 1.
    Looking only for the batch-daemon parent therefore retained multiple stale
    queue consumers indefinitely.  Treat those orphan actuators as generation
    roots too, while preserving any root that still owns a live provider
    broker.  This restores one converged custody path without terminating an
    accepted provider operation.
    """
    now = time.monotonic()
    seen: set[int] = set()
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        pid = int(entry.name)
        if pid in {os.getpid(), current_pid}:
            continue
        try:
            command = (entry / "cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace")
        except OSError:
            continue
        obsolete_root = (
            "b4pt0r-com-batch-daemon" in command
            or "cognilode-provider-queue-actuator" in command
        )
        if not obsolete_root or active_revision in command:
            continue
        seen.add(pid)
        if _descendant_has_provider_broker(pid):
            _OBSOLETE_BROKERLESS_SINCE.pop(pid, None)
            continue
        since = _OBSOLETE_BROKERLESS_SINCE.setdefault(pid, now)
        if now - since < 30:
            continue
        try:
            os.killpg(os.getpgid(pid), signal.SIGTERM)
        except ProcessLookupError:
            pass
        _OBSOLETE_BROKERLESS_SINCE.pop(pid, None)
    for pid in tuple(_OBSOLETE_BROKERLESS_SINCE):
        if pid not in seen:
            _OBSOLETE_BROKERLESS_SINCE.pop(pid, None)


def _reap_draining_generation(pid: int) -> None:
    """Keep live transports, but retire generations with no transport left."""
    # The predecessor already received SIGTERM and had a handoff grace window.
    # A live broker owns the only socket that can still collect an accepted
    # provider turn; without one, retaining its supervisors merely publishes
    # duplicate capability heartbeats forever.
    while _descendant_has_provider_broker(pid):
        time.sleep(2)
    # Broker exit means the provider operation returned to its actuator; it
    # does not mean the actuator has durably completed the scheduler fence.
    # The draining batch daemon is cooperative and exits after its non-daemon
    # actuator thread commits or requeues the result.  Never replace that
    # semantic boundary with a wall-clock kill.
    while True:
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            _reap(pid)
            return
        time.sleep(0.25)


def reap_inherited_drains() -> None:
    """Reap old generation children without making them a handoff barrier."""
    raw = os.environ.pop("COGNILODE_DRAINING_PROVIDER_PIDS", "")
    for value in raw.split(","):
        if value.strip().isdigit():
            threading.Thread(target=_reap_draining_generation,
                             args=(int(value),), daemon=True).start()


def drain(process: subprocess.Popen, *, handoff: bool = True) -> list[int]:
    """Drain safely; accepted provider turns have no source-generation timeout."""
    if process.poll() is not None:
        return []
    # Signal the supervisor only.  It owns a cooperative drain protocol for
    # the queue actuator and its streamed provider children; signalling the
    # whole process group would kill those children before they could finish.
    process.terminate()
    if not handoff:
        process.wait()
        return []
    try:
        process.wait(timeout=5.0)
        return []
    except subprocess.TimeoutExpired:
        # The retiring generation remains alive only to finish already accepted
        # effects. Its generation-scoped daemon lock permits the successor to
        # start immediately; queue leases still prevent duplicate mutation.
        return [process.pid]


def prepare_while_live(process: subprocess.Popen) -> tuple[Path, Path, Path]:
    """Retry release preparation without sacrificing the incumbent actuator."""
    while not STOP:
        try:
            return prepare_frontier()
        except (OSError, subprocess.CalledProcessError, subprocess.TimeoutExpired) as exc:
            print(f"provider release preparation retry: {type(exc).__name__}: {exc}",
                  file=sys.stderr, flush=True)
            if process.poll() is not None:
                fallback = latest_complete_cli()
                if fallback is None:
                    raise
                process = launch_prepared(
                    active_source() / "scripts" / "b4pt0r-com-batch-daemon", fallback
                )
            time.sleep(15)
    raise SystemExit(0)


def main() -> int:
    # Provider generations are clients of the elected central Agent Memory
    # authority.  Older container definitions injected a host-local facade;
    # correct that at the source-owned supervisor boundary so immutable source
    # convergence repairs the running population without requiring a Docker
    # recreate or inheriting environment-local memory authority.
    central_memory = os.environ.get(
        "COGNILODE_CENTRAL_AGENT_MEMORY_ENDPOINT",
        "https://cognilode.com/api/operator/conversations",
    )
    os.environ["AGENT_MEMORY_ENDPOINT"] = central_memory
    os.environ["AGENT_MEMORY_INGEST_ENDPOINT"] = os.environ.get(
        "COGNILODE_CENTRAL_AGENT_MEMORY_INGEST_ENDPOINT",
        "https://cognilode.com/api/operator/agent-memory",
    )
    os.environ["AGENT_MEMORY_INVENTORY_ENDPOINT"] = os.environ.get(
        "COGNILODE_CENTRAL_AGENT_MEMORY_INVENTORY_ENDPOINT",
        "https://cognilode.com/api/operator/inventory/events",
    )
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    reap_inherited_drains()
    source = active_source()
    active_revision = source_revision(source)
    bootstrap_cli = latest_complete_cli()
    target_cli = Path(os.environ.get(
        "COGNILODE_B4PT0R_RELEASE_ROOT", "/runtime/b4pt0r-releases/locked-v2"
    )) / source_revision(source) / "bin" / "b4pt0r"
    if bootstrap_cli is not None and not target_cli.is_file():
        process = launch_prepared(source / "scripts" / "b4pt0r-com-batch-daemon", bootstrap_cli)
        source, runner, cli = prepare_while_live(process)
        for pid in drain(process):
            threading.Thread(target=_reap, args=(pid,), daemon=True).start()
        process = launch_prepared(runner, cli)
    else:
        source, runner, cli = prepare_frontier()
        process = launch_prepared(runner, cli)
    # The clock belongs to the stable Area-2 queue boundary, not to an
    # actuator generation.  Keeping it here lets accepted provider capability
    # heartbeats drive independent clocks while old provider effects drain.
    # The watcher's durable lock also fences any predecessor during handoff.
    clock = launch_clock(source, cli)
    pending_generation: tuple[Path, str] | None = None
    pending_since = 0.0
    pending_frontier_since = 0.0
    stability_seconds = float(os.environ.get(
        "COGNILODE_PROVIDER_SOURCE_STABILITY_SECONDS", "120"
    ))
    maximum_staleness_seconds = float(os.environ.get(
        "COGNILODE_PROVIDER_SOURCE_MAX_STALENESS_SECONDS", "240"
    ))
    while not STOP:
        reap_obsolete_batch_generations(active_revision, process.pid)
        if clock.poll() is not None:
            clock = launch_clock(source, cli)
        if process.poll() is not None:
            source, runner, cli = prepare_frontier()
            process = launch_prepared(runner, cli)
        else:
            candidate = active_source()
            candidate_revision = source_revision(candidate)
            if candidate != source or candidate_revision != active_revision:
                identity = (candidate, candidate_revision)
                if pending_generation != identity:
                    pending_generation = identity
                    pending_since = time.monotonic()
                    if not pending_frontier_since:
                        pending_frontier_since = pending_since
                    time.sleep(2)
                    continue
                # Source convergence can advance many times while agents are
                # publishing related changes.  Keep the admitted provider
                # population live and coalesce that burst into one generation
                # instead of placing the transport perpetually in draining.
                stable_for = time.monotonic() - pending_since
                stale_for = time.monotonic() - pending_frontier_since
                if stable_for < stability_seconds and stale_for < maximum_staleness_seconds:
                    time.sleep(2)
                    continue
                candidate, runner, cli = prepare_frontier()
                draining = drain(process)
                # A source cutover includes the supervisor itself, not only its
                # children.  Otherwise an old bootstrap process can keep stale
                # release/install semantics forever while merely launching new
                # worker scripts beneath it.  Candidate preparation happens
                # before the drain, so provider custody remains live during the
                # potentially slow immutable-release build.
                stop_clock(clock)
                replace_supervisor(candidate, draining)
                source = candidate
                active_revision = source_revision(candidate)
                pending_generation = None
                pending_frontier_since = 0.0
                process = launch_prepared(runner, cli)
            else:
                pending_generation = None
                pending_frontier_since = 0.0
        time.sleep(2)
    if process.poll() is None:
        drain(process, handoff=False)
    stop_clock(clock)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
