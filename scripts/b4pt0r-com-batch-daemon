#!/usr/bin/env python3
"""Continuously execute durable B4PT0R batches without provider polling."""
from __future__ import annotations

import json
import os
import fcntl
import hashlib
from pathlib import Path
import subprocess
import signal
import sqlite3
import sys
import threading
import time


ROOT = Path(os.environ.get(
    "B4PT0R_BATCH_ROOT",
    str(Path.home() / ".local/share/cognilode/b4pt0r-batches"),
))
HERE = Path(__file__).resolve().parent
CLI = os.environ.get(
    "B4PT0R_CLI",
    str(Path.home() / ".local/share/cognilode/b4pt0r-chatmode/venv-python3.12/bin/b4pt0r"),
)
STOP = False
SUPERVISORS: list[threading.Thread] = []
SOURCE_ROOT = Path(os.environ.get("COGNILODE_COMPANY_SOURCE_ROOT", "/runtime/source"))


def provider_generation_environment(interpreter: Path) -> dict[str, str]:
    """Fence local provider brokers to this immutable SDK/runtime pair."""
    source = HERE.parent.resolve()
    transport = source / "scripts/cognilode-provider-transport"
    transport_version = hashlib.sha256(transport.read_bytes()).hexdigest()
    source_revision = source.name
    runtime_python = str(interpreter.resolve())
    runtime_fingerprint = hashlib.sha256(
        f"{source_revision}|{runtime_python}".encode()
    ).hexdigest()
    fence_identity = hashlib.sha256(
        f"{source_revision}|{transport_version}|{runtime_fingerprint}".encode()
    ).hexdigest()
    generation_id = hashlib.sha256(
        f"{source_revision}|{fence_identity}|{runtime_fingerprint}|{transport_version}".encode()
    ).hexdigest()
    root = Path(os.environ.get(
        "COGNILODE_GENERATION_MANIFEST_ROOT", "/runtime/provider-generations"
    ))
    root.mkdir(parents=True, exist_ok=True)
    manifest = root / f"{generation_id}.json"
    if not manifest.is_file():
        temporary = manifest.with_suffix(f".tmp-{os.getpid()}")
        temporary.write_text(json.dumps({
            "generation_id": generation_id,
            "source_revision": source_revision,
            "runtime_fingerprint": runtime_fingerprint,
            "provider_transport_version": transport_version,
            "fence_identity": fence_identity,
            "runtime_python": runtime_python,
            "executable_root": str(source),
        }, sort_keys=True, separators=(",", ":")) + "\n", encoding="utf-8")
        temporary.replace(manifest)
    return {
        "COGNILODE_GENERATION_MANIFEST": str(manifest),
        "COGNILODE_RUNTIME_GENERATION_FINGERPRINT": runtime_fingerprint,
        "COGNILODE_PROVIDER_TRANSPORT_VERSION": transport_version,
        "COGNILODE_GENERATION_FENCE_IDENTITY": fence_identity,
    }


def stop(_signal, _frame):
    global STOP
    STOP = True


def complete(state: Path) -> bool:
    try:
        rows = json.loads((state / "batch-result.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return False
    return bool(rows) and all(row.get("returncode") == 0 for row in rows)


def _sdk_worker_generation(program: list[str]) -> tuple[list[str], str]:
    """Resolve SDK worker code from the moving source pointer, never stale HERE."""
    if len(program) < 2:
        return program, "external"
    if len(program) >= 3 and program[1] == "-m" and program[2].startswith("computerusex."):
        roots = [Path("/runtime/source/current/automation-computeruse-vision/src"),
                 Path("/company/automation-computeruse-vision/src")]
        package = next((root / "computerusex" for root in roots if (root / "computerusex").is_dir()), None)
        if package is None:
            return program, "computerusex-unavailable"
        digest = hashlib.sha256()
        for dependency in sorted(package.glob("*.py")):
            digest.update(dependency.read_bytes())
        return program, digest.hexdigest()
    # The batch daemon is itself launched from an immutable source generation.
    # Keep every supervised SDK worker on that same generation. Following the
    # moving ``current`` link here caused each source publication to terminate
    # live provider turns before the outer generation supervisor could drain
    # them. The outer supervisor alone owns generation handoff.
    selected = Path(program[1])
    dependencies = [selected]
    if selected.name == "cognilode-provider-queue-actuator" and "--provider" in program:
        provider = program[program.index("--provider") + 1]
        if provider != "chatgpt.com":
            configured = os.environ.get("COGNILODE_COMPUTERUSEX_SOURCE", "").strip()
            roots = ([Path(configured)] if configured else []) + [
                Path("/runtime/source/current/automation-computeruse-vision/src"),
                Path("/company/automation-computeruse-vision/src"),
            ]
            package = next((root / "computerusex" for root in roots if (root / "computerusex").is_dir()), None)
            if package is not None:
                dependencies.extend(sorted(package.glob("*.py")))
    if selected.name == "cognilode-chatmode-queue-worker":
        checkout = selected.parent.parent
        dependencies.extend([
            selected.with_name("cognilode-unified-provider"),
            checkout / "codex_backend_sdk/provider_transport_client.py",
            selected.with_name("cognilode-provider-transport"),
        ])
    elif selected.name == "cognilode-provider-scheduler":
        scheduler_root = selected.parent.parent
        dependencies.extend(sorted(
            (scheduler_root / "src/cognilode_provider_scheduler").glob("*.py")
        ))
        dependencies.extend([
            scheduler_root / "data/provider_scheduler/historical_rhythm.json",
            scheduler_root / "data/provider_scheduler/historical_rhythm.uleb128",
        ])
    digest = hashlib.sha256()
    try:
        for dependency in dependencies:
            digest.update(dependency.read_bytes())
        signature = digest.hexdigest()
    except OSError:
        signature = "unavailable"
    resolved = list(program)
    resolved[1] = str(selected)
    return resolved, signature


def _onboarding_ready(program: list[str]) -> bool:
    """Expose provider actuators only in the mandated acceptance order."""
    if "--provider" not in program:
        return True
    provider = program[program.index("--provider") + 1]
    order = ("chatgpt.com", "gemini.com", "claude.com", "anthropic.com")
    if provider not in order or provider == order[0]:
        return True
    proof = Path(os.environ.get(
        "COGNILODE_PROVIDER_ACCEPTANCE_ROOT", "/runtime/area1-acceptance"
    )) / "four-provider-proof.json"
    try:
        record = json.loads(proof.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return False
    completed = {str(row.get("provider") or "") for row in record.get("providers") or []
                 if isinstance(row, dict)}
    return all(prior in completed for prior in order[:order.index(provider)])


def _provider_effect_in_flight(program: list[str]) -> bool:
    """Keep an actuator's complete process tree intact during provider work."""
    if "--provider" not in program:
        return False
    provider = program[program.index("--provider") + 1]
    path = Path(os.environ.get(
        "COGNILODE_PROVIDER_SCHEDULER_DB", "/runtime/provider-scheduler/scheduler.sqlite3"
    ))
    try:
        with sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=2) as connection:
            row = connection.execute(
                "SELECT 1 FROM provider_jobs WHERE provider=? "
                "AND state IN ('claimed','effect_pending') LIMIT 1", (provider,),
            ).fetchone()
        return row is not None
    except (OSError, sqlite3.Error):
        # A temporarily unreadable scheduler is not evidence that an external
        # provider mutation is safe to interrupt.
        return True


def supervise(program: list[str], extra_environment: dict[str, str] | None = None) -> None:
    environment = os.environ.copy()
    environment.update(extra_environment or {})
    while not STOP:
        # The mandated onboarding order is a hard capability gate. Independent
        # clocks begin only after the preceding platform has produced accepted
        # prompt, response, upload, duration, and downloaded-artifact proof.
        while not STOP and not _onboarding_ready(program):
            time.sleep(5)
        if STOP:
            return
        selected, signature = _sdk_worker_generation(program)
        worker_name = Path(selected[1]).name if len(selected) > 1 else "external"
        log_root = ROOT / "supervisor-logs"
        log_root.mkdir(parents=True, exist_ok=True)
        # Provider actuators share one executable basename but not one output
        # stream.  Keep diagnostics isolated by provider so concurrent turns
        # cannot make a ChatGPT fence look like a browser-provider failure.
        log_identity = worker_name
        if worker_name == "cognilode-provider-queue-actuator" and "--provider" in selected:
            provider = selected[selected.index("--provider") + 1]
            log_identity += "-" + provider.replace(".", "-")
        log_path = log_root / f"{log_identity}.log"
        if log_path.is_file() and log_path.stat().st_size > 5_000_000:
            log_path.replace(log_path.with_suffix(".log.previous"))
        log_stream = log_path.open("ab", buffering=0)
        process = subprocess.Popen(
            selected, env=environment, stdout=log_stream, stderr=subprocess.STDOUT,
        )
        while not STOP and process.poll() is None:
            _, active_signature = _sdk_worker_generation(program)
            if active_signature != signature:
                worker_name = Path(selected[1]).name if len(selected) > 1 else "external"
                if (worker_name in {
                    "cognilode-provider-queue-actuator", "cognilode-chatmode-queue-worker",
                } and _provider_effect_in_flight(program)):
                    time.sleep(1)
                    continue
                break
            time.sleep(1)
        if process.poll() is None:
            process.terminate()
            mutation_worker = worker_name in {
                "cognilode-provider-queue-actuator", "cognilode-chatmode-queue-worker",
            }
            if mutation_worker:
                # Accepted/in-turn provider effects outlive source generations.
                # Keep this supervisor alive until the worker has recorded a
                # terminal receipt; a fixed drain timeout would kill daemon
                # threads and lose that accepted turn.
                process.wait()
            else:
                try:
                    process.wait(timeout=30.0)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait()
        returncode = process.poll()
        log_stream.close()
        event = {
            "at": time.time(), "worker": worker_name, "returncode": returncode,
            "source_signature": signature, "command": selected,
        }
        with (ROOT / "supervisor-events.jsonl").open("a", encoding="utf-8") as stream:
            stream.write(json.dumps(event, ensure_ascii=False, sort_keys=True) + "\n")
        if not STOP:
            time.sleep(5)


def native_provider_workers() -> list[tuple[list[str], dict[str, str]]]:
    """Select domain-owned workers for the independent native .com queues."""
    requested = {
        value.strip().casefold()
        for value in os.environ.get(
            "COGNILODE_HOSTED_RHYTHM_PROVIDERS",
            # Provider populations have independent clocks and workers.  Keep
            # every native fallback available so a broken ChatGPT route cannot
            # prevent Gemini, Claude, or Anthropic from repairing it.
            "chatgpt.com,gemini.com,claude.com,anthropic.com",
        ).split(",")
        if value.strip()
    }
    workers: list[tuple[list[str], dict[str, str]]] = []
    # The central provider scheduler is the singular biological-clock owner.
    # Provider actuators advertise capacity and consume leases only; starting
    # the historical floor watcher here would create a second clock caller.
    event_publisher = HERE / "cognilode-provider-event-publisher"
    if event_publisher.is_file():
        workers.append(([str(CLI.rsplit("/", 1)[0] + "/python"), str(event_publisher)], {}))
    acceptance = HERE / "cognilode-provider-onboarding-acceptance"
    acceptance_seed = Path(os.environ.get(
        "COGNILODE_PROVIDER_ACCEPTANCE_ROOT", "/runtime/area1-acceptance"
    )) / "area1-provider-source.zip"
    # Runtime state may publish the acceptance seed after this immutable
    # generation starts. Keep the sequencer supervised from startup rather
    # than requiring an operator-triggered container restart.
    if acceptance.is_file():
        workers.append(([str(CLI.rsplit("/", 1)[0] + "/python"), str(acceptance)], {}))
    # ComputerUseX remains the domain-owned browser adapter.  B4PT0R owns the
    # singular queue-to-actuator boundary for every non-ChatGPT .com provider,
    # so the same lease, result envelope, artifact custody, and memory events
    # apply without a second provider-specific queue implementation.
    configured_computerusex = os.environ.get("COGNILODE_COMPUTERUSEX_SOURCE", "").strip()
    candidates = [Path(configured_computerusex)] if configured_computerusex else [
        Path("/runtime/source/current/automation-computeruse-vision/src"),
        Path("/company/automation-computeruse-vision/src"),
    ]
    computerusex = next(
        (candidate for candidate in candidates if (candidate / "computerusex").is_dir()),
        candidates[0],
    )
    provider_worker = HERE / "cognilode-provider-queue-actuator"
    if provider_worker.is_file() and computerusex.is_dir():
        interpreter = Path(CLI.rsplit("/", 1)[0] + "/python")
        pythonpath = str(computerusex)
        inherited = os.environ.get("PYTHONPATH", "")
        if inherited:
            pythonpath += os.pathsep + inherited
        for provider in ("chatgpt.com", "gemini.com", "claude.com", "anthropic.com"):
            # The acceptance process unlocks these workers one at a time.
            # Listing all four here is safe because `_onboarding_ready` keeps
            # later platforms incapable of consuming unrelated queued work
            # until every predecessor has produced accepted provider proof.
            if provider in requested or acceptance.is_file():
                worker_environment = {"PYTHONPATH": pythonpath}
                worker_environment.update(provider_generation_environment(interpreter))
                workers.append(([
                    str(interpreter), str(provider_worker),
                    "--provider", provider,
                    "--device-id", os.environ.get("COGNILODE_ENVIRONMENT_ID", "company-container"),
                ], worker_environment))
    return workers


def main() -> int:
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    ROOT.mkdir(parents=True, exist_ok=True)
    # A source handoff may overlap the retiring generation while one accepted
    # provider turn drains. Central queue leases and effect fences—not a
    # process-global file lock—provide mutation singularity. Scope this lock to
    # the immutable generation so a successor can serve the other providers.
    generation = os.environ.get("COGNILODE_GENERATION_FENCE_IDENTITY", "legacy")[:24]
    daemon_lock = (ROOT / f".batch-daemon.{generation}.lock").open("a+")
    try:
        fcntl.flock(daemon_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0
    # Provider queues are independent. A long Gemini turn cannot consume or
    # delay a ChatGPT rhythm slot, and neither worker polls the other provider.
    for actuator, extra_environment in native_provider_workers():
        thread = threading.Thread(
            target=supervise,
            args=(actuator, extra_environment),
            # The batch generation retains ownership of every actuator until
            # its admitted mutation drains.  Orphaning these children during
            # a source change allowed the successor generation to start a
            # second consumer for the same provider/account and disconnected
            # live transport sockets. Providers are still independent within
            # this generation; only the atomic generation handoff waits.
            daemon=False,
        )
        SUPERVISORS.append(thread)
        thread.start()
    # Historical ``batch.json`` directories predate the provider scheduler.
    # Replaying them here creates a second mutation route which bypasses queue
    # pacing, credential leases and parent-operation provenance.  They remain
    # readable evidence, but production actuation is exclusively performed by
    # the provider queue workers supervised above.
    while not STOP:
        time.sleep(5)
    # Retain the singleton lock and generation process until every provider
    # actuator has completed its cooperative drain.  This makes generation
    # ownership atomic and prevents duplicate consumers after an upgrade.
    for thread in SUPERVISORS:
        thread.join()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
