#!/usr/bin/env python3
"""Sequential, self-verifying acceptance of all subscription .com actuators.

One durable run admits each turn through the unified queue, waits only on the
queue ledger, rejects short/receipt-only work, and hands every prior physical
result to the next provider.  It never inspects provider history or asks a
foreground operator to ferry a prompt or file.
"""
from __future__ import annotations

from datetime import datetime
import fcntl
import hashlib
import json
import os
from pathlib import Path
import shutil
import time
from typing import Any, Mapping
import zipfile

from codex_backend_sdk.bridge_provider import ProviderCommandClient
from codex_backend_sdk.provider_scheduler_client import scheduler_call

PROVIDERS = ("chatgpt.com", "gemini.com", "claude.com", "anthropic.com")
MIN_PROVIDER_SECONDS = 300.0
MIN_RESPONSE_CHARS = 1200
MIN_ARTIFACT_BYTES = 4096
ACCEPTANCE_PRIORITY = 9_000_000_000_000_000


def iso(value: object) -> float:
    return datetime.fromisoformat(str(value).replace("Z", "+00:00")).timestamp()


def provider_seconds(job: Mapping[str, Any]) -> float:
    """Measure only provider-side execution, never queue or broker waiting."""
    result = job.get("normalized_provider_result") if isinstance(job.get("normalized_provider_result"), Mapping) else {}
    candidates: list[Mapping[str, Any]] = [result]
    seen: set[int] = set()
    while candidates:
        receipt = candidates.pop(0)
        if id(receipt) in seen:
            continue
        seen.add(id(receipt))
        elapsed = receipt.get("elapsed_seconds")
        if isinstance(elapsed, (int, float)):
            return float(elapsed)
        started = receipt.get("provider_started_at") or receipt.get("started_at")
        completed = receipt.get("provider_completed_at") or receipt.get("completed_at")
        if started is not None and completed is not None:
            try:
                start_value = float(started) if isinstance(started, (int, float)) else iso(started)
                end_value = float(completed) if isinstance(completed, (int, float)) else iso(completed)
                return end_value - start_value
            except (TypeError, ValueError):
                pass
        for key in ("provider_receipt", "provider_model_receipt", "model_receipt",
                    "response_observation"):
            child = receipt.get(key)
            if isinstance(child, Mapping):
                candidates.append(child)
    return 0.0


def provider_reasoning_evidence(job: Mapping[str, Any]) -> tuple[float, int]:
    """Measure from the first provider-visible assistant event to terminal."""
    result = job.get("normalized_provider_result") if isinstance(job.get("normalized_provider_result"), Mapping) else {}
    candidates: list[Mapping[str, Any]] = [result]
    receipts: list[Mapping[str, Any]] = []
    seen: set[int] = set()
    while candidates:
        row = candidates.pop(0)
        if id(row) in seen:
            continue
        seen.add(id(row)); receipts.append(row)
        for key in ("provider_receipt", "provider_model_receipt", "model_receipt",
                    "provider_summary", "response_observation"):
            child = row.get(key)
            if isinstance(child, Mapping):
                candidates.append(child)
    first = next((row.get("first_assistant_event_at") for row in receipts
                  if row.get("first_assistant_event_at") is not None), None)
    count = max((int(row.get("assistant_event_count") or 0) for row in receipts), default=0)
    completed = next((row.get("provider_completed_at") or row.get("completed_at")
                      for row in receipts
                      if row.get("provider_completed_at") is not None or row.get("completed_at") is not None), None)
    # Receipts created immediately before this field existed still have an
    # immutable raw SSE.  Recover first-thought evidence locally; never query
    # provider history merely to satisfy acceptance.
    if first is None:
        raw_value = next((row.get("raw_path") for row in receipts if row.get("raw_path")), "")
        raw = Path(str(raw_value or ""))
        if raw.is_file():
            observed: list[float] = []
            for line in raw.read_text(encoding="utf-8", errors="replace").splitlines():
                if not line.startswith("data:"):
                    continue
                try:
                    event = json.loads(line[5:].strip())
                except (TypeError, ValueError):
                    continue
                nested = event.get("v") if isinstance(event.get("v"), Mapping) else {}
                for message in (event.get("message"), nested.get("message")):
                    if not isinstance(message, Mapping):
                        continue
                    author = message.get("author") if isinstance(message.get("author"), Mapping) else {}
                    created = message.get("create_time")
                    if author.get("role") == "assistant" and isinstance(created, (int, float)):
                        observed.append(float(created))
            if observed:
                first, count = min(observed), len(observed)
    try:
        return max(0.0, float(completed) - float(first)), count
    except (TypeError, ValueError):
        return 0.0, count


def physical_outputs(job: Mapping[str, Any]) -> list[str]:
    """Recover downloaded products recursively from the immutable result envelope.

    Provider custody runs as ``/home/worker`` while acceptance runs against the
    same persistent volume as ``/home/evan``.  A custody pathname is therefore
    translated, never copied, before physical verification.
    """
    found: list[str] = []
    seen: set[int] = set()

    def visit(value: Any) -> None:
        if isinstance(value, Mapping):
            if id(value) in seen:
                return
            seen.add(id(value))
            for key in ("path", "local_path", "custody_path"):
                raw = value.get(key)
                if not isinstance(raw, str) or not raw:
                    continue
                candidates = [Path(raw)]
                prefix = "/home/worker/.local/share/cognilode/"
                if raw.startswith(prefix):
                    candidates.append(Path("/home/evan/.local/share/cognilode/") / raw[len(prefix):])
                for candidate in candidates:
                    if candidate.is_file() and candidate.stat().st_size >= MIN_ARTIFACT_BYTES:
                        text = str(candidate.resolve())
                        if text not in found:
                            found.append(text)
                        break
            for child in value.values():
                visit(child)
        elif isinstance(value, (list, tuple)):
            for child in value:
                visit(child)

    visit(job)
    return found


def attachment_packet(paths: list[str], root: Path) -> tuple[str, ...]:
    """Preserve distinct prior products under provider-unique filenames.

    Different provider turns intentionally return the same required package
    name. Browser upload controls collapse equal basenames, so passing both
    paths makes physical readback impossible even when both files entered the
    page. Exact duplicate bytes are sent once; distinct bytes receive a stable
    content-addressed alias and remain separate physical attachments.
    """
    aliases = root / "attachment-aliases"
    aliases.mkdir(parents=True, exist_ok=True)
    emitted: list[str] = []
    names: dict[str, str] = {}
    digests: set[str] = set()
    for raw in paths:
        source = Path(raw).resolve()
        digest = hashlib.sha256(source.read_bytes()).hexdigest()
        if digest in digests:
            continue
        name = source.name
        if name.casefold() in names:
            target = aliases / f"{digest[:12]}-{name}"
            if not target.is_file() or hashlib.sha256(target.read_bytes()).hexdigest() != digest:
                temporary = target.with_suffix(target.suffix + ".tmp")
                try:
                    os.link(source, temporary)
                except OSError:
                    shutil.copy2(source, temporary)
                os.replace(temporary, target)
            source = target
            name = source.name
        names[name.casefold()] = digest
        digests.add(digest)
        emitted.append(str(source))
    return tuple(emitted)


def memory_admitted(result: Mapping[str, Any]) -> bool:
    """Use the send-path admission receipt; never issue a provider read here."""
    pending: list[Mapping[str, Any]] = [result]
    seen: set[int] = set()
    while pending:
        row = pending.pop(0)
        if id(row) in seen:
            continue
        seen.add(id(row))
        central = row.get("central_conversation_store")
        if isinstance(central, Mapping) and central.get("stored") is True and central.get("central_readback_verified") is True:
            return True
        publication = row.get("agent_memory_publication")
        if isinstance(publication, Mapping) and publication.get("ingested") is True:
            return True
        for child in row.values():
            if isinstance(child, Mapping):
                pending.append(child)
    return False


def wait_bootstrap_job(client: ProviderCommandClient, provider: str, job_id: str) -> dict[str, Any]:
    """Wait through queue-authorized retries without losing bootstrap pacing."""
    last_state = ""
    last_fast_forward_at = 0.0
    while True:
        value = scheduler_call({"operation": "get_job", "job_id": job_id})
        job = value.get("job") if isinstance(value.get("job"), Mapping) else {}
        state = str(job.get("state") or "")
        if state == "queued" and int(job.get("priority") or 0) < ACCEPTANCE_PRIORITY:
            scheduler_call({
                "operation": "reprioritize_job", "job_id": job_id,
                "priority": ACCEPTANCE_PRIORITY,
                "parent_operation": {
                    "operation_id": str(job.get("parent_operation_id") or "area1-four-provider-acceptance"),
                    "automation_order": 3, "kind": "taskflow_plan",
                },
            })
        due_value = job.get("due_at")
        try:
            due_ready = iso(due_value) <= time.time() if due_value is not None else True
        except (TypeError, ValueError):
            due_ready = True
        if (state == "queued" and due_ready
                and (state != last_state or time.time() - last_fast_forward_at >= 30)):
            scheduler_call({"operation": "rhythm_fast_forward", "provider": provider, "slots": 1})
            last_fast_forward_at = time.time()
        conversation_id = client.conversation_id(job)
        provider_complete = (
            state in {"complete", "completed", "provider_complete"}
            or bool(job.get("completed_at") and conversation_id)
            or bool(state == "effect_pending" and conversation_id)
        )
        if provider_complete or state in {"failed", "dead", "cancelled", "rejected"}:
            if provider_complete and state == "effect_pending":
                return {"ok": True, "job_id": job_id, "state": "completed",
                        "conversation_id": conversation_id, "job": dict(job)}
            return client.wait(job_id)
        last_state = state
        time.sleep(5)


def source_packet(root: Path) -> Path:
    """Give the provider the actual SDK and browser-adapter sources."""
    source = Path(__file__).resolve().parents[1]
    computerusex = Path(os.environ.get(
        "COGNILODE_COMPUTERUSEX_PROJECT_ROOT",
        "/runtime/source/current/automation-computeruse-vision",
    )).resolve()
    target = root / "codex-backend-sdk-current-source.zip"
    temporary = target.with_suffix(".zip.tmp")
    with zipfile.ZipFile(temporary, "w", zipfile.ZIP_DEFLATED) as bundle:
        for path in sorted(source.rglob("*")):
            if path.is_file() and ".git" not in path.parts and "__pycache__" not in path.parts:
                bundle.write(path, Path("codex-backend-sdk") / path.relative_to(source))
        if computerusex.is_dir():
            for path in sorted(computerusex.rglob("*")):
                if path.is_file() and ".git" not in path.parts and "__pycache__" not in path.parts:
                    bundle.write(path, Path("automation-computeruse-vision") / path.relative_to(computerusex))
    temporary.replace(target)
    return target


def prompt_for(provider: str, following: str | None) -> str:
    if following:
        objective = (
            f"Use the attached source and every prior provider work product to complete the production "
            f"actuation implementation for {following}. Preserve and improve all prior provider work."
        )
        artifact = following.split(".")[0] + "-adapter.zip"
    else:
        objective = (
            "Integrate and harden the complete four-provider actuation substrate as a release-ready "
            "implementation, preserving exact identities, terminal collection, physical uploads and downloads, "
            "central memory publication, and exclusive credential leases."
        )
        artifact = "unified-provider-actuation.zip"
    return (
        f"You are the {provider} implementation worker in a sequential four-provider onboarding. "
        "Read every attached file in full. Perform at least five minutes of substantive provider-side reasoning "
        "and implementation; a receipt, short answer, outline, or status report is invalid. " + objective + " "
        f"Return a physical ZIP named {artifact} containing production-ready repository-relative files and an "
        "APPLY_MANIFEST.json. Modify the existing domain-owned implementations rather than creating a parallel "
        "toy adapter. Trace and harden queue lease consumption, provider capability publication, authenticated "
        "conversation create/continue, physical upload, terminal detection, returned-file download, exact "
        "conversation/message identity, normalized result envelopes, central memory publication, and ambiguous "
        "send recovery. Inspect both attached repositories and preserve their ownership boundary. Do not "
        "invent a standalone adapter module and stop: integrate the provider through the existing public client, "
        "queue actuator, provider broker, ComputerUseX worker, capability heartbeat, conversation continuation, "
        "attachment materializer, returned-artifact collector, normalized result admission, and central-memory "
        "event path. Use sandbox tools for successive source-reading, implementation, and integration-hardening "
        "passes. The returned package must contain every actually changed production file from both repositories, "
        "a source-grounded architecture report, an exact apply manifest, and a provider-operation walkthrough. "
        "If an interface already exists, improve it in place and trace every caller rather than duplicating it. "
        "The response and ZIP must be substantial enough to exceed what a five-minute GPT-5.6-terra Codex "
        "implementation turn could produce. Continue substantive inspection and integration work for the entire "
        "provider interval; never idle, sleep, simulate elapsed time, or use heartbeat calls as proof of work."
    )


def main() -> int:
    root = Path(os.environ.get("COGNILODE_PROVIDER_ACCEPTANCE_ROOT", "/runtime/area1-acceptance"))
    seed = root / "area1-provider-source.zip"
    root.mkdir(parents=True, exist_ok=True)
    # This sequence owns one shared onboarding frontier across every source
    # generation.  A generation-scoped supervisor may overlap while an
    # accepted mutation drains, but its acceptance composer must not.
    singleton = (root / ".four-provider-acceptance.lock").open("a+")
    try:
        fcntl.flock(singleton.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0
    # Discovery and source publication are independent daemons. Remain
    # resident when discovery starts first so a late seed activates the
    # sequence without manual intervention.
    while not seed.is_file():
        time.sleep(5)
    state_path = root / "four-provider-proof.json"
    proof: dict[str, Any] = json.loads(state_path.read_text()) if state_path.is_file() else {
        "schema": "cognilode.four_provider_acceptance.v1", "providers": []
    }
    proof.setdefault("rejected_attempts", [])
    proof.setdefault("inflight", {})
    # Source upgrades preserve rejected-attempt history. Enrich older rows
    # from their durable scheduler envelopes so subsequent turns continue the
    # actual conversation and physical work instead of repeatedly restarting
    # the same shallow task.
    for row in proof["rejected_attempts"]:
        if not isinstance(row, dict) or not row.get("job_id"):
            continue
        if row.get("assistant_message_id") and row.get("artifacts"):
            continue
        observed = scheduler_call({"operation": "get_job", "job_id": row["job_id"]})
        historical = observed.get("job") if isinstance(observed.get("job"), Mapping) else {}
        normalized = historical.get("normalized_provider_result") if isinstance(
            historical.get("normalized_provider_result"), Mapping) else {}
        row.setdefault("assistant_message_id", str(normalized.get("assistant_message_id") or ""))
        row.setdefault("response", str(normalized.get("assistant_text") or ""))
        row.setdefault("artifacts", physical_outputs(historical))
    # A source cutover may inherit proof written by an older acceptance
    # generation.  Never grandfather a row that lacks the exact provider
    # identities or the required physical evidence; demote it to an attempt
    # and let the durable sequence produce a complete replacement.
    valid_rows: list[dict[str, Any]] = []
    for row in proof.get("providers") or []:
        complete_identity = all(str(row.get(key) or "") for key in (
            "provider", "job_id", "conversation_id", "user_message_id", "assistant_message_id",
        ))
        complete_work = (
            float(row.get("provider_seconds") or 0) >= MIN_PROVIDER_SECONDS
            and bool(row.get("uploaded_attachments"))
            and bool(row.get("artifacts"))
        )
        if complete_identity and complete_work:
            valid_rows.append(dict(row))
        else:
            proof["rejected_attempts"].append({
                "provider": row.get("provider"), "job_id": row.get("job_id"),
                "reasons": ["legacy_incomplete_acceptance_record"],
            })
    proof["providers"] = valid_rows
    completed = {row["provider"]: row for row in proof["providers"]}
    inherited = [str(seed), str(source_packet(root))]
    for row in proof["providers"]:
        inherited.extend(path for path in row.get("artifacts") or [] if Path(path).is_file())
    client = ProviderCommandClient(timeout=24 * 3600, poll_interval=10)
    for index, provider in enumerate(PROVIDERS):
        if provider in completed:
            continue
        following = PROVIDERS[index + 1] if index + 1 < len(PROVIDERS) else None
        while provider not in completed:
            prior = [row for row in proof["rejected_attempts"] if row.get("provider") == provider]
            attempt = len(prior) + 1
            authored = prompt_for(provider, following) + (
                " Do the implementation in your own native sandbox. Extract and inspect the actual attached "
                "repository source; do not offload coding to a remote environment. Continue recovering missing "
                "context from the attached source rather than returning an audit or asking questions. "
                " Perform no fewer than three implementation passes: source and interface analysis, "
                "complete implementation, then integration hardening and physical artifact verification. "
                "At the beginning of the turn, use the native sandbox to record a monotonic start marker. "
                "Keep the sandbox work session active for at least 330 seconds while you extract the archives, "
                "read the implementations, edit production files, inspect integration call sites, and package "
                "the result. Before answering, use the sandbox to calculate elapsed time; if it is below 330 "
                "seconds, continue substantive source review and integration hardening rather than answering. "
                "The returned ZIP must exceed 32 KiB of genuine repository-relative implementation and the "
                "terminal explanation must exceed 2,000 characters, describing exact files and behavior. "
                "A small illustrative adapter, prose-only answer, artificial padding, or an early terminal "
                "answer is automatically rejected and cannot advance onboarding."
            )
            if prior:
                authored += (
                    f" The previous {len(prior)} provider turn(s) were automatically rejected: "
                    f"{json.dumps(prior[-1].get('reasons') or [])}. Do not repeat their superficial package. "
                    "Resume from the prior conversation and returned package, preserve every sound change, "
                    "and perform a materially deeper in-place integration using the full provider-side interval."
                )
                for path in prior[-1].get("artifacts") or []:
                    if Path(str(path)).is_file() and str(path) not in inherited:
                        inherited.append(str(path))
            attachments = attachment_packet(inherited, root)
            packet_identity = hashlib.sha256()
            packet_identity.update(authored.encode())
            for inherited_path in attachments:
                packet_identity.update(hashlib.sha256(Path(inherited_path).read_bytes()).digest())
            request_id = (f"area1-sequential-{provider.split('.')[0]}-attempt-{attempt}-"
                          + packet_identity.hexdigest()[:12])
            job_id = str(proof["inflight"].get(provider) or "")
            if not job_id:
                continuation_conversation = ""
                continuation_parent = ""
                if prior:
                    continuation_conversation = str(prior[-1].get("conversation_id") or "")
                    continuation_parent = str(prior[-1].get("assistant_message_id") or "")
                    if not continuation_parent and prior[-1].get("job_id"):
                        prior_result = scheduler_call({
                            "operation": "get_job", "job_id": str(prior[-1]["job_id"]),
                        })
                        prior_job = prior_result.get("job") if isinstance(
                            prior_result.get("job"), Mapping
                        ) else {}
                        prior_normalized = prior_job.get("normalized_provider_result") if isinstance(
                            prior_job.get("normalized_provider_result"), Mapping
                        ) else {}
                        continuation_conversation = str(
                            prior_normalized.get("conversation_id") or continuation_conversation
                        )
                        continuation_parent = str(prior_normalized.get("assistant_message_id") or "")
                queued = client.send_provider(
                    provider=provider, prompt=authored, attachments=attachments, request_id=request_id,
                    conversation_id=continuation_conversation or None,
                    parent_message_id=continuation_parent or None,
                    project="unified-provider-actuation", role="provider-implementation-worker",
                    source="area1-sequential-onboarding", prompt_authority="taskflow_plan",
                    priority=ACCEPTANCE_PRIORITY,
                    # The recovered successful attached-file mini-loop used
                    # gpt-5-6-thinking with requested ``high`` mapped by the
                    # provider to ``extended``.  Preserve that known working
                    # mode rather than substituting a quick xhigh turn.
                    model="gpt-5-6-thinking" if provider == "chatgpt.com" else None,
                    effort="high" if provider == "chatgpt.com" else None, collect_artifacts=True,
                    parent_operation={"operation_id": "area1-four-provider-acceptance",
                                      "automation_order": 3, "kind": "taskflow_plan"},
                )
                job_id = str(queued.get("job_id") or queued.get("job", {}).get("id") or request_id)
                proof["inflight"][provider] = job_id
                state_path.write_text(json.dumps(proof, ensure_ascii=False, indent=2, sort_keys=True) + "\n")
                # Acceptance is an explicit bootstrap operation, not ordinary
                # production cadence. Release one preserved biological slot.
                scheduler_call({"operation": "rhythm_fast_forward", "provider": provider, "slots": 1})
            priority_receipt = scheduler_call({
                "operation": "reprioritize_job", "job_id": job_id,
                "priority": 8_000_000_000_000_000,
                "parent_operation": {"operation_id": "area1-four-provider-acceptance",
                                     "automation_order": 3, "kind": "taskflow_plan"},
            })
            if priority_receipt.get("updated") is True:
                scheduler_call({"operation": "rhythm_fast_forward", "provider": provider, "slots": 1})
            result = wait_bootstrap_job(client, provider, job_id)
            job = result.get("job") if isinstance(result.get("job"), Mapping) else {}
            proof["inflight"].pop(provider, None)
            reasons: list[str] = []
            if result.get("ok") is not True:
                reasons.append("no_queue_recorded_terminal_completion")
            duration = provider_seconds(job)
            reasoning_seconds, reasoning_events = provider_reasoning_evidence(job)
            if duration < MIN_PROVIDER_SECONDS:
                reasons.append("provider_execution_shorter_than_five_minutes")
            if reasoning_seconds < MIN_PROVIDER_SECONDS or reasoning_events < 1:
                reasons.append("no_five_minute_provider_side_assistant_window")
            normalized = job.get("normalized_provider_result") if isinstance(
                job.get("normalized_provider_result"), Mapping
            ) else {}
            conversation_id = str(normalized.get("conversation_id") or result.get("conversation_id") or "")
            user_message_id = str(normalized.get("user_message_id") or "")
            assistant_message_id = str(normalized.get("assistant_message_id") or "")
            assistant_text = str(normalized.get("assistant_text") or "")
            if not conversation_id or not user_message_id or not assistant_message_id:
                reasons.append("missing_exact_provider_identity")
            if len(assistant_text.strip()) < MIN_RESPONSE_CHARS:
                reasons.append("superficial_provider_response")
            # The normalized envelope contains the exact terminal provider
            # text.  A synchronous memory read here would be an observability
            # request and can deadlock behind the mutation broker; admission is
            # instead proven by the receipt produced during the send itself.
            rendered = assistant_text
            if len(rendered.strip()) < MIN_RESPONSE_CHARS:
                reasons.append("superficial_or_unavailable_response")
            if not memory_admitted(normalized):
                reasons.append("agent_memory_admission_unconfirmed")
            artifacts = physical_outputs(job)
            if not artifacts:
                reasons.append("no_collected_physical_work_product")
            upload_proof = [row for row in job.get("effect_evidence") or []
                            if isinstance(row, Mapping) and row.get("kind") in
                            {"provider_uploaded_attachment", "provider_structured_upload", "provider_tool_evidence"}]
            if not upload_proof:
                receipt = normalized.get("provider_receipt") if isinstance(
                    normalized.get("provider_receipt"), Mapping
                ) else {}
                for attached in receipt.get("attached_context_files") or []:
                    if not isinstance(attached, Mapping):
                        continue
                    ref = str(attached.get("sha256") or attached.get("id") or attached.get("path") or "")
                    if ref:
                        upload_proof.append({"kind": "provider_uploaded_attachment", "ref": ref})
            if not upload_proof:
                reasons.append("no_provider_upload_evidence")
            if reasons:
                proof["rejected_attempts"].append({"provider": provider, "attempt": attempt,
                    "job_id": job.get("id") or result.get("job_id"), "conversation_id": conversation_id,
                    "assistant_message_id": assistant_message_id,
                    "response": rendered,
                    "artifacts": artifacts,
                    "provider_seconds": duration, "provider_reasoning_seconds": reasoning_seconds,
                    "provider_assistant_events": reasoning_events, "reasons": reasons})
                state_path.write_text(json.dumps(proof, ensure_ascii=False, indent=2, sort_keys=True) + "\n")
                time.sleep(10)
                continue
            record = {
                "provider": provider, "job_id": job.get("id"), "conversation_id": conversation_id,
                "user_message_id": user_message_id, "assistant_message_id": assistant_message_id,
                "prompt_sha256": hashlib.sha256(authored.encode()).hexdigest(),
                "response_sha256": hashlib.sha256(rendered.encode()).hexdigest(),
                "response": rendered, "provider_seconds": duration,
                "provider_reasoning_seconds": reasoning_seconds,
                "provider_assistant_events": reasoning_events,
                "uploaded_attachments": upload_proof, "artifacts": artifacts,
            }
            proof["providers"].append(record)
            completed[provider] = record
            state_path.write_text(json.dumps(proof, ensure_ascii=False, indent=2, sort_keys=True) + "\n")
            inherited.extend(artifacts)
    proof["complete"] = len(proof["providers"]) == len(PROVIDERS)
    proof["completed_at"] = time.time()
    state_path.write_text(json.dumps(proof, ensure_ascii=False, indent=2, sort_keys=True) + "\n")
    print(json.dumps(proof, ensure_ascii=False))
    # Acceptance may temporarily accelerate a clock, but production pacing is
    # always restored automatically.  Each provider keeps its own biological
    # tape and an independently scaled fifteen-minute daily-average gap.
    for provider in PROVIDERS:
        scheduler_call({
            "operation": "rhythm_tune_pacing",
            "provider": provider,
            "target_average_gap_ms": 15 * 60 * 1000,
        })
    # Remain the live acceptance owner.  The source-generation supervisor
    # replaces this process on code changes; ordinary completion does not turn
    # a permanent safety gate back into a foreground one-shot command.
    while True:
        time.sleep(3600)


if __name__ == "__main__":
    raise SystemExit(main())
