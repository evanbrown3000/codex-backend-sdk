#!/usr/bin/env python3
"""Run an SDK service from the synchronized source generation.

Mutating services opt into a local drain socket. A generation change stops new
mutations, waits for active ones to finish, then starts the next source. The
source-sync service itself remains the bootstrap source and does not use this.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import signal
import sqlite3
import socket
import subprocess
import sys
import time


STOP = False


def durable_provider_effects() -> int | None:
    """Count unexpired accepted effects before allowing a generation exit.

    The drain socket is intentionally only an in-process view.  A transport
    restart or a lost child can make it report zero while the scheduler still
    owns an accepted provider effect.  Fail closed if the durable ledger cannot
    be read; source replacement is not more important than custody.
    """
    database = Path(os.environ.get(
        "COGNILODE_PROVIDER_SCHEDULER_DB",
        "/runtime/provider-scheduler/scheduler.sqlite3",
    ))
    try:
        with sqlite3.connect(database, timeout=5) as connection:
            row = connection.execute(
                "SELECT COUNT(*) FROM provider_jobs "
                "WHERE state = 'effect_pending' AND lease_until > ?",
                (time.time(),),
            ).fetchone()
        return int(row[0]) if row else None
    except (OSError, sqlite3.Error, TypeError, ValueError):
        return None


def service_python(source: Path) -> Path | None:
    """Return the immutable interpreter built from exactly ``source``.

    The generation supervisor is deliberately bootstrapped by the container's
    system Python, but SDK services import packaged dependencies (requests,
    Universe Storage, ComputerUseX) that live in the immutable B4PT0R release.
    Running children with ``sys.executable`` therefore made every provider
    attempt fail before transport.  Only published ``.complete`` releases are
    eligible, including completed predecessor generations during a cold build.
    """
    explicit = os.environ.get("COGNILODE_SOURCE_GENERATION_PYTHON", "").strip()
    if explicit:
        candidate = Path(explicit)
        if candidate.is_file():
            return candidate
    configured = Path(os.environ.get(
        "COGNILODE_B4PT0R_RELEASE_ROOT",
        "/runtime/b4pt0r-releases/locked-v3-computerusex",
    ))
    roots = [configured]
    if configured.parent.is_dir():
        roots.extend(
            path for path in configured.parent.iterdir()
            if path.is_dir() and path != configured
        )
    repository = source.parent.parent
    # The source frontier is an immutable revision-named checkout.  Its git
    # metadata can point at a shared moving branch and is not its identity.
    revision = repository.name
    for root in roots:
        complete: list[tuple[int, Path]] = []
        for release in (root / revision, *root.glob(revision + "-*")):
            interpreter = release / "bin/python"
            marker = release / ".complete"
            if interpreter.is_file() and marker.is_file():
                complete.append((marker.stat().st_mtime_ns, interpreter))
        if complete:
            return max(complete)[1]
    return None


def newest_complete_python() -> Path | None:
    """Cold-start from the newest published runtime while its successor builds."""
    configured = Path(os.environ.get(
        "COGNILODE_B4PT0R_RELEASE_ROOT",
        "/runtime/b4pt0r-releases/locked-v3-computerusex",
    ))
    roots = [configured]
    if configured.parent.is_dir():
        roots.extend(path for path in configured.parent.iterdir()
                     if path.is_dir() and path != configured)
    candidates: list[tuple[int, Path]] = []
    for root in roots:
        for marker in root.glob("*/.complete"):
            interpreter = marker.parent / "bin/python"
            if interpreter.is_file():
                candidates.append((marker.stat().st_mtime_ns, interpreter))
    return max(candidates, default=(0, None))[1]


def content_generation(current: Path) -> tuple[Path, str] | None:
    """Identify the executable closure rather than the checkout directory."""
    selected = current.resolve()
    if not selected.is_file():
        return None
    digest = hashlib.sha256()
    sources = [selected]
    package = selected.parent.parent / "codex_backend_sdk"
    # Provider transport imports the synchronized SDK package into its
    # credential runtime.  The HTTP gate is self-contained; coupling it to all
    # SDK module changes would create needless admission-socket outages.
    if selected.name == "cognilode-provider-transport" and package.is_dir():
        sources.extend(sorted(package.rglob("*.py")))
        # The transport launches these sibling programs by immutable HERE path;
        # they are part of its executable closure even though they are not
        # imported Python modules.  Omitting them left provider custody on an
        # older sender after a source-converged transport fix.
        for sibling in ("cognilode-b4pt0r-chatmode", "chatgpt_sentinel_vm.mjs"):
            dependency = selected.with_name(sibling)
            if dependency.is_file():
                sources.append(dependency)
    for source in sources:
        digest.update(str(source.relative_to(selected.parent.parent)).encode())
        digest.update(source.read_bytes())
    return selected, digest.hexdigest()


def generation_environment(
    selected: Path, signature: str, interpreter: Path,
) -> dict[str, str]:
    """Publish a complete manifest before provider-custody cutover."""
    environment = os.environ.copy()
    if selected.name != "cognilode-provider-transport":
        return environment
    executable_root = selected.parent.parent.resolve()
    source_revision = executable_root.name
    runtime_python = str(interpreter)
    runtime_fingerprint = hashlib.sha256(
        f"{source_revision}|{runtime_python}".encode()
    ).hexdigest()
    transport_version = hashlib.sha256(selected.read_bytes()).hexdigest()
    generation_id = hashlib.sha256(
        "|".join((source_revision, signature, runtime_fingerprint, transport_version)).encode()
    ).hexdigest()
    manifest = {
        "generation_id": generation_id,
        "source_revision": source_revision,
        "runtime_fingerprint": runtime_fingerprint,
        "provider_transport_version": transport_version,
        "fence_identity": signature,
        "runtime_python": runtime_python,
        "executable_root": str(executable_root),
    }
    manifest_root = Path(os.environ.get(
        "COGNILODE_GENERATION_MANIFEST_ROOT", "/runtime/provider-generations"
    ))
    manifest_root.mkdir(parents=True, exist_ok=True)
    manifest_path = manifest_root / f"{generation_id}.json"
    if not manifest_path.is_file():
        temporary = manifest_path.with_suffix(f".tmp-{os.getpid()}")
        with temporary.open("w", encoding="utf-8") as stream:
            json.dump(manifest, stream, sort_keys=True, separators=(",", ":"))
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        temporary.replace(manifest_path)
        directory = os.open(manifest_root, os.O_RDONLY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    environment.update({
        "COGNILODE_GENERATION_MANIFEST": str(manifest_path),
        "COGNILODE_RUNTIME_GENERATION_FINGERPRINT": runtime_fingerprint,
        "COGNILODE_PROVIDER_TRANSPORT_VERSION": transport_version,
        "COGNILODE_GENERATION_FENCE_IDENTITY": signature,
    })
    return environment


def request_stop(_signum, _frame):
    global STOP
    STOP = True


def custody_state(socket_path: Path, operation: str = "active") -> tuple[int, bool] | None:
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as channel:
            channel.settimeout(5)
            channel.connect(str(socket_path))
            channel.sendall((json.dumps({"operation": operation}) + "\n").encode())
            data = bytearray()
            while b'\n' not in data and len(data) < 4096:
                piece = channel.recv(4096)
                if not piece:
                    break
                data.extend(piece)
        reply = json.loads(data.split(b'\n', 1)[0])
        if type(reply.get("draining")) is bool and type(reply.get("active")) is int:
            return max(0, reply["active"]), reply["draining"]
    except (OSError, ValueError, IndexError, TypeError):
        pass
    return None


def drain(socket_path: Path) -> int | None:
    state = custody_state(socket_path, "drain")
    return state[0] if state is not None and state[1] else None


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--script", required=True)
    parser.add_argument("--drain-socket", type=Path, required=True)
    parser.add_argument("--no-drain", action="store_true",
                        help="restart a non-mutating local service on source change")
    parser.add_argument("args", nargs=argparse.REMAINDER)
    options = parser.parse_args()
    if "/" in options.script or options.script.startswith("."):
        parser.error("script must be an SDK script basename")
    child_args = options.args[1:] if options.args[:1] == ["--"] else options.args
    root = Path(os.environ.get("COGNILODE_COMPANY_SOURCE_ROOT", "/runtime/source"))
    current = root / "current/codex-backend-sdk/scripts" / options.script
    signal.signal(signal.SIGTERM, request_stop)
    signal.signal(signal.SIGINT, request_stop)
    while not STOP:
        generation = content_generation(current)
        if generation is None:
            print("SDK source generation pending", flush=True)
            time.sleep(5)
            continue
        selected, signature = generation
        # A container recreation must not take provider custody offline merely
        # because the moving source frontier is ahead of its immutable build.
        # Start the newest complete runtime, then the loop below changes over
        # only after the exact frontier release is published.
        interpreter = service_python(selected)
        if interpreter is None:
            interpreter = newest_complete_python()
            if interpreter is not None:
                # A completed interpreter and a newer script are not an
                # immutable generation.  During a cold build, run the script
                # from the checkout that produced the fallback release; the
                # normal generation comparison below will hand over once the
                # exact frontier release exists.
                fallback_revision = interpreter.parent.parent.name
                fallback_script = (root / "checkouts/codex-backend-sdk" /
                                   fallback_revision / "scripts" / options.script)
                fallback_generation = content_generation(fallback_script)
                if fallback_generation is None:
                    interpreter = None
                else:
                    selected, signature = fallback_generation
        if interpreter is None:
            print(f"SDK service {options.script} waiting for matching immutable release", flush=True)
            time.sleep(2)
            continue
        print(f"SDK service {options.script} source generation {selected}", flush=True)
        # Each immutable generation is a process tree: the batch runtime owns
        # queue actuators and the transport owns custody brokers.  A source
        # handoff that signals only the immediate Python process leaks the old
        # generation's children, leaving multiple queue consumers alive.  Own
        # the generation as one process group so the already-drained handoff
        # retires the whole tree atomically.
        child_environment = generation_environment(selected, signature, interpreter)
        child = subprocess.Popen([str(interpreter), str(selected), *child_args],
                                 env=child_environment, start_new_session=True)
        pending_signature: str | None = None
        pending_since = 0.0
        stability_seconds = float(os.environ.get(
            "COGNILODE_PROVIDER_SOURCE_STABILITY_SECONDS", "120"
        ))
        while child.poll() is None and not STOP:
            active_generation = content_generation(current)
            if active_generation is None:
                time.sleep(2)
                continue
            if active_generation[1] != signature:
                if pending_signature != active_generation[1]:
                    pending_signature = active_generation[1]
                    # Coalesce a moving frontier, but do not let continuous
                    # publication postpone custody fixes forever.  The first
                    # complete divergent generation starts the bounded window;
                    # later revisions replace the target without resetting it.
                    if pending_since == 0.0:
                        pending_since = time.monotonic()
                candidate_ready = service_python(active_generation[0]) is not None
                # A higher-level reconciler may already have fenced admission.
                # With no admitted send left, retaining the drained generation
                # for the debounce interval is pure provider downtime; adopt
                # the newest complete generation immediately.
                state = custody_state(options.drain_socket)
                durable = durable_provider_effects()
                if (candidate_ready and state == (0, True)
                        and durable == 0):
                    break
                if candidate_ready and time.monotonic() - pending_since >= stability_seconds:
                    break
            else:
                pending_signature = None
                pending_since = 0.0
            time.sleep(2)
        if child.poll() is None:
            last_report = 0.0
            drain_started = time.monotonic()
            orphan_grace = max(30.0, float(os.environ.get(
                "COGNILODE_ORPHAN_DRAIN_GRACE_SECONDS", "60"
            )))
            while child.poll() is None:
                if options.no_drain:
                    break
                active = drain(options.drain_socket)
                durable = durable_provider_effects()
                if durable is None:
                    active = None
                elif active == 0 and durable > 0:
                    active = durable
                elif active is not None:
                    active = max(active, durable)
                if active == 0:
                    break
                # An in-process active counter can outlive its completed queue
                # effect after a disconnected client or wedged response writer.
                # The durable scheduler is the mutation authority: once it has
                # no accepted effect, a bounded drain retires that orphaned
                # process tree instead of keeping custody on stale source
                # indefinitely. Never force retirement while durable effects
                # remain or when their state cannot be read.
                if (durable == 0 and active is not None
                        and time.monotonic() - drain_started >= orphan_grace):
                    print(f"SDK service {options.script} retiring {active} "
                          "orphaned in-process sends after durable completion",
                          flush=True)
                    break
                if time.monotonic() - last_report >= 60:
                    print(f"SDK service {options.script} generation held: "
                          f"{'drain unavailable' if active is None else str(active) + ' active sends'}",
                          flush=True)
                    last_report = time.monotonic()
                time.sleep(2)
            if child.poll() is None:
                os.killpg(child.pid, signal.SIGTERM)
                try:
                    child.wait(timeout=30)
                except subprocess.TimeoutExpired:
                    # The drain contract has already barred new sends and
                    # reported zero active sends. Do not leave stale custody.
                    os.killpg(child.pid, signal.SIGKILL)
                    child.wait()
        if not STOP:
            time.sleep(2)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
