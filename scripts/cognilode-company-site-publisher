#!/usr/bin/env python3
"""Publish a synchronized main archive once per revision, with readback."""
from __future__ import annotations

import json
import os
from pathlib import Path
import subprocess
import time
from urllib.request import Request, urlopen


SOURCE = Path(os.environ.get("COGNILODE_COMPANY_SOURCE_ROOT", "/runtime/source"))
STATE = Path(os.environ.get("COGNILODE_SITE_PUBLISH_STATE", "/runtime/site-publisher.json"))


def publish_once() -> None:
    active = SOURCE / "current/cognilode-cloudflare-pages-site"
    if not active.is_symlink():
        print("site publisher waiting for source sync", flush=True)
        return
    release = active.resolve(strict=True)
    sha = release.name
    if len(sha) != 40 or any(c not in "0123456789abcdef" for c in sha):
        raise RuntimeError("synchronized site revision is invalid")
    try:
        state = json.loads(STATE.read_text())
    except (OSError, ValueError):
        state = {}
    env = os.environ.copy()
    env["COGNILODE_DEPLOY_SOURCE_SHA"] = sha
    env["COGNILODE_WORKER_DEPLOY_STATE"] = str(SOURCE.parent / "rhythm-worker-deploy.json")
    env["PATH"] = "/usr/bin:/usr/local/bin:/bin"
    pages_file = Path(env.get("COGNILODE_CLOUDFLARE_TOKEN_FILE", "/deploy/pages-token.json"))
    pages = json.loads(pages_file.read_text())
    if pages.get("scope") != "Pages Write" or not pages.get("token"):
        raise RuntimeError("Pages deployment custody is incomplete")
    env["CLOUDFLARE_API_TOKEN"] = pages["token"]
    env["CLOUDFLARE_ACCOUNT_ID"] = pages["account_id"]
    if not state.get("pages_sha"):
        try:
            with urlopen(Request("https://cognilode.com/.well-known/cognilode-release.json",
                                 headers={"cache-control":"no-cache"}), timeout=20) as response:
                deployed=json.load(response)
            if deployed.get("source_sha")==sha:
                state["pages_sha"]=sha
                STATE.write_text(json.dumps(state))
        except (OSError, ValueError):
            pass
    if state.get("pages_sha") != sha:
        subprocess.run(["bash", str(release / "scripts/deploy-current-main-direct.sh")],
                       cwd=release, env=env, check=True, timeout=600)
        state["pages_sha"] = sha
        STATE.write_text(json.dumps(state))
    # The worker deployer compares both source and the operator credential
    # version, so an ordinary custody rotation propagates without a new commit.
    subprocess.run(["python3", str(release / "scripts/deploy-rhythm-trigger-from-custody.py")],
                   cwd=release, env=env, check=True, timeout=600)
    state["worker_sha"] = sha
    STATE.write_text(json.dumps(state))


if __name__ == "__main__":
    while True:
        try:
            publish_once()
        except Exception as error:
            print(f"site publisher pending: {type(error).__name__}: {error}", flush=True)
        time.sleep(max(300, int(os.environ.get("COGNILODE_SITE_PUBLISH_INTERVAL", "600"))))
