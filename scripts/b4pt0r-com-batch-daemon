#!/usr/bin/env python3
"""Continuously execute durable B4PT0R batches without provider polling."""
from __future__ import annotations

import json
import os
import fcntl
from pathlib import Path
import subprocess
import signal
import threading
import time


ROOT = Path(os.environ.get(
    "B4PT0R_BATCH_ROOT",
    str(Path.home() / ".local/share/cognilode/b4pt0r-batches"),
))
HERE = Path(__file__).resolve().parent
CLI = os.environ.get(
    "B4PT0R_CLI",
    str(Path.home() / ".local/share/cognilode/b4pt0r-chatmode/venv-python3.12/bin/b4pt0r"),
)
STOP = False


def stop(_signal, _frame):
    global STOP
    STOP = True


def complete(state: Path) -> bool:
    try:
        rows = json.loads((state / "batch-result.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return False
    return bool(rows) and all(row.get("returncode") == 0 for row in rows)


def supervise(program: list[str]) -> None:
    while not STOP:
        process = subprocess.Popen(program)
        while not STOP and process.poll() is None:
            time.sleep(1)
        if process.poll() is None:
            process.terminate()
            try:
                process.wait(timeout=30)
            except subprocess.TimeoutExpired:
                process.kill()
        if not STOP:
            time.sleep(5)


def main() -> int:
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    ROOT.mkdir(parents=True, exist_ok=True)
    daemon_lock = (ROOT / ".batch-daemon.lock").open("a+")
    try:
        fcntl.flock(daemon_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0
    # The actuator watches only the central D1 queue.  It does not poll a
    # provider: provider network traffic begins only after a rhythm claim and
    # then remains on the streamed send.  The floor watcher has one separate
    # leader in provider transport, while every chat-mode device needs its
    # queue actuator here.
    actuator = [
        str(CLI.rsplit("/", 1)[0] + "/python"),
        str(HERE / "cognilode-chatmode-queue-worker"),
        "--device-id", os.environ.get("COGNILODE_ENVIRONMENT_ID", "company-container"),
        "--interval", "60",
    ]
    threading.Thread(target=supervise, args=(actuator,), daemon=True).start()
    retry: dict[str, tuple[int, float]] = {}
    while not STOP:
        now = time.time()
        for batch in ROOT.glob("*/batch.json"):
            state = batch.parent / "state"
            if complete(state):
                retry.pop(str(batch), None)
                continue
            failures, due = retry.get(str(batch), (0, 0.0))
            if now < due:
                continue
            process = subprocess.Popen([
                str(HERE / "b4pt0r-com-batch"), str(batch),
                "--state-root", str(state), "--cli", CLI,
            ])
            while not STOP and process.poll() is None:
                time.sleep(1)
            if process.poll() is None:
                process.terminate()
                try:
                    process.wait(timeout=30)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait()
            failures = 0 if process.returncode == 0 else failures + 1
            retry[str(batch)] = (failures, time.time() + min(900, 15 * (2 ** min(failures, 6))))
            if STOP:
                break
        if not STOP:
            time.sleep(5)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
