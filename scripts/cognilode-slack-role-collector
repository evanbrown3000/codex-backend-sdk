#!/usr/bin/env python3
"""Bounded, resumable Slack project/team role snapshot collection.

Uses the user's already-authenticated slackcli browser profile. It reads facts;
it never posts, joins, or treats channel prose as policy. Each channel snapshot
contains only role-declaration messages and independent coverage cursors.
"""
from __future__ import annotations

import argparse
from datetime import datetime, timezone
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import time
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
SYNC_PATH = ROOT / "scripts/cognilode-employee-roster-sync"
DEFAULT_CLI = Path.home() / ".local/bin/slackcli"
DEFAULT_LANDING = Path.home() / ".local/share/cognilode/slack-role-snapshots"
PREFIXES = ("proj-", "team-", "agent-team-")
MAX_CHANNELS = 200
MAX_LIST_PAGES = 10
MAX_READ_PAGES = 3
READ_LIMIT = 200


def _sync_module():
    loader = importlib.machinery.SourceFileLoader("slack_role_sync_for_collector", str(SYNC_PATH))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    loader.exec_module(module)
    return module


def _call(cli: Path, args: list[str]) -> dict[str, Any]:
    for attempt in range(3):
        result = subprocess.run([str(cli), *args, "--json"], capture_output=True,
                                text=True, timeout=45)
        if result.returncode == 0:
            value = json.loads(result.stdout)
            if isinstance(value, dict):
                return value
        if attempt < 2:
            time.sleep(1 + attempt * 2)
    raise RuntimeError(f"slackcli {args[:2]} failed after three bounded attempts")


def list_project_channels(cli: Path) -> list[dict[str, Any]]:
    selected: dict[str, dict[str, Any]] = {}
    cursor = ""
    for _ in range(MAX_LIST_PAGES):
        args = ["conversations", "list", "--types", "public_channel,private_channel",
                "--limit", "200"]
        if cursor:
            args += ["--cursor", cursor]
        page = _call(cli, args)
        for channel in page.get("conversations") or []:
            if not isinstance(channel, dict):
                continue
            cid = str(channel.get("id") or "")
            name = str(channel.get("name") or "")
            if (re.fullmatch(r"C[A-Z0-9]{8,}", cid)
                and name.startswith(PREFIXES)
                and re.fullmatch(r"[a-z0-9_-]{1,100}", name)):
                selected[cid] = {"id": cid, "name": name,
                                 "is_member": bool(channel.get("is_member")),
                                 "is_private": bool(channel.get("is_private"))}
        cursor = str(page.get("next_cursor") or "")
        if not cursor:
            break
    else:
        raise RuntimeError("Slack channel inventory exceeded bounded pagination")
    if len(selected) > MAX_CHANNELS:
        raise RuntimeError("Slack project/team channel count exceeds bounded collection")
    return sorted(selected.values(), key=lambda row: row["name"])


def _read(cli: Path, cid: str, *, oldest: str = "", latest: str = "") -> dict[str, Any]:
    args = ["conversations", "read", cid, "--limit", str(READ_LIMIT)]
    if oldest:
        args += ["--oldest", oldest]
    if latest:
        args += ["--latest", latest]
    result = _call(cli, args)
    if result.get("channel_id") != cid or not isinstance(result.get("messages"), list):
        raise RuntimeError(f"Slack channel response mismatch for {cid}")
    return result


def _role_rows(messages: list[dict[str, Any]], sync) -> dict[str, dict[str, str]]:
    rows: dict[str, dict[str, str]] = {}
    for item in messages:
        if not isinstance(item, dict):
            continue
        ts = str(item.get("ts") or "")
        text = str(item.get("text") or "")
        if re.fullmatch(r"\d{10}\.\d{1,6}", ts) and sync.role_from_message(text):
            row = {"ts": ts, "user": str(item.get("user") or ""),
                   "text": text[:4000]}
            thread_ts = str(item.get("thread_ts") or "")
            if re.fullmatch(r"\d{10}\.\d{1,6}", thread_ts):
                row["thread_ts"] = thread_ts
            rows[ts] = row
    return rows


def _atomic(path: Path, body: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    raw = (json.dumps(body, sort_keys=True, indent=2, ensure_ascii=False) + "\n").encode()
    with tempfile.NamedTemporaryFile("wb", dir=path.parent, prefix=".slack-", delete=False) as out:
        tmp = Path(out.name)
        out.write(raw)
        out.flush()
        os.fsync(out.fileno())
    tmp.replace(path)


def collect_channel(cli: Path, channel: dict[str, Any], landing: Path, sync) -> dict[str, Any]:
    cid = channel["id"]
    name = channel["name"]
    path = landing / f"{name}.json"
    prior = json.loads(path.read_text(encoding="utf-8")) if path.is_file() else {}
    if prior and prior.get("channel_id") != cid:
        raise RuntimeError(f"Slack channel name {name} changed identity")
    roles = {str(m["ts"]): m for m in prior.get("messages") or [] if isinstance(m, dict) and "ts" in m}
    newest = str(prior.get("newest_ts") or "")
    older = str(prior.get("backfill_before") or "")
    complete = bool(prior.get("history_complete"))
    initial_scan = not prior or not prior.get("thread_replies_included")
    if prior and initial_scan:
        # Earlier snapshots explicitly excluded replies. Keep their role rows,
        # but reread the full channel with replies before claiming coverage.
        newest, older, complete = "", "", False
    pages = 0
    fetched = 0

    # New messages: a bounded forward cursor prevents rereading the whole channel.
    forward = newest
    for _ in range(MAX_READ_PAGES):
        if not forward and not initial_scan:
            break
        page = _read(cli, cid, oldest=forward) if forward else _read(cli, cid)
        pages += 1
        messages = page["messages"]
        fetched += len(messages)
        roles.update(_role_rows(messages, sync))
        if messages:
            oldest_on_page = str(messages[0]["ts"])
            latest_on_page = str(messages[-1]["ts"])
            if initial_scan and not older:
                older = oldest_on_page if page.get("has_more") else ""
                complete = not bool(page.get("has_more"))
            if latest_on_page <= forward:
                raise RuntimeError(f"Slack forward cursor did not advance for {cid}")
            newest = max(newest, latest_on_page)
            forward = latest_on_page
        if not page.get("has_more") or not messages:
            break
    if initial_scan and not newest:
        complete = True

    # Recover older declarations over successive cycles without an unbounded scan.
    for _ in range(MAX_READ_PAGES):
        if not older:
            break
        page = _read(cli, cid, latest=older)
        pages += 1
        messages = page["messages"]
        fetched += len(messages)
        roles.update(_role_rows(messages, sync))
        if not messages or not page.get("has_more"):
            older = ""
            complete = True
            break
        next_older = str(messages[0]["ts"])
        if next_older >= older:
            raise RuntimeError(f"Slack backward cursor did not advance for {cid}")
        older = next_older

    snapshot = {"schema": "cognilode.slack_role_snapshot.v1", "channel_id": cid,
                "channel_name": name, "is_member": channel["is_member"],
                "is_private": channel["is_private"], "newest_ts": newest,
                "backfill_before": older, "history_complete": complete,
                "thread_replies_included": True,
                "last_scan_at": datetime.now(timezone.utc).isoformat(),
                "message_count": len(roles),
                "messages": [roles[k] for k in sorted(roles)]}
    _atomic(path, snapshot)
    return {"channel": name, "pages": pages, "fetched": fetched,
            "role_declarations": len(roles), "history_complete": complete}


def collect(cli: Path = DEFAULT_CLI, landing: Path = DEFAULT_LANDING) -> dict[str, Any]:
    sync = _sync_module()
    channels = list_project_channels(cli)
    results = []
    failures = []
    for channel in channels:
        try:
            results.append(collect_channel(cli, channel, landing, sync))
        except Exception as exc:
            failures.append({"channel": channel["name"], "error": type(exc).__name__})
        time.sleep(0.1)
    result = {"workspace": "everything", "channels_discovered": len(channels),
              "channels_scanned": len(results), "channels_complete": sum(r["history_complete"] for r in results),
              "channels_with_roles": sum(bool(r["role_declarations"]) for r in results),
              "role_messages": sum(r["role_declarations"] for r in results),
              "pages": sum(r["pages"] for r in results), "failures": failures,
              "at": datetime.now(timezone.utc).isoformat()}
    _atomic(landing / "collection-status.json", result)
    return result


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--cli", type=Path, default=DEFAULT_CLI)
    parser.add_argument("--landing-dir", type=Path, default=DEFAULT_LANDING)
    args = parser.parse_args()
    report = collect(args.cli, args.landing_dir)
    print(json.dumps(report, sort_keys=True))
    return 0 if not report["failures"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
