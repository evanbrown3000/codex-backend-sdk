#!/usr/bin/env python3
"""Run release custody from synchronized SDK source, adopting new generations."""
from __future__ import annotations

import os
import signal
from pathlib import Path
import re
import signal
import subprocess
import sys
import time


SCRIPTS = Path(os.environ.get('COGNILODE_COMPANY_SOURCE_ROOT', '/runtime/source')) / 'current/codex-backend-sdk/scripts'
CODEX_SOURCE = Path(os.environ.get('COGNILODE_COMPANY_SOURCE_ROOT', '/runtime/source')) / 'current/cognilode-codex'
BOOT_WRAPPER = Path(__file__).resolve()
STOP = False
BUCKET = os.environ.get('COGNILODE_CODEX_RELEASE_BUCKET',
                       'cognilode-ephemeral-artifacts-362928919715-us-west-2')


def stop(_signum, _frame):
    global STOP
    STOP = True


def selected_pin() -> str:
    try:
        source = CODEX_SOURCE.resolve(strict=True)
    except OSError:
        return ""
    pin = source.name
    if not re.fullmatch(r"[0-9a-f]{40}", pin):
        return ""
    observed = subprocess.run(
        ["git", "-c", f"safe.directory={source}", "-C", str(source), "rev-parse", "HEAD"],
        capture_output=True, text=True, timeout=30,
    )
    return pin if observed.returncode == 0 and observed.stdout.strip() == pin else ""


def reap_orphaned_publications() -> None:
    """Reap only legacy aws put-object children orphaned by prior generations.

    Older custody versions spawned AWS in PID 1's process group and then
    terminated only the Python parent. Restrict matching to orphaned AWS
    processes publishing this product's immutable codex-releases keys.
    """
    for entry in Path('/proc').iterdir():
        if not entry.name.isdigit() or entry.name == '1':
            continue
        try:
            fields = (entry / 'stat').read_text().rsplit(')', 1)[1].split()
            state, ppid, pgid = fields[0], int(fields[1]), int(fields[2])
            argv = (entry / 'cmdline').read_bytes().decode(errors='replace').split('\0')
        except (OSError, ValueError, IndexError):
            continue
        if (ppid != 1 or pgid != 1 or len(argv) < 4 or
                not any(arg.endswith('/aws') for arg in argv[:3]) or 's3api' not in argv or
                'put-object' not in argv or BUCKET not in argv or
                not any(arg.startswith('codex-releases/') for arg in argv)):
            continue
        pid = int(entry.name)
        if state == 'Z':
            # These are abandoned grandchildren from pre-fix Popen calls;
            # they are now adopted by PID 1 and can be reaped explicitly.
            try:
                os.waitpid(pid, os.WNOHANG)
            except ChildProcessError:
                pass
            continue
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            continue
        deadline = time.monotonic() + 3
        while time.monotonic() < deadline and Path(f'/proc/{pid}').exists():
            time.sleep(0.05)
        if Path(f'/proc/{pid}').exists():
            try:
                os.kill(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass


def main() -> None:
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    Path(os.environ['HOME']).mkdir(parents=True, exist_ok=True)
    reap_orphaned_publications()
    while not STOP:
        selected = (SCRIPTS / 'cognilode-company-codex-release-custody').resolve()
        pin = selected_pin()
        if not selected.is_file() or not pin:
            time.sleep(5)
            continue
        print(f'Codex release custody source generation {selected} for {pin}', flush=True)
        env = os.environ.copy()
        env['COGNILODE_CODEX_SOURCE_COMMIT'] = pin
        # Keep long-running AWS upload children in this generation's process
        # group so source handoff cannot orphan an old-pin publisher.
        child = subprocess.Popen([sys.executable, str(selected)], env=env,
                                 start_new_session=True)
        while (not STOP and child.poll() is None and
               selected == (SCRIPTS / 'cognilode-company-codex-release-custody').resolve() and
               pin == selected_pin()):
            time.sleep(5)
        if child.poll() is None:
            try:
                os.killpg(child.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            try:
                child.wait(timeout=15)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(child.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                child.wait(timeout=10)
        if STOP:
            return
        wrapper = (SCRIPTS / 'cognilode-company-codex-release-custody-runtime').resolve()
        if wrapper.is_file() and wrapper != BOOT_WRAPPER:
            os.execv(sys.executable, [sys.executable, str(wrapper)])
        time.sleep(2)


if __name__ == '__main__':
    main()
