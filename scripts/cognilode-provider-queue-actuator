#!/usr/bin/env python3
"""Consume one scheduled .com queue through the singular Area-1 actuator.

The scheduler owns clocks, priority, assignment, and retry permission.  This
process only advertises a concrete actuator, consumes leases assigned to it,
crosses the fenced effect boundary, and reports the normalized provider result.
"""
from __future__ import annotations

import argparse
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import signal
import socket
import sys
import threading
import tempfile
import time
from typing import Any, Mapping
from urllib.request import urlopen

from codex_backend_sdk.provider_actuation_client import ProviderActuationClient
from codex_backend_sdk.provider_scheduler_client import scheduler_call

STOP = False
DRAINING = False
CHATGPT_DEFAULT_CONCURRENCY = 10
# A bad deployment value must not turn one credential-bearing process into an
# unbounded thread factory.  This ceiling is local actuation policy only; the
# biological scheduler remains the authority that decides which jobs exist and
# which leases may be claimed.
MAX_ACTUATION_CONCURRENCY = 32


def timestamp(value: object) -> float:
    if value in (None, ""):
        return 0.0
    if isinstance(value, (int, float)):
        return float(value)
    return datetime.fromisoformat(str(value).replace("Z", "+00:00")).timestamp()


def provider_backend_ready(provider: str) -> bool:
    """Publish availability only when the mutation backend is reachable."""
    if provider == "chatgpt.com":
        return True
    endpoint = os.environ.get("COMPUTERUSEX_CDP_ENDPOINT", "http://provider-browser:9334").rstrip("/")
    try:
        with urlopen(endpoint + "/json/version", timeout=2.0) as response:
            return response.status == 200 and bool(response.read(262144))
    except Exception:
        return False


def stop(*_args: object) -> None:
    global DRAINING
    # A synchronized source revision is not permission to interrupt a live
    # hosted-agent turn. Stop claiming new work, retain the incumbent runtime,
    # and let already-started provider operations reach terminal state.
    DRAINING = True


def actuation_concurrency(provider: str) -> int:
    """Return a bounded lane count without coupling native and browser lanes."""
    if provider == "chatgpt.com":
        configured = os.environ.get(
            "COGNILODE_CHATGPT_MAX_PARALLEL",
            os.environ.get(
                "COGNILODE_PROVIDER_ACCOUNT_CONCURRENCY",
                str(CHATGPT_DEFAULT_CONCURRENCY),
            ),
        )
    else:
        configured = os.environ.get("COGNILODE_PROVIDER_ACCOUNT_CONCURRENCY", "1")
    try:
        requested = int(configured)
    except ValueError:
        requested = CHATGPT_DEFAULT_CONCURRENCY if provider == "chatgpt.com" else 1
    return min(MAX_ACTUATION_CONCURRENCY, max(1, requested))


def fence(job: Mapping[str, Any]) -> dict[str, Any]:
    lease = job.get("lease") if isinstance(job.get("lease"), Mapping) else {}
    return {
        "job_id": str(job["id"]),
        "worker_id": str(job.get("claimed_by") or ""),
        "device_id": str(job.get("assigned_device") or ""),
        "lease_token": str(lease.get("token") or job.get("lease_token") or ""),
        "lease_generation": int(lease.get("generation") or job.get("lease_generation") or 0),
    }


def complete_job(payload: Mapping[str, Any]) -> dict[str, Any]:
    """Confirm an idempotent completion when its reply framing is lost.

    The scheduler can durably commit ``complete_job`` before the local Unix
    socket reader receives a parseable response.  Treating that ambiguous
    reply as an actuator failure causes the exception handler to release and
    replay an already-complete provider effect.  Resolve ambiguity through the
    scheduler read model; do not issue a second provider effect or mutate queue
    timing.
    """
    try:
        return scheduler_call(payload)
    except Exception:
        job_id = str(payload.get("job_id") or "")
        for attempt in range(20):
            try:
                observed = scheduler_call({"operation": "get_job", "job_id": job_id})
                job = observed.get("job") if isinstance(observed.get("job"), Mapping) else {}
                if str(job.get("state") or "") in {"complete", "rejected"}:
                    return observed
            except (json.JSONDecodeError, RuntimeError, OSError):
                pass
            time.sleep(min(0.25 * (attempt + 1), 2.0))
        raise


def lease_remaining_seconds(job: Mapping[str, Any], *, fallback: int = 3600) -> int:
    """Use the scheduler's persisted effect lease, not a generation timeout."""
    lease = job.get("lease") if isinstance(job.get("lease"), Mapping) else {}
    until = lease.get("until") or job.get("lease_until")
    if isinstance(until, (int, float)):
        return max(1, int(float(until) - time.time()))
    if isinstance(until, str) and until:
        try:
            parsed = datetime.fromisoformat(until.replace("Z", "+00:00"))
            return max(1, int((parsed - datetime.now(timezone.utc)).total_seconds()))
        except ValueError:
            pass
    return fallback


def local_attachment(row: object) -> str:
    # Shared file custody must remain usable while the immutable environment
    # catches up with a newer source generation. Resolve this hot path without
    # importing a module that may not exist in the incumbent wheel.
    value = row if isinstance(row, Mapping) else {"ref": row}
    ref = value.get("ref") or value.get("path") or ""
    if isinstance(ref, str):
        local = ref.removeprefix("file:") if ref.startswith("file:") else ref
        candidate = Path(local).expanduser()
        if candidate.is_file():
            return str(candidate)
    from codex_backend_sdk.attachment_custody import materialize_attachment
    return materialize_attachment(row)


def persist_admission_intent(job: Mapping[str, Any]) -> None:
    """Durably retain explicit application intent before any provider effect."""
    intent = job.get("application_intent")
    if not isinstance(intent, Mapping):
        metadata = job.get("metadata") if isinstance(job.get("metadata"), Mapping) else {}
        intent = metadata.get("application_intent")
    if not isinstance(intent, Mapping):
        return
    job_id = str(job.get("id") or "").strip()
    if not job_id:
        raise RuntimeError("provider_job_identity_required_for_admission_intent")
    parent = job.get("parent_operation") if isinstance(job.get("parent_operation"), Mapping) else {}
    operation_id = str(parent.get("operation_id") or job.get("parent_operation_id") or job_id)
    root = Path(os.environ.get("COGNILODE_RETURNED_PRODUCT_ADMISSIONS",
                               "/runtime/worker/returned-products/admission-intents"))
    target = root / (hashlib.sha256(job_id.encode()).hexdigest() + ".json")
    record = {"schema": "cognilode.returned_product.pending_intent.v1", "job_id": job_id,
              "operation_id": operation_id, "application_intent": dict(intent)}
    root.mkdir(parents=True, exist_ok=True)
    encoded = json.dumps(record, sort_keys=True, separators=(",", ":")) + "\n"
    if target.exists():
        prior = json.loads(target.read_text(encoding="utf-8"))
        if prior != record:
            raise RuntimeError("admission_intent_identity_conflict")
        return
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=root, prefix=target.name + ".", delete=False) as stream:
        stream.write(encoded); stream.flush(); os.fsync(stream.fileno())
        temporary = Path(stream.name)
    try:
        os.link(temporary, target)
    except FileExistsError:
        prior = json.loads(target.read_text(encoding="utf-8"))
        if prior != record:
            raise RuntimeError("admission_intent_identity_conflict")
    finally:
        temporary.unlink(missing_ok=True)


def evidence(result: Mapping[str, Any]) -> list[dict[str, Any]]:
    rows = [
        {"kind": "provider_conversation", "ref": str(result.get("conversation_id") or "")},
        {"kind": "provider_user_message", "ref": str(result.get("user_message_id") or "")},
        {"kind": "provider_assistant_message", "ref": str(result.get("assistant_message_id") or "")},
    ]
    for artifact in result.get("artifacts") or []:
        if isinstance(artifact, Mapping):
            custody = artifact.get("custody") if isinstance(artifact.get("custody"), Mapping) else {}
            rows.append({"kind": "provider_returned_artifact", "ref": str(
                custody.get("artifact_id") or custody.get("sha256") or artifact.get("sha256") or artifact.get("path") or ""
            )})
    receipt = result.get("provider_receipt") if isinstance(result.get("provider_receipt"), Mapping) else {}
    uploads = receipt.get("attachments") or ([receipt.get("attachment")] if receipt.get("attachment") else [])
    # The B4PT0R sender records the exact provider attachment descriptors as
    # ``attached_context_files`` on its durable receipt.  Preserve that native
    # field as upload evidence instead of requiring an alias that the sender
    # never writes.
    if receipt.get("attached_context_files"):
        uploads = list(uploads if isinstance(uploads, list) else []) + list(receipt["attached_context_files"])
    model_receipt = receipt.get("provider_model_receipt") if isinstance(receipt.get("provider_model_receipt"), Mapping) else {}
    if model_receipt.get("attached_context_files"):
        uploads = list(uploads if isinstance(uploads, list) else []) + list(model_receipt["attached_context_files"])
    for upload in uploads if isinstance(uploads, list) else []:
        if isinstance(upload, Mapping):
            item = upload.get("attachment") if isinstance(upload.get("attachment"), Mapping) else upload
            if item.get("included") or item.get("sha256"):
                rows.append({"kind": "provider_uploaded_attachment", "ref": str(item.get("sha256") or item.get("path") or "")})
    return [row for row in rows if row["ref"]]


def complete_insufficient_chatgpt(job: Mapping[str, Any], result: Mapping[str, Any],
                                 elapsed: float | None) -> None:
    """Close an accepted terminal short turn; never replay identical prompt."""
    rejected = {**dict(result), "accepted": True, "terminal": True,
                "state": "insufficient_evidence",
                "provider_execution_seconds": elapsed,
                "rejection_reason": "provider_execution_below_300_seconds",
                "taskflow_completion": False}
    complete_job({
        "operation": "complete_job", **fence(job),
        "conversation_id": rejected.get("conversation_id"),
        "effect_evidence": evidence(rejected),
        "artifacts": rejected.get("artifacts") or [],
        "normalized_provider_result": rejected,
        "result_state": "rejected",
        "rejection_reason": rejected["rejection_reason"],
    })


def provider_execution_seconds(result: Mapping[str, Any]) -> float | None:
    # The unified ChatGPT path intentionally wraps the native model receipt:
    # normalized result -> provider_receipt -> provider_model_receipt.  Walk
    # the bounded receipt envelope rather than treating that valid shape as a
    # sub-five-minute turn and rejecting an accepted terminal artifact.
    candidates: list[Mapping[str, Any]] = [result]
    for candidate in list(candidates):
        for key in ("provider_receipt", "provider_model_receipt"):
            nested = candidate.get(key)
            if isinstance(nested, Mapping) and nested not in candidates:
                candidates.append(nested)
    # The first pass can append provider_receipt; visit that wrapper once to
    # reach its provider_model_receipt without permitting unbounded traversal.
    for candidate in list(candidates[1:]):
        nested = candidate.get("provider_model_receipt")
        if isinstance(nested, Mapping) and nested not in candidates:
            candidates.append(nested)
    for candidate in candidates:
        elapsed = candidate.get("elapsed_seconds")
        if isinstance(elapsed, (int, float)):
            return max(0.0, float(elapsed))
        started = candidate.get("provider_started_at") or candidate.get("started_at")
        completed = candidate.get("provider_completed_at") or candidate.get("completed_at")
        if isinstance(started, (int, float)) and isinstance(completed, (int, float)):
            return max(0.0, float(completed) - float(started))
    return None


def recover_terminal(job: Mapping[str, Any]) -> bool:
    """Finish a fenced job from its durable local stream receipt after cutover.

    This is not provider observation or history hydration.  The original sender
    writes the terminal receipt only after artifact collection and central
    Agent Memory readback.  A successor generation can therefore finish the
    same scheduler fence without repeating the provider mutation.
    """
    provider = str(job.get("provider") or "")
    job_id = str(job.get("id") or "")
    if provider != "chatgpt.com":
        # ComputerUseX writes one immutable receipt only after the provider
        # response is terminal and returned-file collection has finished.  A
        # source-generation handoff can happen after that write but before the
        # broker acknowledges scheduler completion.  Bind the receipt to the
        # immutable prompt plus the currently fenced effect window and finish
        # the same operation instead of sending the prompt again.
        profile = provider.removesuffix(".com")
        runtime_root = Path(os.environ.get(
            "COMPUTERUSEX_RUNTIME_ROOT", "/runtime/worker/computerusex",
        ))
        receipt_root = runtime_root / "durable" / "web_agents" / profile
        prompt_sha = hashlib.sha256(str(job.get("prompt") or "").encode()).hexdigest()
        effect_started = timestamp(job.get("effect_started_at"))
        operation_prefix = f"{job_id}:lease:"
        candidates: list[tuple[int, Path, Mapping[str, Any]]] = []
        for path in receipt_root.glob(f"web-agent-{profile}-*.json"):
            try:
                row = json.loads(path.read_text(encoding="utf-8"))
            except (OSError, ValueError):
                continue
            if (str(row.get("provider") or "") not in {provider, profile}
                    or str(row.get("prompt_sha256") or "") != prompt_sha
                    or (row.get("operation_id")
                        and not str(row.get("operation_id")).startswith(operation_prefix))
                    or row.get("ok") is not True
                    or str(row.get("status") or "") != "response_collected"
                    or timestamp(row.get("completed_at")) < effect_started):
                continue
            candidates.append((path.stat().st_mtime_ns, path, row))
        if not candidates:
            return False
        _, path, receipt = max(candidates, key=lambda item: item[0])
        artifacts = receipt.get("response_downloaded_files") or receipt.get("downloadable_files") or []
        result = {
            "accepted": bool((receipt.get("submission") or {}).get("provider_visible_reconciliation")),
            "terminal": True,
            "conversation_id": receipt.get("observed_url") or (receipt.get("discovered_conversation_urls") or [None])[-1],
            "user_message_id": receipt.get("user_message_id"),
            "assistant_message_id": receipt.get("assistant_message_id"),
            "assistant_text": receipt.get("response") or "",
            "artifacts": artifacts,
            "provider_receipt": dict(receipt),
            "recovered_from_receipt": str(path),
            "queue_job_id": job_id,
        }
        if not result["accepted"]:
            return False
        complete_job({
            "operation": "complete_job", **fence(job),
            "conversation_id": result.get("conversation_id"),
            "effect_evidence": evidence(result),
            "artifacts": artifacts,
            "normalized_provider_result": result,
        })
        return True
    # A source cutover can release the scheduler lease after the provider has
    # already written its terminal receipt.  The next claim has a newer fence,
    # but repeating the same provider mutation is wrong.  Queue identity binds
    # every attempt to the same immutable prompt and attachments, so recover
    # the newest terminal receipt from any earlier lease generation and commit
    # it under the currently held fence.
    prefix = f"{job_id}:queue-lease:"
    root = Path(os.environ.get(
        "COGNILODE_CHATMODE_WORK_ROOT",
        str(Path.home() / ".local/share/cognilode/b4pt0r-chatmode"),
    ))
    candidates: list[tuple[int, Path, Mapping[str, Any]]] = []
    for path in root.glob("**/*.sse.receipt.json"):
        try:
            row = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if str(row.get("queue_job_id") or "").startswith(prefix):
            candidates.append((path.stat().st_mtime_ns, path, row))
    if not candidates:
        return False
    _, path, receipt = max(candidates, key=lambda item: item[0])
    central = receipt.get("central_conversation_store") if isinstance(receipt.get("central_conversation_store"), Mapping) else {}
    if (receipt.get("assistant_terminal") is not True
            or receipt.get("provider_acceptance_observed") is not True
            or central.get("central_readback_verified") is not True):
        return False
    result = {
        "accepted": True, "terminal": True,
        "conversation_id": receipt.get("conversation_id"),
        "user_message_id": receipt.get("user_message_id"),
        "assistant_message_id": receipt.get("terminal_assistant_message_id"),
        "assistant_text": receipt.get("terminal_assistant_text") or "",
        "artifacts": receipt.get("downloaded_files") or [],
        "provider_receipt": dict(receipt),
        "recovered_from_receipt": str(path),
        "queue_job_id": job_id,
    }
    if str(job.get("provider") or "") == "chatgpt.com":
        elapsed = provider_execution_seconds(result)
        if elapsed is None or elapsed < 300.0:
            complete_insufficient_chatgpt(job, result, elapsed)
            return True
    complete_job({
        "operation": "complete_job", **fence(job),
        "conversation_id": result.get("conversation_id"),
        "effect_evidence": evidence(result),
        "artifacts": result.get("artifacts") or [],
        "normalized_provider_result": result,
    })
    return True


def recover_provider_error(job: Mapping[str, Any]) -> bool:
    """Release an exact failed attempt whose broker died after publication.

    The unified actuator publishes ``provider_error`` before returning to the
    queue worker.  Generation turnover in that small acknowledgement window
    must not leave an effect fence pinned for an hour.  This reads only the
    local append-only operation ledger; it never observes provider history.
    """
    operation_id = f"{job.get('id')}:lease:{int(job.get('lease_generation') or 0)}"
    path = Path(os.environ.get(
        "COGNILODE_PROVIDER_EVENT_OUTBOX", "/runtime/provider-events/outbox.jsonl",
    ))
    if not path.is_file():
        return False
    try:
        with path.open("rb") as stream:
            stream.seek(0, os.SEEK_END)
            size = stream.tell()
            stream.seek(max(0, size - 8 * 1024 * 1024))
            rows = stream.read().splitlines()
    except OSError:
        return False
    effect_started = timestamp(job.get("effect_started_at"))
    for raw in reversed(rows):
        try:
            event = json.loads(raw)
        except (UnicodeDecodeError, ValueError):
            continue
        if (str(event.get("operation_id") or "") != operation_id
                or str(event.get("state") or "") != "provider_error"):
            continue
        observed = event.get("observed_at")
        try:
            observed_at = (float(observed) if isinstance(observed, (int, float))
                           else datetime.fromisoformat(str(observed).replace("Z", "+00:00")).timestamp())
        except (TypeError, ValueError):
            observed_at = 0
        if observed_at < effect_started:
            continue
        payload = event.get("payload") if isinstance(event.get("payload"), Mapping) else {}
        scheduler_call({
            "operation": "release_job", **fence(job),
            "provider_state": "provider_error",
            "reason": str(payload.get("code") or "provider_error") + ":" + str(payload.get("message") or "")[:500],
            "retry_after_seconds": 1,
        })
        return True
    return False


def chatgpt_transport(job: Mapping[str, Any], attachments: tuple[str, ...]) -> dict[str, Any]:
    job_id = str(job["id"])
    prompt_root = Path("/runtime/provider-inputs")
    prompt_root.mkdir(parents=True, exist_ok=True)
    prompt_file = prompt_root / (job_id + ".txt")
    prompt_file.write_text(str(job.get("prompt") or ""), encoding="utf-8")
    requested_model = str(job.get("model") or "gpt-5-6-thinking")
    model = {"gpt-5.6-sol": "gpt-5-6-thinking", "gpt-5.6": "gpt-5-6-thinking"}.get(
        requested_model, requested_model
    )
    requested_effort = str(job.get("reasoning_effort") or "xhigh")
    effort = {"max": "xhigh", "extended": "xhigh"}.get(requested_effort, requested_effort)
    turn_timeout = max(60, lease_remaining_seconds(job))
    args = [
        "--auth-source", "codex", "send", "--prompt-file", str(prompt_file),
        "--queue-job-id", job_id,
        "--model", model,
        "--effort", effort,
        "--timeout", str(turn_timeout), "--provider-attempt", str(job.get("lease_generation") or 1),
        "--provider-account-id", "central-custody",
    ]
    conversation_id = str(job.get("conversation_id") or "")
    parent_message_id = str(job.get("parent_message_id") or "")
    # A queue-authorized replay of an unacceptably short terminal attempt is a
    # new provider attempt for the same logical job, not a continuation of the
    # discarded provider branch.  The scheduler intentionally retains the
    # prior receipt as evidence, so it can still contain conversation_id while
    # lacking the exact terminal parent.  Forwarding that half-identity makes
    # the actuation layer reject the retry before any provider-side work.  A
    # genuine continuation always carries both identities from Agent Memory.
    if int(job.get("lease_generation") or 1) > 1 and not parent_message_id:
        conversation_id = ""
    if conversation_id:
        args.extend(["--conversation-id", conversation_id])
    if parent_message_id:
        args.extend(["--parent-message-id", parent_message_id])
    for attachment in attachments:
        args.extend(["--attach", attachment])
    parent = job.get("parent_operation") if isinstance(job.get("parent_operation"), Mapping) else {}
    request = {"operation": "transport", "args": args, "send_fence": {
        **fence(job), "provider_attempt": int(job.get("lease_generation") or 1),
        "parent_operation_id": str(parent.get("operation_id") or job.get("parent_operation_id") or job_id),
        "automation_order": int(parent.get("automation_order") or job.get("parent_automation_order") or 2),
        "origin": str(parent.get("kind") or job.get("parent_kind") or "provider_queue"),
        "taskflow_node": parent.get("taskflow_node"),
    }}
    path = os.environ.get("COGNILODE_PROVIDER_SOCKET", "/runtime/provider.sock")
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(turn_timeout + 180); connection.connect(path)
        connection.sendall((json.dumps(request, separators=(",", ":")) + "\n").encode())
        connection.shutdown(socket.SHUT_WR)
        chunks = []
        while True:
            chunk = connection.recv(65536)
            if not chunk: break
            chunks.append(chunk)
    outer = json.loads(b"".join(chunks).decode())
    stdout = str(outer.get("stdout") or "")
    values = []
    for line in stdout.splitlines():
        try: values.append(json.loads(line))
        except json.JSONDecodeError: pass
    raw = values[-1] if values else {}
    if int(outer.get("exit_code") or 0) != 0 or raw.get("assistant_terminal") is not True:
        print(json.dumps({
            "kind": "chatgpt_transport_failure",
            "job_id": job_id,
            "exit_code": int(outer.get("exit_code") or 0),
            "transport_stderr": str(outer.get("stderr") or "")[-4000:],
            "provider_result": raw,
        }, sort_keys=True), flush=True)
    return {
        "accepted": raw.get("provider_acceptance_observed") is True,
        "terminal": raw.get("assistant_terminal") is True,
        "conversation_id": raw.get("conversation_id"),
        "user_message_id": raw.get("user_message_id"),
        "assistant_message_id": raw.get("terminal_assistant_message_id"),
        "assistant_text": raw.get("terminal_assistant_text") or "",
        "artifacts": raw.get("downloaded_files") or [],
        "provider_receipt": raw,
        "provider_error": None if int(outer.get("exit_code") or 0) == 0 else {
            "code": "chatgpt_transport_error", "message": str(outer.get("stderr") or "")[:500]
        },
    }


def provider_transport(job: Mapping[str, Any], attachments: tuple[str, ...],
                       client: ProviderActuationClient) -> dict[str, Any]:
    """Invoke the B4PT0R actuator without coupling independent providers.

    ChatGPT owns its long-lived streaming transport socket. Browser providers
    use the same SDK actuator and custody broker in the queue worker process;
    they must not become unavailable merely because a ChatGPT source generation
    is draining an accepted turn.
    """
    parent = job.get("parent_operation") if isinstance(job.get("parent_operation"), Mapping) else {}
    turn_timeout = max(60, lease_remaining_seconds(job))
    if str(job.get("provider") or "") != "chatgpt.com":
        return client.prompt(
            str(job["provider"]), str(job.get("conversation_id") or "") or None,
            str(job.get("prompt") or ""), attachments,
            operation_id=str(job["id"]) + ":lease:" + str(job.get("lease_generation") or 0),
            account_id=str(job.get("assigned_account") or "primary"),
            parent_operation={
                "operation_id": str(parent.get("operation_id") or job.get("parent_operation_id") or job["id"]),
                "automation_order": int(parent.get("automation_order") or job.get("parent_automation_order") or 2),
                "origin": str(parent.get("kind") or job.get("parent_kind") or "provider_queue"),
                "taskflow_node": parent.get("taskflow_node"),
            },
            mode="continue" if job.get("conversation_id") else "create",
            parent_message_id=str(job.get("parent_message_id") or "") or None,
            model=str(job.get("model") or "") or None,
            reasoning_effort=str(job.get("reasoning_effort") or "") or None,
            metadata={"timeout_seconds": turn_timeout, "queue_job_id": str(job["id"])},
        )
    request = {
        "operation": "provider_prompt", "provider": str(job["provider"]),
        "operation_id": str(job["id"]) + ":lease:" + str(job.get("lease_generation") or 0),
        "account_id": str(job.get("assigned_account") or "primary"),
        "conversation_id": str(job.get("conversation_id") or "") or None,
        "parent_message_id": str(job.get("parent_message_id") or "") or None,
        "mode": "continue" if job.get("conversation_id") else "create",
        "prompt": str(job.get("prompt") or ""), "attachments": list(attachments),
        "model": str(job.get("model") or "") or None,
        "reasoning_effort": str(job.get("reasoning_effort") or "") or None,
        "timeout_seconds": turn_timeout,
        "metadata": {"timeout_seconds": turn_timeout, "queue_job_id": str(job["id"])},
        "parent_operation": {
            "operation_id": str(parent.get("operation_id") or job.get("parent_operation_id") or job["id"]),
            "automation_order": int(parent.get("automation_order") or job.get("parent_automation_order") or 2),
            "origin": str(parent.get("kind") or job.get("parent_kind") or "provider_queue"),
            "taskflow_node": parent.get("taskflow_node"),
        },
        "send_fence": {**fence(job), "job_id": str(job["id"])},
    }
    path = os.environ.get("COGNILODE_PROVIDER_SOCKET", "/runtime/provider.sock")
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(turn_timeout + 180); connection.connect(path)
        connection.sendall((json.dumps(request, separators=(",", ":")) + "\n").encode())
        connection.shutdown(socket.SHUT_WR)
        chunks = []
        while True:
            chunk = connection.recv(65536)
            if not chunk: break
            chunks.append(chunk)
    outer = json.loads(b"".join(chunks).decode())
    result = outer.get("provider_result") if isinstance(outer.get("provider_result"), Mapping) else {}
    if int(outer.get("exit_code") or 0) and not result:
        raise RuntimeError(str(outer.get("stderr") or "provider transport failed"))
    return dict(result)


def chatgpt_transport_has_job(job_id: str) -> bool | None:
    """Inspect local custody only; never query provider conversation history."""
    path = os.environ.get("COGNILODE_PROVIDER_SOCKET", "/runtime/provider.sock")
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
            connection.settimeout(5)
            connection.connect(path)
            connection.sendall(b'{"operation":"active"}\n')
            connection.shutdown(socket.SHUT_WR)
            data = bytearray()
            while b"\n" not in data and len(data) < 65536:
                piece = connection.recv(65536)
                if not piece:
                    break
                data.extend(piece)
        result = json.loads(data.split(b"\n", 1)[0])
        jobs = result.get("job_ids")
        return job_id in jobs if isinstance(jobs, list) else None
    except (OSError, ValueError, IndexError, TypeError):
        return None


def reject_prohibited_elapsed_time_padding(job: Mapping[str, Any]) -> bool:
    """Reject prompts that manufacture provider duration with sleep/heartbeat loops."""
    prompt = str(job.get("prompt") or "").casefold()
    prohibited = (
        "visible heartbeat" in prompt
        or "heartbeat loop" in prompt
        or ("separate python tool calls" in prompt and "sleep" in prompt)
        or ("time.sleep" in prompt and "heartbeat" in prompt)
        or ("six separate" in prompt and "heartbeat" in prompt)
        or ("do not finish before" in prompt and "heartbeat" in prompt)
    )
    if not prohibited:
        return False
    complete_job({
        "operation": "complete_job", **fence(job),
        "conversation_id": None,
        # Scheduler completion always requires durable evidence.  A policy
        # rejection has no provider-side effect, but the rejecting scheduler
        # decision is itself the terminal effect and must be recorded rather
        # than raising and requeueing the prohibited prompt forever.
        "effect_evidence": [{
            "kind": "scheduler_policy_rejection",
            "ref": "prohibited_elapsed_time_padding",
        }],
        "artifacts": [],
        "normalized_provider_result": {
            "schema": "cognilode.provider_result.v1",
            "state": "invalid_prompt", "terminal": True, "accepted": False,
            "provider": job.get("provider"),
            "rejection_reason": "prohibited_elapsed_time_padding",
            "taskflow_completion": False,
        },
        "result_state": "rejected",
        "rejection_reason": "prohibited_elapsed_time_padding",
    })
    return True


def process(job: Mapping[str, Any], client: ProviderActuationClient) -> None:
    if reject_prohibited_elapsed_time_padding(job):
        return
    # An ambiguous completion acknowledgement can leave the scheduler's
    # durable terminal receipt on a requeued generation.  Recover that exact
    # accepted turn before authorizing another external provider effect.
    if int(job.get("lease_generation") or 0) > 1 and recover_terminal(job):
        return
    # Scheduler admission persists the full payload; materialize its intent
    # into the shared join ledger before attachment work or begin_effect.
    persist_admission_intent(job)
    try:
        attachments = tuple(local_attachment(row) for row in job.get("attachment_refs") or ())
    except Exception as exc:
        # Missing staged input is a pre-effect admission problem. Release the
        # scheduler lease without crossing the mutation boundary or consuming
        # a provider turn; source/artifact custody can materialize it and retry.
        scheduler_call({"operation": "release_job", **fence(job),
                        "provider_state": "input_unavailable",
                        "reason": "scheduled_attachment_unavailable:" + type(exc).__name__,
                        "retry_after_seconds": 60})
        return
    boundary = scheduler_call({"operation": "begin_effect", **fence(job)})
    if boundary.get("send_authorized") is not True:
        return
    if isinstance(boundary.get("job"), Mapping):
        # begin_effect returns the authoritative post-authorization lease. All
        # downstream transport waits are derived from that actual expiry.
        job = dict(boundary["job"])
    parent = job.get("parent_operation") if isinstance(job.get("parent_operation"), Mapping) else {}
    operation_id = str(parent.get("operation_id") or job.get("parent_operation_id") or job["id"])
    result = (chatgpt_transport(job, attachments) if job["provider"] == "chatgpt.com"
              else provider_transport(job, attachments, client))
    if result.get("accepted") is not True or result.get("terminal") is not True:
        if result.get("accepted") is True:
            # Acceptance has crossed the external-effect boundary. A missing
            # terminal response is not retry authorization: collect a local
            # terminal receipt if it appears, otherwise hold the fenced job
            # until its actual scheduler effect lease expires.
            expiry = time.monotonic() + lease_remaining_seconds(job)
            while time.monotonic() < expiry:
                if recover_terminal(job):
                    return
                time.sleep(min(5.0, max(0.1, expiry - time.monotonic())))
            scheduler_call({
                "operation": "release_job", **fence(job),
                "provider_state": "accepted_turn_without_terminal_receipt",
                "reason": "accepted_turn_waited_until_effect_lease_expiry",
                "retry_after_seconds": 1,
            })
            return
        provider_error = result.get("provider_error") or {}
        reason = str(provider_error.get("code") or result.get("state") or "provider_incomplete")
        detail = str(provider_error.get("message") or "").strip()
        if detail:
            reason += ":" + detail[:500]
        scheduler_call({
            "operation": "release_job", **fence(job), "provider_state": "provider_error",
            "reason": reason,
            "retry_after_seconds": 60,
        })
        return
    if str(job.get("provider") or "") == "chatgpt.com":
        elapsed = provider_execution_seconds(result)
        if elapsed is None or elapsed < 300.0:
            complete_insufficient_chatgpt(job, result, elapsed)
            return
    # Carry only scheduler identity, not inferred intent, into the terminal
    # record so the returned-product worker can perform the durable join.
    result = {**dict(result), "queue_job_id": str(job["id"]),
              "parent_operation": {"operation_id": operation_id}}
    complete_job({
        "operation": "complete_job", **fence(job),
        "conversation_id": result.get("conversation_id"),
        "effect_evidence": evidence(result),
        "artifacts": result.get("artifacts") or [],
        "normalized_provider_result": dict(result),
    })


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--provider", required=True, choices=("chatgpt.com", "gemini.com", "claude.com", "anthropic.com"))
    parser.add_argument("--device-id", default=os.environ.get("COGNILODE_ENVIRONMENT_ID", "company-container"))
    parser.add_argument("--interval", type=float, default=10)
    args = parser.parse_args()
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    # Preserve the established ChatGPT device identity so already-fenced
    # scheduler leases survive the migration from the legacy worker to this
    # provider-neutral actuator. Other providers retain distinct devices and
    # independent concurrency.
    device = (args.device_id if args.provider == "chatgpt.com"
              else args.device_id + ":b4pt0r:" + args.provider)
    active: dict[str, Mapping[str, Any]] = {}
    lock = threading.Lock()
    # One custody/account/browser lane executes one mutation at a time.
    # Different providers remain concurrent because each owns its own
    # actuator. A restart therefore cannot fan recovered leases into parallel
    # turns on one account.
    # Native Chat-mode streams are independently fenced and historically ran
    # as a real concurrent workforce.  Serializing the account behind one long
    # turn starves higher-order work and wastes subscription capacity. Browser
    # adapters retain one protected profile lane unless explicitly expanded.
    max_concurrency = actuation_concurrency(args.provider)
    print(json.dumps({
        "kind": "provider_actuator_ready", "provider": args.provider,
        "device_id": device, "max_concurrency": max_concurrency,
    }, sort_keys=True), flush=True)

    def launch(job: Mapping[str, Any]) -> bool:
        job_id = str(job.get("id") or "")
        with lock:
            if not job_id or job_id in active or len(active) >= max_concurrency:
                return False
            active[job_id] = job

        def run() -> None:
            try:
                client = ProviderActuationClient(
                    [sys.executable, "-m", "codex_backend_sdk.provider_broker"], timeout=2400
                )
                process(job, client)
            except Exception as exc:
                print(json.dumps({
                    "kind": "provider_actuator_exception", "provider": args.provider,
                    "job_id": job_id, "error_type": type(exc).__name__,
                    "error": str(exc)[:4000],
                }, sort_keys=True), flush=True)
                # Completion may already be durable even when a subsequent
                # local operation (most notably JSON reply decoding) failed.
                # Reconcile the scheduler read model before requesting any
                # retry.  If the read itself is unavailable, leave the lease
                # fenced rather than risk replaying an accepted mutation.
                print(json.dumps({
                    "kind": "provider_actuator_exception",
                    "provider": args.provider,
                    "job_id": job_id,
                    "error": type(exc).__name__ + ":" + str(exc)[:2000],
                }), flush=True)
                try:
                    observed = scheduler_call({"operation": "get_job", "job_id": job_id})
                    durable = (observed.get("job")
                               if isinstance(observed.get("job"), Mapping) else {})
                    durable_state = str(durable.get("state") or "")
                    if durable_state in {"complete", "rejected", "cancelled"}:
                        print(json.dumps({
                            "kind": "provider_actuator_terminal_preserved",
                            "provider": args.provider, "job_id": job_id,
                            "state": durable_state,
                        }, sort_keys=True), flush=True)
                        return
                    scheduler_call({
                        "operation": "release_job", **fence(job),
                        "provider_state": "provider_error",
                        "reason": ("actuator_exception:" + type(exc).__name__ + ":" + str(exc))[:700],
                        "retry_after_seconds": 60,
                    })
                except Exception as release_exc:
                    print(json.dumps({
                        "kind": "provider_actuator_release_failed",
                        "provider": args.provider,
                        "job_id": job_id,
                        "error": type(release_exc).__name__ + ":" + str(release_exc)[:300],
                    }), flush=True)
            finally:
                with lock:
                    active.pop(job_id, None)

        # Non-daemon job threads keep their own fence, transport response and
        # output collection alive even if the polling loop stops unexpectedly.
        # The cooperative drain below still provides the normal source-change
        # handoff and waits for this same active registry to become empty.
        threading.Thread(target=run, daemon=False, name="provider-" + job_id[:24]).start()
        return True

    device_ids = [device]
    # The predecessor ChatGPT actuator advertised the environment ID directly.
    # Keep accepting those fenced leases during rolling upgrades.
    if args.provider == "chatgpt.com":
        device_ids.append(args.device_id)

    while not STOP:
        if DRAINING:
            with lock:
                active_count = len(active)
            if not active_count:
                # A rhythm tick and SIGTERM can cross after the scheduler has
                # fenced a job but before this process has put it in `active`.
                # Exiting there strands the queue lease until its full expiry.
                # Drain every already-assigned claim through the incumbent
                # generation; do not claim any new work while draining.
                found_claim = False
                try:
                    for assigned_device in device_ids:
                        listed = scheduler_call({
                            "operation": "list_jobs", "provider": args.provider,
                            "state": "claimed", "assigned_device": assigned_device,
                            "limit": max_concurrency,
                        })
                        for job in listed.get("jobs") or []:
                            if isinstance(job, Mapping) and launch(job):
                                found_claim = True
                    if not found_claim:
                        break
                except Exception as exc:
                    print(json.dumps({
                        "kind": "provider_actuator_drain_retry",
                        "provider": args.provider,
                        "error": type(exc).__name__ + ":" + str(exc)[:300],
                    }), flush=True)
            time.sleep(1.0)
            continue
        try:
            account = "central-custody" if args.provider == "chatgpt.com" else "primary"
            with lock:
                active_count = len(active)
            backend_ready = provider_backend_ready(args.provider)
            scheduler_call({
                "operation": "rhythm_device_heartbeat",
                "device": {
                    "id": device, "available": backend_ready, "active_turns": active_count,
                    "max_concurrency": max_concurrency,
                    "environment_id": args.device_id,
                    "capabilities": {
                        "environment": args.device_id, "accounts": [account],
                        "providers": {args.provider: {
                            "enabled": backend_ready, "authentication": "both", "attachments": True,
                            "artifact_downloads": True, "continuation": True,
                            "models": (["gpt-5-6-thinking", "gpt-5.6", "gpt-5.6-sol",
                                        "gpt-6-astra", "gpt-6-sol", "gpt-6-luna", "auto"]
                                       if args.provider == "chatgpt.com" else []),
                            "reasoning_modes": ["low", "medium", "high", "xhigh", "max", "extended"],
                            "max_concurrency": max_concurrency,
                        }},
                    },
                },
            })
            if not backend_ready:
                time.sleep(max(1.0, args.interval))
                continue
            seen = set()
            for assigned_device in device_ids:
                for state in ("effect_pending", "claimed"):
                    listed = scheduler_call({
                        "operation": "list_jobs", "provider": args.provider,
                        "state": state, "assigned_device": assigned_device,
                        "limit": max_concurrency,
                    })
                    for job in listed.get("jobs") or []:
                        if not isinstance(job, Mapping) or job.get("id") in seen:
                            continue
                        seen.add(job.get("id"))
                        if state == "effect_pending":
                            recovered = recover_terminal(job) or recover_provider_error(job)
                            with lock:
                                still_active = str(job.get("id") or "") in active
                            if (not recovered and not still_active
                                    and lease_remaining_seconds(job) <= 0):
                                # An accepted/in-turn effect remains fenced
                                # until its persisted scheduler lease expires.
                                # At expiry, recover any local terminal receipt
                                # first; only then may the queue authorize retry.
                                scheduler_call({
                                    "operation": "release_job", **fence(job),
                                    "provider_state": "provider_collection_interrupted",
                                    "reason": "effect_lease_expired_without_terminal_receipt",
                                    "retry_after_seconds": 1,
                                })
                        else:
                            # A prior generation may have finished the exact
                            # provider mutation after its old lease expired.
                            # The freshly claimed fence is the first safe
                            # opportunity to commit that durable receipt; do
                            # so before authorizing any replay.
                            if not recover_terminal(job):
                                launch(job)
        except Exception as exc:
            print(json.dumps({"kind": "provider_actuator_retry", "provider": args.provider,
                              "error": type(exc).__name__ + ":" + str(exc)[:300]}), flush=True)
        if not STOP and not DRAINING:
            time.sleep(max(1.0, args.interval))
    # A source-generation handoff must drain accepted provider turns rather
    # than converting every source update into a retry.  The batch supervisor
    # deliberately grants this process a long drain window; remain alive so
    # the existing transport and collector can publish their terminal result.
    while True:
        with lock:
            if not active:
                break
        time.sleep(1.0)
    # Never release or destroy an authorized provider effect at a wall-clock
    # generation deadline. The sender retains its live thread until it records
    # the terminal receipt (or the scheduler's persisted effect lease expires).
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
