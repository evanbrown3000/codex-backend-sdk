#!/usr/bin/env python3
"""Supervise event-driven provider work inside the standard company container."""
from __future__ import annotations

import os
import fcntl
from pathlib import Path
import signal
import shutil
import subprocess
import sys
import time

HERE = Path(__file__).resolve().parent
STOP = False


def stop(_signal, _frame):
    global STOP
    STOP = True


def active_source() -> Path:
    """Resolve the runner from the synchronized source frontier.

    The container is intentionally long lived because it owns provider state.
    Source generations are immutable and the ``current`` link advances.  The
    supervisor observes that link and drains the old batch runner before using
    the next generation, avoiding both stale code and interrupted provider
    mutations.
    """
    configured = os.environ.get("COGNILODE_B4PT0R_SDK_ROOT")
    root = Path(configured) if configured else HERE.parent
    return root.resolve()


def release_for(source: Path) -> tuple[Path, Path]:
    """Build one immutable CLI environment for a synchronized SDK revision."""
    release_root = Path(os.environ.get(
        "COGNILODE_B4PT0R_RELEASE_ROOT", "/runtime/b4pt0r-releases"
    ))
    release = release_root / source.name
    cli = release / "bin" / "b4pt0r"
    marker = release / ".complete"
    release_root.mkdir(parents=True, exist_ok=True)
    with (release_root / ".release-build.lock").open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if cli.is_file() and marker.is_file():
            return source / "scripts" / "b4pt0r-com-batch-daemon", cli
        temporary = release_root / (source.name + f".building-{os.getpid()}")
        if temporary.exists():
            shutil.rmtree(temporary)
        builder = Path(os.environ.get("COGNILODE_VENV_PYTHON", "/usr/local/bin/python3"))
        if not builder.is_file():
            builder = Path(sys.executable)
        subprocess.run([str(builder), "-m", "venv", "--clear", str(temporary)],
                       check=True, timeout=300)
        install = [str(temporary / "bin" / "python"), "-m", "pip", "install", "--no-cache-dir", str(source)]
        universe = Path(os.environ.get(
            "COGNILODE_UNIVERSE_STORAGE_ROOT", "/runtime/source/current/universe-storage"
        )).resolve()
        if universe.is_dir():
            install.append(str(universe))
        subprocess.run(install, check=True, timeout=900)
        (temporary / ".complete").write_text(source.name + "\n", encoding="utf-8")
        if release.exists():
            shutil.rmtree(release)
        temporary.replace(release)
    return source / "scripts" / "b4pt0r-com-batch-daemon", release / "bin" / "b4pt0r"


def launch(source: Path) -> subprocess.Popen:
    runner, cli = release_for(source)
    environment = os.environ.copy()
    environment["B4PT0R_CLI"] = str(cli)
    return subprocess.Popen(
        [sys.executable, str(runner)], env=environment, start_new_session=True
    )


def main() -> int:
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    source = active_source()
    process = launch(source)
    while not STOP:
        if process.poll() is not None:
            source = active_source()
            process = launch(source)
        else:
            candidate = active_source()
            if candidate != source:
                # SIGTERM asks the daemon to finish its active batch and then
                # exit.  No provider turn is killed during a source cutover.
                process.terminate()
                process.wait()
                source = candidate
                process = launch(source)
        time.sleep(2)
    if process.poll() is None:
        process.terminate()
        try:
            process.wait(timeout=30)
        except subprocess.TimeoutExpired:
            process.kill()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
