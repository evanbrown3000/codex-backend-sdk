class CapabilityError(RuntimeError):
    def __init__(self, code: str, message: str) -> None:
        super().__init__(message)
        self.code = code


class ProviderHTTPError(CapabilityError):
    """HTTP failure with enough structure for bounded recovery decisions."""

    def __init__(self, operation: str, response) -> None:
        self.operation = operation
        self.status = int(getattr(response, "status_code", 0) or 0)
        self.headers = dict(getattr(response, "headers", {}) or {})
        text = str(getattr(response, "text", "") or "")[:2000]
        self.body_preview = text
        super().__init__(
            "provider_rejected",
            f"{operation} HTTP {self.status}: {text[:1000]}",
        )


class PrepostUploadError(CapabilityError):
    def __init__(self, cause: Exception, retry_after_seconds: float = 0) -> None:
        self.http_status = cause.status if isinstance(cause, ProviderHTTPError) else None
        self.retry_after_seconds = retry_after_seconds
        super().__init__("prepost_attachment_upload_failed",
                         f"{type(cause).__name__}: {str(cause)[:500]}")


SAFE_AUTH_REFRESHES = 1
SAFE_RATE_RETRIES = 2
SAFE_PREPARE_SERVER_RETRIES = 2
SAFE_404_RETRIES = 1
SAFE_RECONCILE_POLLS = 4
MAX_RETRY_AFTER_SECONDS = 900.0
MAX_RETURNED_ARTIFACT_BYTES = 2_500_000_000


def _retry_after_seconds(headers: dict | None, *, now: float | None = None) -> float:
    value = ""
    for key, item in dict(headers or {}).items():
        if str(key).lower() == "retry-after":
            value = str(item).strip()
            break
    if not value:
        return 1.0
    try:
        return max(0.0, min(float(value), MAX_RETRY_AFTER_SECONDS))
    except ValueError:
        pass
    try:
        when = email.utils.parsedate_to_datetime(value)
        if when.tzinfo is None:
            when = when.replace(tzinfo=dt.timezone.utc)
        current = dt.datetime.fromtimestamp(now if now is not None else time.time(), tz=dt.timezone.utc)
        return max(0.0, min((when - current).total_seconds(), MAX_RETRY_AFTER_SECONDS))
    except Exception:
        return 1.0


def _classify_http_status(status: int, *, has_conversation: bool) -> str:
    if status in (401, 403):
        return "authentication_refresh"
    if status == 404:
        return "missing_conversation" if has_conversation else "not_found_transient"
    if status == 429:
        return "rate_limit"
    if status == 408 or 500 <= status <= 599:
        return "server_transient_ambiguous"
    return "provider_rejected"


def _safe_close(response) -> None:
    try:
        response.close()
    except Exception:
        pass


def _response_bytes(response) -> bytes:
    raw = getattr(response, "content", b"")
    if isinstance(raw, str):
        return raw.encode("utf-8", "replace")
    try:
        return bytes(raw or b"")
    except Exception:
        return str(raw or "").encode("utf-8", "replace")


def _persist_bytes(path: Path, raw: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("wb") as handle:
        handle.write(raw)
        handle.flush()
        os.fsync(handle.fileno())


def _stream_response_durable(response, path: Path) -> tuple[bytes, Exception | None]:
    chunks: list[bytes] = []
    error: Exception | None = None
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("wb") as dst:
        try:
            for chunk in response.iter_content(chunk_size=65536):
                if not chunk:
                    continue
                if isinstance(chunk, str):
                    chunk = chunk.encode("utf-8")
                chunk = bytes(chunk)
                chunks.append(chunk)
                dst.write(chunk)
                dst.flush()
                os.fsync(dst.fileno())
        except Exception as exc:  # response may already have been accepted upstream
            error = exc
        finally:
            _safe_close(response)
    return b"".join(chunks), error


def _extract_conversation_id(raw: bytes) -> str | None:
    text = raw.decode("utf-8", "replace")
    for pattern in (
        r'"conversation_id"\s*:\s*"([^"]+)"',
        r'"conversationId"\s*:\s*"([^"]+)"',
    ):
        match = re.search(pattern, text)
        if match:
            return match.group(1)
    return None


def _provider_stream_failure(summary: dict) -> str | None:
    errors = summary.get("provider_errors") if isinstance(summary, dict) else None
    if not errors:
        return None
    text = json.dumps(errors, ensure_ascii=False).lower()
    if "websocket" in text:
        return "websocket_failure"
    if "response.failed" in text or "responses" in text:
        return "responses_failure"
    return "provider_stream_failure"


def _stream_exception_kind(error: Exception | None) -> str:
    if error is None:
        return "stream_transport_failure"
    text = f"{type(error).__name__}: {error}".lower()
    if "websocket" in text:
        return "websocket_failure"
    if "response" in text:
        return "responses_failure"
    return "stream_transport_failure"


def _run(argv: list[str], *, timeout: int = 300) -> subprocess.CompletedProcess[str]:
    return subprocess.run(argv, text=True, capture_output=True, timeout=timeout, check=False)


def ensure_runtime() -> None:
    if os.environ.get("B4PT0R_CHATMODE_RUNTIME") == "1":
        return
    try:
        import curl_cffi  # noqa: F401
        import secretstorage  # noqa: F401
        import cryptography  # noqa: F401
        return
    except Exception:
        pass

    # The company image can contain both /usr/bin/python3 and a separately
    # installed /usr/local/bin/python3. A venv from an older image may still
    # have an executable while its stdlib has disappeared. Select the image's
    # packaged Python, version the runtime, and probe imports before reuse.
    base = Path(os.environ.get("B4PT0R_CHATMODE_BASE_PYTHON") or
                ("/usr/local/bin/python3" if Path("/usr/local/bin/python3").is_file()
                 else sys.executable)).resolve(strict=True)
    version = _run([str(base), "-c", "import sys;print('%d.%d' % sys.version_info[:2])"], timeout=20)
    if version.returncode or not re.fullmatch(r"\d+\.\d+", version.stdout.strip()):
        raise CapabilityError("runtime_install_failure", "image Python version unavailable")
    runtime = DEFAULT_OUTPUT_ROOT / ("venv-python" + version.stdout.strip())
    python = runtime / "bin/python"

    def healthy(path: Path) -> bool:
        if not path.is_file():
            return False
        probe = _run([str(path), "-c",
                      "import encodings,curl_cffi,secretstorage,cryptography"], timeout=30)
        return probe.returncode == 0

    DEFAULT_OUTPUT_ROOT.mkdir(parents=True, exist_ok=True)
    with (DEFAULT_OUTPUT_ROOT / ".runtime-install.lock").open("a+") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        if not healthy(python):
            candidate = DEFAULT_OUTPUT_ROOT / (runtime.name + ".build-" + uuid.uuid4().hex[:12])
            try:
                proc = _run([str(base), "-m", "venv", str(candidate)], timeout=300)
                if proc.returncode:
                    raise CapabilityError("runtime_install_failure", (proc.stderr or proc.stdout).strip()[-800:])
                proc = _run([str(candidate / "bin/python"), "-m", "pip", "install",
                             "curl_cffi", "secretstorage", "cryptography"], timeout=600)
                if proc.returncode:
                    raise CapabilityError("runtime_install_failure", (proc.stderr or proc.stdout).strip()[-800:])
                if not healthy(candidate / "bin/python"):
                    raise CapabilityError("runtime_install_failure", "built runtime failed import probe")
                if runtime.exists():
                    runtime.rename(DEFAULT_OUTPUT_ROOT / (runtime.name + ".retired-" + uuid.uuid4().hex[:12]))
                candidate.rename(runtime)
            finally:
                if candidate.exists():
                    shutil.rmtree(candidate)
    env = dict(os.environ)
    env["B4PT0R_CHATMODE_RUNTIME"] = "1"
    os.execve(str(python), [str(python), *sys.argv], env)


def _chrome_secret() -> bytes:
    import secretstorage

    bus = secretstorage.dbus_init()
    collection = secretstorage.get_default_collection(bus)
    for item in collection.get_all_items():
        try:
            label = item.get_label()
            attrs = item.get_attributes()
        except Exception:
            continue
        if "Chrome Safe Storage" in label or attrs.get("application") == "chrome":
            return item.get_secret()
    raise CapabilityError("chrome_secret_missing", "could not read Chrome Safe Storage from Secret Service")


def _decrypt_cookie(host: str, encrypted: bytes, value: str, secret: bytes) -> str:
    if value:
        return value
    from cryptography.hazmat.backends import default_backend
    from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes

    data = encrypted[3:] if encrypted.startswith((b"v10", b"v11")) else encrypted
    key = hashlib.pbkdf2_hmac("sha1", secret, b"saltysalt", 1, 16)
    decryptor = Cipher(algorithms.AES(key), modes.CBC(b" " * 16), backend=default_backend()).decryptor()
    plain = decryptor.update(data) + decryptor.finalize()
    pad = plain[-1]
    if 1 <= pad <= 16:
        plain = plain[:-pad]
    host_digest = hashlib.sha256(host.encode("utf-8")).digest()
    if plain.startswith(host_digest):
        plain = plain[32:]
    return plain.decode("utf-8", "replace")


def load_chrome_cookies(profile: Path) -> list[tuple[str, str, str, str, bool]]:
    cookies_db = profile / "Cookies"
    if not cookies_db.exists():
        raise CapabilityError("chrome_profile_missing", f"Chrome cookies DB not found: {cookies_db}")
    secret = _chrome_secret()
    fd, tmp = tempfile.mkstemp(prefix="b4pt0r-chrome-cookies-", suffix=".sqlite")
    os.close(fd)
    shutil.copy2(cookies_db, tmp)
    rows: list[tuple[str, str, str, str, bool]] = []
    try:
        con = sqlite3.connect(tmp)
        try:
            query = """
                select host_key, name, value, encrypted_value, path, is_secure
                from cookies
                where host_key like '%chatgpt.com' or host_key like '%openai.com'
            """
            for host, name, value, encrypted, path, secure in con.execute(query):
                try:
                    cookie_value = _decrypt_cookie(str(host), bytes(encrypted), str(value or ""), secret)
                except Exception:
                    continue
                if cookie_value:
                    rows.append((str(host), str(name), cookie_value, str(path or "/"), bool(secure)))
        finally:
            con.close()
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
    if not rows:
        raise CapabilityError("chrome_cookies_missing", "no decryptable ChatGPT/OpenAI cookies found")
    return rows


def new_session(profile: Path, impersonate: str):
    from curl_cffi import requests

    session = requests.Session(impersonate=impersonate, timeout=120)
    for host, name, value, path, secure in load_chrome_cookies(profile):
        session.cookies.set(name, value, domain=host, path=path, secure=secure)
    return session


def codex_device_id() -> str:
    if os.environ.get("COGNILODE_CHATMODE_PORTABLE") == "1":
        # Containers keep provider identity beside their writable Codex auth
        # custody. The operator-token mount is intentionally read-only.
        path = (Path(os.environ["CODEX_HOME"]) / "chatmode-provider-device-id"
                if os.environ.get("CODEX_HOME") else
                Path.home() / ".config/cognilode/chatmode-provider-device-id")
        path.parent.mkdir(parents=True, exist_ok=True)
        lock_path = path.with_name(path.name + ".lock")
        with lock_path.open("a+", encoding="ascii") as lock:
            os.chmod(lock_path, 0o600)
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
            if path.exists():
                return str(uuid.UUID(path.read_text(encoding="ascii").strip()))
            value = str(uuid.uuid4())
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            with os.fdopen(fd, "w", encoding="ascii") as stream:
                stream.write(value + "\n")
                stream.flush()
                os.fsync(stream.fileno())
            return value
    local_storage = Path.home() / ".config/Codex/Default/Local Storage/leveldb"
    if not local_storage.exists():
        return ""
    try:
        proc = subprocess.run(
            ["strings", *[str(path) for path in local_storage.iterdir() if path.is_file()]],
            text=True,
            capture_output=True,
            timeout=30,
            check=False,
        )
    except Exception:
        return ""
    match = re.search(r"codex\.chatgpt-conversations\.device-id\s+([0-9a-f-]{36})", proc.stdout)
    return match.group(1) if match else ""


def codex_identity() -> tuple[object, dict, str]:
    from curl_cffi import requests

    auth_path = Path.home() / ".codex/auth.json"
    try:
        tokens = json.loads(auth_path.read_text(encoding="utf-8")).get("tokens") or {}
    except Exception as exc:
        raise CapabilityError("codex_auth_missing", f"could not read {auth_path}") from exc
    token = str(tokens.get("access_token") or "")
    account_id = str(tokens.get("account_id") or "")
    if not token or not account_id:
        raise CapabilityError("codex_auth_incomplete", "Codex auth omitted access token or account ID")
    device_id = codex_device_id()
    if not device_id:
        raise CapabilityError("codex_device_missing", "local Codex provider device ID not found")
    session = requests.Session(impersonate=DEFAULT_IMPERSONATE, timeout=120)
    return session, {
        "access_token": token,
        "account_id": account_id,
        "plan_type": None,
        "user_email": None,
        "source": "codex_portable_auth" if os.environ.get("COGNILODE_CHATMODE_PORTABLE") == "1" else "codex_desktop_auth",
    }, device_id


def _refresh_portable_codex_auth(expected_account: str, stale_token: str) -> None:
    """Refresh phone-local Codex OAuth only after a proven auth rejection.

    The queue owns send ambiguity. This changes credentials, not conversation
    state, and callers may invoke it only from their existing 401/403 recovery.
    """
    from codex_backend_sdk.oauth import refresh_access_token
    from codex_backend_sdk.storage import _extract_openai_claims

    auth_path = Path.home() / ".codex/auth.json"
    lock_path = auth_path.with_name("auth.json.refresh.lock")
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    with lock_path.open("a+", encoding="ascii") as lock:
        os.chmod(lock_path, 0o600)
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        document = json.loads(auth_path.read_text(encoding="utf-8"))
        tokens = document.get("tokens") or {}
        account_id = str(tokens.get("account_id") or "")
        if not account_id or (expected_account and account_id != expected_account):
            raise CapabilityError("auth_account_mismatch", "local Codex account changed during refresh")
        if str(tokens.get("access_token") or "") != stale_token:
            return  # Another local refresher already replaced the rejected token.
        refresh_token = str(tokens.get("refresh_token") or "")
        if not refresh_token:
            raise CapabilityError("auth_refresh_unavailable", "local Codex refresh token is absent")
        renewed = refresh_access_token(refresh_token)
        new_access = str(renewed.get("access_token") or "")
        new_account = str(_extract_openai_claims(new_access).get("chatgpt_account_id") or "")
        if not new_access or new_access == stale_token or new_account != account_id:
            raise CapabilityError("auth_account_mismatch", "refreshed token did not preserve local account")
        tokens["access_token"] = new_access
        if renewed.get("refresh_token"):
            tokens["refresh_token"] = str(renewed["refresh_token"])
        if renewed.get("id_token"):
            tokens["id_token"] = str(renewed["id_token"])
        document["last_refresh"] = dt.datetime.now(dt.timezone.utc).isoformat()
        fd, name = tempfile.mkstemp(prefix=".auth-refresh-", dir=auth_path.parent)
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as out:
                os.fchmod(out.fileno(), 0o600)
                json.dump(document, out)
                out.write("\n")
                out.flush()
                os.fsync(out.fileno())
            os.replace(name, auth_path)
            directory = os.open(auth_path.parent, os.O_RDONLY)
            try:
                os.fsync(directory)
            finally:
                os.close(directory)
        finally:
            if os.path.exists(name):
                os.unlink(name)


def request_json(response, operation: str) -> dict:
    if response.status_code >= 300:
        raise ProviderHTTPError(operation, response)
    try:
        value = response.json()
    except Exception as exc:
        raise CapabilityError("provider_bad_response", f"{operation} returned non-JSON") from exc
    if not isinstance(value, dict):
        raise CapabilityError("provider_bad_response", f"{operation} returned non-object JSON")
    return value


def request_json_any(response, operation: str):
    if response.status_code >= 300:
        raise ProviderHTTPError(operation, response)
    try:
        return response.json()
    except Exception as exc:
        raise CapabilityError("provider_bad_response", f"{operation} returned non-JSON") from exc


def _normalize_operator_token(value: str) -> str:
    token = str(value or "").strip()
    token = re.sub(r"^Bearer\s+", "", token, flags=re.IGNORECASE).strip()
    if (
        (token.startswith('"') and token.endswith('"'))
        or (token.startswith("'") and token.endswith("'"))
    ):
        token = token[1:-1].strip()
    return token


def _tokens_from_env_file(path: Path) -> list[str]:
    try:
        raw = path.expanduser().read_text(encoding="utf-8")
    except OSError:
        return []
    tokens: list[str] = []
    for line in raw.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        if key.strip() in {
            "COGNILODE_MCP_EXECUTION_KEY",
            "COGNILODE_OPERATOR_AUTHORIZATION",
            "COGNILODE_CONVERSATION_OBSERVATORY_AUTHORIZATION",
            "REMOTE_SHELL_CONTROL_KEY",
        }:
            token = _normalize_operator_token(value)
            if token:
                tokens.append(token)
    return tokens


def operator_bearers() -> list[str]:
    tokens: list[str] = []
    for value in (
        os.environ.get("COGNILODE_OPERATOR_TOKEN", ""),
        os.environ.get("COGNILODE_MCP_EXECUTION_KEY", ""),
        os.environ.get("COGNILODE_OPERATOR_AUTHORIZATION", ""),
        os.environ.get("COGNILODE_CONVERSATION_OBSERVATORY_AUTHORIZATION", ""),
        os.environ.get("REMOTE_SHELL_CONTROL_KEY", ""),
    ):
        token = _normalize_operator_token(value)
        if token:
            tokens.append(token)
    token_file = os.environ.get("COGNILODE_OPERATOR_TOKEN_FILE", "")
    for candidate in (
        Path(token_file).expanduser() if token_file else None,
        Path.home() / ".config/cognilode/operator-bearer",
        Path.home() / ".config/cognilode/observability-operator-key.txt",
        Path.home() / ".config/cognilode/remote-shell-control-key",
        Path.home() / ".config/cognilode/provider-worker.env",
        Path.home() / ".config/cognilode/evanpc-host-node.env",
        Path.home() / ".config/cognilode/evanpc-host-node.generated4.env",
        Path.home() / ".config/cognilode/remote-shell-evanpc.env",
    ):
        if candidate is None:
            continue
        if candidate.suffix == ".env":
            tokens.extend(_tokens_from_env_file(candidate))
            continue
        try:
            token = _normalize_operator_token(candidate.read_text(encoding="utf-8"))
        except OSError:
            continue
        if token:
            tokens.append(token)
    unique: list[str] = []
    seen: set[str] = set()
    for token in tokens:
        if token in seen:
            continue
        seen.add(token)
        unique.append(token)
    return unique


def operator_memory_post(body: dict, *, timeout: int = 55) -> dict:
    tokens = operator_bearers()
    if not tokens:
        raise CapabilityError("central_memory_auth_unavailable", "operator bearer token unavailable")
    last_error = None
    for index, token in enumerate(tokens, start=1):
        request = urllib.request.Request(
            os.environ.get("COGNILODE_AGENT_MEMORY_URL", DEFAULT_AGENT_MEMORY_URL),
            data=json.dumps(body, ensure_ascii=False, separators=(",", ":")).encode("utf-8"),
            headers={
                "authorization": "Bearer " + token,
                "content-type": "application/json",
                "accept": "application/json",
                "user-agent": "Cognilode-B4PT0R-ChatMode/central-ingest",
            },
            method="POST",
        )
        try:
            with urllib.request.urlopen(request, timeout=timeout) as response:
                raw = response.read().decode("utf-8", "replace")
                status = response.status
        except urllib.error.HTTPError as exc:
            raw = exc.read(2000).decode("utf-8", "replace")
            last_error = f"Agent Memory HTTP {exc.code}: {raw[:1000]}"
            if exc.code == 401 and index < len(tokens):
                continue
            raise CapabilityError("central_memory_http_failed", last_error) from exc
        except Exception as exc:
            raise CapabilityError("central_memory_request_failed", f"{type(exc).__name__}: {str(exc)[:500]}") from exc
        try:
            value = json.loads(raw or "{}")
        except Exception as exc:
            raise CapabilityError("central_memory_bad_response", f"Agent Memory HTTP {status} returned non-JSON") from exc
        if status // 100 == 2 and isinstance(value, dict) and value.get("ok") is True:
            value["_auth_candidate_index"] = index
            return value
        last_error = f"Agent Memory rejected: {str(value)[:1000]}"
    raise CapabilityError("central_memory_rejected", last_error or "Agent Memory rejected every local operator credential")


MAX_PROVIDER_SSE_BYTES = 16 * 1024 * 1024
MAX_TOOL_EVENTS = 4000
MAX_TOOL_CONTENT_CHARS = 200000
MAX_TOTAL_TOOL_CONTENT_CHARS = 4000000


def provider_sse_tool_history(raw: bytes, *, expected_sha256: str = "",
                              terminal_message_id: str = "") -> dict:
    """Extract provider-observed tool messages, retaining their first-seen order.

    The stream is authoritative for message identity and content. JSON-pointer
    patches are reconstructed before final messages are selected. An absent or
    malformed stream never becomes a claim of native sandbox execution.
    """
    if len(raw) > MAX_PROVIDER_SSE_BYTES:
        raise CapabilityError("provider_stream_too_large", "provider SSE exceeds bounded ingestion size")
    raw_sha = hashlib.sha256(raw).hexdigest()
    if expected_sha256 and raw_sha != expected_sha256:
        raise CapabilityError("provider_stream_hash_mismatch", "provider SSE SHA-256 mismatch")
    state = None
    inherited_path = ""
    inherited_operation = "add"
    messages: dict[str, dict] = {}
    order: list[str] = []
    observed_model_metadata: dict[str, dict[str, str]] = {}

    def patch(target, change):
        path = str(change.get("p", change.get("path", "")))
        operation = str(change.get("o", change.get("op", "replace")))
        value = change.get("v", change.get("value"))
        if not path:
            return copy.deepcopy(value) if operation in {"add", "replace"} else target
        parts = [part.replace("~1", "/").replace("~0", "~") for part in path.split("/")[1:]]
        parent = target
        try:
            for part in parts[:-1]:
                parent = parent[int(part)] if isinstance(parent, list) else parent[part]
            leaf = parts[-1]
            if isinstance(parent, list):
                if operation == "remove": parent.pop(int(leaf))
                elif operation == "add" and leaf == "-": parent.append(copy.deepcopy(value))
                elif operation == "append": parent[int(leaf)] += value
                else:
                    index = int(leaf)
                    if operation == "add" and index == len(parent): parent.append(copy.deepcopy(value))
                    else: parent[index] = copy.deepcopy(value)
            elif isinstance(parent, dict):
                if operation == "remove": parent.pop(leaf, None)
                elif operation == "append" and isinstance(parent.get(leaf), (str, list)):
                    parent[leaf] += value
                else: parent[leaf] = copy.deepcopy(value)
        except (IndexError, KeyError, TypeError, ValueError):
            return target
        return target

    def content_text(content):
        if isinstance(content, str): return content
        if not isinstance(content, dict): return ""
        if isinstance(content.get("text"), str): return content["text"]
        parts = content.get("parts")
        if isinstance(parts, list):
            return "\n".join(part if isinstance(part, str) else str(part.get("text") or "")
                             for part in parts if isinstance(part, str) or isinstance(part, dict))
        return ""

    def observe(value):
        if isinstance(value, dict):
            message = value.get("message") if isinstance(value.get("message"), dict) else value
            if isinstance(message, dict) and isinstance(message.get("author"), dict):
                message_id = message.get("id")
                if isinstance(message_id, str) and message_id:
                    if message_id not in messages: order.append(message_id)
                    prior = messages.get(message_id)
                    candidate = copy.deepcopy(message)
                    if (candidate.get("author") or {}).get("role") == "assistant":
                        metadata = candidate.get("metadata") or {}
                        if isinstance(metadata, dict):
                            fields = {key: metadata[key] for key in
                                      ("model_slug", "resolved_model_slug", "default_model_slug", "thinking_effort")
                                      if isinstance(metadata.get(key), str) and metadata[key]}
                            if fields:
                                observed_model_metadata.setdefault(message_id, {}).update(fields)
                    if prior and not content_text(candidate.get("content")) and content_text(prior.get("content")):
                        candidate["content"] = prior["content"]
                    messages[message_id] = candidate
                    return
            for key, child in value.items():
                if key not in {"content", "metadata"}: observe(child)
        elif isinstance(value, list):
            for child in value: observe(child)

    for line in raw.decode("utf-8", "replace").splitlines():
        if line.startswith("data:"): line = line[5:].strip()
        if not line.startswith("{"): continue
        try: event = json.loads(line)
        except json.JSONDecodeError: continue
        if not isinstance(event, dict): continue
        if "v" in event and any(key in event for key in ("c", "o", "p")):
            inherited_path = str(event.get("p", inherited_path))
            inherited_operation = str(event.get("o", inherited_operation))
            if inherited_operation == "patch" and isinstance(event["v"], list):
                for change in event["v"]:
                    if isinstance(change, dict): state = patch(state, change)
            else:
                state = patch(state, {"p": inherited_path, "o": inherited_operation, "v": event["v"]})
        observe(event)
        if state is not None: observe(state)

    events = []
    content_chars = 0
    finished_container_exec_results = 0
    for message_id in order:
        message = messages[message_id]
        author = message.get("author") or {}
        role = author.get("role")
        recipient = message.get("recipient")
        if role == "assistant" and isinstance(recipient, str) and recipient not in {"", "all"}:
            normalized_role, tool_name = "tool_call", recipient
        elif role == "tool" and isinstance(author.get("name"), str):
            normalized_role, tool_name = "tool_result", author["name"]
        else:
            continue
        if len(events) >= MAX_TOOL_EVENTS:
            raise CapabilityError("provider_tool_history_too_large", "provider SSE has too many tool messages")
        body = content_text(message.get("content"))
        if len(body) > MAX_TOOL_CONTENT_CHARS or content_chars + len(body) > MAX_TOTAL_TOOL_CONTENT_CHARS:
            raise CapabilityError("provider_tool_history_too_large", "provider SSE tool content exceeds bounded ingestion size")
        content_chars += len(body)
        metadata = message.get("metadata") or {}
        parent_id = str(metadata.get("parent_id") or "") if isinstance(metadata, dict) else ""
        status = str(message.get("status") or "")
        content_type = str((message.get("content") or {}).get("content_type") or "") if isinstance(message.get("content"), dict) else ""
        if normalized_role == "tool_result" and tool_name == "container.exec" and status == "finished_successfully":
            parent = messages.get(parent_id) or {}
            if parent.get("recipient") == "container.exec" and (parent.get("author") or {}).get("role") == "assistant":
                finished_container_exec_results += 1
        events.append({
            "role": normalized_role,
            "provider_message_id": message_id,
            "provider_parent_id": parent_id or None,
            "tool_name": tool_name,
            "provider_status": status or None,
            "provider_content_type": content_type or None,
            "source_index": len(events),
            "raw_stream_sha256": raw_sha,
            "content": body if body else f"[Provider {normalized_role} message has no text; tool={tool_name}; id={message_id}]",
            "provider_content_sha256": hashlib.sha256(body.encode("utf-8")).hexdigest(),
            "authorship": "provider-observed",
            "source_content_complete": True,
        })
    provider_model_receipt = None
    fields = observed_model_metadata.get(terminal_message_id) if terminal_message_id else None
    if fields:
        provider_model_receipt = {"source": "provider_sse_terminal_message",
                                  "raw_stream_sha256": raw_sha,
                                  "terminal_assistant_message_id": terminal_message_id,
                                  **fields}
    return {"raw_stream_sha256": raw_sha, "tool_events": events,
            "finished_container_exec_results": finished_container_exec_results,
            "provider_model_receipt": provider_model_receipt}


def _provider_sse_bucket() -> str:
    bucket = os.environ.get("COGNILODE_TASKFLOW_ATTACHMENT_S3_BUCKET", "").strip()
    if not bucket:
        config = Path.home() / ".config/cognilode/chatmode-queue-worker.env"
        try:
            for line in config.read_text(encoding="utf-8").splitlines():
                if line.startswith("COGNILODE_TASKFLOW_ATTACHMENT_S3_BUCKET="):
                    bucket = line.split("=", 1)[1].strip().strip('"')
                    break
        except OSError:
            pass
    if not re.fullmatch(r"[a-z0-9][a-z0-9.-]{2,62}", bucket):
        raise CapabilityError("provider_sse_store_unconfigured", "private provider SSE source bucket is unavailable")
    return bucket


def archive_provider_sse(raw_path: Path, expected_sha256: str) -> dict:
    """Keep the exact provider source reachable beyond this device.

    The object key is content-addressed. A GET of the complete private object
    is hashed before central memory advertises it as a durable source.
    """
    if not re.fullmatch(r"[a-f0-9]{64}", expected_sha256):
        raise CapabilityError("provider_stream_hash_invalid", "provider SSE SHA-256 is invalid")
    if not raw_path.is_file() or raw_path.stat().st_size > MAX_PROVIDER_SSE_BYTES:
        raise CapabilityError("provider_stream_unavailable", "bounded provider SSE source file is unavailable")
    bucket = _provider_sse_bucket()
    key = f"chatmode-provider-sse/sha256/{expected_sha256[:2]}/{expected_sha256}.sse"
    aws = os.environ.get("COGNILODE_AWS_CLI") or shutil.which("aws")
    if not aws:
        raise CapabilityError("provider_sse_store_unavailable", "AWS CLI is unavailable")
    base = [str(aws), "s3api"]
    head = subprocess.run([*base, "head-object", "--bucket", bucket, "--key", key,
                           "--output", "json"], capture_output=True, text=True, timeout=45, check=False)
    try: prior = json.loads(head.stdout) if head.returncode == 0 else {}
    except ValueError: prior = {}
    prior_metadata = prior.get("Metadata") if isinstance(prior.get("Metadata"), dict) else {}
    if prior.get("ContentLength") != raw_path.stat().st_size or prior_metadata.get("sha256") != expected_sha256:
        put = subprocess.run([*base, "put-object", "--bucket", bucket, "--key", key,
                              "--body", str(raw_path), "--server-side-encryption", "AES256",
                              "--metadata", "sha256=" + expected_sha256, "--output", "json"],
                             capture_output=True, text=True, timeout=120, check=False)
        if put.returncode:
            raise CapabilityError("provider_sse_store_write_failed", "private provider SSE source upload failed")
    with tempfile.TemporaryDirectory(prefix="cognilode-sse-readback-") as tmp:
        target = Path(tmp) / "readback.sse"
        got = subprocess.run([*base, "get-object", "--bucket", bucket, "--key", key,
                              str(target), "--output", "json"],
                             capture_output=True, text=True, timeout=120, check=False)
        if got.returncode or not target.is_file() or hashlib.sha256(target.read_bytes()).hexdigest() != expected_sha256:
            raise CapabilityError("provider_sse_store_readback_mismatch", "private provider SSE source readback failed")
    return {"uri": f"s3://{bucket}/{key}", "sha256": expected_sha256,
            "bytes": raw_path.stat().st_size, "readback_verified": True}


def archive_returned_artifact(item: dict) -> dict:
    """Publish a downloaded provider artifact under its SHA-256, once.

    S3 validates the supplied SHA-256 while accepting the upload. A HEAD then
    checks the durable object's size and checksum before any central reference
    is admitted. The provider sandbox URL is never the custody reference.
    """
    path = Path(str(item.get("path") or ""))
    expected = str(item.get("sha256") or "").lower()
    size = int(item.get("size") or 0)
    if not re.fullmatch(r"[a-f0-9]{64}", expected) or not path.is_file() or size <= 0:
        raise CapabilityError("returned_artifact_invalid", "downloaded artifact identity is incomplete")
    if path.stat().st_size != size:
        raise CapabilityError("returned_artifact_changed", "downloaded artifact size changed")
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(chunk)
    if digest.hexdigest() != expected:
        raise CapabilityError("returned_artifact_changed", "downloaded artifact SHA-256 changed")
    bucket = _provider_sse_bucket()
    key = f"chatmode-returned-artifacts/sha256/{expected[:2]}/{expected}"
    checksum = base64.b64encode(bytes.fromhex(expected)).decode("ascii")
    aws = shutil.which("aws")
    if not aws:
        raise CapabilityError("returned_artifact_store_unavailable", "AWS CLI unavailable for private artifact custody")
    base = [str(aws), "s3api"]
    head_args = [*base, "head-object", "--bucket", bucket, "--key", key,
                 "--checksum-mode", "ENABLED", "--output", "json"]
    head = subprocess.run(head_args, capture_output=True, text=True, timeout=45, check=False)
    try:
        prior = json.loads(head.stdout) if head.returncode == 0 else {}
    except ValueError:
        prior = {}
    if prior.get("ContentLength") != size or prior.get("ChecksumSHA256") != checksum:
        put = subprocess.run([*base, "put-object", "--bucket", bucket, "--key", key,
                              "--body", str(path), "--server-side-encryption", "AES256",
                              "--checksum-sha256", checksum,
                              "--metadata", "sha256=" + expected, "--output", "json"],
                             capture_output=True, text=True, timeout=1800, check=False)
        if put.returncode:
            raise CapabilityError("returned_artifact_store_write_failed", "private artifact upload failed")
        head = subprocess.run(head_args, capture_output=True, text=True, timeout=45, check=False)
        try:
            prior = json.loads(head.stdout) if head.returncode == 0 else {}
        except ValueError:
            prior = {}
    if prior.get("ContentLength") != size or prior.get("ChecksumSHA256") != checksum:
        raise CapabilityError("returned_artifact_store_readback_mismatch", "private artifact checksum readback failed")
    return {"name": str(item.get("name") or path.name), "size": size,
            "sha256": expected, "storage_uri": f"s3://{bucket}/{key}",
            "source": "chatgpt_interpreter_download", "readback_verified": True}


def admit_central_conversation(*, result_id: str, prompt: str, result: dict, attachments: list[dict]) -> dict:
    assistant = str(result.get("terminal_assistant_text") or "")
    summary = result.get("provider_summary") if isinstance(result.get("provider_summary"), dict) else {}
    conversation_id = str(summary.get("conversation_id") or result.get("conversation_id") or result_id)[:160]
    if not assistant:
        return {"ok": False, "stored": False, "reason": "no_terminal_assistant_text"}
    raw_sha = str(result.get("raw_sha256") or "")
    raw_path_text = str(result.get("raw_path_host") or result.get("raw_path") or "")
    if raw_sha:
        if not raw_path_text or not Path(raw_path_text).is_file():
            raise CapabilityError("provider_stream_unavailable", "SHA-bound provider SSE file is unavailable for central ingestion")
        raw_path = Path(raw_path_text)
        if raw_path.stat().st_size > MAX_PROVIDER_SSE_BYTES:
            raise CapabilityError("provider_stream_too_large", "provider SSE exceeds bounded ingestion size")
        tool_history = provider_sse_tool_history(
            raw_path.read_bytes(), expected_sha256=raw_sha,
            terminal_message_id=str(result.get("terminal_assistant_message_id") or ""))
        raw_source = archive_provider_sse(raw_path, raw_sha)
    else:
        tool_history = {"raw_stream_sha256": "", "tool_events": [],
                        "finished_container_exec_results": 0, "provider_model_receipt": None}
        raw_source = None
    if tool_history["provider_model_receipt"] is None:
        # A broken SSE can still leave a complete provider terminal in the
        # exact-turn hydration. Preserve its observed model/effort provenance.
        tool_history["provider_model_receipt"] = result.get("provider_model_receipt")
    archived_artifacts = [archive_returned_artifact(item) for item in
                          (result.get("downloaded_files") or [])]
    export_bound = result.get("identity_source") == "privacy_export_exact_prompt_message"
    user_event = {"role": "user", "provider_message_id":
                  str(result.get("user_message_id")) if export_bound else "b4pt0r-user:" + result_id,
                  "source_index": -1, "content": prompt, "authorship": "operator-authored",
                  "source_content_complete": True}
    terminal_event = {"role": "assistant", "provider_message_id": str(result.get("terminal_assistant_message_id") or "b4pt0r-terminal:" + result_id),
                      "source_index": len(tool_history["tool_events"]), "content": assistant,
                      "authorship": "provider-observed", "source_content_complete": True}
    body = {
        "operation": "record_conversation",
        "provider": "chatgpt.com",
        "conversation_id": conversation_id,
        "title": "B4PT0R Chat-mode Prompt Dispatch",
        "prompt_at": (str(result.get("user_created_at")) if export_bound else
                      time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(float(result.get("started_at") or time.time())))),
        "response_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(float(result.get("completed_at") or time.time()))),
        "capture": {
            "prompt": True,
            "provider_structured_uploads": True,
            "interim_summaries": False,
            "response": True,
            "uploaded_files": True,
            "downloadable_files": True,
            "provider_sse_tool_history": bool(raw_sha),
            **({"source_kind": "privacy_export_with_exact_live_provider_readback",
                "source_content_complete": True,
                "source_response_complete": True,
                "export_member": result.get("export_member"),
                "export_member_crc32": result.get("export_member_crc32"),
                "export_etag": result.get("export_etag")}
               if export_bound else {}),
        },
        "prompt": prompt,
        "response_excerpt": assistant,
        "prompt_sha256": hashlib.sha256(prompt.encode("utf-8")).hexdigest(),
        "response_sha256": hashlib.sha256(assistant.encode("utf-8")).hexdigest(),
        "events": [user_event, *tool_history["tool_events"], terminal_event],
        "provider_structured_uploads": attachments,
        "downloadable_files": archived_artifacts,
        "conversation_urls": [f"https://chatgpt.com/c/{conversation_id}"] if conversation_id else [],
        "source": "privacy-export-exact-live-readback" if export_bound else "b4pt0r-chatmode-hot-path",
        "raw_expansion_handle": f"b4pt0r-chatmode:{result_id}",
        "read_receipt": {
            "record_id": result_id,
            "transport": result.get("transport"),
            "provider_acceptance_observed": result.get("provider_acceptance_observed"),
            "assistant_terminal": result.get("assistant_terminal"),
            "terminal_assistant_message_id": result.get("terminal_assistant_message_id"),
            "raw_sha256": result.get("raw_sha256"),
            "raw_sse_source": raw_source,
            "provider_tool_event_count": len(tool_history["tool_events"]),
            "provider_observed_finished_container_exec_results": tool_history["finished_container_exec_results"],
            "provider_model_receipt": tool_history["provider_model_receipt"],
            "provider_requests_created_by_central_readback": 0,
        },
    }
    # D1's turn table is the single logical store. Ordered deltas avoid a
    # giant request and preserve all provider tool messages across retries.
    source_events = body.pop("events")
    batches: list[list[dict]] = []
    batch: list[dict] = []
    batch_chars = 0
    for source_event in source_events:
        size = len(json.dumps(source_event, ensure_ascii=False))
        if batch and (len(batch) >= 100 or batch_chars + size > 1000000):
            batches.append(batch)
            batch, batch_chars = [], 0
        batch.append(source_event)
        batch_chars += size
    if batch: batches.append(batch)
    admitted = {}
    for index, delta in enumerate(batches):
        final = index == len(batches)-1
        capture = {**body["capture"], "source_response_complete": final, "response": final}
        chunk = {**body, "capture": capture, "events": delta,
                 "response_excerpt": assistant if final else None,
                 "response_at": body["response_at"] if final else None}
        admitted = operator_memory_post(chunk)
        if admitted.get("stored") is not True:
            raise CapabilityError("central_memory_partial_admission", "ordered provider event delta was not stored")
    stored_id = str(admitted.get("conversation_id") or conversation_id)
    readback = operator_memory_post({"operation": "read", "provider": "chatgpt.com", "conversation_id": stored_id})
    conversation = readback.get("conversation") if isinstance(readback.get("conversation"), dict) else {}
    read_prompt = str(conversation.get("prompt") or "")
    read_response = str(conversation.get("response_excerpt") or "")
    prompt_hash = hashlib.sha256(read_prompt.encode("utf-8")).hexdigest()
    response_hash = hashlib.sha256(read_response.encode("utf-8")).hexdigest()
    expected_prompt_hash = body["prompt_sha256"]
    expected_response_hash = body["response_sha256"]
    if prompt_hash != expected_prompt_hash or response_hash != expected_response_hash:
        raise CapabilityError("central_memory_readback_mismatch", "central readback hash mismatch")
    observed_events = [event for event in conversation.get("events") or []
                       if event.get("role") in {"tool_call", "tool_result"}
                       and event.get("raw_stream_sha256") == raw_sha]
    expected_events = tool_history["tool_events"]
    if len(observed_events) != len(expected_events):
        raise CapabilityError("central_tool_history_readback_mismatch", "central tool-event count mismatch")
    for expected, observed in zip(expected_events, observed_events):
        for key in ("role", "provider_message_id", "provider_parent_id", "tool_name", "provider_status", "provider_content_type", "provider_content_sha256", "raw_stream_sha256", "content"):
            if observed.get(key) != expected.get(key):
                raise CapabilityError("central_tool_history_readback_mismatch", "central tool-event ordering or content mismatch")
    receipt = conversation.get("read_receipt") or {}
    if raw_sha and receipt.get("raw_sha256") != raw_sha:
        raise CapabilityError("central_tool_history_readback_mismatch", "central raw stream hash mismatch")
    if raw_source and receipt.get("raw_sse_source") != raw_source:
        raise CapabilityError("central_tool_history_readback_mismatch", "central raw stream source mismatch")
    if receipt.get("provider_model_receipt") != tool_history["provider_model_receipt"]:
        raise CapabilityError("central_provider_model_readback_mismatch",
                              "provider stream model and effort receipt did not survive central readback")
    observed_artifacts = {str(item.get("sha256") or ""): item for item in
                          (conversation.get("downloadable_files") or []) if isinstance(item, dict)}
    for artifact in archived_artifacts:
        observed = observed_artifacts.get(artifact["sha256"])
        if not observed or observed.get("storage_uri") != artifact["storage_uri"]:
            raise CapabilityError("central_artifact_readback_mismatch",
                                  "private artifact reference did not survive central readback")
    return {
        "ok": True,
        "stored": admitted.get("stored") is True,
        "job_completed": admitted.get("job_completed") is True,
        "provider": "chatgpt.com",
        "conversation_id": stored_id,
        "central_readback_verified": True,
        "central_prompt_sha256": prompt_hash,
        "central_response_sha256": response_hash,
        "central_raw_stream_sha256": raw_sha or None,
        "central_raw_sse_source": raw_source,
        "central_artifacts": archived_artifacts,
        "central_tool_event_count": len(observed_events),
        "central_observed_finished_container_exec_results": tool_history["finished_container_exec_results"],
        "provider_model_receipt": tool_history["provider_model_receipt"],
        "provider_requests_created_by_readback": 0,
        "url_records": admitted.get("url_records", 0),
    }


def upload_attachment(session, auth: dict, source: Path, *, device_id: str) -> tuple[dict, int]:
    path = source.expanduser().resolve(strict=True)
    raw = path.read_bytes()
    if not raw:
        raise CapabilityError("empty_attachment", f"attachment is empty: {path}")
    mime_type = mimetypes.guess_type(path.name)[0] or "application/octet-stream"
    use_case = (
        "my_files"
        if mime_type.startswith("text/")
        or mime_type in {"application/json", "application/pdf", "application/zip", "application/x-zip-compressed"}
        else "ace_upload"
    )
    headers = app_headers(auth, device_id=device_id)
    created = request_json(
        session.post(BASE + "files", headers=headers, json={
            "file_name": path.name,
            "file_size": len(raw),
            "use_case": use_case,
        }, timeout=60),
        "POST /backend-api/files",
    )
    file_id = str(created.get("file_id") or "").strip()
    upload_url = str(created.get("upload_url") or "").strip()
    if not file_id or not upload_url:
        raise CapabilityError("attachment_create_bad_response", "file create omitted file_id or upload_url")
    put = session.put(
        upload_url,
        data=raw,
        headers={"Content-Type": mime_type, "x-ms-blob-type": "BlockBlob"},
        timeout=180,
    )
    if put.status_code >= 300:
        raise ProviderHTTPError("attachment PUT", put)
    finalized = request_json(
        session.post(BASE + f"files/{file_id}/uploaded", headers=headers, json={}, timeout=120),
        f"POST /backend-api/files/{file_id}/uploaded",
    )
    return {
        "id": file_id,
        "name": str(finalized.get("file_name") or path.name),
        "mimeType": str(finalized.get("mime_type") or mime_type),
        "size": int(finalized.get("file_size_bytes") or len(raw)),
        "sha256": hashlib.sha256(raw).hexdigest(),
    }, 3


def upload_attachments(session, auth: dict, paths: list[str], *, device_id: str) -> tuple[list[dict], int]:
    attachments: list[dict] = []
    request_count = 0
    for item in paths:
        attachment, requests_created = upload_attachment(session, auth, Path(item), device_id=device_id)
        attachments.append(attachment)
        request_count += requests_created
    return attachments, request_count


def upload_attachments_durable(args: argparse.Namespace, session, auth: dict, device_id: str,
                               paths: list[str], ledger_path: Path) -> tuple[list[dict], int, object, dict, str]:
    """Persist completed physical uploads before the Chat turn can be posted.

    A retry may create an orphan provider file, but never a second Chat turn.
    Finalized file IDs keyed by the exact ZIP bytes survive process restarts.
    """
    try:
        ledger = json.loads(ledger_path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        ledger = {}
    if not isinstance(ledger, dict):
        ledger = {}
    entries = ledger.get("files") if isinstance(ledger.get("files"), dict) else {}
    attachments: list[dict] = []
    request_count = 0
    for item in paths:
        path = Path(item).expanduser().resolve(strict=True)
        raw = path.read_bytes()
        digest = hashlib.sha256(raw).hexdigest()
        key = hashlib.sha256((str(path) + "\0" + digest).encode()).hexdigest()
        cached = entries.get(key) if isinstance(entries.get(key), dict) else None
        if cached and cached.get("sha256") == digest and cached.get("name") == path.name and cached.get("id"):
            attachments.append(cached)
            continue
        last_error = None
        for attempt in range(1, 5):
            try:
                attachment, created = upload_attachment(session, auth, path, device_id=device_id)
                attachments.append(attachment)
                request_count += created
                entries[key] = attachment
                atomic_json(ledger_path, {"schema": "cognilode.chatmode_uploads.v1", "files": entries})
                last_error = None
                break
            except ProviderHTTPError as exc:
                last_error = exc
                if exc.status in (401, 403) and attempt < 4:
                    session, auth, device_id = _refresh_auth_context(args, session, auth)
                    continue
                if (exc.status == 429 or exc.status == 408 or 500 <= exc.status <= 599) and attempt < 4:
                    delay = (_retry_after_seconds(exc.headers) if any(
                        str(k).lower() == "retry-after" for k in exc.headers) else min(float(attempt), 3.0))
                    if delay > 30:
                        break  # Preserve provider advice as the next D1 due time.
                    time.sleep(delay)
                    continue
                break
            except (TimeoutError, ConnectionError, OSError) as exc:
                last_error = exc
                if attempt < 4:
                    time.sleep(min(float(attempt), 3.0))
                    continue
                break
        if last_error is not None:
            delay = (_retry_after_seconds(last_error.headers) if isinstance(last_error, ProviderHTTPError)
                     and any(str(k).lower() == "retry-after" for k in last_error.headers) else 0)
            raise PrepostUploadError(last_error, delay) from last_error
    return attachments, request_count, session, auth, device_id


def _queue_fence(queue_job_id: str) -> dict:
    if not queue_job_id:
        return {}
    try:
        fence = json.loads(os.environ.get("COGNILODE_CHATMODE_SEND_FENCE", ""))
    except (ValueError, TypeError):
        fence = None
    if not isinstance(fence, dict) or fence.get("job_id") != queue_job_id or not all(
        fence.get(key) for key in ("worker_id", "lease_token", "lease_generation", "device_id")):
        raise CapabilityError("queue_send_fence_missing", "queued Chat turn requires the active D1 lease fence")
    return fence


def _record_post_boundary(fence: dict, user_message_id: str, receipt_path: Path,
                          attachments: list[dict]) -> None:
    if not fence:
        return
    receipt_sha = hashlib.sha256(receipt_path.read_bytes()).hexdigest()
    uploads = [{key: item.get(key) for key in ("id", "sha256", "size", "name")}
               for item in attachments]
    response = operator_memory_post({"operation": "record_chatmode_post_started", **fence,
        "user_message_id": user_message_id, "receipt_sha256": receipt_sha, "uploads": uploads})
    if not response.get("ok"):
        raise CapabilityError("post_boundary_rejected", str(response.get("error") or "D1 rejected Chat POST boundary"))


def hydrate_conversation(session, auth: dict, conversation_id: str, *, device_id: str, timeout: int = 120) -> dict:
    value = request_json_any(
        session.get(BASE + "conversation/" + conversation_id, headers=app_headers(auth, device_id=device_id), timeout=timeout),
        "GET /backend-api/conversation/" + conversation_id,
    )
    if not isinstance(value, dict):
        raise CapabilityError("provider_bad_response", "conversation hydration returned non-object JSON")
    return value


def list_recent_conversations(session, auth: dict, *, device_id: str, offset: int = 0, limit: int = 12) -> dict:
    """GET-only recent index, matching the historical Chat rotor transport."""
    value = request_json_any(
        session.get(BASE + f"conversations?offset={offset}&limit={limit}&order=updated",
                    headers=app_headers(auth, device_id=device_id), timeout=30),
        "GET /backend-api/conversations",
    )
    if not isinstance(value, dict) or not isinstance(value.get("items"), list):
        raise CapabilityError("provider_bad_response", "recent conversation index changed shape")
    return value


def atomic_json(path: Path, value: dict) -> None:
    """Keep a recoverable receipt when an actuator dies during a write."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=path.name + ".", suffix=".tmp", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(value, handle, ensure_ascii=False, indent=2, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def _refresh_auth_context(args: argparse.Namespace, session, previous_auth: dict | None = None):
    """Reload local credentials, then try the historical browser-session source.

    A stale Codex token may remain unchanged on disk even after a provider 403.
    The old chat rotor obtained a fresh access token from the authenticated
    ChatGPT browser's /api/auth/session. Keep the same account when switching
    sources, and only use this while reads or a proven pre-accept rejection can
    be retried. An ambiguous conversation POST is never replayed here.
    """
    try:
        session.close()
    except Exception:
        pass
    sources = ("codex", "chrome") if args.auth_source == "codex" else ("chrome", "codex")
    stale_token = str((previous_auth or {}).get("access_token") or "")
    expected_account = str((previous_auth or {}).get("account_id") or "")
    unchanged = None
    failures = []
    for source in sources:
        candidate = None
        try:
            if source == "codex":
                candidate, auth, device_id = codex_identity()
                if (os.environ.get("COGNILODE_CHATMODE_PORTABLE") == "1" and stale_token
                        and auth["access_token"] == stale_token):
                    candidate.close()
                    candidate = None
                    _refresh_portable_codex_auth(expected_account, stale_token)
                    candidate, auth, device_id = codex_identity()
            else:
                candidate = new_session(Path(args.chrome_profile).expanduser(), args.impersonate)
                auth = identity(candidate)
                device_id = device_id_from_cookies(candidate)
                auth["source"] = "browser_auth_session"
            if expected_account and auth["account_id"] != expected_account:
                raise CapabilityError("auth_account_mismatch", "refreshed provider account differs from original account")
            if stale_token and auth["access_token"] == stale_token and source == sources[0]:
                unchanged = (candidate, auth, device_id)
                candidate = None
                continue
            if unchanged is not None:
                unchanged[0].close()
            return candidate, auth, device_id
        except Exception as exc:
            failures.append(f"{source}:{type(exc).__name__}")
            if candidate is not None:
                candidate.close()
    if unchanged is not None:
        return unchanged
    raise CapabilityError("auth_refresh_unavailable", "local provider auth sources unavailable: " + ",".join(failures))


def _hydrate_with_recovery(
    args: argparse.Namespace,
    session,
    auth: dict,
    device_id: str,
    conversation_id: str,
    *,
    max_attempts: int = 3,
) -> tuple[dict | None, object, dict, str, list[dict], str]:
    """Safe GET-only recovery used after ambiguous mutations and for 404 confirmation."""
    events: list[dict] = []
    auth_refreshes = 0
    for attempt in range(1, max_attempts + 1):
        try:
            value = hydrate_conversation(session, auth, conversation_id, device_id=device_id)
            events.append({"phase": "hydrate", "attempt": attempt, "outcome": "ok"})
            return value, session, auth, device_id, events, "ok"
        except ProviderHTTPError as exc:
            kind = _classify_http_status(exc.status, has_conversation=True)
            event = {
                "phase": "hydrate",
                "attempt": attempt,
                "http_status": exc.status,
                "classification": kind,
            }
            if exc.status in (401, 403) and auth_refreshes < SAFE_AUTH_REFRESHES:
                auth_refreshes += 1
                session, auth, device_id = _refresh_auth_context(args, session, auth)
                event["action"] = "authentication_refreshed"
                events.append(event)
                continue
            if exc.status == 404:
                event["action"] = "retry_read_for_eventual_consistency"
                events.append(event)
                if attempt < max_attempts:
                    time.sleep(min(0.25 * attempt, 1.0))
                    continue
                return None, session, auth, device_id, events, "missing_conversation"
            if exc.status == 429 and attempt < max_attempts:
                delay = _retry_after_seconds(exc.headers)
                event.update({"action": "retry_after", "delay_seconds": delay})
                events.append(event)
                time.sleep(delay)
                continue
            if (exc.status == 408 or 500 <= exc.status <= 599) and attempt < max_attempts:
                delay = (_retry_after_seconds(exc.headers) if any(
                    str(key).lower() == "retry-after" for key in exc.headers) else min(float(attempt), 2.0))
                event.update({"action": "retry_safe_read", "delay_seconds": delay})
                events.append(event)
                time.sleep(delay)
                continue
            events.append(event)
            return None, session, auth, device_id, events, kind
        except Exception as exc:
            events.append({
                "phase": "hydrate",
                "attempt": attempt,
                "classification": "read_transport_failure",
                "error": f"{type(exc).__name__}: {str(exc)[:300]}",
            })
            if attempt < max_attempts:
                time.sleep(min(float(attempt), 2.0))
                continue
            return None, session, auth, device_id, events, "read_transport_failure"
    return None, session, auth, device_id, events, "read_transport_failure"


def _reconcile_turn(
    args: argparse.Namespace,
    session,
    auth: dict,
    device_id: str,
    *,
    conversation_id: str,
    user_message_id: str,
) -> tuple[dict, object, dict, str]:
    """Poll read-only hydration for the exact submitted message; never replay the mutation."""
    events: list[dict] = []
    saw_user = False
    last_state = "unknown"
    for poll in range(1, SAFE_RECONCILE_POLLS + 1):
        conversation, session, auth, device_id, read_events, read_state = _hydrate_with_recovery(
            args, session, auth, device_id, conversation_id, max_attempts=2
        )
        events.extend(read_events)
        last_state = read_state
        if conversation is not None:
            messages = branch_messages(conversation)
            present = any(str(message.get("id") or "") == user_message_id for message in messages)
            saw_user = saw_user or present
            if present:
                try:
                    terminal = terminal_response_from_hydration(conversation, user_message_id)
                except CapabilityError as exc:
                    events.append({
                        "phase": "reconcile",
                        "poll": poll,
                        "outcome": exc.code,
                    })
                else:
                    events.append({"phase": "reconcile", "poll": poll, "outcome": "terminal_recovered"})
                    return {
                        "accepted": True,
                        "terminal": True,
                        "conversation": conversation,
                        "conversation_id": conversation_id,
                        "assistant_message_id": terminal.get("assistant_message_id"),
                        "assistant_text": terminal.get("assistant_text") or "",
                        "provider_model_receipt": terminal.get("provider_model_receipt"),
                        "events": events,
                        "state": "provider_accepted_recovered",
                    }, session, auth, device_id
            else:
                events.append({"phase": "reconcile", "poll": poll, "outcome": "submitted_message_not_visible"})
        else:
            events.append({"phase": "reconcile", "poll": poll, "outcome": read_state})
        if poll < SAFE_RECONCILE_POLLS:
            time.sleep(min(0.5 * poll, 1.5))
    return {
        "accepted": saw_user,
        "terminal": False,
        "conversation_id": conversation_id,
        "events": events,
        "state": "provider_accepted_unfinished" if saw_user else (
            "missing_conversation" if last_state == "missing_conversation" else "ambiguous_acceptance"
        ),
    }, session, auth, device_id


def discover_recent_turn(
    args: argparse.Namespace,
    session,
    auth: dict,
    device_id: str,
    *,
    user_message_id: str,
    known_conversation_id: str = "",
    offset: int = 0,
    limit: int = 12,
) -> tuple[dict, object, dict, str]:
    """Find an accepted ambiguous turn with GETs only and an exact user ID.

    One invocation scans at most one recent-index page. The worker persists the
    next offset and retries later; a 429 returns Retry-After without sleeping
    inside its provider actuator. No negative scan authorizes another POST.
    """
    events: list[dict] = []
    offset = max(0, min(int(offset), 48))
    limit = max(1, min(int(limit), 12))

    def read(operation: str, call):
        nonlocal session, auth, device_id
        for attempt in (1, 2):
            try:
                return call(), None
            except ProviderHTTPError as exc:
                event = {"phase": operation, "attempt": attempt, "http_status": exc.status}
                if exc.status in (401, 403) and attempt == 1:
                    try:
                        session, auth, device_id = _refresh_auth_context(args, session, auth)
                    except Exception as refresh_error:
                        event["refresh_error"] = type(refresh_error).__name__
                    else:
                        event["action"] = "refresh_auth_then_retry_get"
                        events.append(event)
                        continue
                if exc.status == 429:
                    delay = _retry_after_seconds(exc.headers)
                    event.update({"action": "defer_get", "retry_after_seconds": delay})
                    events.append(event)
                    return None, {"state": "rate_limited", "retry_after_seconds": delay}
                if exc.status == 408 or 500 <= exc.status <= 599:
                    delay = (_retry_after_seconds(exc.headers) if any(
                        str(key).lower() == "retry-after" for key in exc.headers) else 60)
                    event.update({"action": "defer_get", "retry_after_seconds": delay})
                    events.append(event)
                    return None, {"state": "read_transient", "retry_after_seconds": delay}
                event["action"] = "retry_get_later"
                events.append(event)
                return None, {"state": "read_transient", "retry_after_seconds": 60}
            except Exception as exc:
                events.append({"phase": operation, "attempt": attempt,
                               "error": f"{type(exc).__name__}: {str(exc)[:200]}"})
                return None, {"state": "read_transient", "retry_after_seconds": 60}
        return None, {"state": "read_transient", "retry_after_seconds": 60}

    if known_conversation_id:
        candidates = [{"id": known_conversation_id}]
        next_offset = offset
    else:
        index, issue = read("recent_index", lambda: list_recent_conversations(
            session, auth, device_id=device_id, offset=offset, limit=limit))
        if issue:
            return {**issue, "events": events, "next_offset": offset}, session, auth, device_id
        candidates = index["items"]
        next_offset = 0 if len(candidates) < limit or offset + len(candidates) >= 48 else offset + len(candidates)
        events.append({"phase": "recent_index", "offset": offset, "candidates": len(candidates)})

    for item in candidates:
        conversation_id = str(item.get("id") or "") if isinstance(item, dict) else ""
        if not conversation_id:
            continue
        conversation, issue = read("hydrate", lambda cid=conversation_id: hydrate_conversation(
            session, auth, cid, device_id=device_id, timeout=12))
        if issue:
            if issue["state"] in {"rate_limited", "read_transient"}:
                return {**issue, "events": events, "next_offset": offset}, session, auth, device_id
            continue
        messages = branch_messages(conversation)
        if not any(str(message.get("id") or "") == user_message_id for message in messages):
            continue
        events.append({"phase": "hydrate", "conversation_id": conversation_id,
                       "outcome": "exact_user_message_found"})
        try:
            terminal = terminal_response_from_hydration(conversation, user_message_id)
        except CapabilityError as exc:
            if exc.code != "provider_turn_unfinished":
                events.append({"phase": "hydrate", "outcome": exc.code})
            return {"state": "provider_accepted_unfinished", "accepted": True,
                    "terminal": False, "conversation_id": conversation_id,
                    "events": events, "next_offset": offset}, session, auth, device_id
        return {"state": "provider_accepted_recovered", "accepted": True,
                "terminal": True, "conversation_id": conversation_id,
                "assistant_message_id": terminal.get("assistant_message_id"),
                "assistant_text": terminal.get("assistant_text") or "",
                "provider_model_receipt": terminal.get("provider_model_receipt"),
                "events": events, "next_offset": offset}, session, auth, device_id
    return {"state": "not_found_in_recent", "accepted": False, "terminal": False,
            "events": events, "next_offset": next_offset,
            "retry_after_seconds": 300}, session, auth, device_id


def branch_messages(conversation: dict) -> list[dict]:
    mapping = conversation.get("mapping") if isinstance(conversation.get("mapping"), dict) else {}
    current = conversation.get("current_node")
    chain: list[dict] = []
    visited: set[str] = set()
    while isinstance(current, str) and current and current not in visited:
        visited.add(current)
        node = mapping.get(current)
        if not isinstance(node, dict):
            break
        message = node.get("message")
        if isinstance(message, dict):
            chain.append(message)
        current = node.get("parent")
    chain.reverse()
    return chain


def message_text(message: dict) -> str:
    content = message.get("content") if isinstance(message.get("content"), dict) else {}
    parts = content.get("parts") if isinstance(content.get("parts"), list) else []
    texts: list[str] = []
    for part in parts:
        if isinstance(part, str):
            texts.append(part)
        elif isinstance(part, dict):
            text = part.get("text") or part.get("content")
            if isinstance(text, str):
                texts.append(text)
    return "\n".join(text for text in texts if text)


def terminal_response_from_hydration(conversation: dict, user_message_id: str) -> dict:
    messages = branch_messages(conversation)
    user_index = None
    for index, message in enumerate(messages):
        if str(message.get("id") or "") == user_message_id:
            user_index = index
            break
    if user_index is None:
        raise CapabilityError("provider_reconciliation_failed", "hydrated branch omitted the submitted user message")
    terminal = None
    for message in messages[user_index + 1:]:
        author = message.get("author") if isinstance(message.get("author"), dict) else {}
        if author.get("role") == "user":
            break  # A later user turn cannot complete this exact submission.
        if author.get("role") == "assistant" and message.get("end_turn") is True:
            terminal = message
    if not terminal:
        raise CapabilityError("provider_turn_unfinished", "hydrated branch has no terminal assistant message after submitted user message")
    return {
        "user_message": messages[user_index],
        "assistant_message": terminal,
        "assistant_message_id": terminal.get("id"),
        "assistant_text": message_text(terminal),
        "provider_model_receipt": _hydrated_model_receipt(terminal),
    }


def _hydrated_model_receipt(message: dict) -> dict | None:
    metadata = message.get("metadata") if isinstance(message.get("metadata"), dict) else {}
    fields = {key: str(metadata[key]) for key in
              ("model_slug", "resolved_model_slug", "default_model_slug", "thinking_effort")
              if isinstance(metadata.get(key), str) and metadata[key]}
    if not fields:
        return None
    raw = json.dumps(message, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
    return {"source": "provider_hydrated_terminal_message",
            "hydrated_message_sha256": hashlib.sha256(raw).hexdigest(),
            "terminal_assistant_message_id": str(message.get("id") or ""), **fields}


def sandbox_artifact_paths(assistant_text: str) -> list[str]:
    """Return provider-linked files from the two bounded interpreter roots.

    Chat-mode work can expose a real sandbox download under /tmp as well as
    /mnt/data. Ignoring the former loses returned work despite a terminal turn.
    """
    return list(dict.fromkeys(re.findall(
        r"sandbox:(/(?:mnt/data|tmp)/[^\s)>\]]+)", assistant_text
    )))


def download_interpreter_artifacts(
    session,
    auth: dict,
    *,
    conversation_id: str,
    assistant_message_id: str,
    assistant_text: str,
    output_dir: Path,
    device_id: str,
) -> list[dict]:
    downloads: list[dict] = []
    headers = app_headers(auth, device_id=device_id)
    used_destinations: set[Path] = set()
    for sandbox_path in sandbox_artifact_paths(assistant_text):
        name = Path(sandbox_path).name or "downloaded-artifact"
        destination = output_dir / name
        suffix_index = 2
        while destination in used_destinations:
            source_name = Path(name)
            destination = output_dir / f"{source_name.stem}-{suffix_index}{source_name.suffix}"
            suffix_index += 1
        used_destinations.add(destination)
        # A completed transfer is atomically renamed into this per-turn
        # directory. Reuse its bytes after a collector crash rather than
        # requesting the same provider artifact again.
        if destination.is_file() and 0 < destination.stat().st_size <= MAX_RETURNED_ARTIFACT_BYTES:
            digest = hashlib.sha256()
            with destination.open("rb") as saved:
                for chunk in iter(lambda: saved.read(1024 * 1024), b""):
                    digest.update(chunk)
            downloads.append({"name": destination.name, "source_name": name,
                              "sandbox_path": sandbox_path, "path": str(destination),
                              "size": destination.stat().st_size, "sha256": digest.hexdigest(),
                              "source": "chatgpt_interpreter_download"})
            continue
        metadata = request_json(
            session.get(
                BASE + f"conversation/{conversation_id}/interpreter/download?" + urlencode({
                    "message_id": assistant_message_id,
                    "sandbox_path": sandbox_path,
                }),
                headers=headers,
                timeout=120,
            ),
            "GET /backend-api/conversation/interpreter/download",
        )
        download_url = str(metadata.get("download_url") or "").strip()
        if not download_url.startswith("https://"):
            raise CapabilityError("provider_download_failed", f"download metadata omitted HTTPS URL for {sandbox_path}")
        response = session.get(download_url, headers=headers, timeout=1800, stream=True)
        if response.status_code >= 300:
            detail = str(getattr(response, "text", "") or "")[:500]
            _safe_close(response)
            raise CapabilityError("provider_download_failed", f"artifact download HTTP {response.status_code}: {detail}")
        length = next((str(value) for key, value in
                       (getattr(response, "headers", {}) or {}).items()
                       if str(key).lower() == "content-length"), "")
        if length.isdigit() and int(length) > MAX_RETURNED_ARTIFACT_BYTES:
            _safe_close(response)
            raise CapabilityError("provider_download_too_large", "provider artifact exceeds result limit")
        destination.parent.mkdir(parents=True, exist_ok=True)
        temp_destination = destination.with_name(destination.name + ".part")
        temp_destination.unlink(missing_ok=True)
        size = 0
        digest = hashlib.sha256()
        try:
            with temp_destination.open("xb") as handle:
                for chunk in response.iter_content(chunk_size=1024 * 1024):
                    if not chunk:
                        continue
                    size += len(chunk)
                    if size > MAX_RETURNED_ARTIFACT_BYTES:
                        raise CapabilityError("provider_download_too_large", "provider artifact exceeds result limit")
                    handle.write(chunk)
                    digest.update(chunk)
                handle.flush()
                os.fsync(handle.fileno())
            if not size or (length.isdigit() and size != int(length)):
                raise CapabilityError("provider_download_incomplete", "provider artifact length differs")
            temp_destination.replace(destination)
        except Exception:
            temp_destination.unlink(missing_ok=True)
            raise
        finally:
            _safe_close(response)
        downloads.append({
            "name": destination.name,
            "source_name": name,
            "sandbox_path": sandbox_path,
            "path": str(destination),
            "size": size,
            "sha256": digest.hexdigest(),
            "source": "chatgpt_interpreter_download",
        })
    return downloads


def identity(session) -> dict:
    response = session.get(SESSION, headers={"accept": "application/json", "referer": "https://chatgpt.com/"})
    value = request_json(response, "GET /api/auth/session")
    token = str(value.get("accessToken") or "")
    account = value.get("account") if isinstance(value.get("account"), dict) else {}
    account_id = str(account.get("id") or "")
    if not token or not account_id:
        raise CapabilityError("auth_session_incomplete", "ChatGPT session omitted access token or account ID")
    user = value.get("user") if isinstance(value.get("user"), dict) else {}
    return {
        "access_token": token,
        "account_id": account_id,
        "plan_type": account.get("planType"),
        "user_email": user.get("email"),
    }


def device_id_from_cookies(session) -> str:
    for cookie in session.cookies.jar:
        if cookie.name == "oai-did" and cookie.value:
            return str(cookie.value)
    return ""


def app_headers(auth: dict, *, stream: bool = False, device_id: str = "") -> dict[str, str]:
    headers = {
        "Authorization": "Bearer " + str(auth["access_token"]),
        "ChatGPT-Account-ID": str(auth["account_id"]),
        "Accept": "text/event-stream" if stream else "application/json",
        "Content-Type": "application/json",
        "Origin": "https://chatgpt.com",
        "Referer": "https://chatgpt.com/",
    }
    if auth.get("source") in {"codex_desktop_auth", "codex_portable_auth"}:
        headers.update({
            "User-Agent": "Codex Desktop/42.3.0",
            "OAI-Language": "en",
            "originator": "Codex Desktop",
        })
    if device_id:
        headers["OAI-Device-ID"] = device_id
    return headers


def _mix(value: str) -> str:
    number = 2166136261
    for char in value:
        number = ((number ^ ord(char)) * 16777619) & 0xFFFFFFFF
    number ^= number >> 16
    number = (number * 2246822507) & 0xFFFFFFFF
    number ^= number >> 13
    number = (number * 3266489909) & 0xFFFFFFFF
    number ^= number >> 16
    return f"{number & 0xFFFFFFFF:08x}"


def sentinel_headers(session, auth: dict, *, device_id: str) -> dict[str, str]:
    headers = app_headers(auth, device_id=device_id)
    values = [
        3840, str(dt.datetime.now().astimezone()), None, 1,
        "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/150.0.0.0 Safari/537.36",
        None, None, "en-US", "en-US,en", random.random(), None, None, None,
        0, device_id, "", 8, time.time() * 1000, 0, 0, 0, 0, 0, 0, 0,
    ]
    key = "gAAAAAC" + base64.b64encode(json.dumps(values, separators=(",", ":")).encode()).decode()
    response = session.post(BASE + "sentinel/chat-requirements/prepare", headers=headers, json={"p": key}, timeout=60)
    requirements = request_json(response, "POST /backend-api/sentinel/chat-requirements/prepare")
    proof = requirements.get("proofofwork") if isinstance(requirements.get("proofofwork"), dict) else {}
    if proof.get("required"):
        started = time.perf_counter()
        template = list(values)
        proof_token = None
        for counter in range(500_000):
            template[3] = counter
            template[9] = round((time.perf_counter() - started) * 1000)
            candidate = base64.b64encode(json.dumps(template, separators=(",", ":")).encode()).decode()
            difficulty = str(proof["difficulty"])
            if _mix(str(proof["seed"]) + candidate)[: len(difficulty)] <= difficulty:
                proof_token = "gAAAAAB" + candidate + "~S"
                break
        if not proof_token:
            raise CapabilityError("sentinel_pow_failure", "sentinel proof-of-work was not solved")
        headers["OpenAI-Sentinel-Proof-Token"] = proof_token
    turn = requirements.get("turnstile") if isinstance(requirements.get("turnstile"), dict) else {}
    if turn.get("required"):
        if not SENTINEL_VM.exists():
            raise CapabilityError("sentinel_vm_missing", f"Sentinel VM not found: {SENTINEL_VM}")
        proc = subprocess.run(
            ["node", str(SENTINEL_VM), str(turn["dx"]), key],
            text=True,
            capture_output=True,
            timeout=30,
            check=False,
        )
        if proc.returncode:
            detail = (proc.stderr or proc.stdout or "").strip()[:800]
            raise CapabilityError("sentinel_turnstile_failure", detail or "Sentinel VM failed")
        headers["OpenAI-Sentinel-Turnstile-Token"] = proc.stdout.strip()
    if requirements.get("token"):
        headers["OpenAI-Sentinel-Chat-Requirements-Token"] = str(requirements["token"])
    if requirements.get("prepare_token"):
        headers["OpenAI-Sentinel-Chat-Requirements-Prepare-Token"] = str(requirements["prepare_token"])
    return headers


def connector_hints(connector_ids: list[str]) -> list[str]:
    result: list[str] = []
    for value in connector_ids:
        connector_id = value.strip()
        if not connector_id:
            continue
        if not re.fullmatch(r"asdk_app_[A-Za-z0-9]{16,64}", connector_id):
            raise CapabilityError("invalid_connector_id", f"invalid ChatGPT connector ID: {connector_id}")
        hint = "plugin:" + connector_id
        if hint not in result:
            result.append(hint)
    return result


def build_payload(prompt: str, *, conversation_id: str | None, parent_message_id: str | None, model: str, effort: str, connector_ids: list[str] | None = None, attachments: list[dict] | None = None, user_message_id: str | None = None) -> tuple[str, dict]:
    wire_effort = {"medium": "standard", "high": "extended", "xhigh": "xhigh"}[effort]
    message_id = str(uuid.UUID(user_message_id)) if user_message_id else str(uuid.uuid4())
    system_hints = connector_hints(connector_ids or [])
    metadata = {
        **({"system_hints": system_hints} if system_hints else {}),
        **({"attachments": attachments} if attachments else {}),
    }
    payload = {
        "action": "next",
        "messages": [{
            "id": message_id,
            "author": {"role": "user"},
            "create_time": time.time(),
            "content": {"content_type": "text", "parts": [prompt]},
            "metadata": metadata,
        }],
        "parent_message_id": str(parent_message_id or "").strip() or "client-created-root",
        "model": model,
        "thinking_effort": wire_effort,
        "conversation_mode": {"kind": "primary_assistant"},
        "suggestions": [],
        "history_and_training_disabled": False,
        "force_paragen": False,
        "force_rate_limit": False,
        "websocket_request_id": str(uuid.uuid4()),
        "timezone_offset_min": 300,
        "timezone": "America/Chicago",
        "supported_encodings": ["v1"],
        "supports_buffering": True,
        "client_contextual_info": {"app_name": "chatgpt.com"},
        "force_parallel_switch": "auto",
        "client_prepare_state": "success",
    }
    if conversation_id:
        payload["conversation_id"] = conversation_id
    if system_hints:
        payload["system_hints"] = system_hints
    return message_id, payload


def prepare_payload(session, auth: dict, payload: dict, *, device_id: str) -> tuple[dict[str, str], dict]:
    import copy

    message = payload["messages"][0]
    prepare = {
        key: copy.deepcopy(payload[key])
        for key in (
            "action", "conversation_id", "parent_message_id", "model",
            "thinking_effort", "system_hints", "timezone_offset_min", "timezone",
        )
        if key in payload
    }
    prepare.update({
        "client_prepare_state": "sent",
        "client_prepare_source": "context_change",
        "client_prepare_dispatch": "immediate",
        "is_do_not_remember": False,
        "partial_query": {
            "id": message.get("id"),
            "author": copy.deepcopy(message.get("author") or {"role": "user"}),
            "content": copy.deepcopy(message.get("content") or {}),
        },
    })
    headers = sentinel_headers(session, auth, device_id=device_id)
    headers.update({
        "X-OpenAI-Target-Path": "/backend-api/f/conversation/prepare",
        "X-OpenAI-Target-Route": "/backend-api/f/conversation/prepare",
    })
    response = session.post(BASE + "f/conversation/prepare", headers=headers, json=prepare)
    prepared = request_json(response, "POST /backend-api/f/conversation/prepare")
    conduit = prepared.get("conduit_token") or prepared.get("conduitToken") or response.headers.get("x-conduit-token")
    if not isinstance(conduit, str) or not conduit.strip():
        raise CapabilityError("prepare_missing_conduit", "conversation prepare omitted conduit token")
    gen_headers = dict(headers)
    gen_headers.update({
        "Accept": "text/event-stream",
    })
    gen_headers.update({
        "X-Conduit-Token": conduit.strip(),
        "X-Oai-Turn-Trace-Id": str(uuid.uuid4()),
        "X-OpenAI-Target-Path": "/backend-api/f/conversation",
        "X-OpenAI-Target-Route": "/backend-api/f/conversation",
    })
    prepared_payload = copy.deepcopy(payload)
    prepared_payload["client_prepare_state"] = "sent"
    return gen_headers, prepared_payload


def summarize_sse(raw: bytes, expected_user_message_id: str) -> dict:
    terminal_text = ""
    terminal_message_id = None
    conversation_id = None
    errors: list[dict] = []
    accepted = False
    assistant_end_turn = False
    assistant_started = False
    assistant_status = None

    def absorb_message(message: dict) -> None:
        nonlocal terminal_text, terminal_message_id, assistant_end_turn, assistant_started, assistant_status
        author = message.get("author") if isinstance(message.get("author"), dict) else {}
        if author.get("role") != "assistant":
            return
        assistant_started = True
        terminal_message_id = message.get("id") or terminal_message_id
        content = message.get("content") if isinstance(message.get("content"), dict) else {}
        parts = content.get("parts") if isinstance(content.get("parts"), list) else []
        if parts:
            terminal_text = "\n".join(str(part) for part in parts if part is not None)
        if isinstance(message.get("status"), str):
            assistant_status = message.get("status")
        metadata = message.get("metadata") if isinstance(message.get("metadata"), dict) else {}
        if message.get("end_turn") is True or metadata.get("finish_details") or metadata.get("is_complete"):
            assistant_end_turn = True

    def apply_patch_item(item: dict) -> None:
        nonlocal terminal_text, assistant_end_turn, assistant_status
        path = item.get("p")
        value = item.get("v")
        if path == "/message/content/parts/0" and isinstance(value, str):
            terminal_text += value
        elif path == "/message/end_turn" and value is True:
            assistant_end_turn = True
        elif path == "/message/status" and isinstance(value, str):
            assistant_status = value

    for line in raw.decode("utf-8", "replace").splitlines():
        if not line.startswith("data:"):
            continue
        data = line[5:].strip()
        if not data or data == "[DONE]":
            continue
        try:
            event = json.loads(data)
        except Exception:
            continue
        if not isinstance(event, dict):
            continue
        if event.get("conversation_id"):
            conversation_id = event.get("conversation_id")
        nested = event.get("v")
        if isinstance(nested, dict) and nested.get("conversation_id"):
            conversation_id = nested.get("conversation_id")
        if event.get("message_id") == expected_user_message_id or event.get("user_message_id") == expected_user_message_id:
            accepted = True
        message = event.get("message")
        if isinstance(message, dict):
            absorb_message(message)
        if isinstance(nested, dict) and isinstance(nested.get("message"), dict):
            absorb_message(nested["message"])
        if event.get("p") == "/message/content/parts/0" and isinstance(event.get("v"), str):
            assistant_started = True
            terminal_text += event["v"]
        elif event.get("p") in ("", None) and isinstance(event.get("v"), str) and assistant_started:
            terminal_text += event["v"]
        if isinstance(event.get("v"), list):
            for item in event["v"]:
                if isinstance(item, dict):
                    apply_patch_item(item)
        event_type = str(event.get("type") or "")
        if event_type.endswith(".failed") or event_type.endswith(".error"):
            errors.append({"type": event_type, "event": event})
        if "websocket" in event_type.lower() and (event.get("error") or event.get("detail")):
            errors.append({"type": event_type or "websocket_error", "event": event})
        if isinstance(event.get("error"), dict):
            errors.append(event["error"])
        elif isinstance(event.get("error"), str):
            errors.append({"error": event["error"]})
        if isinstance(event.get("detail"), str):
            errors.append({"detail": event["detail"]})
    return {
        "provider_acceptance_observed": accepted or bool(conversation_id),
        "assistant_end_turn": assistant_end_turn or assistant_status == "finished_successfully",
        "terminal_assistant_text": terminal_text,
        "terminal_assistant_message_id": terminal_message_id,
        "conversation_id": conversation_id,
        "provider_errors": errors,
    }


def health(args: argparse.Namespace) -> dict:
    if args.auth_source == "codex":
        try:
            session, auth, device_id = codex_identity()
        except CapabilityError:
            session = new_session(Path(args.chrome_profile).expanduser(), args.impersonate)
            auth = identity(session)
            auth["source"] = "browser_auth_session"
            device_id = device_id_from_cookies(session)
        try:
            sentinel_headers(session, auth, device_id=device_id)
        except ProviderHTTPError as exc:
            if exc.status not in (401, 403):
                raise
            session, auth, device_id = _refresh_auth_context(args, session, auth)
            sentinel_headers(session, auth, device_id=device_id)
    else:
        session = new_session(Path(args.chrome_profile).expanduser(), args.impersonate)
        auth = identity(session)
        auth["source"] = "browser_auth_session"
        device_id = device_id_from_cookies(session)
    return {
        "ok": True,
        "state": "ready",
        "transport": "codex_portable_auth_http" if auth.get("source") == "codex_portable_auth" else
                     "codex_desktop_auth_http" if auth.get("source") == "codex_desktop_auth" else "host_chrome_state_http",
        "account_id_present": bool(auth["account_id"]),
        "token_present": bool(auth["access_token"]),
        "device_id_present": bool(device_id),
        "plan_type": auth.get("plan_type"),
        "user_email": auth.get("user_email"),
    }


def send(args: argparse.Namespace) -> dict:
    prompt = args.prompt or (Path(args.prompt_file).read_text(encoding="utf-8") if args.prompt_file else "")
    prompt = prompt.strip()
    if not prompt:
        raise CapabilityError("empty_prompt", "send requires --prompt or --prompt-file")
    output_root = Path(args.output_dir).expanduser() if args.output_dir else DEFAULT_OUTPUT_ROOT
    output_root.mkdir(parents=True, exist_ok=True)
    queue_job_id = str(getattr(args, "queue_job_id", "") or "").strip()
    result_id = ("b4pt0r-chatmode-job-" + hashlib.sha256(queue_job_id.encode()).hexdigest()[:24]) if queue_job_id else (
        "b4pt0r-chatmode-" + time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()) + "-" + uuid.uuid4().hex[:8])
    raw_path = output_root / f"{result_id}.sse"
    receipt_path = output_root / f"{result_id}.sse.receipt.json"
    record_path = output_root / f"{result_id}.json"
    artifact_dir = output_root / f"{result_id}.files"
    if queue_job_id and (receipt_path.exists() or record_path.exists()):
        raise CapabilityError("existing_queue_send_requires_reconciliation", f"existing send receipt for queue job {queue_job_id}; reconcile exact user message before any new mutation")
    fence = _queue_fence(queue_job_id)

    if args.auth_source == "codex":
        session, auth, device_id = codex_identity()
        transport = "codex_portable_auth_http" if auth.get("source") == "codex_portable_auth" else "codex_desktop_auth_http"
    else:
        session = new_session(Path(args.chrome_profile).expanduser(), args.impersonate)
        auth = identity(session)
        auth["source"] = "browser_auth_session"
        device_id = device_id_from_cookies(session)
        transport = "host_chrome_state_http"

    if args.conversation_id:
        # An older central readback is not sufficient to determine an existing
        # ChatGPT branch's current parent. Consult the provider before uploading
        # attachments or submitting the next user message. This is GET-only.
        existing, session, auth, device_id, read_events, read_state = _hydrate_with_recovery(
            args, session, auth, device_id, args.conversation_id, max_attempts=3
        )
        if existing is None:
            raise CapabilityError("conversation_resume_read_failed",
                                  "existing provider conversation could not be read: " + str(read_state))
        chain = branch_messages(existing)
        active = next((message for message in reversed(chain)
                       if isinstance(message.get("author"), dict)
                       and message["author"].get("role") in ("user", "assistant")
                       and isinstance(message.get("id"), str) and message["id"]), None)
        if not active:
            raise CapabilityError("conversation_resume_parent_missing",
                                  "existing provider branch has no source-identified terminal message")
        author = active["author"]["role"]
        metadata = active.get("metadata") if isinstance(active.get("metadata"), dict) else {}
        is_terminal = (author == "assistant" and (
            active.get("end_turn") is True or metadata.get("finish_details") is not None
            or metadata.get("is_complete") is True))
        if not is_terminal:
            raise CapabilityError("conversation_resume_pending_turn",
                                  "provider branch has an unfinished or unacknowledged user turn")
        provider_parent = active["id"]
        if args.parent_message_id and args.parent_message_id != provider_parent:
            raise CapabilityError("conversation_resume_stale_parent",
                                  "target ChatGPT branch changed since DecisionX selected its instruction")
        args.parent_message_id = provider_parent

    attachments, attachment_requests, session, auth, device_id = upload_attachments_durable(
        args, session, auth, device_id, args.attach, output_root / f"{result_id}.uploads.json")
    message_id, payload = build_payload(
        prompt,
        conversation_id=args.conversation_id,
        parent_message_id=args.parent_message_id,
        model=args.model,
        effort=args.effort,
        connector_ids=args.connector_id,
        attachments=attachments,
        user_message_id=str(uuid.uuid5(uuid.NAMESPACE_URL, "cognilode-chatmode-queue:" + queue_job_id)) if queue_job_id else None,
    )
    receipt = {
        "state": "send_started",
        "transport": transport,
        "queue_job_id": queue_job_id or None,
        "user_message_id": message_id,
        "parent_message_id": payload.get("parent_message_id"),
        "conversation_id": args.conversation_id or None,
        "model": args.model,
        "thinking_effort": args.effort,
        "attached_context_files": attachments,
        "context_attachment_provider_requests": attachment_requests,
        "raw_path": str(raw_path),
        "started_at": time.time(),
    }
    atomic_json(receipt_path, receipt)

    recovery_events: list[dict] = []
    auth_refreshes = 0
    rate_retries = 0
    not_found_retries = 0
    prepare_server_retries = 0
    mutation_attempts = 0
    selected_raw = b""
    selected_raw_path: Path | None = None
    http_status: int | None = None
    provider_request_id = None
    summary: dict = {
        "provider_acceptance_observed": False,
        "assistant_end_turn": False,
        "terminal_assistant_text": "",
        "terminal_assistant_message_id": None,
        "conversation_id": args.conversation_id or None,
        "provider_errors": [],
    }
    state = "provider_rejected"
    ambiguous_replay_suppressed = False
    terminal_from_hydration: dict | None = None
    provider_retry_after_seconds = 0.0

    while True:
        # Prepare/sentinel calls do not submit the user message, so bounded retries are safe here.
        try:
            headers, prepared = prepare_payload(session, auth, payload, device_id=device_id)
        except ProviderHTTPError as exc:
            kind = _classify_http_status(exc.status, has_conversation=bool(args.conversation_id))
            event = {
                "phase": "prepare",
                "http_status": exc.status,
                "classification": kind,
            }
            if exc.status in (401, 403) and auth_refreshes < SAFE_AUTH_REFRESHES:
                auth_refreshes += 1
                session, auth, device_id = _refresh_auth_context(args, session, auth)
                event["action"] = "authentication_refreshed"
                recovery_events.append(event)
                continue
            if exc.status == 429 and rate_retries < SAFE_RATE_RETRIES:
                rate_retries += 1
                delay = _retry_after_seconds(exc.headers)
                event.update({"action": "retry_after", "delay_seconds": delay})
                recovery_events.append(event)
                time.sleep(delay)
                continue
            if (exc.status == 408 or 500 <= exc.status <= 599) and prepare_server_retries < SAFE_PREPARE_SERVER_RETRIES:
                prepare_server_retries += 1
                delay = (_retry_after_seconds(exc.headers) if any(
                    str(key).lower() == "retry-after" for key in exc.headers)
                    else min(float(prepare_server_retries), 2.0))
                event.update({"action": "retry_prepare", "delay_seconds": delay})
                recovery_events.append(event)
                time.sleep(delay)
                continue
            if exc.status == 404:
                if args.conversation_id:
                    conversation, session, auth, device_id, read_events, read_state = _hydrate_with_recovery(
                        args, session, auth, device_id, args.conversation_id, max_attempts=2
                    )
                    recovery_events.extend(read_events)
                    if read_state == "missing_conversation":
                        event["action"] = "confirmed_missing_conversation"
                        recovery_events.append(event)
                        state = "missing_conversation"
                        http_status = exc.status
                        selected_raw = exc.body_preview.encode("utf-8", "replace")
                        break
                    if conversation is not None and not_found_retries < SAFE_404_RETRIES:
                        not_found_retries += 1
                        event["action"] = "conversation_exists_retry_prepare"
                        recovery_events.append(event)
                        continue
                elif not_found_retries < SAFE_404_RETRIES:
                    not_found_retries += 1
                    event["action"] = "retry_prepare_not_found"
                    recovery_events.append(event)
                    continue
                recovery_events.append(event)
                state = "provider_rejected"
                http_status = exc.status
                selected_raw = exc.body_preview.encode("utf-8", "replace")
                break
            recovery_events.append(event)
            state = "authentication_failed" if exc.status in (401, 403) else (
                "rate_limited" if exc.status == 429 else kind
            )
            http_status = exc.status
            selected_raw = exc.body_preview.encode("utf-8", "replace")
            break
        except Exception as exc:
            # No conversation POST occurred; this prepare-path failure is safe to report without ambiguity.
            recovery_events.append({
                "phase": "prepare",
                "classification": "prepare_transport_failure",
                "error": f"{type(exc).__name__}: {str(exc)[:500]}",
            })
            state = "prepare_transport_failure"
            selected_raw = str(exc).encode("utf-8", "replace")
            break

        _record_post_boundary(fence, message_id, receipt_path, attachments)
        mutation_attempts += 1
        attempt_path = output_root / f"{result_id}.attempt-{mutation_attempts:02d}.sse"
        try:
            response = session.post(
                BASE + "f/conversation",
                headers=headers,
                json=prepared,
                stream=True,
                timeout=args.timeout,
            )
        except Exception as exc:
            # The client cannot prove whether bytes reached/committed at the provider. Never replay.
            ambiguous_replay_suppressed = True
            recovery_events.append({
                "phase": "conversation_post",
                "attempt": mutation_attempts,
                "classification": "ambiguous_acceptance",
                "action": "mutation_replay_suppressed",
                "error": f"{type(exc).__name__}: {str(exc)[:500]}",
            })
            state = "ambiguous_acceptance"
            conversation_id = args.conversation_id
            if conversation_id:
                reconciliation, session, auth, device_id = _reconcile_turn(
                    args,
                    session,
                    auth,
                    device_id,
                    conversation_id=conversation_id,
                    user_message_id=message_id,
                )
                recovery_events.extend(reconciliation.get("events") or [])
                state = reconciliation.get("state") or state
                if reconciliation.get("accepted"):
                    summary["provider_acceptance_observed"] = True
                    summary["conversation_id"] = conversation_id
                if reconciliation.get("terminal"):
                    terminal_from_hydration = reconciliation
                    summary.update({
                        "assistant_end_turn": True,
                        "terminal_assistant_text": reconciliation.get("assistant_text") or "",
                        "terminal_assistant_message_id": reconciliation.get("assistant_message_id"),
                    })
            break

        http_status = int(getattr(response, "status_code", 0) or 0)
        provider_request_id = (getattr(response, "headers", {}) or {}).get("x-request-id")
        if http_status >= 300:
            raw = _response_bytes(response)
            _persist_bytes(attempt_path, raw)
            _safe_close(response)
            selected_raw = raw
            selected_raw_path = attempt_path
            kind = _classify_http_status(http_status, has_conversation=bool(args.conversation_id))
            event = {
                "phase": "conversation_post",
                "attempt": mutation_attempts,
                "http_status": http_status,
                "classification": kind,
                "attempt_path": str(attempt_path),
            }
            if http_status in (401, 403) and auth_refreshes < SAFE_AUTH_REFRESHES:
                # Explicit auth rejection means the mutation was not accepted; replay after refresh is safe.
                auth_refreshes += 1
                session, auth, device_id = _refresh_auth_context(args, session, auth)
                event["action"] = "authentication_refreshed_then_safe_retry"
                recovery_events.append(event)
                continue
            if http_status == 429 and rate_retries < SAFE_RATE_RETRIES:
                # Explicit rate-limit rejection means the mutation was not accepted.
                rate_retries += 1
                delay = _retry_after_seconds(dict(getattr(response, "headers", {}) or {}))
                event.update({"action": "retry_after_then_safe_retry", "delay_seconds": delay})
                recovery_events.append(event)
                time.sleep(delay)
                continue
            if http_status == 404 or http_status == 408 or 500 <= http_status <= 599:
                # An intermediary can emit 404/408/5xx after upstream acceptance.
                # Even an existing conversation is insufficient proof that this
                # *turn* was rejected. Reconcile the exact user ID before any
                # future mutation; a negative read cannot authorize a replay.
                ambiguous_replay_suppressed = True
                event["action"] = "mutation_replay_suppressed_reconcile_only"
                if any(str(key).lower() == "retry-after" for key in (getattr(response, "headers", {}) or {})):
                    provider_retry_after_seconds = _retry_after_seconds(response.headers)
                    event["retry_after_seconds"] = provider_retry_after_seconds
                recovery_events.append(event)
                state = "ambiguous_acceptance"
                conversation_id = args.conversation_id or _extract_conversation_id(raw)
                if conversation_id and provider_retry_after_seconds <= 0:
                    reconciliation, session, auth, device_id = _reconcile_turn(
                        args,
                        session,
                        auth,
                        device_id,
                        conversation_id=conversation_id,
                        user_message_id=message_id,
                    )
                    recovery_events.extend(reconciliation.get("events") or [])
                    state = reconciliation.get("state") or state
                    if reconciliation.get("accepted"):
                        summary["provider_acceptance_observed"] = True
                        summary["conversation_id"] = conversation_id
                    if reconciliation.get("terminal"):
                        terminal_from_hydration = reconciliation
                        summary.update({
                            "assistant_end_turn": True,
                            "terminal_assistant_text": reconciliation.get("assistant_text") or "",
                            "terminal_assistant_message_id": reconciliation.get("assistant_message_id"),
                        })
                    elif http_status == 404 and reconciliation.get("state") == "missing_conversation":
                        state = "missing_conversation"
                break
            recovery_events.append(event)
            state = "authentication_failed" if http_status in (401, 403) else (
                "rate_limited" if http_status == 429 else "provider_rejected"
            )
            break

        raw, stream_error = _stream_response_durable(response, attempt_path)
        selected_raw = raw
        selected_raw_path = attempt_path
        summary = summarize_sse(raw, message_id)
        conversation_id = str(summary.get("conversation_id") or args.conversation_id or "").strip() or None
        if conversation_id:
            summary["conversation_id"] = conversation_id
        stream_failure = _provider_stream_failure(summary)

        if stream_error is not None or stream_failure is not None:
            # A 2xx response/partial stream proves the request crossed the mutation boundary. Read back only.
            ambiguous_replay_suppressed = True
            recovery_events.append({
                "phase": "conversation_stream",
                "attempt": mutation_attempts,
                "classification": stream_failure or _stream_exception_kind(stream_error),
                "action": "mutation_replay_suppressed_reconcile_only",
                "error": None if stream_error is None else f"{type(stream_error).__name__}: {str(stream_error)[:500]}",
                "attempt_path": str(attempt_path),
            })
            state = "ambiguous_acceptance"
            if conversation_id:
                reconciliation, session, auth, device_id = _reconcile_turn(
                    args,
                    session,
                    auth,
                    device_id,
                    conversation_id=conversation_id,
                    user_message_id=message_id,
                )
                recovery_events.extend(reconciliation.get("events") or [])
                state = reconciliation.get("state") or state
                if reconciliation.get("accepted"):
                    summary["provider_acceptance_observed"] = True
                if reconciliation.get("terminal"):
                    terminal_from_hydration = reconciliation
                    summary.update({
                        "assistant_end_turn": True,
                        "terminal_assistant_text": reconciliation.get("assistant_text") or "",
                        "terminal_assistant_message_id": reconciliation.get("assistant_message_id"),
                    })
            break

        if summary.get("provider_acceptance_observed"):
            state = "provider_accepted"
            # If SSE ended before terminal completion, recover the exact turn through read-only hydration.
            if conversation_id and not (summary.get("assistant_end_turn") and summary.get("terminal_assistant_text")):
                reconciliation, session, auth, device_id = _reconcile_turn(
                    args,
                    session,
                    auth,
                    device_id,
                    conversation_id=conversation_id,
                    user_message_id=message_id,
                )
                recovery_events.extend(reconciliation.get("events") or [])
                if reconciliation.get("accepted"):
                    state = reconciliation.get("state") or state
                if reconciliation.get("terminal"):
                    terminal_from_hydration = reconciliation
                    summary.update({
                        "assistant_end_turn": True,
                        "terminal_assistant_text": reconciliation.get("assistant_text") or "",
                        "terminal_assistant_message_id": reconciliation.get("assistant_message_id"),
                    })
            break

        # A 2xx mutation response without an acceptance marker is ambiguous; do not submit again.
        ambiguous_replay_suppressed = True
        recovery_events.append({
            "phase": "conversation_stream",
            "attempt": mutation_attempts,
            "classification": "ambiguous_acceptance",
            "action": "mutation_replay_suppressed",
            "attempt_path": str(attempt_path),
        })
        state = "ambiguous_acceptance"
        if conversation_id:
            reconciliation, session, auth, device_id = _reconcile_turn(
                args,
                session,
                auth,
                device_id,
                conversation_id=conversation_id,
                user_message_id=message_id,
            )
            recovery_events.extend(reconciliation.get("events") or [])
            state = reconciliation.get("state") or state
            if reconciliation.get("accepted"):
                summary["provider_acceptance_observed"] = True
            if reconciliation.get("terminal"):
                terminal_from_hydration = reconciliation
                summary.update({
                    "assistant_end_turn": True,
                    "terminal_assistant_text": reconciliation.get("assistant_text") or "",
                    "terminal_assistant_message_id": reconciliation.get("assistant_message_id"),
                })
        break

    if selected_raw_path is not None and selected_raw_path.exists():
        shutil.copyfile(selected_raw_path, raw_path)
    elif not raw_path.exists():
        _persist_bytes(raw_path, selected_raw)

    # Preserve current acceptance semantics, while enriching accepted turns from canonical hydration.
    if terminal_from_hydration is not None:
        summary["hydrated_branch_reconciled"] = True
    elif summary.get("provider_acceptance_observed"):
        summary.setdefault("hydrated_branch_reconciled", False)

    downloaded_files: list[dict] = []
    artifact_download_error = None
    conversation_id = str(summary.get("conversation_id") or args.conversation_id or "").strip()
    assistant_message_id = str(summary.get("terminal_assistant_message_id") or "").strip()
    terminal_text = str(summary.get("terminal_assistant_text") or "")
    if summary.get("provider_acceptance_observed") and conversation_id and assistant_message_id and terminal_text:
        try:
            artifact_dir.mkdir(parents=True, exist_ok=True)
            downloaded_files = download_interpreter_artifacts(
                session,
                auth,
                conversation_id=conversation_id,
                assistant_message_id=assistant_message_id,
                assistant_text=terminal_text,
                output_dir=artifact_dir,
                device_id=device_id,
            )
        except CapabilityError as exc:
            artifact_download_error = {"code": exc.code, "error": str(exc)}
        except Exception as exc:
            artifact_download_error = {"code": "artifact_download_failed", "error": f"{type(exc).__name__}: {str(exc)[:500]}"}
    summary["downloaded_files"] = downloaded_files

    accepted = bool(summary.get("provider_acceptance_observed"))
    if accepted and state in {"ambiguous_acceptance", "provider_accepted_recovered"}:
        state = "provider_accepted_recovered" if summary.get("assistant_end_turn") else "provider_accepted_unfinished"
    result = {
        **receipt,
        "transport": "codex_portable_auth_http" if auth.get("source") == "codex_portable_auth" else
                     "codex_desktop_auth_http" if auth.get("source") == "codex_desktop_auth" else "host_chrome_state_http",
        "conversation_id": conversation_id or None,
        "ok": accepted,
        "state": state,
        "http_status": http_status,
        "provider_request_id": provider_request_id,
        "retry_after_seconds": provider_retry_after_seconds,
        "completed_at": time.time(),
        "raw_path_host": str(raw_path),
        "receipt_path_host": str(receipt_path),
        "record_path_host": str(record_path),
        "raw_bytes": len(selected_raw),
        "raw_sha256": hashlib.sha256(selected_raw).hexdigest(),
        "provider_summary": summary,
        "provider_acceptance_observed": accepted,
        "assistant_terminal": bool(summary.get("assistant_end_turn")),
        "terminal_assistant_text": terminal_text,
        "terminal_assistant_message_id": summary.get("terminal_assistant_message_id"),
        "provider_model_receipt": (terminal_from_hydration or {}).get("provider_model_receipt"),
        "hydrated_branch_reconciled": bool(summary.get("hydrated_branch_reconciled")),
        "hydration_error": None,
        "downloaded_files": downloaded_files,
        "artifact_download_error": artifact_download_error,
        "recovery": {
            "bounded": True,
            "mutation_attempts": mutation_attempts,
            "authentication_refreshes": auth_refreshes,
            "rate_limit_retries": rate_retries,
            "not_found_retries": not_found_retries,
            "prepare_server_retries": prepare_server_retries,
            "ambiguous_replay_suppressed": ambiguous_replay_suppressed,
            "events": recovery_events,
        },
    }
    central_ingest = None
    if result["ok"] and result["assistant_terminal"] and result["terminal_assistant_text"]:
        try:
            central_ingest = admit_central_conversation(
                result_id=result_id,
                prompt=prompt,
                result=result,
                attachments=attachments,
            )
        except CapabilityError as exc:
            central_ingest = {"ok": False, "code": exc.code, "error": str(exc)}
    result["central_conversation_store"] = central_ingest
    if not result["ok"] or (http_status is not None and http_status >= 300):
        result["error_preview"] = selected_raw.decode("utf-8", "replace")[:1000]
    receipt_path.write_text(json.dumps(result, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    record = {
        "schema": "cognilode.b4pt0r_chatmode_result.v1",
        "capability": "B4PT0R Chat-mode Prompt Dispatch",
        "record_id": result_id,
        "created_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "prompt_sha256": hashlib.sha256(prompt.encode("utf-8")).hexdigest(),
        "prompt": prompt,
        "result": result,
        "semantic_acceptance_pending": result["ok"],
    }
    if result["ok"] and result["assistant_terminal"] and result["terminal_assistant_text"]:
        record["semantic_acceptance_pending"] = False
        record["admitted_terminal_response"] = True
    taskflow_path = TASKFLOW_DIR / f"{result_id}.json"
    memory_path = MEMORY_QUEUE_DIR / f"{result_id}.json"
    result["taskflow_record_path"] = str(taskflow_path)
    result["memory_queue_record_path"] = str(memory_path)
    record["result"] = result
    for target in (taskflow_path, memory_path):
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(json.dumps(record, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    record_path.write_text(json.dumps(record, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    try:
        session.close()
    except Exception:
        pass
    return result


def admit_record(args: argparse.Namespace) -> dict:
    record_path = Path(args.record).expanduser().resolve(strict=True)
    record = json.loads(record_path.read_text(encoding="utf-8"))
    result = record.get("result") if isinstance(record.get("result"), dict) else {}
    prompt = str(record.get("prompt") or "")
    attachments = result.get("attached_context_files") if isinstance(result.get("attached_context_files"), list) else []
    if not prompt:
        raise CapabilityError("record_prompt_missing", f"record has no prompt: {record_path}")
    if not result.get("terminal_assistant_text"):
        raise CapabilityError("record_terminal_response_missing", f"record has no terminal assistant text: {record_path}")
    central_ingest = admit_central_conversation(
        result_id=str(record.get("record_id") or record_path.stem),
        prompt=prompt,
        result=result,
        attachments=attachments,
    )
    result["central_conversation_store"] = central_ingest
    record["result"] = result
    if result.get("ok") and result.get("assistant_terminal") and result.get("terminal_assistant_text"):
        record["semantic_acceptance_pending"] = False
        record["admitted_terminal_response"] = True
    record_path.write_text(json.dumps(record, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    for key in ("receipt_path_host", "taskflow_record_path", "memory_queue_record_path"):
        target_value = result.get(key)
        if not target_value:
            continue
        target = Path(str(target_value)).expanduser()
        if target.exists():
            target.write_text(json.dumps(record if key != "receipt_path_host" else result, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    return {
        "ok": central_ingest.get("ok") is True,
        "record_path_host": str(record_path),
        "central_conversation_store": central_ingest,
    }


def reconcile_queue_job(args: argparse.Namespace) -> dict:
    """Recover an ambiguous queued send by exact user ID, without another send."""
    queue_job_id = str(args.queue_job_id or "").strip()
    if not queue_job_id:
        raise CapabilityError("queue_job_id_missing", "reconcile requires --queue-job-id")
    prompt = Path(args.prompt_file).read_text(encoding="utf-8") if args.prompt_file else ""
    if not prompt.strip():
        raise CapabilityError("prompt_missing", "reconcile requires the original queue prompt")
    output_root = Path(args.output_dir).expanduser() if args.output_dir else DEFAULT_OUTPUT_ROOT
    output_root.mkdir(parents=True, exist_ok=True)
    result_id = "b4pt0r-chatmode-job-" + hashlib.sha256(queue_job_id.encode()).hexdigest()[:24]
    receipt_path = output_root / f"{result_id}.sse.receipt.json"
    record_path = output_root / f"{result_id}.json"
    old_receipt = json.loads(receipt_path.read_text(encoding="utf-8")) if receipt_path.is_file() else {}
    old_record = json.loads(record_path.read_text(encoding="utf-8")) if record_path.is_file() else {}
    expected_user_id = str(uuid.uuid5(uuid.NAMESPACE_URL, "cognilode-chatmode-queue:" + queue_job_id))
    for value in (old_receipt, old_record.get("result") or {}):
        if value.get("queue_job_id") not in (None, queue_job_id) or value.get("user_message_id") not in (None, expected_user_id):
            raise CapabilityError("recovery_identity_mismatch", "local receipt belongs to another queued send")
    if old_record.get("prompt") not in (None, prompt):
        raise CapabilityError("recovery_prompt_mismatch", "local record prompt differs from queue prompt")
    if args.auth_source == "codex":
        session, auth, device_id = codex_identity()
        transport = "codex_portable_auth_http" if auth.get("source") == "codex_portable_auth" else "codex_desktop_auth_http"
    else:
        session = new_session(Path(args.chrome_profile).expanduser(), args.impersonate)
        auth = identity(session)
        device_id = device_id_from_cookies(session)
        transport = "host_chrome_state_http"
    try:
        previous = old_record.get("result") if isinstance(old_record.get("result"), dict) else old_receipt
        known = str(previous.get("conversation_id") or old_receipt.get("conversation_id") or "")
        if getattr(args, "known_only", False) and not known:
            return {"ok": False, "state": "recent_index_deferred", "queue_job_id": queue_job_id,
                    "user_message_id": expected_user_id, "retry_after_seconds": 60,
                    "next_offset": args.scan_offset,
                    "recovery": {"ambiguous_replay_suppressed": True, "events": []}}
        found, session, auth, device_id = discover_recent_turn(
            args, session, auth, device_id, user_message_id=expected_user_id,
            known_conversation_id=known, offset=args.scan_offset, limit=args.max_candidates,
        )
        if known and not getattr(args, "known_only", False) and not found.get("accepted") and found.get("state") not in {"rate_limited", "read_transient"}:
            fallback, session, auth, device_id = discover_recent_turn(
                args, session, auth, device_id, user_message_id=expected_user_id,
                offset=args.scan_offset, limit=args.max_candidates,
            )
            fallback["events"] = list(found.get("events") or []) + list(fallback.get("events") or [])
            found = fallback
        if not found.get("accepted"):
            return {"ok": False, "state": found["state"], "queue_job_id": queue_job_id,
                    "user_message_id": expected_user_id,
                    "retry_after_seconds": found.get("retry_after_seconds", 300),
                    "next_offset": found.get("next_offset", args.scan_offset),
                    "recovery": {"ambiguous_replay_suppressed": True,
                                 "method": "exact_user_message_recent_get", "events": found.get("events") or []}}
        result = dict(previous)
        conversation_id = str(found["conversation_id"])
        terminal = bool(found.get("terminal"))
        result.update({
            "queue_job_id": queue_job_id, "user_message_id": expected_user_id,
            "transport": transport, "conversation_id": conversation_id,
            "provider_acceptance_observed": True, "ok": True,
            "state": "provider_accepted_recovered" if terminal else "provider_accepted_unfinished",
            "assistant_terminal": terminal,
            "terminal_assistant_text": found.get("assistant_text") or "",
            "terminal_assistant_message_id": found.get("assistant_message_id"),
            "provider_model_receipt": found.get("provider_model_receipt") or result.get("provider_model_receipt"),
            "completed_at": time.time(),
            "recovery": {"ambiguous_replay_suppressed": True,
                         "method": "exact_user_message_recent_get", "events": found.get("events") or []},
        })
        result["provider_summary"] = {
            **dict(result.get("provider_summary") or {}),
            "provider_acceptance_observed": True, "conversation_id": conversation_id,
            "assistant_end_turn": terminal,
            "terminal_assistant_text": result["terminal_assistant_text"],
            "terminal_assistant_message_id": result["terminal_assistant_message_id"],
        }
        attachments = result.get("attached_context_files") if isinstance(result.get("attached_context_files"), list) else []
        if terminal and result["terminal_assistant_text"] and result["terminal_assistant_message_id"]:
            try:
                artifact_dir = output_root / f"{result_id}.files"
                artifact_dir.mkdir(parents=True, exist_ok=True)
                result["downloaded_files"] = download_interpreter_artifacts(
                    session, auth, conversation_id=conversation_id,
                    assistant_message_id=str(result["terminal_assistant_message_id"]),
                    assistant_text=result["terminal_assistant_text"],
                    output_dir=artifact_dir, device_id=device_id,
                )
            except Exception as exc:
                result["artifact_download_error"] = f"{type(exc).__name__}: {str(exc)[:400]}"
            try:
                result["central_conversation_store"] = admit_central_conversation(
                    result_id=result_id, prompt=prompt, result=result, attachments=attachments)
            except Exception as exc:
                result["central_conversation_store"] = {"ok": False,
                    "error": f"{type(exc).__name__}: {str(exc)[:400]}"}
        record = dict(old_record)
        record.update({"schema": "cognilode.b4pt0r_chatmode_result.v1",
                       "record_id": result_id, "prompt": prompt,
                       "prompt_sha256": hashlib.sha256(prompt.encode()).hexdigest(),
                       "result": result,
                       "semantic_acceptance_pending": not bool(result.get("assistant_terminal"))})
        if result.get("assistant_terminal") and (result.get("central_conversation_store") or {}).get("central_readback_verified"):
            record["admitted_terminal_response"] = True
        atomic_json(receipt_path, result)
        atomic_json(record_path, record)
        for directory in (TASKFLOW_DIR, MEMORY_QUEUE_DIR):
            directory.mkdir(parents=True, exist_ok=True)
            atomic_json(directory / f"{result_id}.json", record)
        return result
    finally:
        try:
            session.close()
        except Exception:
            pass


def main(argv: list[str] | None = None) -> int:
    ensure_runtime()
    parser = argparse.ArgumentParser(prog="cognilode-b4pt0r-chatmode")
    parser.add_argument("--auth-source", choices=("codex", "chrome"), default="codex")
    parser.add_argument("--chrome-profile", default=str(DEFAULT_PROFILE))
    parser.add_argument("--impersonate", default=DEFAULT_IMPERSONATE)
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("health")
    p = sub.add_parser("send")
    p.add_argument("--prompt")
    p.add_argument("--prompt-file")
    p.add_argument("--conversation-id")
    p.add_argument("--parent-message-id")
    p.add_argument("--model", default="gpt-5-6-thinking")
    p.add_argument("--effort", default="high", choices=("medium", "high", "xhigh"))
    p.add_argument("--output-dir")
    p.add_argument("--connector-id", action="append", default=[])
    p.add_argument("--attach", action="append", default=[])
    p.add_argument("--queue-job-id", default="")
    p.add_argument("--timeout", type=int, default=900)
    admit = sub.add_parser("admit-record")
    admit.add_argument("--record", required=True)
    reconcile = sub.add_parser("reconcile")
    reconcile.add_argument("--queue-job-id", required=True)
    reconcile.add_argument("--prompt-file", required=True)
    reconcile.add_argument("--output-dir")
    reconcile.add_argument("--scan-offset", type=int, default=0)
    reconcile.add_argument("--max-candidates", type=int, default=12)
    reconcile.add_argument("--known-only", action="store_true",
                           help="hydrate a known conversation ID without reading the recent index")
    args = parser.parse_args(argv)
    try:
        if args.command == "health":
            value = health(args)
        elif args.command == "admit-record":
            value = admit_record(args)
        elif args.command == "reconcile":
            value = reconcile_queue_job(args)
        else:
            value = send(args)
        print(json.dumps(value, ensure_ascii=False, sort_keys=True))
        return 0 if value.get("ok") else 2
    except CapabilityError as exc:
        print(json.dumps({"ok": False, "state": exc.code, "error": str(exc),
                          "http_status": getattr(exc, "http_status", None),
                          "retry_after_seconds": getattr(exc, "retry_after_seconds", 0)}, sort_keys=True), file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
