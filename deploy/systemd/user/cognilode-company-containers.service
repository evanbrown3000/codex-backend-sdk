[Unit]
Description=Start company Docker containers and retire host company workers
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=%h/Projects/codex-backend-sdk/scripts/cognilode-company-container-bootstrap
TimeoutStartSec=0
TimeoutStopSec=30s
WatchdogSec=7min
Restart=always
RestartSec=30s

[Install]
WantedBy=default.target
