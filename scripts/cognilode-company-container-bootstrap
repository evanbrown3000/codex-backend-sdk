#!/usr/bin/env bash
set -euo pipefail

# This is the single permitted EvanPC host service: it only reconciles Docker
# containers from the current centrally converged compose definition.  Company
# operational code continues to run inside those containers.
source_root="${COMPANY_SOURCE_ROOT:-$HOME/.local/share/cognilode/company-runtime/shared/source}"
project="${COGNILODE_COMPOSE_PROJECT:-cognilode-company-runtime}"
interval="${COGNILODE_ENVIRONMENT_SYNC_SECONDS:-300}"

while true; do
  compose="$source_root/current/codex-backend-sdk/deploy/compose/company-chatmode.yml"
  if [[ -f "$compose" ]]; then
    mapfile -t services < <(docker compose -p "$project" -f "$compose" ps --services 2>/dev/null || true)
    if ((${#services[@]})); then
      docker compose -p "$project" -f "$compose" up -d --no-deps "${services[@]}"
    fi
  fi
  sleep "$interval"
done
