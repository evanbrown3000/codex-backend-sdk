#!/usr/bin/env python3
"""Run an SDK service from the synchronized source generation.

Mutating services opt into a local drain socket. A generation change stops new
mutations, waits for active ones to finish, then starts the next source. The
source-sync service itself remains the bootstrap source and does not use this.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import signal
import socket
import subprocess
import sys
import time


STOP = False


def content_generation(current: Path) -> tuple[Path, str] | None:
    """Identify the executable closure rather than the checkout directory."""
    selected = current.resolve()
    if not selected.is_file():
        return None
    digest = hashlib.sha256()
    sources = [selected]
    package = selected.parent.parent / "codex_backend_sdk"
    # Provider transport imports the synchronized SDK package into its
    # credential runtime.  The HTTP gate is self-contained; coupling it to all
    # SDK module changes would create needless admission-socket outages.
    if selected.name == "cognilode-provider-transport" and package.is_dir():
        sources.extend(sorted(package.rglob("*.py")))
    for source in sources:
        digest.update(str(source.relative_to(selected.parent.parent)).encode())
        digest.update(source.read_bytes())
    return selected, digest.hexdigest()


def request_stop(_signum, _frame):
    global STOP
    STOP = True


def drain(socket_path: Path) -> int | None:
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as channel:
            channel.settimeout(5)
            channel.connect(str(socket_path))
            channel.sendall(b'{"operation":"drain"}\n')
            data = bytearray()
            while b'\n' not in data and len(data) < 4096:
                piece = channel.recv(4096)
                if not piece:
                    break
                data.extend(piece)
        reply = json.loads(data.split(b'\n', 1)[0])
        if reply.get("draining") is True and type(reply.get("active")) is int:
            return max(0, reply["active"])
    except (OSError, ValueError, IndexError, TypeError):
        pass
    return None


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--script", required=True)
    parser.add_argument("--drain-socket", type=Path, required=True)
    parser.add_argument("--no-drain", action="store_true",
                        help="restart a non-mutating local service on source change")
    parser.add_argument("args", nargs=argparse.REMAINDER)
    options = parser.parse_args()
    if "/" in options.script or options.script.startswith("."):
        parser.error("script must be an SDK script basename")
    child_args = options.args[1:] if options.args[:1] == ["--"] else options.args
    root = Path(os.environ.get("COGNILODE_COMPANY_SOURCE_ROOT", "/runtime/source"))
    current = root / "current/codex-backend-sdk/scripts" / options.script
    signal.signal(signal.SIGTERM, request_stop)
    signal.signal(signal.SIGINT, request_stop)
    while not STOP:
        generation = content_generation(current)
        if generation is None:
            print("SDK source generation pending", flush=True)
            time.sleep(5)
            continue
        selected, signature = generation
        print(f"SDK service {options.script} source generation {selected}", flush=True)
        child = subprocess.Popen([sys.executable, str(selected), *child_args], env=os.environ.copy())
        while child.poll() is None and not STOP:
            active_generation = content_generation(current)
            if active_generation is None or active_generation[1] != signature:
                break
            time.sleep(2)
        if child.poll() is None:
            last_report = 0.0
            while child.poll() is None:
                if options.no_drain:
                    break
                active = drain(options.drain_socket)
                if active == 0:
                    break
                if time.monotonic() - last_report >= 60:
                    print(f"SDK service {options.script} generation held: "
                          f"{'drain unavailable' if active is None else str(active) + ' active sends'}",
                          flush=True)
                    last_report = time.monotonic()
                time.sleep(2)
            if child.poll() is None:
                child.terminate()
                try:
                    child.wait(timeout=30)
                except subprocess.TimeoutExpired:
                    # The drain contract has already barred new sends and
                    # reported zero active sends. Do not leave stale custody.
                    child.kill()
                    child.wait()
        if not STOP:
            time.sleep(2)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
