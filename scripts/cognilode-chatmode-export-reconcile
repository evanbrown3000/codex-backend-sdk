#!/usr/bin/env python3
"""Bind legacy held Chat-mode jobs to a bulk privacy export, without a POST.

Reads only ZIP directory and nearby dated JSON shards via authenticated ranges.
An exact, unique prompt SHA on the export's current branch, close to the D1
enqueue time, supplies the original user-message ID.  The normal collector
then independently reads that exact provider branch before D1 completion.
No private export URL, cookie, prompt body, or extra transcript corpus is logged.
"""
from __future__ import annotations

import argparse
from datetime import datetime, timezone
from hashlib import sha256
from importlib.machinery import SourceFileLoader
import json
from pathlib import Path
import re
import sys
import zipfile

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
from chatmode_export_range import AuthenticatedRangeFile

sender = SourceFileLoader("chatmode_sender_export", str(HERE / "cognilode-b4pt0r-chatmode")).load_module()
worker = SourceFileLoader("chatmode_worker_export", str(HERE / "cognilode-chatmode-queue-worker")).load_module()
SHARD = re.compile(r"^conversations-(\d{3})\.json$")
MAX_SHARD_BYTES = 600 * 1024 * 1024
MAX_MESSAGE_DELAY = 24 * 3600


def timestamp(value) -> float:
    if isinstance(value, (float, int)):
        return float(value)
    return datetime.fromisoformat(str(value).replace("Z", "+00:00")).timestamp()


def pending_legacy_jobs() -> list[dict]:
    response = sender.operator_memory_post({"operation": "list_jobs", "provider": "chatgpt.com",
                                            "state": "effect_pending", "limit": 100})
    jobs = response.get("jobs") or []
    if response.get("next_cursor"):
        raise RuntimeError("legacy scan exceeds one D1 page")
    return [j for j in jobs if j.get("migrated_from") == "cloudflare-kv-agent-memory-prompt-job"
            and j.get("migration_hold_reason") == "legacy_job_may_have_started_provider_effect"
            and j.get("prompt_sha256") == sha256(str(j.get("prompt") or "").encode()).hexdigest()]


def current_branch_matches(conversation: dict, jobs_by_sha: dict[str, list[dict]], member: str,
                           crc32: int) -> list[dict]:
    branch = sender.branch_messages(conversation)
    results = []
    for index, message in enumerate(branch):
        if (message.get("author") or {}).get("role") != "user":
            continue
        text = sender.message_text(message)
        digest = sha256(text.encode()).hexdigest()
        for job in jobs_by_sha.get(digest, []):
            when = timestamp(message.get("create_time") or 0)
            if not timestamp(job["created_at"]) <= when <= timestamp(job["created_at"]) + MAX_MESSAGE_DELAY:
                continue
            # The exported turn must itself have a final assistant descendant.
            terminal = next((m for m in reversed(branch[index + 1:])
                             if (m.get("author") or {}).get("role") == "assistant"
                             and sender.message_text(m)), None)
            if terminal is None:
                continue
            results.append({"job_id": job["id"], "conversation_id": conversation.get("id"),
                            "user_message_id": message.get("id"), "prompt_sha256": digest,
                            "user_created_at": when, "export_member": member,
                            "export_member_crc32": f"{crc32:08x}"})
    return results


def scan(archive: zipfile.ZipFile, jobs: list[dict]) -> tuple[dict[str, list[dict]], list[str]]:
    names = sorted((int(m.group(1)), info) for info in archive.infolist()
                   if (m := SHARD.fullmatch(info.filename)))
    if not names or [n for n, _ in names] != list(range(len(names))):
        raise RuntimeError("privacy export has noncontiguous conversation shards")
    earliest = min(timestamp(j["created_at"]) for j in jobs)
    by_sha: dict[str, list[dict]] = {}
    for j in jobs:
        by_sha.setdefault(j["prompt_sha256"], []).append(j)
    found: dict[str, list[dict]] = {j["id"]: [] for j in jobs}
    scanned: list[str] = []
    for _, info in reversed(names):
        if info.file_size > MAX_SHARD_BYTES:
            raise RuntimeError("export conversation shard exceeds memory bound")
        conversations = json.loads(archive.read(info))  # ZipFile verifies member CRC.
        if not isinstance(conversations, list):
            raise RuntimeError("export shard is not a conversation list")
        scanned.append(info.filename)
        dates = []
        for conversation in conversations:
            if not isinstance(conversation, dict):
                continue
            dates.append(timestamp(conversation.get("create_time") or 0))
            for match in current_branch_matches(conversation, by_sha, info.filename, info.CRC):
                found[match["job_id"]].append(match)
        # Shards 0..N-2 are ordered by creation time. N-1 may contain
        # leftovers, so only stop after inspecting an earlier ordinary shard.
        if info.filename != names[-1][1].filename and dates and max(dates) < earliest - MAX_MESSAGE_DELAY:
            break
    return found, scanned


def bind_and_collect(job: dict, match: dict, source: AuthenticatedRangeFile) -> dict:
    if not re.fullmatch(r"[0-9a-f-]{36}", str(match["conversation_id"])):
        raise RuntimeError("export match lacks provider conversation ID")
    receipt = sender.DEFAULT_OUTPUT_ROOT / (worker.job_stem(job["id"]) + ".sse.receipt.json")
    if receipt.is_file():
        current = json.loads(receipt.read_text(encoding="utf-8"))
        if (current.get("conversation_id"), current.get("user_message_id")) != (
                match["conversation_id"], match["user_message_id"]):
            raise RuntimeError("existing provider send receipt has different identity")
    else:
        worker.atomic_json(receipt, {"state": "provider_accepted", "queue_job_id": job["id"],
            "identity_source": "privacy_export_exact_prompt_message",
            "conversation_id": match["conversation_id"],
            "user_message_id": match["user_message_id"],
            "prompt_sha256": job["prompt_sha256"],
            "user_created_at": datetime.fromtimestamp(match["user_created_at"], timezone.utc).isoformat(),
            "export_member": match["export_member"],
            "export_member_crc32": match["export_member_crc32"],
            "export_etag": source.etag, "export_bytes": source.size,
            "transport": "host_chrome_state_http", "attached_context_files": []})
    worker.recover(job)
    committed = sender.operator_memory_post({"operation": "get_job", "job_id": job["id"]}).get("job") or {}
    return {"job_id": job["id"], "conversation_id": match["conversation_id"],
            "state": committed.get("state"), "exact_provider_readback":
            bool(worker.result_for_job(job["id"]) and
                 (worker.result_for_job(job["id"]).get("central_conversation_store") or {})
                 .get("central_readback_verified"))}


def main() -> int:
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--url-file", required=True, type=Path)
    p.add_argument("--dry-run", action="store_true")
    args = p.parse_args()
    if args.url_file.stat().st_mode & 0o077:
        raise RuntimeError("signed export URL file must be private (0600)")
    url = args.url_file.read_text(encoding="utf-8").strip()
    if not url.startswith("https://chatgpt.com/backend-api/estuary/content?"):
        raise RuntimeError("unexpected export URL origin or path")
    jobs = pending_legacy_jobs()
    if not jobs:
        print(json.dumps({"pending_legacy": 0, "matched": 0}))
        return 0
    session = sender.new_session(sender.DEFAULT_PROFILE, sender.DEFAULT_IMPERSONATE)
    source = AuthenticatedRangeFile(session, url)
    with zipfile.ZipFile(source) as archive:
        matches, shards = scan(archive, jobs)
    outcomes = []
    for job in jobs:
        candidates = matches[job["id"]]
        # A repeated prompt on more than one provider turn remains ambiguous.
        unique = {(m["conversation_id"], m["user_message_id"]): m for m in candidates}
        if len(unique) != 1:
            outcomes.append({"job_id": job["id"], "state": "no_exact_match" if not unique else "ambiguous_matches",
                             "match_count": len(unique)})
            continue
        match = next(iter(unique.values()))
        outcomes.append({"job_id": job["id"], "state": "exact_match_dry_run",
                         "conversation_id": match["conversation_id"]} if args.dry_run else
                        bind_and_collect(job, match, source))
    print(json.dumps({"pending_legacy": len(jobs), "shards_scanned": shards,
                      "export_bytes": source.size, "outcomes": outcomes}, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
