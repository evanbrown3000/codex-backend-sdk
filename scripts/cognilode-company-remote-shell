"""Container-only relay node for company source, Codex, and artifact operations."""
import hashlib, hmac, json, os, re, secrets, signal, socket, subprocess, threading, time, urllib.request
from pathlib import Path
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

custody_path=Path(os.environ.get('COGNILODE_RELAY_NODE_FILE','/relay/node.json'))
while not custody_path.is_file() or custody_path.stat().st_size == 0:
    print('company relay waiting for central node custody',flush=True)
    time.sleep(10)
with custody_path.open(encoding='utf-8') as source:
    CUSTODY=json.load(source)
BEARER=str(CUSTODY['mcp_bearer'])
NODE_ID=str(CUSTODY['node_id'])
NODE_TOKEN=str(CUSTODY['node_token'])
ENVIRONMENT_ID=os.environ.get('COGNILODE_ENVIRONMENT_ID',NODE_ID)
if not all((BEARER,NODE_ID,NODE_TOKEN)):
    raise RuntimeError('company relay custody is incomplete')
CENTRAL=str(CUSTODY.get('central_url') or 'https://cognilode.com').rstrip('/')
PORT=int(os.environ.get('COGNILODE_MCP_PORT','8899'))
WORKSPACE=os.environ.get('COGNILODE_WORKSPACE','/runtime/source/current')
HB_STATUS=os.environ.get('COGNILODE_HEARTBEAT_STATUS','')
MAX_OUTPUT=4*1024*1024
PROCESSES={}; LOCK=threading.RLock()
PROVIDER_ROOT=Path(os.environ.get('COGNILODE_PROVIDER_OPERATION_ROOT','/runtime/relay/provider-operations'))
PROVIDER_SOCKET=os.environ.get('COGNILODE_PROVIDER_SOCKET','/runtime/provider.sock')
PROVIDER_LIVE=set(); PROVIDER_LOCK=threading.RLock()
PROVIDER_ID=re.compile(r'^[0-9a-fA-F]{8}-[0-9a-fA-F-]{27,40}$')
ROLLOUT_SOCKET=os.environ.get('COGNILODE_ROLLOUT_SOCKET','/runtime/drive-rollouts/rollouts.sock')
STOCK_CLI=os.environ.get('COGNILODE_STOCK_CLI',
    '/runtime/source/current/memory-stock-canonical/deploy/conversation-vacuum/conversation_stock_api.py')
STOCK_DB=os.environ.get('COGNILODE_STOCK_DB',
    '/memory-stock/runtime/conversation-vacuum/intake.sqlite3')
AWS_BROKER_SOCKET=os.environ.get('COGNILODE_AWS_BROKER_SOCKET','/runtime/aws-broker/broker.sock')

def aws_session(payload):
    """Forward a bounded STS request to the isolated local credential broker."""
    purpose=str(payload.get('purpose') or '') if isinstance(payload,dict) else ''
    if purpose not in ('artifact-read','artifact-write','secrets-read','secrets-write'):
        raise ValueError('invalid AWS credential purpose')
    request=json.dumps({'purpose':purpose},separators=(',',':')).encode()
    with socket.socket(socket.AF_UNIX,socket.SOCK_STREAM) as connection:
        connection.settimeout(40)
        connection.connect(AWS_BROKER_SOCKET)
        connection.sendall(len(request).to_bytes(4,'big')+request)
        prefix=b''
        while len(prefix)<4:
            chunk=connection.recv(4-len(prefix))
            if not chunk: raise RuntimeError('incomplete AWS broker response')
            prefix+=chunk
        length=int.from_bytes(prefix,'big')
        if length<1 or length>32_768: raise RuntimeError('invalid AWS broker response')
        content=b''
        while len(content)<length:
            chunk=connection.recv(length-len(content))
            if not chunk: raise RuntimeError('incomplete AWS broker response')
            content+=chunk
    response=json.loads(content)
    if not isinstance(response,dict) or not response.get('ok'):
        raise RuntimeError('scoped AWS broker unavailable')
    return response

def drive_rollout(payload):
    """Forward only the restricted rollout operation to local credential custody."""
    request=json.dumps(payload,separators=(',',':')).encode()
    if len(request)>30_000_000: raise ValueError('rollout exceeds central size limit')
    with socket.socket(socket.AF_UNIX,socket.SOCK_STREAM) as connection:
        connection.settimeout(190)
        connection.connect(ROLLOUT_SOCKET)
        connection.sendall(len(request).to_bytes(4,'big')+request)
        prefix=b''
        while len(prefix)<4:
            chunk=connection.recv(4-len(prefix))
            if not chunk: raise RuntimeError('incomplete Drive custody response')
            prefix+=chunk
        length=int.from_bytes(prefix,'big')
        if length<1 or length>30_000_000: raise RuntimeError('invalid Drive custody response')
        chunks=[]
        while length:
            chunk=connection.recv(min(length,1048576))
            if not chunk: raise RuntimeError('incomplete Drive custody response')
            chunks.append(chunk); length-=len(chunk)
    response=json.loads(b''.join(chunks))
    if not isinstance(response,dict):
        raise RuntimeError('Drive custody response invalid')
    # A staged immutable object is a normal, durable pending state. Preserve
    # its typed hold for the central endpoint, which already knows how to
    # defer the reader without issuing another provider or Drive request.
    if response.get('state') in ('held','ambiguous'):
        return response
    if not response.get('ok'):
        raise RuntimeError('Drive custody operation unavailable')
    return response

def stock_conversation(payload):
    """Read indexed normalized stock locally; never poll a provider."""
    if not isinstance(payload,dict) or payload.get('action') not in ('search','list','read','context','status'):
        raise ValueError('invalid conversation stock operation')
    if len(str(payload.get('selector') or ''))>200 or len(str(payload.get('query') or ''))>1000:
        raise ValueError('conversation stock selector or query too long')
    request=json.dumps(payload,separators=(',',':')).encode()
    if len(request)>16_384: raise ValueError('conversation stock request too large')
    result=subprocess.run(['python3',STOCK_CLI],input=request,capture_output=True,
        env={**os.environ,'COGNILODE_STOCK_DB':STOCK_DB},timeout=40,check=False)
    if result.returncode or len(result.stdout)>28_000_000:
        raise RuntimeError('conversation stock read unavailable')
    response=json.loads(result.stdout)
    if response.get('schema')!='cognilode.conversation-stock.v1' or response.get('error'):
        raise RuntimeError('conversation stock response unavailable')
    return {'ok':True,**response}

def provider_file(operation_id):
    if not PROVIDER_ID.fullmatch(str(operation_id)): raise ValueError('invalid provider operation id')
    return PROVIDER_ROOT/(operation_id+'.json')

def provider_write(path, value):
    PROVIDER_ROOT.mkdir(parents=True,exist_ok=True)
    temporary=path.with_name(path.name+'.'+secrets.token_hex(8)+'.tmp')
    with os.fdopen(os.open(temporary,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600),'w') as stream:
        json.dump(value,stream,separators=(',',':'))
        stream.flush(); os.fsync(stream.fileno())
    os.replace(temporary,path)

def provider_run(operation_id,args,send_fence,fingerprint):
    path=provider_file(operation_id)
    try:
        with socket.socket(socket.AF_UNIX,socket.SOCK_STREAM) as channel:
            channel.settimeout(2000)
            channel.connect(PROVIDER_SOCKET)
            channel.sendall((json.dumps({'operation':'transport','args':args,
                'send_fence':send_fence},separators=(',',':'))+'\n').encode())
            result=bytearray()
            while b'\n' not in result and len(result)<4*1024*1024:
                piece=channel.recv(65536)
                if not piece: break
                result.extend(piece)
        if b'\n' not in result: raise RuntimeError('provider socket response incomplete')
        value=json.loads(result.split(b'\n',1)[0]);
        if not isinstance(value,dict): raise RuntimeError('provider socket result invalid')
        provider_write(path,{'state':'done','operation_id':operation_id,'args_sha256':fingerprint,
            'result':value,'at':time.time()})
    except Exception as error:
        provider_write(path,{'state':'ambiguous','operation_id':operation_id,'args_sha256':fingerprint,
            'error':type(error).__name__,'at':time.time()})
    finally:
        with PROVIDER_LOCK: PROVIDER_LIVE.discard(operation_id)

def provider_operation(payload):
    operation=str(payload.get('operation') or '')
    operation_id=str(payload.get('operation_id') or '')
    path=provider_file(operation_id)
    with PROVIDER_LOCK:
        if path.is_file():
            value=json.loads(path.read_text())
            if operation=='start':
                requested=hashlib.sha256(json.dumps(payload.get('args'),separators=(',',':')).encode()).hexdigest()
                if value.get('args_sha256')!=requested:
                    return {'ok':False,'state':'conflict','operation_id':operation_id,
                        'error':'provider_operation_id_reused_with_different_arguments'}
            if value.get('state')=='started' and operation_id not in PROVIDER_LIVE:
                return {'ok':False,'state':'ambiguous','operation_id':operation_id,
                    'retry_start':False,'error':'credential_container_restarted_after_start'}
            return {'ok':True,**value}
        if operation!='start': return {'ok':False,'state':'missing','operation_id':operation_id}
        args=payload.get('args'); fence=payload.get('send_fence')
        if not isinstance(args,list) or len(args)<3 or len(args)>150 or any(not isinstance(x,str) or len(x)>4096 for x in args):
            raise ValueError('invalid provider arguments')
        if args[0]!='--auth-source' or args[1] not in ('codex','chrome') or args[2] not in ('send','reconcile','health'):
            raise ValueError('unsupported credential-bearing operation')
        if args[2]=='send' and (not isinstance(fence,dict) or
            not all(fence.get(key) for key in ('job_id','worker_id','lease_token','lease_generation','device_id'))):
            raise ValueError('queue effect fence required')
        fingerprint=hashlib.sha256(json.dumps(args,separators=(',',':')).encode()).hexdigest()
        provider_write(path,{'state':'started','operation_id':operation_id,
            'args_sha256':fingerprint,'at':time.time()})
        PROVIDER_LIVE.add(operation_id)
        threading.Thread(target=provider_run,args=(operation_id,args,fence,fingerprint),daemon=True).start()
        return {'ok':True,'state':'started','operation_id':operation_id}

def write_hb(ok, **extra):
    if not HB_STATUS: return
    obj={'ok':bool(ok),'node_id':NODE_ID,'time':time.time(),**extra}
    try:
        os.makedirs(os.path.dirname(HB_STATUS),exist_ok=True)
        tmp=HB_STATUS+'.tmp'
        with open(tmp,'w') as f: json.dump(obj,f,separators=(',',':'))
        os.replace(tmp,HB_STATUS)
    except Exception: pass

class Proc:
    def __init__(self, argv, cwd=None, pipe_stdin=False):
        if not isinstance(argv,list) or not argv or not all(isinstance(x,str) for x in argv): raise ValueError('argv must be a non-empty string array')
        self.id='company-'+secrets.token_hex(12); self.events=[]; self.seq=0; self.lock=threading.RLock()
        self.proc=subprocess.Popen(argv,cwd=cwd or WORKSPACE,stdin=subprocess.PIPE if pipe_stdin else subprocess.DEVNULL,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,start_new_session=True,bufsize=0)
        threading.Thread(target=self._collect,daemon=True).start()
    def _collect(self):
        while True:
            b=self.proc.stdout.read(4096)
            if not b: break
            with self.lock:
                self.seq+=1; self.events.append((self.seq,b))
                total=sum(len(x[1]) for x in self.events)
                while total>MAX_OUTPUT and self.events:
                    total-=len(self.events[0][1]); self.events.pop(0)
        self.proc.wait()
    def read(self,after=0,max_bytes=262144,wait_ms=0):
        deadline=time.monotonic()+min(max(wait_ms,0),9000)/1000
        while time.monotonic()<deadline:
            with self.lock:
                if self.seq>after or self.proc.poll() is not None: break
            time.sleep(.05)
        with self.lock:
            chunks=[(n,b) for n,b in self.events if n>after]; out=[]; size=0
            for n,b in chunks:
                room=max_bytes-size
                if room<=0: break
                out.append((n,b[:room])); size+=len(out[-1][1])
                if len(b)>room: break
            last=out[-1][0] if out else after
            return {'output':b''.join(b for _,b in out).decode('utf-8','replace'),'next_seq':last,'truncated':bool(chunks and (not out or last!=chunks[-1][0] or size>=max_bytes)),'exited':self.proc.poll() is not None,'closed':self.proc.poll() is not None,'exit_code':self.proc.poll(),'failure':None}

def tool(name,a):
    if name in ('shell_start','shell_execute'):
        cwd=a.get('cwd') or WORKSPACE
        if not os.path.isdir(cwd): raise ValueError('cwd does not exist')
        with LOCK:
            if sum(p.proc.poll() is None for p in PROCESSES.values())>=16: raise RuntimeError('process capacity reached')
            p=Proc(a.get('argv'),cwd,bool(a.get('pipe_stdin'))); PROCESSES[p.id]=p
        if name=='shell_start': return {'ok':True,'process_id':p.id,'running':True}
        timeout=max(1,min(int(a.get('timeout_seconds') or 30),900)); deadline=time.monotonic()+timeout
        while p.proc.poll() is None and time.monotonic()<deadline: time.sleep(.05)
        r=p.read(0,262144,0)
        return {'ok':r['exit_code'] in (None,0),'process_id':p.id,'running':not r['exited'],**r}
    p=PROCESSES.get(a.get('process_id'))
    if not p: raise ValueError('process_id not found')
    if name=='shell_poll': return {'ok':True,'process_id':p.id,'running':p.proc.poll() is None,**p.read(int(a.get('after_seq') or 0),min(262144,max(1,int(a.get('max_bytes') or 262144))),int(a.get('wait_ms') or 0))}
    if name=='shell_write':
        if p.proc.stdin is None: raise ValueError('stdin is not piped')
        b=str(a.get('text') or '').encode(); p.proc.stdin.write(b); p.proc.stdin.flush(); return {'ok':True,'process_id':p.id,'bytes_written':len(b)}
    if name=='shell_terminate':
        if p.proc.poll() is None: os.killpg(p.proc.pid,signal.SIGTERM)
        return {'ok':True,'process_id':p.id,'terminated':True}
    raise ValueError('unknown tool')

def heartbeat():
    while True:
        try:
            try:
                with socket.create_connection(('127.0.0.1',8799),timeout=1):
                    codex_ready=True
            except OSError:
                codex_ready=False
            body=json.dumps({'node_id':NODE_ID,'environment_id':ENVIRONMENT_ID,
                'image':'company-docker','container_profile':'company-container-v1',
                'container_limits':{'cpus':2,'pids':512,'memory':'4g',
                    'workspace':'/runtime/worker','privileged':False,
                    'host_mounts':0,'mount_scope':'company-only'},
                'codex_exec_server':codex_ready,
                'aws_broker':Path(AWS_BROKER_SOCKET).is_socket(),
                'network_public':True,'network_local':True}).encode()
            req=urllib.request.Request(CENTRAL+'/api/operator/remote-shell/heartbeat',data=body,method='POST',headers={'Authorization':'Bearer '+NODE_TOKEN,'Content-Type':'application/json','User-Agent':'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36','Accept':'application/json,text/plain,*/*','Origin':CENTRAL,'Referer':CENTRAL+'/'})
            with urllib.request.urlopen(req,timeout=12) as r:
                write_hb(200<=r.status<300,http_status=r.status)
        except Exception as e:
            write_hb(False,error=type(e).__name__+': '+str(e)[:300])
        time.sleep(30)

class H(BaseHTTPRequestHandler):
    def log_message(self,*_): pass
    def sendj(self,x,status=200):
        b=json.dumps(x,separators=(',',':')).encode(); self.send_response(status); self.send_header('Content-Type','application/json'); self.send_header('Content-Length',str(len(b))); self.end_headers(); self.wfile.write(b)
    def do_GET(self):
        if self.path=='/healthz': return self.sendj({'ok':True,'node_id':NODE_ID,'workspace':WORKSPACE,'container':True})
        self.sendj({'error':'not found'},404)
    def do_POST(self):
        if self.path not in ('/mcp','/provider','/rollouts','/conversations','/aws-session'): return self.sendj({'error':'not found'},404)
        if not hmac.compare_digest(self.headers.get('Authorization',''),'Bearer '+BEARER): return self.sendj({'error':'unauthorized'},401)
        payload={}
        try:
            n=int(self.headers.get('Content-Length','0'))
            maximum=30_000_000 if self.path=='/rollouts' else (1048576 if self.path=='/provider' else 65536)
            if n<1 or n>maximum: raise ValueError('invalid request length')
            if self.path=='/provider': return self.sendj(provider_operation(json.loads(self.rfile.read(n))))
            if self.path=='/rollouts': return self.sendj(drive_rollout(json.loads(self.rfile.read(n))))
            if self.path=='/conversations': return self.sendj(stock_conversation(json.loads(self.rfile.read(n))))
            if self.path=='/aws-session': return self.sendj(aws_session(json.loads(self.rfile.read(n))))
            payload=json.loads(self.rfile.read(n)); method=payload.get('method'); rid=payload.get('id')
            if method=='initialize': result={'protocolVersion':'2025-06-18','capabilities':{'tools':{}},'serverInfo':{'name':'cognilode-company-remote-shell','version':'3.0.0'}}
            elif method=='tools/list': result={'tools':[{'name':x,'description':x,'inputSchema':{'type':'object'}} for x in ('shell_execute','shell_start','shell_poll','shell_write','shell_terminate')]}
            elif method=='tools/call':
                v=tool(payload.get('params',{}).get('name',''),payload.get('params',{}).get('arguments') or {})
                result={'content':[{'type':'text','text':json.dumps(v)}],'isError':not v.get('ok',False)}
            else: return self.sendj({'jsonrpc':'2.0','id':rid,'error':{'code':-32601,'message':'unknown method'}})
            self.sendj({'jsonrpc':'2.0','id':rid,'result':result})
        except Exception as e:
            if self.path!='/mcp':
                return self.sendj({'ok':False,'error':type(e).__name__},
                    503 if isinstance(e,RuntimeError) else 400)
            self.sendj({'jsonrpc':'2.0','id':payload.get('id'),'result':{'content':[{'type':'text','text':json.dumps({'error':str(e)})}],'isError':True}})

if __name__=='__main__':
    os.makedirs(WORKSPACE,exist_ok=True); threading.Thread(target=heartbeat,daemon=True).start(); ThreadingHTTPServer.allow_reuse_address=True; ThreadingHTTPServer(('0.0.0.0',PORT),H).serve_forever()
