#!/usr/bin/env python3
"""Home-network actuator for rhythm-claimed ChatGPT.com chat-mode jobs.

The hosted D1 queue owns priority, dependency readiness, and slot claims. This
worker owns only the authenticated provider send and its fenced completion.
An ambiguous send is never replayed; the exact receipt is recovered instead.
"""
from __future__ import annotations

import argparse
import copy
from datetime import datetime, timezone
import fcntl
from functools import lru_cache
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request
from urllib.parse import urlsplit
import uuid
import threading
import time
import zipfile

SENDER_PATH = Path(__file__).with_name("cognilode-b4pt0r-chatmode")
COLLECTOR_PATH = Path(__file__).with_name("cognilode-b4pt0r-collect")
class _LazySender:
    """Load the provider transport only when a provider operation is actually used.

    Keeping import side effects lazy makes validation helpers/tests runnable from a
    focused source packet that intentionally does not carry authenticated provider
    transport code. Production behavior is unchanged on first sender attribute use.
    """
    _module = None

    def _load(self):
        if self._module is None:
            loader = importlib.machinery.SourceFileLoader("cognilode_chatmode_sender", str(SENDER_PATH))
            spec = importlib.util.spec_from_loader(loader.name, loader)
            if spec is None:
                raise RuntimeError("unable to load ChatGPT transport module")
            module = importlib.util.module_from_spec(spec)
            loader.exec_module(module)
            self._module = module
        return self._module

    def __getattr__(self, name):
        return getattr(self._load(), name)

sender = _LazySender()

ROOT = Path.home() / ".local/share/cognilode/chatmode-queue-worker"
DEVICE_ID = os.environ.get("COGNILODE_CHATMODE_DEVICE_ID", "evanpc")
MAX_ATTACHMENT_BYTES = 20 * 1024 * 1024
MAX_RETURNED_WORK_BYTES = 2_500_000_000
DEVICE_PRIORITY = int(os.environ.get("COGNILODE_CHATMODE_DEVICE_PRIORITY", "100"))
STAGE_ROOT = ROOT / "staged-attachments"
DRAIN = False


def request_drain(_signal, _frame) -> None:
    """Finish any accepted provider mutation before leaving a source generation."""
    global DRAIN
    DRAIN = True
JOB_SCAN_PAGE_SIZE = 100
JOB_SCAN_PAGES_PER_POLL = 4
TERMINAL_DELIVERABLE_RECHECK_SECONDS = 300
TERMINAL_DELIVERABLE_WINDOW_SECONDS = 1800
TERMINAL_DELIVERABLE_ABSOLUTE_SECONDS = 10800


def sender_prefix() -> list[str]:
    """Route the single rhythm queue through unified prompting's provider adapter."""
    source = os.environ.get("COGNILODE_CHATMODE_AUTH_SOURCE", "codex").strip().lower()
    if source not in {"codex", "chrome"}:
        raise ValueError("COGNILODE_CHATMODE_AUTH_SOURCE must be codex or chrome")
    unified = os.environ.get("COGNILODE_UNIFIED_PROMPTER", "").strip()
    if not unified:
        source_root = Path(os.environ.get("COGNILODE_COMPANY_SOURCE_ROOT", "/runtime/source"))
        unified = str(source_root / "current/modified-codex-runtime/src/modified_codex/unified_bridge.py")
    if not Path(unified).is_file():
        raise RuntimeError("unified prompting transport is unavailable")
    command = [sys.executable, unified, "transport", "--provider", "chatgpt.com", "--", "--auth-source", source]
    if source == "chrome":
        profile = os.environ.get("COGNILODE_CHATMODE_CHROME_PROFILE", "").strip()
        if profile:
            command.extend(["--chrome-profile", profile])
    return command


def provider_tool_evidence(raw: bytes, *, expected_sha256: str = "") -> list[dict]:
    """Identify completed provider tool calls from the actual ChatGPT stream.

    ChatGPT streams message snapshots and JSON-pointer patches. This only emits
    metadata for an assistant tool call with a matching provider tool result;
    it does not treat a model's textual claim of sandbox work as execution.
    An opaque or changed provider format yields no evidence, not a fabricated
    native-compute claim. The raw stream hash lets a reviewer recheck it later.
    """
    raw_sha = hashlib.sha256(raw).hexdigest()
    if expected_sha256 and raw_sha != expected_sha256:
        raise ValueError("provider stream SHA-256 mismatch")
    state = None
    inherited_path = ""
    inherited_operation = "add"
    messages: dict[str, dict] = {}

    def patch(target, change):
        path = str(change.get("p", change.get("path", "")))
        operation = str(change.get("o", change.get("op", "replace")))
        value = change.get("v", change.get("value"))
        if not path:
            return copy.deepcopy(value) if operation in {"add", "replace"} else target
        parts = [p.replace("~1", "/").replace("~0", "~") for p in path.split("/")[1:]]
        parent = target
        try:
            for part in parts[:-1]:
                parent = parent[int(part)] if isinstance(parent, list) else parent[part]
            leaf = parts[-1]
            if isinstance(parent, list):
                if operation == "remove": parent.pop(int(leaf))
                elif operation == "add" and leaf == "-": parent.append(copy.deepcopy(value))
                elif operation == "append": parent[int(leaf)] += value
                else:
                    index = int(leaf)
                    if operation == "add" and index == len(parent): parent.append(copy.deepcopy(value))
                    else: parent[index] = copy.deepcopy(value)
            elif isinstance(parent, dict):
                if operation == "remove": parent.pop(leaf, None)
                elif operation == "append" and isinstance(parent.get(leaf), (str, list)):
                    parent[leaf] += value
                else: parent[leaf] = copy.deepcopy(value)
        except (IndexError, KeyError, TypeError, ValueError):
            return target
        return target

    def observe(value):
        if isinstance(value, dict):
            msg = value.get("message") if isinstance(value.get("message"), dict) else value
            if isinstance(msg, dict) and isinstance(msg.get("author"), dict):
                mid = msg.get("id")
                if isinstance(mid, str) and mid:
                    author = msg["author"]
                    metadata = msg.get("metadata") or {}
                    messages[mid] = {"role": author.get("role"),
                                     "name": author.get("name"),
                                     "recipient": msg.get("recipient"),
                                     "status": msg.get("status"),
                                     "parent_id": metadata.get("parent_id") if isinstance(metadata, dict) else None}
                    return
            for key, child in value.items():
                if key not in {"content", "metadata"}: observe(child)
        elif isinstance(value, list):
            for child in value: observe(child)

    for line in raw.decode("utf-8", "replace").splitlines():
        if line.startswith("data:"): line = line[5:].strip()
        if not line.startswith("{"): continue
        try: event = json.loads(line)
        except json.JSONDecodeError: continue
        if not isinstance(event, dict): continue
        if "v" in event and any(k in event for k in ("c", "o", "p")):
            inherited_path = str(event.get("p", inherited_path))
            inherited_operation = str(event.get("o", inherited_operation))
            if inherited_operation == "patch" and isinstance(event["v"], list):
                for change in event["v"]:
                    if isinstance(change, dict): state = patch(state, change)
            else: state = patch(state, {"p": inherited_path, "o": inherited_operation, "v": event["v"]})
        observe(event)
        if state is not None: observe(state)

    calls = {}
    results = {}
    for mid, msg in messages.items():
        role = msg.get("role")
        recipient = msg.get("recipient")
        if role == "assistant" and isinstance(recipient, str) and recipient not in {"", "all"}:
            calls[mid] = recipient
        if role == "tool" and isinstance(msg.get("name"), str):
            results[mid] = (msg["name"], str(msg.get("parent_id") or ""), msg.get("status"))
    evidence = []
    for result_id, (name, parent_id, status) in results.items():
        # A paired call that remained in progress or finished with an error
        # proves invocation, not completed native computation.
        if not parent_id or calls.get(parent_id) != name or status != "finished_successfully": continue
        # ChatGPT Chat-mode's built-in sandbox is container.exec; Code Mode's
        # built-in sandbox is functions.exec. An opaque plugin recipient (for
        # example api_tool.call_tool or a dynamic tool ID) is not native work.
        if name not in {"functions.exec", "container.exec"}: continue
        evidence.append({"kind": ("provider_observed_native_exec" if name == "container.exec"
                                  else "provider_observed_functions_exec"),
                         "tool": name, "ref": result_id,
                         "call_ref": parent_id, "raw_stream_sha256": raw_sha})
    return sorted(evidence, key=lambda row: row["ref"])


def atomic_json(path: Path, value: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=path.parent, delete=False) as tmp:
        json.dump(value, tmp, ensure_ascii=False, sort_keys=True)
        tmp.write("\n")
        name = tmp.name
    os.replace(name, path)


def event(kind: str, **fields) -> None:
    print(json.dumps({"at": time.time(), "kind": kind, **fields}, sort_keys=True), flush=True)


def job_stem(job_id: str) -> str:
    return "b4pt0r-chatmode-job-" + hashlib.sha256(job_id.encode()).hexdigest()[:24]


def job_state_path(job_id: str) -> Path:
    return ROOT / "jobs" / (hashlib.sha256(job_id.encode()).hexdigest() + ".json")


def recent_index_gate_path() -> Path:
    return ROOT / "recent-index-gate.json"


def known_conversation_for_job(job_id: str) -> str:
    """A known-ID hydration can proceed while recent-index reads cool down."""
    stem = job_stem(job_id)
    for suffix in (".sse.receipt.json", ".json"):
        path = sender.DEFAULT_OUTPUT_ROOT / (stem + suffix)
        try:
            value = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if isinstance(value, dict):
            result = value.get("result") if isinstance(value.get("result"), dict) else value
            if result.get("queue_job_id") not in (None, job_id):
                continue
            conversation_id = str(result.get("conversation_id") or "")
            if conversation_id:
                return conversation_id
    return ""


def selected_for_device(job: dict, device_id: str = DEVICE_ID) -> bool:
    return (job.get("provider") == "chatgpt.com"
            and job.get("rhythm_tape_sha256")
            and job.get("rhythm_slot_index") is not None
            and str(job.get("claimed_by") or "").startswith("rhythm:" + device_id + ":"))


def _sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def _stage_remote_attachment(url: str, expected: str, *, max_bytes: int = MAX_ATTACHMENT_BYTES) -> Path:
    if not expected or len(expected) != 64 or any(c not in "0123456789abcdefABCDEF" for c in expected):
        raise ValueError("remote attachment requires exact SHA-256")
    expected = expected.lower()
    if url.startswith("s3://"):
        buckets = {value.strip() for value in (
            os.environ.get("COGNILODE_TASKFLOW_ATTACHMENT_S3_BUCKET", "") + "," +
            os.environ.get("COGNILODE_TASKFLOW_ATTACHMENT_S3_READ_BUCKETS", "")
        ).split(",") if value.strip()}
        bucket = url[5:].split("/", 1)[0]
        key = f"taskflow-artifacts/sha256/{expected}.zip"
        if bucket not in buckets or url != f"s3://{bucket}/{key}":
            raise ValueError("S3 attachment is outside the configured private launchpad")
        aws = os.environ.get("COGNILODE_AWS_CLI") or shutil.which("aws")
        if not aws:
            raise ValueError("AWS CLI unavailable on selected network device")
        STAGE_ROOT.mkdir(parents=True, exist_ok=True)
        target = STAGE_ROOT / expected
        if target.is_file() and _sha256_file(target) == expected:
            return target
        head = subprocess.run([aws, "s3api", "head-object", "--bucket", bucket, "--key", key,
                               "--output", "json"], capture_output=True, text=True, check=True, timeout=30)
        metadata = json.loads(head.stdout)
        if (not 0 < int(metadata.get("ContentLength", 0)) <= max_bytes
                or (metadata.get("Metadata") or {}).get("sha256") != expected):
            raise ValueError("private attachment metadata mismatch")
        with tempfile.NamedTemporaryFile(dir=STAGE_ROOT, delete=False) as temp:
            name = Path(temp.name)
        try:
            subprocess.run([aws, "s3api", "get-object", "--bucket", bucket, "--key", key,
                            str(name), "--output", "json"], capture_output=True, text=True,
                           check=True, timeout=1800 if max_bytes > MAX_ATTACHMENT_BYTES else 120)
            if name.stat().st_size != int(metadata["ContentLength"]) or _sha256_file(name) != expected:
                raise ValueError("private attachment SHA-256 mismatch")
            os.replace(name, target)
        finally:
            name.unlink(missing_ok=True)
        return target
    if not url.startswith("https://"):
        raise ValueError("remote attachment staging requires https")
    STAGE_ROOT.mkdir(parents=True, exist_ok=True)
    target = STAGE_ROOT / expected.lower()
    if target.is_file() and _sha256_file(target) == expected.lower():
        return target
    req = urllib.request.Request(url, headers={"User-Agent": "cognilode-chatmode-actuator/1"})
    with tempfile.NamedTemporaryFile(dir=STAGE_ROOT, delete=False) as temp:
        name = Path(temp.name)
        try:
            with urllib.request.urlopen(req, timeout=1800 if max_bytes > MAX_ATTACHMENT_BYTES else 120) as response:
                total = 0
                while True:
                    chunk = response.read(1024 * 1024)
                    if not chunk:
                        break
                    total += len(chunk)
                    if total > max_bytes:
                        raise ValueError("attachment exceeds bounded size")
                    temp.write(chunk)
            temp.flush()
            if _sha256_file(name) != expected:
                raise ValueError("staged attachment SHA-256 mismatch")
            os.replace(name, target)
        finally:
            name.unlink(missing_ok=True)
    return target


def _stage_universe_attachment(locator: str, expected: str) -> Path:
    """Materialize a custody locator through the elected Universe Storage API."""
    from universe_storage.client import UniverseStorageClient

    endpoint = os.environ.get("UNIVERSE_STORAGE_ENDPOINT", "").strip()
    password = os.environ.get("UNIVERSE_STORAGE_OPERATOR_PASSWORD", "").strip()
    password_file = os.environ.get("UNIVERSE_STORAGE_OPERATOR_PASSWORD_FILE", "").strip()
    if not password and password_file:
        password = Path(password_file).read_text(encoding="utf-8").strip()
    if not endpoint or not password:
        raise RuntimeError("central Universe Storage custody is not configured")
    data = UniverseStorageClient(endpoint, operator_password=password, timeout=180).read(locator)
    if len(data) > MAX_ATTACHMENT_BYTES:
        raise ValueError("attachment exceeds bounded size")
    actual = hashlib.sha256(data).hexdigest()
    if expected and actual != expected.lower():
        raise ValueError("staged attachment SHA-256 mismatch")
    STAGE_ROOT.mkdir(parents=True, exist_ok=True)
    target = STAGE_ROOT / actual
    if not target.is_file():
        with tempfile.NamedTemporaryFile(dir=STAGE_ROOT, delete=False) as stream:
            temporary = Path(stream.name)
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        try:
            os.replace(temporary, target)
        finally:
            temporary.unlink(missing_ok=True)
    return target


def attachment_paths(job: dict) -> list[Path]:
    paths = []
    for row in job.get("attachment_refs") or []:
        expected = "" if isinstance(row, str) else str(row.get("sha256") or "")
        ref = row if isinstance(row, str) else str(row.get("ref") or "")
        parsed = urlsplit(ref)
        custody_locator = bool(parsed.scheme and parsed.netloc) and parsed.scheme not in {"http", "https", "s3"}
        if custody_locator:
            path = _stage_universe_attachment(ref, expected)
        elif ref.startswith("file:"):
            ref = ref.removeprefix("file:")
            path = Path(ref).expanduser()
        else:
            path = Path(ref).expanduser() if ref and not ref.startswith(("https://", "http://", "s3://")) else None
        if not path or not path.is_absolute() or not path.is_file():
            mirrors = [] if isinstance(row, str) else list(row.get("mirrors") or [])
            if ref.startswith(("https://", "s3://")):
                mirrors.insert(0, ref)
            # Jobs queued before the D1 mirror-preservation fix retained only
            # their local path. Recover the content-addressed private launchpad
            # from the signed digest on an alternate device.
            bucket = os.environ.get("COGNILODE_TASKFLOW_ATTACHMENT_S3_BUCKET", "").strip()
            if bucket and len(expected) == 64 and all(c in "0123456789abcdefABCDEF" for c in expected):
                digest = expected.lower()
                fallback = f"s3://{bucket}/taskflow-artifacts/sha256/{digest}.zip"
                if fallback not in mirrors:
                    mirrors.append(fallback)
            staged = None
            failures = []
            for url in mirrors:
                try:
                    staged = _stage_remote_attachment(str(url), expected)
                    break
                except Exception as exc:
                    if isinstance(exc, subprocess.CalledProcessError):
                        reason = f"aws_exit_{exc.returncode}"
                    elif isinstance(exc, urllib.error.HTTPError):
                        reason = f"http_{exc.code}"
                    else:
                        reason = type(exc).__name__ + ":" + str(exc)[:100]
                    failures.append(reason)
            if staged is None:
                raise ValueError("attachment not readable or stageable on selected network device: " +
                                 "; ".join(failures[:4]))
            path = staged
        if path.stat().st_size > MAX_ATTACHMENT_BYTES:
            raise ValueError("attachment exceeds 20 MiB")
        if expected and _sha256_file(path) != expected.lower():
            raise ValueError("attachment SHA-256 mismatch")
        if (path.suffix.lower() == ".zip" or ref.lower().endswith(".zip")) and not zipfile.is_zipfile(path):
            raise ValueError("attachment ZIP invalid")
        paths.append(path)
    return paths



# DecisionX labeling is a phase of the EXISTING D1 queue. Only derived progress
# metadata and transient attachment ZIPs live on this network device.
import sqlite3
from collections import defaultdict
from contextlib import contextmanager

DX_HOME = ROOT / "decisionx-label-batches"
DX_TARGET = 128
DX_EPISODES_PER_SOURCE_PER_SCAN = 4
DX_MIN = 48
DX_TAIL_MIN = 32
DX_INPUT_CHAR_BUDGET = 1_000_000  # physical ZIP limit still applies; native sandbox chunks analysis
DX_SCAN_INTERVAL_SECONDS = 600
DX_STOCK_CACHE_SECONDS = 900
DX_PRIORITY = -1000000  # human-requested bottom priority for bulk historical labels
DX_MAX_UNADMITTED_BATCHES = 3
_DX_STOCK_LOCK = threading.Lock()
_DX_STOCK_THREAD = None
_DX_STOCK_VALUE = None
_DX_STOCK_AT = 0.0
DX_PROMPT = """You are a ChatGPT.com Chat-mode DecisionX labeling employee. Read the attached
episodes.jsonl completely. It contains MANY source-linked candidate IAE episodes
from the existing conversation memory, never a replacement memory database.

The attached decisionx episode ZIP and source ZIPs contain complete rendered
conversation records for every episode, split into <=20 MiB files. Run the
attached RUN_ME.py in YOUR native ChatGPT.com sandbox as:
python RUN_ME.py <episode-input.zip> <output-dir> <all-complete-source-zips...>
It verifies every episode against the complete sources, renders the full
conversations under complete_sources/, and computes lexical neighbors. Read
those renderings as context and use neighbors.json as supporting evidence while
YOU reason semantically.
Each source rendering states its fidelity tier and provenance. Historical S3
rendered text has unverified original origin; Codex visible rollouts and privacy
export text projections do not prove original media or tool completeness. Use
the tier when judging evidence and never upgrade it by inference.
Do not move this computation to a remote machine. Include NATIVE_COMPUTE.json
and neighbors.json unchanged in your single returned ZIP, alongside your labels.

For EVERY episode, infer the user's Intent/Instruction (I), the assistant's
actual Action (A), and subsequent Evidence/Evaluation (E); unknowns must stay
unknown. Human identity cannot be inferred from a user role alone. Separate
directly authored human guidance from agent-authored commentary or quotations.
Do not treat repetition, forceful language, or a 'canonical' label as authority.
Include possible adjacent/double triplets where the evaluation becomes the
instruction for another action. A non-null double_triplet must have exactly:
instruction_turn_id, action_turn_ids, evaluation_turn_id, i, a, e, and
relationship. The turn IDs must match next_user_turn,
following_action_turns, and following_user_turn in the input episode. Set e
and evaluation_turn_id to null when a defensible later evaluation is absent. Use null
for the whole double_triplet when the next user turn does not actually instruct
the following assistant action. Preserve original episode_id and source_sha256.
Produce grounded, concise lexical descriptors AND natural-language embedding_text,
changed_conditions, outcome_signals, and uncertainties. Do not invent observed
success or source text; the evidence field may be null.

You MUST process all input episodes in ~20K-token groups inside your native
ChatGPT sandbox, retaining each group's result before processing the next.
Do the heavy source verification and lexical computation there. In this ONE agent
turn, not one provider call per episode. For each source, keep its provider, conversation ID and original turn IDs as exact locator evidence. Use native-sandbox computation to create
one downloadable ZIP. That ZIP MUST contain decisionx_iae_labels.jsonl, exactly
one JSON object for each input episode, and EXTERNAL_EFFECT_INSTRUCTIONS.md.
Each JSON record: episode_id, source_sha256, i, a, e, outcome, tags (array),
embedding_text, human_authorship_assessment, changed_conditions,
double_triplet (object or null), and uncertainty. Labels are agent-derived
descriptors with traceable source anchors, not human instructions. The existing
external operator admits these records into Agent Memory; do not create new
memory stores or schedulers. Report substantive issues in chat, but fix any
format/output defect before finishing. Avoid rewriting entire source transcripts
inside descriptors. Reason across the batch thoroughly.
"""

@contextmanager
def _dx_connection():
    DX_HOME.mkdir(parents=True, exist_ok=True)
    db = sqlite3.connect(str(DX_HOME / "progress.sqlite3"))
    try:
        db.execute("""CREATE TABLE IF NOT EXISTS episodes
            (id TEXT PRIMARY KEY, source_sha TEXT NOT NULL, state TEXT NOT NULL,
             attempts INTEGER NOT NULL DEFAULT 0, retry_after REAL NOT NULL DEFAULT 0,
             batch TEXT, updated REAL NOT NULL)""")
        db.execute("""CREATE TABLE IF NOT EXISTS verified_dispatches
            (batch TEXT PRIMARY KEY, job_id TEXT NOT NULL, prompt_sha TEXT NOT NULL,
             priority INTEGER NOT NULL, queued_at REAL NOT NULL)""")
        yield db
        db.commit()
    except Exception:
        db.rollback()
        raise
    finally:
        db.close()

def _dx_load():
    path = DX_HOME / "scan.json"
    if path.exists():
        state = json.loads(path.read_text(encoding="utf-8"))
        # Older scans retained full conversation excerpts in a local spool.
        # Only source handles and hashes are needed between cycles: source text
        # stays in the shared conversation store until a dispatch ZIP is built.
        refs = [_dx_ref(row) for row in state.get("spool") or []]
        if refs != state.get("spool"):
            state["spool"] = refs
            atomic_json(path, state)
        return state
    return {"offset": 0, "spool": [], "last_scan": 0.0}


def _dx_bridge():
    import importlib.machinery
    import importlib.util
    bridge_path = Path(__file__).resolve().parent / "cognilode-root-plan-handoff"
    loader = importlib.machinery.SourceFileLoader("decisionx_shared_stock_gate", str(bridge_path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    bridge = importlib.util.module_from_spec(spec)
    loader.exec_module(bridge)
    return bridge


def _dx_refresh_stock():
    """Read the large shared census off the queue-polling thread."""
    global _DX_STOCK_VALUE, _DX_STOCK_AT
    try:
        stock = _dx_bridge().shared_stock_census(
            sender.operator_memory_post, minimum=500,
            checkpoint_path=DX_HOME / "shared-stock-readback-proofs.json",
            stop_at_minimum=True)
        if not isinstance(stock, dict):
            raise ValueError("DecisionX shared stock census malformed")
        event("decisionx_shared_stock_census_result",
              distinct_complete=stock.get("distinct_complete"),
              span_days=stock.get("span_days"),
              multi_year_ready=stock.get("multi_year_ready"),
              partial_read_errors=stock.get("partial_read_errors"))
    except Exception as exc:
        event("decisionx_shared_stock_census_retry", error=type(exc).__name__ + ":" + str(exc)[:240])
        stock = None
    with _DX_STOCK_LOCK:
        _DX_STOCK_VALUE = stock
        _DX_STOCK_AT = time.time()


def _dx_stock_snapshot():
    """Return a recent full census or start one without missing a rhythm slot.

    Even a ready cached census is only a candidate list: every selected source
    is independently reread and reverified before physical upload.
    """
    global _DX_STOCK_THREAD
    now = time.time()
    with _DX_STOCK_LOCK:
        ttl = (60 if _DX_STOCK_VALUE is None or int(_DX_STOCK_VALUE.get("distinct_complete") or 0) < 500
               or _DX_STOCK_VALUE.get("partial_read_errors") else DX_STOCK_CACHE_SECONDS)
        if _DX_STOCK_AT and now - _DX_STOCK_AT < ttl:
            return _DX_STOCK_VALUE
        if _DX_STOCK_THREAD is None or not _DX_STOCK_THREAD.is_alive():
            _DX_STOCK_THREAD = threading.Thread(target=_dx_refresh_stock,
                                                name="decisionx-shared-stock-census", daemon=True)
            _DX_STOCK_THREAD.start()
            event("decisionx_shared_stock_census_started")
    return None


def _dx_source_batch_builder():
    import importlib.machinery
    import importlib.util
    script = Path(__file__).resolve().parent / "cognilode-root-memory-native-cycle"
    loader = importlib.machinery.SourceFileLoader("decisionx_full_source_batch_builder", str(script))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def _dx_ref(episode):
    return {key: episode[key] for key in
            ("episode_id", "source_sha256", "provider", "conversation_id")}


def _dx_unique_source_refs(refs):
    result = []
    seen = set()
    for ref in refs:
        key = (ref["provider"], ref["conversation_id"])
        if key not in seen:
            result.append(ref)
            seen.add(key)
    return result


def _dx_resolve(refs, *, complete_source=None):
    """Rehydrate exact episodes from the shared store only for a due batch."""
    by_conversation = {}
    selected = []
    stale = []
    for ref in refs:
        key = (ref["provider"], ref["conversation_id"])
        if key not in by_conversation:
            result = sender.operator_memory_post({"operation": "read", "provider": key[0],
                                                  "conversation_id": key[1]})
            if not result.get("ok"):
                raise RuntimeError("DecisionX source conversation unavailable for batch")
            if complete_source is not None and not complete_source(
                    {"provider": key[0], "conversation_id": key[1]}, result):
                by_conversation[key] = {}
            else:
                by_conversation[key] = {e["episode_id"]: e for e in
                                        _dx_extract(result.get("conversation") or {})}
        episode = by_conversation[key].get(ref["episode_id"])
        if episode is None or episode["source_sha256"] != ref["source_sha256"]:
            stale.append(ref)
        else:
            selected.append(episode)
    return selected, stale

def _dx_extract(row):
    """Source-linked, branch-aware overlapping I/A/E and I/A/I episodes.

    Explicit provider parent links govern branch choice when present. Without
    them, chronology is only a candidate relation, never proof of evaluation.
    Assistant messages remain claimed actions until external-effect evidence
    resolves them. Different branches are never spliced into one history.
    """
    events = row.get("events") or []
    nodes = []
    for n, ev in enumerate(events):
        if not isinstance(ev, dict):
            continue
        role = str(ev.get("role") or "").lower()
        value = ev.get("content")
        if isinstance(value, dict):
            value = value.get("text") or value.get("parts") or ""
        if isinstance(value, list):
            value = "\n".join(str(x.get("text") or x.get("content") or "")
                              if isinstance(x, dict) else str(x) for x in value)
        md = ev.get("metadata") if isinstance(ev.get("metadata"), dict) else {}
        mid = str(ev.get("id") or ev.get("source_event_id") or ev.get("turn_key")
                  or ("ordinal:" + str(ev.get("index",n))))
        parent = str(ev.get("parent_id") or ev.get("parent_node_id")
                     or ev.get("source_parent_id") or md.get("parent_id") or "")
        nodes.append({
            "id":mid, "parent":parent, "role":role,
            "text":str(value or "").strip(), "authorship":ev.get("authorship","unverified"),
            "time":ev.get("created_at") or ev.get("observed_at"), "ordinal":n,
            "provider_effects":ev.get("effect_evidence") or ev.get("external_effects") or []
        })
    graph = {x["id"]:x for x in nodes}
    linked = [x for x in nodes if x["parent"] and x["parent"] in graph
              and x["parent"] != x["id"]]
    paths = []
    if linked:
        parents = {x["parent"] for x in linked}
        leaves = [x for x in nodes if x["id"] not in parents]
        for leaf in leaves:
            path,seen,node = [],set(),leaf
            while node and node["id"] not in seen:
                seen.add(node["id"])
                path.append(node)
                node=graph.get(node["parent"])
            if node is not None:  # Cyclic or ambiguous parent pointers are not evidence.
                continue
            if len(path) > 1:
                paths.append(list(reversed(path)))
        # An incomplete graph cannot justify following a cross-branch user turn.
        if not paths:
            return []
    else:
        paths=[nodes]
    episodes, emitted = [],set()
    for path in paths:
        ordinary = [x for x in path if x["role"] in ("user","assistant") and x["text"]]
        for idx,u in enumerate(ordinary):
            if u["role"]!="user":continue
            later=ordinary[idx+1:]
            end=next((j for j,v in enumerate(later) if v["role"]=="user"),len(later))
            replies=[v for v in later[:end] if v["role"]=="assistant"]
            if not replies:continue
            following=later[end] if end<len(later) else None
            after=later[end+1:] if following else []
            following_end=next((j for j,v in enumerate(after) if v["role"]=="user"),len(after))
            next_actions=[v for v in after[:following_end] if v["role"]=="assistant"]
            next_user=after[following_end] if next_actions and following_end<len(after) else None
            ancestor=ordinary[max(0,idx-2):idx]
            convert=lambda v: (None if v is None else {key:v[key] for key in
                ("id","role","text","authorship","time","provider_effects")})
            source={
                "provider":row.get("provider"),"conversation_id":row.get("conversation_id"),
                "intent_turn":convert(u),
                "action_turns":[convert(v) for v in replies],
                "next_user_turn":convert(following),
                "following_action_turns":[convert(v) for v in next_actions],
                "following_user_turn":convert(next_user),
                "preceding_context":[convert(v) for v in ancestor],
                "relationship_basis":"provider_parent_chain" if linked else "chronology_only",
                "source_capture":(row.get("capture") or {})
            }
            raw=json.dumps(source,sort_keys=True,ensure_ascii=False,separators=(",",":"))
            digest=hashlib.sha256(raw.encode("utf-8")).hexdigest()
            identity="|".join([str(row.get("provider")),str(row.get("conversation_id")),
                u["id"],replies[0]["id"],following["id"] if following else "terminal",
                next_actions[0]["id"] if next_actions else "no-successor-action"])
            eid=hashlib.sha256(identity.encode()).hexdigest()[:48]
            if (eid,digest) in emitted:continue
            emitted.add((eid,digest))
            episodes.append({"episode_id":eid,"source_sha256":digest,**source})
    return episodes

def _dx_input_zip(episodes, batch):
    folder = DX_HOME / "input"
    folder.mkdir(parents=True,exist_ok=True)
    path = folder / (batch + ".zip")
    if not path.is_file():
        runner = Path(__file__).resolve().parent / "decisionx_native_batch.py"
        runner_raw = runner.read_bytes()
        manifest = {"schema":"decisionx.iae.batch.v3","batch_id":batch,
                    "episode_count":len(episodes),
                    "runner_sha256":hashlib.sha256(runner_raw).hexdigest(),
                    "episodes":[{"episode_id":e["episode_id"],"source_sha256":e["source_sha256"]}
                                for e in episodes]}
        with zipfile.ZipFile(path,"w",compression=zipfile.ZIP_DEFLATED,compresslevel=7) as archive:
            archive.writestr("manifest.json",json.dumps(manifest,ensure_ascii=False))
            archive.writestr("episodes.jsonl","".join(json.dumps(e,ensure_ascii=False)+"\n" for e in episodes))
            archive.writestr("RUN_ME.py",runner_raw)
    if path.stat().st_size > MAX_ATTACHMENT_BYTES:
        raise ValueError("DecisionX batch exceeds attachment limit")
    return path


def _dx_retire_completed_inputs(limit=20):
    """Remove transport copies only after D1 confirms the label result was admitted."""
    folder = DX_HOME / "input"
    if not folder.is_dir(): return 0
    retired = 0
    for path in sorted(folder.glob("*.zip"))[:limit]:
        batch = path.stem
        if path.is_symlink() or not re.fullmatch(r"[0-9a-f]{32}", batch): continue
        try:
            with zipfile.ZipFile(path) as archive:
                manifest = json.loads(archive.read("manifest.json"))
            if manifest.get("batch_id") != batch: continue
            result = sender.operator_memory_post({"operation": "get_job", "job_id": "decisionx-iae-" + batch})
            job = result.get("job") or {}
            evidence = job.get("effect_evidence") or []
            if job.get("state") != "complete" or not any(
                isinstance(item, dict) and item.get("kind") == "decisionx_label_admission"
                and int(item.get("admitted") or 0) > 0
                for item in evidence
            ): continue
            path.unlink()
            full_dir = folder / batch / "full"
            if full_dir.is_dir() and not full_dir.is_symlink():
                for full_zip in full_dir.glob("batch-*.zip"):
                    if full_zip.is_file() and not full_zip.is_symlink():
                        full_zip.unlink()
                try:
                    full_dir.rmdir()
                    full_dir.parent.rmdir()
                except OSError:
                    pass
            retired += 1
        except (OSError, KeyError, ValueError, zipfile.BadZipFile):
            continue
    return retired


def _dx_reconcile_queued(db):
    """A cancelled/failed old batch must not pin local source refs forever."""
    batches = [row[0] for row in db.execute(
        "SELECT DISTINCT batch FROM episodes WHERE state='queued' AND batch IS NOT NULL LIMIT 100")]
    released = 0
    for batch in batches:
        result = sender.operator_memory_post({"operation": "get_job", "job_id": "decisionx-iae-" + batch})
        job = result.get("job") or {}
        if job.get("state") not in {"cancelled", "failed", "complete"}:
            continue
        if job.get("state") in {"cancelled", "failed"}:
            db.execute("DELETE FROM verified_dispatches WHERE batch=?", (batch,))
        evidence = job.get("effect_evidence") or []
        admission = next((row for row in evidence if isinstance(row, dict)
                          and row.get("kind") == "decisionx_label_admission"), None)
        if job.get("state") == "complete" and admission:
            accepted = admission.get("admitted_episode_ids") or []
            if isinstance(accepted, list) and len(accepted) == int(admission.get("admitted") or -1):
                for episode_id in accepted:
                    db.execute("UPDATE episodes SET state='done',updated=? "
                               "WHERE state='queued' AND batch=? AND id=?",
                               (time.time(), batch, str(episode_id)))
        cursor = db.execute("UPDATE episodes SET state='retry',retry_after=0,updated=? "
                            "WHERE state='queued' AND batch=?", (time.time(), batch))
        released += cursor.rowcount
    return released


def _dx_reconcile_unproved_done(db):
    """Retire legacy local completion claims without central label admission.

    Earlier transport-only ChatGPT jobs were marked done locally even though
    their returned labels never entered the D1 descriptor index. Those rows
    must remain eligible for genuine native source-grounded labeling.
    """
    released = 0
    batches = [row[0] for row in db.execute(
        "SELECT DISTINCT batch FROM episodes WHERE state='done' AND batch IS NOT NULL")]
    for batch in batches:
        result = sender.operator_memory_post({"operation": "get_job", "job_id": "decisionx-iae-" + batch})
        job = result.get("job") or {}
        if job.get("id") != "decisionx-iae-" + batch:
            raise RuntimeError("DecisionX completed-batch provenance unavailable")
        evidence = job.get("effect_evidence") or []
        admission = next((row for row in evidence if isinstance(row, dict)
                          and row.get("kind") == "decisionx_label_admission"
                          and int(row.get("admitted") or 0) > 0), None)
        source_refs = [ref for ref in job.get("attachment_refs") or []
                       if isinstance(ref, dict) and ref.get("kind") == "decisionx_native_source"]
        if job.get("state") == "complete" and admission and len(source_refs) >= 2:
            continue
        cursor = db.execute("UPDATE episodes SET state='retry',retry_after=0,updated=? "
                            "WHERE state='done' AND batch=?", (time.time(), batch))
        released += cursor.rowcount
    return released


def _dx_batch_priority(db):
    """Bulk labeling never preempts higher-value provider work."""
    return DX_PRIORITY


def _dx_diversified_source_refs(refs):
    """Round-robin verified sources across provider, year, then project hint."""
    cohorts = defaultdict(lambda: defaultdict(list))
    for ref in refs:
        provider, cid = str(ref.get("provider") or ""), str(ref.get("conversation_id") or "")
        if not provider or not cid:
            continue
        try:
            year = datetime.fromisoformat(str(ref.get("source_at_utc") or "").replace(
                "Z", "+00:00")).year
        except ValueError:
            year = 0
        project = str(ref.get("project_hint") or "unclassified").strip().casefold()[:80]
        cohorts[(provider, year)][project].append(ref)
    by_cohort = {}
    for cohort, projects in cohorts.items():
        ordered = []
        for group in projects.values():
            group.sort(key=lambda ref: hashlib.sha256(
                (str(ref["provider"]) + ":" + str(ref["conversation_id"])).encode()).hexdigest())
        project_keys = sorted(projects, key=lambda key: hashlib.sha256(key.encode()).hexdigest())
        while any(projects.values()):
            for key in project_keys:
                if projects[key]:
                    ordered.append(projects[key].pop(0))
        by_cohort[cohort] = ordered
    cohorts_ordered = sorted(by_cohort, key=lambda key: (key[1], key[0]))
    result = []
    while any(by_cohort.values()):
        for key in cohorts_ordered:
            if by_cohort[key]:
                result.append(by_cohort[key].pop(0))
    return result


def decisionx_batch_pump():
    """Incrementally create MULTI-episode Chat-mode jobs in the ONE hosted D1 queue."""
    state = _dx_load()
    if time.time() - float(state.get("last_scan") or 0) < DX_SCAN_INTERVAL_SECONDS: return
    # Do not build a private micro-corpus from whatever happens to have been
    # ingested on this device. A descriptor batch is a slice of the already
    # substantial, independently Drive-verified shared conversation stock.
    stock = _dx_stock_snapshot()
    if stock is None:
        return
    state["last_scan"] = time.time()
    # A genuine 500+ conversation corpus is substantive even when the available
    # source horizon is shorter than two years. Coverage remains visible to the
    # model and sampling allocator; an arbitrary age threshold must not shut
    # down the entire labeling capability.
    if int(stock.get("distinct_complete") or 0) < 500:
        atomic_json(DX_HOME / "scan.json", state)
        event("decisionx_batch_deferred_shared_stock", distinct_complete=stock.get("distinct_complete"),
              span_days=stock.get("span_days"))
        return
    bridge = _dx_bridge()
    verified = {(row["provider"], row["conversation_id"])
                for row in stock.get("verified_source_refs") or []}
    retired = _dx_retire_completed_inputs()
    if retired: event("decisionx_transport_inputs_retired", count=retired)
    with _dx_connection() as db:
        released = _dx_reconcile_queued(db)
        if released: event("decisionx_cancelled_batch_refs_released", episodes=released)
        unproved = _dx_reconcile_unproved_done(db)
        if unproved: event("decisionx_unproved_done_released", episodes=unproved)
        outstanding = db.execute(
            "SELECT COUNT(DISTINCT batch) FROM episodes WHERE state='queued' AND batch IS NOT NULL"
        ).fetchone()[0]
        if outstanding >= DX_MAX_UNADMITTED_BATCHES:
            # Let real native labeling and central descriptor admission tell us
            # whether these source slices are useful before allocating more
            # ChatGPT turns.  The D1 queue, not this local database, remains
            # the authority for job state; _dx_reconcile_queued refreshes it.
            atomic_json(DX_HOME / "scan.json", state)
            event("decisionx_batch_deferred_backpressure", outstanding=outstanding,
                  limit=DX_MAX_UNADMITTED_BATCHES)
            return
        # Retained handles may have been written by older episode-only scans.
        # A native batch reads one complete conversation per candidate; do not
        # spend one ChatGPT slot labeling the same source twice.
        pending = _dx_unique_source_refs(state.get("spool") or [])
        known = {e["episode_id"] for e in pending}
        known_sources = {(e["provider"], e["conversation_id"]) for e in pending}
        source_refs = _dx_diversified_source_refs(stock.get("verified_source_refs") or [])
        if not source_refs:
            raise RuntimeError("DecisionX verified stock lacks source references")
        # Pre-gate scans may have advanced the cursor past rare providers and
        # years. The first genuinely verified dispatch starts at the head of
        # the diversified stock, rather than inheriting that stale offset.
        cursor = (0 if db.execute("SELECT 1 FROM verified_dispatches LIMIT 1").fetchone() is None
                  else int(state.get("offset") or 0) % len(source_refs))
        end_of_corpus = False
        # The verified stock itself supplies stable source handles. Select one
        # episode from each source on this pass before returning for deeper turns.
        for _ in range(min(len(source_refs), DX_TARGET * 4)):
            if len(pending) >= DX_TARGET:
                break
            ref = source_refs[cursor]
            cursor = (cursor + 1) % len(source_refs)
            if cursor == 0:
                end_of_corpus = True
            provider, cid = ref["provider"], ref["conversation_id"]
            if (provider, cid) not in verified:
                continue
            if (provider, cid) in known_sources:
                continue
            try:
                result = sender.operator_memory_post({"operation":"read","provider":provider,
                                                      "conversation_id":cid})
            except Exception as exc:
                event("decisionx_source_retry_after_read_error", provider=provider,
                      conversation_id=cid, error=type(exc).__name__)
                continue
            if not result.get("ok") or bridge._complete_source(ref, result) is None:
                continue
            source = result.get("conversation") or {}
            if (source.get("prompt_sha256") != ref["prompt_sha256"]
                or source.get("response_sha256") != ref["response_sha256"]):
                continue
            source_added = 0
            for episode in _dx_extract(source):
                eid, sha = episode["episode_id"], episode["source_sha256"]
                old = db.execute("SELECT source_sha,state,retry_after FROM episodes WHERE id=?",(eid,)).fetchone()
                if old and old[0]==sha and (old[1] in ("done","queued") or old[2]>time.time()): continue
                if eid in known: continue
                pending.append(_dx_ref(episode));known.add(eid)
                known_sources.add((provider, cid))
                source_added += 1
                if source_added >= DX_EPISODES_PER_SOURCE_PER_SCAN or len(pending)>=DX_TARGET:
                    break
        state["offset"] = cursor
        state["spool"] = pending
        # Defer tail work until there are enough candidates; avoid micro-labeling calls.
        if len(pending) < DX_MIN and not (end_of_corpus and len(pending) >= DX_TAIL_MIN):
            atomic_json(DX_HOME/"scan.json",state)
            event("decisionx_batch_deferred",episodes=len(pending),cursor=cursor)
            return
        selected, stale = _dx_resolve(pending[:DX_TARGET],
            complete_source=lambda index, result: bridge._complete_source(index, result) is not None)
        selected = [episode for episode in selected
                    if (episode["provider"], episode["conversation_id"]) in verified]
        if stale:
            stale_ids = {(e["episode_id"], e["source_sha256"]) for e in stale}
            pending = [e for e in pending if (e["episode_id"],e["source_sha256"]) not in stale_ids]
            state["spool"] = pending
        if len(selected) < DX_MIN and not (end_of_corpus and len(selected) >= DX_TAIL_MIN):
            atomic_json(DX_HOME/"scan.json",state)
            event("decisionx_batch_deferred_after_source_change", episodes=len(selected), stale=len(stale))
            return
        bounded = []
        char_count = 0
        for episode in selected:
            size = len(json.dumps(episode, ensure_ascii=False))
            if bounded and char_count + size > DX_INPUT_CHAR_BUDGET: break
            bounded.append(episode)
            char_count += size
        selected = bounded
        attempt = 1 + max((int((db.execute(
            "SELECT attempts FROM episodes WHERE id=? AND source_sha=?",
            (e["episode_id"], e["source_sha256"])).fetchone() or (0,))[0])
            for e in selected), default=0)
        batch_source = "drive-verified-v3:attempt-" + str(attempt) + ":" + "".join(
            e["episode_id"] + e["source_sha256"] for e in selected)
        batch = hashlib.sha256(batch_source.encode()).hexdigest()[:32]
        srczip = _dx_input_zip(selected,batch)
        builder = _dx_source_batch_builder()
        selected_keys = {(row["provider"], row["conversation_id"]) for row in selected}
        source_refs = [row for row in stock["verified_source_refs"]
                       if (row["provider"], row["conversation_id"]) in selected_keys]
        full_zips = builder.build_source_batches(sender.operator_memory_post, source_refs,
            output_root=DX_HOME / "input" / batch / "full", bridge=bridge)
        if len(full_zips) + 1 > 64:
            raise ValueError("DecisionX native batch exceeds 64 physical attachments")
        packet_files = [{"path": str(srczip), "sha256": hashlib.sha256(srczip.read_bytes()).hexdigest()}]
        packet_files.extend(full_zips)
        refs = []
        for packet in packet_files:
            mirror = builder.publish_private(packet)
            refs.append({"ref": packet["path"], "sha256": packet["sha256"],
                         "mirrors": [mirror], "kind": "decisionx_native_source"})
        prompt = (DX_PROMPT + "\nBatch identity: " + batch + "\nAttempt: " + str(attempt)
                  + "\nEpisode count: " + str(len(selected)))
        digest = hashlib.sha256(prompt.encode("utf-8")).hexdigest()
        id_value = "decisionx-iae-" + batch
        priority = _dx_batch_priority(db)
        reply = sender.operator_memory_post({
            "operation":"enqueue_decisionx_prompt", "job_id":id_value,
            "provider":"chatgpt.com","prompt":prompt,
            "decisionx":{"authored_by":"DecisionX","decision_key":id_value,
                         "prompt_sha256":digest,"source_kind":"agent_memory_iae_batch"},
            "priority":priority,"project":"DecisionX",
            "role":"historical-decision-labeler","phase":"iae_label_batch",
            "reasoning_effort":"xhigh","model":"gpt-5-6-thinking",
            "taskflow_step":"iae-label-batch-"+batch,
            "assigned_employee":"DecisionX Chat-mode labeler",
            "attachment_refs":refs,
            "reason":"low_priority_large_batch_semantic_descriptors"})
        if not reply.get("ok") or (reply.get("job") or {}).get("state") not in {
                "queued", "claimed", "effect_pending_read_recovery", "complete"}:
            atomic_json(DX_HOME/"scan.json",state)
            raise RuntimeError("DecisionX enqueue was not retained as an actionable D1 job: "
                               + str(reply.get("error") or (reply.get("job") or {}).get("state")))
        db.execute("INSERT OR REPLACE INTO verified_dispatches"
                   "(batch,job_id,prompt_sha,priority,queued_at) VALUES(?,?,?,?,?)",
                   (batch,id_value,digest,priority,time.time()))
        now = time.time()
        for e in selected:
            db.execute("""INSERT INTO episodes(id,source_sha,state,attempts,retry_after,batch,updated)
                          VALUES(?,?, 'queued',1,0,?,?)
                          ON CONFLICT(id) DO UPDATE SET
                          source_sha=excluded.source_sha,state='queued',
                          attempts=episodes.attempts+1,retry_after=0,
                          batch=excluded.batch,updated=excluded.updated""",
                       (e["episode_id"],e["source_sha256"],batch,now))
        selected_ids = {(e["episode_id"],e["source_sha256"]) for e in selected}
        state["spool"] = [e for e in pending if (e["episode_id"],e["source_sha256"]) not in selected_ids]
        atomic_json(DX_HOME/"scan.json",state)
        event("decisionx_batch_queued",job_id=id_value,episodes=len(selected),
              priority=priority,idempotent=reply.get("idempotent",False))

def _dx_packet_paths(job):
    packets = []
    for attachment in job.get("attachment_refs") or []:
        if not isinstance(attachment, dict):
            raise ValueError("DecisionX input packet reference malformed")
        expected = str(attachment.get("sha256") or "")
        if not re.fullmatch(r"[0-9a-f]{64}", expected):
            raise ValueError("DecisionX input packet lacks exact SHA")
        ref = str(attachment.get("ref") or "")
        local = Path(ref[5:] if ref.startswith("file:") else ref)
        if not local.is_file() or hashlib.sha256(local.read_bytes()).hexdigest() != expected:
            mirrors = attachment.get("mirrors") or []
            candidates = []
            for mirror in mirrors:
                try:
                    candidates.append(_stage_remote_attachment(str(mirror), expected))
                except (OSError, ValueError, RuntimeError, subprocess.SubprocessError):
                    continue
            local = next((path for path in candidates if path.is_file()
                          and hashlib.sha256(path.read_bytes()).hexdigest() == expected), local)
        if not local.is_file() or hashlib.sha256(local.read_bytes()).hexdigest() != expected:
            raise ValueError("DecisionX physical input packet unavailable or changed")
        if local.stat().st_size > MAX_ATTACHMENT_BYTES:
            raise ValueError("DecisionX physical input packet exceeds 20 MiB")
        packets.append({"path": local, "sha256": expected})
    if not packets:
        raise ValueError("DecisionX input packets missing")
    return packets


def _dx_full_source_refs(packets):
    refs = {}
    for packet in packets[1:]:
        with zipfile.ZipFile(packet["path"]) as source_archive:
            manifest = json.loads(source_archive.read("MANIFEST.json"))
            if manifest.get("schema") != "cognilode.root_memory_sources.v1":
                raise ValueError("complete source packet schema mismatch")
            for row in manifest.get("parts") or []:
                key = (str(row.get("provider") or ""), str(row.get("conversation_id") or ""))
                identity = (str(row.get("prompt_sha256") or ""), str(row.get("response_sha256") or ""))
                if key in refs and refs[key] != identity:
                    raise ValueError("complete source identity conflict")
                refs[key] = identity
    return refs


def _dx_adjacent_triplet_valid(label, source):
    if "double_triplet" not in label:
        return False
    adjacent = label["double_triplet"]
    if adjacent is None:
        return True
    next_user = source.get("next_user_turn") or {}
    following = source.get("following_action_turns") or []
    final_user = source.get("following_user_turn") or {}
    if not isinstance(adjacent, dict) or not next_user or not following:
        return False
    has_evaluation = adjacent.get("e") is not None
    return (adjacent.get("instruction_turn_id") == next_user.get("id")
            and adjacent.get("action_turn_ids") == [turn.get("id") for turn in following]
            and adjacent.get("evaluation_turn_id") ==
                (final_user.get("id") if has_evaluation else None)
            and all(isinstance(adjacent.get(key), str) and len(adjacent[key].strip()) >= 20
                    for key in ("i", "a", "relationship"))
            and (adjacent.get("e") is None
                 or isinstance(adjacent.get("e"), str) and len(adjacent["e"].strip()) >= 20)
            and (not has_evaluation or bool(final_user)))


def decisionx_admit_labels(job, files, conversation_id, *, preflight_error=None):
    """Admit actual returned semantic records into existing Agent Memory segments."""
    if job.get("phase") != "iae_label_batch": return None
    batch = str(job["id"]).removeprefix("decisionx-iae-")
    try:
        packets = _dx_packet_paths(job)
        input_zip = packets[0]["path"]
        full_refs = _dx_full_source_refs(packets)
    except (OSError, ValueError, RuntimeError):
        if preflight_error:
            return {"requested": 0, "admitted": 0, "retry_pending": 0,
                    "label_error": preflight_error, "input_zip_sha256": None,
                    "output_zip_sha256": None}
        raise
    with zipfile.ZipFile(input_zip) as archive:
        input_manifest = json.loads(archive.read("manifest.json"))
        sources = {r["episode_id"]:r for r in (json.loads(line) for line in archive.read("episodes.jsonl").decode("utf-8").splitlines() if line.strip())}
    expected = {r["episode_id"]:r["source_sha256"] for r in input_manifest["episodes"]}
    output = next((Path(r["path"]) for r in files if str(r["name"] or "").lower().endswith(".zip")),None)
    label_error = preflight_error
    records = []
    try:
        if preflight_error: raise ValueError(preflight_error)
        if output is None:
            raise ValueError("missing_label_output")
        with zipfile.ZipFile(output) as archive:
            names=archive.namelist()
            name=next((n for n in names if n.split("/")[-1]=="decisionx_iae_labels.jsonl"),None)
            if not name: raise ValueError("missing_decisionx_iae_labels_jsonl")
            records=[json.loads(x) for x in archive.read(name).decode("utf-8").splitlines() if x.strip()]
    except (OSError,ValueError,zipfile.BadZipFile,KeyError,json.JSONDecodeError) as exc:
        # A provider terminal result is real even if the labeling artifact was
        # malformed. Track failed semantic work and automatically requeue it.
        label_error = type(exc).__name__ + ":" + str(exc)[:140]
    current_ids = set()
    if records:
        bridge = _dx_bridge()
        current, _ = _dx_resolve([_dx_ref(src) for src in sources.values()],
            complete_source=lambda index, result: (
                bridge._complete_source(index, result) is not None
                and full_refs.get((index["provider"], index["conversation_id"])) == (
                    str((result.get("conversation") or {}).get("prompt_sha256") or ""),
                    str((result.get("conversation") or {}).get("response_sha256") or ""))))
        current_ids = {(row["episode_id"], row["source_sha256"]) for row in current}
    selected, seen = [], set()
    for row in records:
        if not isinstance(row,dict): continue
        eid = str(row.get("episode_id") or "")
        if (eid in seen or expected.get(eid)!=row.get("source_sha256")
                or (eid, expected.get(eid)) not in current_ids): continue
        i,a = row.get("i"),row.get("a")
        if (not isinstance(i,str) or not isinstance(a,str) or len(i.strip()) < 20
                or len(a.strip()) < 20 or not isinstance(row.get("embedding_text"),str)
                or len(row["embedding_text"].strip()) < 30
                or not isinstance(row.get("tags"),list)
                or not isinstance(row.get("human_authorship_assessment"),str)
                or not isinstance(row.get("uncertainty"),str)):
            continue
        src = sources[eid]
        following = src.get("following_action_turns") or []
        if not _dx_adjacent_triplet_valid(row, src):
            continue
        segment_id = "decisionx.iae." + hashlib.sha256((eid+expected[eid]).encode()).hexdigest()
        content = json.dumps(row,sort_keys=True,ensure_ascii=False)
        if len(content)>180000: continue
        row["source_locator"] = {"provider":src.get("provider"),"conversation_id":src.get("conversation_id"),
                                  "intent_turn_id":src["intent_turn"].get("id"),
                                  "action_turn_ids":[r.get("id") for r in src.get("action_turns") or []],
                                  "evaluation_turn_id":(src.get("next_user_turn") or {}).get("id"),
                                  "following_action_turn_ids":[r.get("id") for r in following],
                                  "following_evaluation_turn_id":(src.get("following_user_turn") or {}).get("id")}
        content = json.dumps(row,sort_keys=True,ensure_ascii=False)
        seen.add(eid)
        selected.append({"segment_id":segment_id,"kind":"IAE",
                         "source_key":str(src.get("provider"))+":"+str(src.get("conversation_id")),"author_class":"agent_derived",
                         "origin":"chatgpt.com:decisionx_iae_label",
                         "content":content,
                         "metadata":{"source_episode_id":eid,
                                     "source_sha256":expected[eid],
                                     "drive_verified_source":True,
                                     "full_source_prompt_sha256":full_refs[(src["provider"],src["conversation_id"])][0],
                                     "full_source_response_sha256":full_refs[(src["provider"],src["conversation_id"])][1],
                                     "label_conversation_id":conversation_id,
                                     "label_batch_id":batch,
                                     "intent_turn_id":src["intent_turn"].get("id"),
                                     "action_turn_ids":[r.get("id") for r in src.get("action_turns") or []],
                                     "evaluation_turn_id":(src.get("next_user_turn") or {}).get("id"),
                                     "following_action_turn_ids":[r.get("id") for r in following],
                                     "following_evaluation_turn_id":(src.get("following_user_turn") or {}).get("id"),
                                     "source_authorship":src["intent_turn"].get("authorship","unverified")}})
    # Existing append-only D1 segment store with idempotent segment IDs and FTS.
    for offset in range(0,len(selected),24):
        result=sender.operator_memory_post({"operation":"append_segments",
                                             "segments":selected[offset:offset+24]})
        if not result.get("ok"):raise RuntimeError("Agent Memory label admission rejected")
    missing=set(expected)-seen
    with _dx_connection() as db:
        now=time.time()
        for eid in seen:
            db.execute("UPDATE episodes SET state='done',updated=? WHERE id=?",(now,eid))
        for eid in missing:
            previous=db.execute("SELECT attempts FROM episodes WHERE id=?",(eid,)).fetchone()
            attempts=(previous[0] if previous else 1)
            cooldown=min(86400,900*(2**min(7,attempts)))
            db.execute("UPDATE episodes SET state='retry',retry_after=?,updated=? WHERE id=?",
                       (now+cooldown,now,eid))
    event("decisionx_label_admitted",job_id=job["id"],label_error=label_error,requested=len(expected),
          accepted=len(seen),missing=len(missing),conversation_id=conversation_id)
    return {"requested":len(expected),"admitted":len(seen),"retry_pending":len(missing),
            "admitted_episode_ids":sorted(seen),
            "label_error":label_error,
            "input_zip_sha256":hashlib.sha256(input_zip.read_bytes()).hexdigest(),
            "output_zip_sha256":hashlib.sha256(output.read_bytes()).hexdigest() if output and output.is_file() else None}


def _dx_native_preflight(job, files, value, evidence):
    if job.get("phase") != "iae_label_batch": return None
    if not any(row.get("kind") == "provider_observed_native_exec" for row in evidence):
        return "missing_provider_observed_native_exec"
    refs = job.get("attachment_refs") or []
    if len(refs) < 2 or len(refs) > 64: return "missing_exact_input_zip"
    try:
        packets = _dx_packet_paths(job)
    except (OSError, ValueError, RuntimeError):
        return "input_zip_sha_mismatch"
    expected = packets[0]["sha256"]
    input_path = packets[0]["path"]
    central = value.get("central_conversation_store") or {}
    uploads = central.get("provider_structured_uploads") or []
    uploaded = {str(row.get("sha256") or "") for row in uploads if isinstance(row,dict)}
    if any(packet["sha256"] not in uploaded for packet in packets):
        return "provider_upload_proof_missing"
    output = [row for row in files if str(row.get("name") or "").lower().endswith(".zip")]
    if len(output) != 1: return "output_zip_count_invalid"
    result = output[0]
    path = Path(str(result.get("path") or ""))
    if not path.is_file() or hashlib.sha256(path.read_bytes()).hexdigest() != result.get("sha256"):
        return "output_zip_sha_mismatch"
    try:
        with zipfile.ZipFile(path) as archive:
            if archive.testzip() is not None: return "output_zip_crc_failed"
            names = set(archive.namelist())
            if not {"NATIVE_COMPUTE.json", "neighbors.json",
                    "decisionx_iae_labels.jsonl", "EXTERNAL_EFFECT_INSTRUCTIONS.md"} <= names:
                return "native_work_product_files_missing"
            compute = json.loads(archive.read("NATIVE_COMPUTE.json"))
            neighbors = archive.read("neighbors.json")
            neighbor_rows = json.loads(neighbors)
        with zipfile.ZipFile(input_path) as source_archive:
            input_manifest = json.loads(source_archive.read("manifest.json"))
        source_refs = _dx_full_source_refs(packets)
        input_ids = {str(row.get("episode_id") or "") for row in input_manifest.get("episodes") or []}
        produced_refs = {(str(row.get("provider") or ""), str(row.get("conversation_id") or ""),
                          str(row.get("prompt_sha256") or ""), str(row.get("response_sha256") or ""))
                         for row in compute.get("source_refs") or []}
        expected_refs = {(*key,*identity) for key,identity in source_refs.items()}
        if (compute.get("schema") != "decisionx.native_batch_compute.v1"
                or compute.get("input_zip_sha256") != expected
                or compute.get("source_zip_sha256s") != [packet["sha256"] for packet in packets[1:]]
                or compute.get("distinct_complete_sources") != len(source_refs)
                or produced_refs != expected_refs
                or compute.get("neighbors_sha256") != hashlib.sha256(neighbors).hexdigest()
                or compute.get("episode_count") != input_manifest.get("episode_count")
                or compute.get("episode_count") != len(input_ids)
                or compute.get("episode_count") != compute.get("distinct_episode_count")
                or not isinstance(neighbor_rows,list)
                or {str(row.get("episode_id") or "") for row in neighbor_rows} != input_ids):
            return "native_compute_proof_mismatch"
    except (OSError, ValueError, KeyError, TypeError, AttributeError, zipfile.BadZipFile, json.JSONDecodeError):
        return "native_compute_proof_invalid"
    return None


def validated_result(value: dict, job: dict | None = None) -> tuple[str, list[dict]] | None:
    central = value.get("central_conversation_store") or {}
    conversation_id = str(value.get("conversation_id") or "")
    if not (value.get("assistant_terminal") is True and central.get("central_readback_verified") is True
            and central.get("conversation_id") == conversation_id and conversation_id):
        return None
    # RPE producer cells ask for source analysis in the terminal response, not
    # an external-effect ZIP. Bind text-only completion to the exact D1 RPE
    # request and centrally read-back response so a different turn cannot
    # satisfy this cell or borrow the TaskFlow sandbox-artifact contract.
    if job is not None and job.get("prompt_author") == "rpe_run":
        proof = job.get("rpe_run_receipt") or {}
        answer = value.get("terminal_assistant_text") or ""
        # D1 fences the original plan bytes; the existing Chat-mode sender
        # calls strip() before POST and central admission. Verify both forms.
        raw_prompt = str(job.get("prompt") or "")
        if (proof.get("schema") != "cognilode.rpe.model_request.v1"
                or job.get("id") != f"rpe-{proof.get('request_id')}"
                or value.get("queue_job_id") != job.get("id")
                or hashlib.sha256(raw_prompt.encode("utf-8")).hexdigest()
                   != job.get("prompt_sha256")
                or central.get("central_prompt_sha256")
                   != hashlib.sha256(raw_prompt.strip().encode("utf-8")).hexdigest()
                or not isinstance(answer, str) or not answer.strip()
                or hashlib.sha256(answer.encode("utf-8")).hexdigest()
                   != central.get("central_response_sha256")):
            return None
        return conversation_id, []
    files = []
    for item in value.get("downloaded_files") or []:
        path = Path(str(item.get("path") or ""))
        digest = str(item.get("sha256") or "")
        if (not path.is_file() or not 0 < path.stat().st_size <= MAX_RETURNED_WORK_BYTES
                or _sha256_file(path) != digest):
            return None
        if path.suffix.lower() == ".zip":
            try:
                with zipfile.ZipFile(path) as archive:
                    instructions = [name for name in archive.namelist()
                                    if name == "EXTERNAL_EFFECT_INSTRUCTIONS.md"
                                    or (name.count("/") == 1 and name.split("/", 1)[0]
                                        not in {"", ".", ".."} and
                                        name.endswith("/EXTERNAL_EFFECT_INSTRUCTIONS.md"))]
                    if len(instructions) != 1:
                        return None
                    info = archive.getinfo(instructions[0])
                    if info.file_size > 1_000_000 or not archive.read(info):
                        return None
            except (OSError, KeyError, zipfile.BadZipFile):
                return None
        files.append({"path": str(path), "sha256": digest, "name": item.get("name")})
    if len([f for f in files if str(f["name"] or "").lower().endswith(".zip")]) != 1:
        return None
    return conversation_id, files


def terminal_deliverable_candidate(job: dict, value: dict | None) -> bool:
    """A final, centrally reread Chat-mode turn whose required ZIP is unusable."""
    if (not value or job.get("provider") != "chatgpt.com"
            or job.get("phase") not in {"chatgpt_sandbox", "iae_label_batch"}):
        return False
    central = value.get("central_conversation_store") or {}
    cid = str(value.get("conversation_id") or "")
    return bool(value.get("assistant_terminal") is True and value.get("terminal_assistant_text")
                and value.get("terminal_assistant_message_id") and cid
                and central.get("central_readback_verified") is True
                and central.get("conversation_id") == cid and validated_result(value) is None)


def terminal_deliverable_deadline(job: dict, value: dict) -> float:
    observed = float(value.get("completed_at") or 0)
    if observed <= 0:
        raise ValueError("terminal collector has no durable completion timestamp")
    started = datetime.fromisoformat(str(job.get("effect_started_at") or "").replace("Z", "+00:00")).timestamp()
    if started <= 0:
        raise ValueError("D1 job lacks durable effect start")
    return min(observed + TERMINAL_DELIVERABLE_WINDOW_SECONDS,
               started + TERMINAL_DELIVERABLE_ABSOLUTE_SECONDS)


def complete_failed_deliverable(job: dict, value: dict, *, deadline: float) -> bool:
    """Fenced completion records a work-product defect, never semantic success."""
    if not terminal_deliverable_candidate(job, value):
        return False
    cid = str(value["conversation_id"])
    text_sha = hashlib.sha256(str(value["terminal_assistant_text"]).encode()).hexdigest()
    evidence = [{"kind": "provider_conversation", "ref": cid},
                {"kind": "central_conversation_readback", "ref": cid},
                {"kind": "chatgpt_terminal_deliverable_failure", "ref": text_sha,
                 "conversation_id": cid,
                 "terminal_assistant_message_id": str(value["terminal_assistant_message_id"]),
                 "reason": "no_usable_single_work_zip_after_bounded_get_collection",
                 "collection_deadline_epoch": deadline}]
    evidence.extend(tool_evidence_from_result(value))
    reply = sender.operator_memory_post({"operation": "complete_job", **fence(job),
                                         "conversation_id": cid, "effect_evidence": evidence})
    if not reply.get("ok"):
        event("failed_deliverable_completion_retry_required", job_id=job["id"], error=reply.get("error"))
        return False
    committed = sender.operator_memory_post({"operation": "get_job", "job_id": job["id"]}).get("job") or {}
    matching = [row for row in committed.get("effect_evidence") or [] if isinstance(row, dict)
                and row.get("kind") == "chatgpt_terminal_deliverable_failure" and row.get("ref") == text_sha]
    if committed.get("state") != "complete" or committed.get("conversation_id") != cid or len(matching) != 1:
        event("failed_deliverable_readback_retry_required", job_id=job["id"], conversation_id=cid)
        return False
    atomic_json(job_state_path(job["id"]), {"state": "complete_failed_deliverable", "job_id": job["id"],
                                             "conversation_id": cid, "terminal_text_sha256": text_sha})
    event("job_completed_failed_deliverable", job_id=job["id"], conversation_id=cid,
          terminal_text_sha256=text_sha)
    return True


def publish_taskflow_work_zip(path: Path, digest: str) -> str:
    """Make a returned ZIP readable by the external-effect employee's device.

    This runs after terminal collection, before D1 completion. A failed or
    ambiguous upload leaves the claimed job for collection recovery; it never
    sends the provider prompt again.
    """
    bucket = os.environ.get("COGNILODE_TASKFLOW_ATTACHMENT_S3_BUCKET", "").strip()
    aws = os.environ.get("COGNILODE_AWS_CLI") or shutil.which("aws")
    if not bucket or not aws:
        raise RuntimeError("private TaskFlow work-product launchpad unavailable")
    if (path.suffix.lower() != ".zip" or not path.is_file()
            or not 0 < path.stat().st_size <= MAX_RETURNED_WORK_BYTES
            or not re.fullmatch(r"[0-9a-f]{64}", digest)
            or _sha256_file(path) != digest):
        raise ValueError("returned TaskFlow ZIP SHA or size mismatch")
    key = f"taskflow-artifacts/sha256/{digest}.zip"
    base = [aws, "s3api"]
    head_args = base + ["head-object", "--bucket", bucket, "--key", key, "--output", "json"]
    head = subprocess.run(head_args, capture_output=True, text=True, check=False, timeout=30)
    if head.returncode != 0:
        subprocess.run(base + ["put-object", "--bucket", bucket, "--key", key,
                               "--body", str(path), "--server-side-encryption", "AES256",
                               "--metadata", f"sha256={digest}", "--content-type", "application/zip",
                               "--output", "json"], capture_output=True, text=True,
                       check=True, timeout=1800)
        head = subprocess.run(head_args, capture_output=True, text=True, check=True, timeout=30)
    metadata = json.loads(head.stdout)
    if (int(metadata.get("ContentLength") or 0) != path.stat().st_size
            or (metadata.get("Metadata") or {}).get("sha256") != digest):
        raise ValueError("private TaskFlow ZIP metadata mismatch")
    ROOT.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=ROOT, delete=False) as temp:
        readback = Path(temp.name)
    try:
        subprocess.run(base + ["get-object", "--bucket", bucket, "--key", key,
                               str(readback), "--output", "json"], capture_output=True,
                       text=True, check=True, timeout=1800)
        if _sha256_file(readback) != digest:
            raise ValueError("private TaskFlow ZIP full readback SHA mismatch")
    finally:
        readback.unlink(missing_ok=True)
    return f"s3://{bucket}/{key}"


def result_for_job(job_id: str) -> dict | None:
    stem = job_stem(job_id)
    candidates = []
    for suffix in (".collected.json", ".json"):
        path = sender.DEFAULT_OUTPUT_ROOT / (stem + suffix)
        if not path.is_file():
            continue
        try:
            value = json.loads(path.read_text(encoding="utf-8"))
            if isinstance(value, dict):
                candidates.append((path.stat().st_mtime, value.get("result", value)))
        except (OSError, ValueError):
            continue
    if not candidates:
        return None
    for _, value in sorted(candidates, reverse=True):
        if isinstance(value, dict) and validated_result(value):
            return value
    return max(candidates, key=lambda row: row[0])[1]


def tool_evidence_from_result(value: dict) -> list[dict]:
    path_text = value.get("raw_path_host") or value.get("raw_path")
    digest = value.get("raw_sha256")
    if not isinstance(path_text, str) or not isinstance(digest, str):
        return []
    path = Path(path_text)
    try:
        if not path.is_file() or path.stat().st_size > 50 * 1024 * 1024:
            return []
        return provider_tool_evidence(path.read_bytes(), expected_sha256=digest)
    except (OSError, ValueError):
        return []


def fence(job: dict) -> dict:
    return {"job_id": job["id"], "worker_id": job["claimed_by"],
            "lease_token": job["lease_token"], "lease_generation": job["lease_generation"]}


def complete_legacy_export_match(job: dict, value: dict) -> bool:
    """Finish only a migrated text job bound by export and exact live readback.

    These old status jobs predate the one-ZIP TaskFlow contract.  Their provider
    effect can be recognized without inventing the newer deterministic message ID.
    """
    if (job.get("state") != "effect_pending"
        or job.get("migrated_from") != "cloudflare-kv-agent-memory-prompt-job"
        or job.get("migration_hold_reason") != "legacy_job_may_have_started_provider_effect"
        or job.get("phase") is not None
        or value.get("identity_source") != "privacy_export_exact_prompt_message"
        or value.get("queue_job_id") != job.get("id")
        or value.get("prompt_sha256") != job.get("prompt_sha256")
        or value.get("collection_method") != "read_only_exact_branch_hydration"
        or value.get("assistant_terminal") is not True
        or not value.get("terminal_assistant_text")
        or not value.get("terminal_assistant_message_id")
        or not value.get("user_message_id")):
        return False
    cid = str(value.get("conversation_id") or "")
    central = value.get("central_conversation_store") or {}
    if not cid or central.get("conversation_id") != cid or central.get("central_readback_verified") is not True:
        return False
    collected = sender.DEFAULT_OUTPUT_ROOT / (job_stem(job["id"]) + ".collected.json")
    try:
        row = json.loads(collected.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return False
    if (row.get("complete") is not True or row.get("prompt_sha256") != job.get("prompt_sha256")
        or hashlib.sha256(str(row.get("prompt") or "").encode()).hexdigest() != job.get("prompt_sha256")):
        return False
    evidence = [{"kind": "provider_conversation", "ref": cid},
                {"kind": "provider_user_message", "ref": str(value["user_message_id"])},
                {"kind": "central_conversation_readback", "ref": cid},
                {"kind": "privacy_export_exact_match", "ref": str(value.get("export_member_crc32") or ""),
                 "prompt_sha256": job["prompt_sha256"],
                 "export_member": str(value.get("export_member") or ""),
                 "export_etag": str(value.get("export_etag") or "")}]
    reply = sender.operator_memory_post({"operation": "complete_job", **fence(job),
                                          "conversation_id": cid, "effect_evidence": evidence})
    if not reply.get("ok"):
        event("legacy_export_completion_retry_required", job_id=job["id"], error=reply.get("error"))
        return False
    committed = sender.operator_memory_post({"operation": "get_job", "job_id": job["id"]}).get("job") or {}
    if committed.get("state") != "complete" or committed.get("conversation_id") != cid:
        event("legacy_export_completion_readback_retry_required", job_id=job["id"])
        return False
    atomic_json(job_state_path(job["id"]), {"state": "complete", "job_id": job["id"],
                                           "conversation_id": cid,
                                           "identity_source": "privacy_export_exact_prompt_message"})
    event("legacy_export_job_completed", job_id=job["id"], conversation_id=cid)
    return True


def complete_from_result(job: dict, value: dict) -> bool:
    checked = validated_result(value, job)
    if not checked:
        return False
    conversation_id, files = checked
    if job.get("prompt_author") == "rpe_run":
        text_sha = hashlib.sha256(value["terminal_assistant_text"].encode("utf-8")).hexdigest()
        evidence = [{"kind": "provider_conversation", "ref": conversation_id},
                    {"kind": "central_conversation_readback", "ref": conversation_id},
                    {"kind": "rpe_terminal_research_text", "ref": text_sha,
                     "request_id": job["rpe_run_receipt"]["request_id"],
                     "run_id": job["rpe_run_receipt"]["run_id"]}]
        reply = sender.operator_memory_post({"operation": "complete_job", **fence(job),
                                             "conversation_id": conversation_id,
                                             "effect_evidence": evidence})
        if reply.get("ok"):
            atomic_json(job_state_path(job["id"]), {"state": "complete", "job_id": job["id"],
                                                    "conversation_id": conversation_id,
                                                    "terminal_text_sha256": text_sha})
            event("rpe_research_turn_completed", job_id=job["id"],
                  conversation_id=conversation_id, terminal_text_sha256=text_sha)
            return True
        event("completion_rejected", job_id=job["id"], error=reply.get("error"))
        return False
    if (job.get("taskflow_multi_phase") or (job.get("payload") or {}).get("taskflow_multi_phase")
        or job.get("phase") == "decisionx_successor"):
        try:
            for row in files:
                if str(row["name"] or "").lower().endswith(".zip"):
                    row["mirrors"] = [publish_taskflow_work_zip(Path(row["path"]), row["sha256"])]
        except Exception as exc:
            event("taskflow_work_zip_mirror_retry_required", job_id=job["id"],
                  error=type(exc).__name__ + ":" + str(exc)[:240])
            return False
    native_evidence = tool_evidence_from_result(value)
    preflight_error = _dx_native_preflight(job, files, value, native_evidence)
    try:
        decisionx_result = decisionx_admit_labels(job, files, conversation_id,
                                                   preflight_error=preflight_error)
    except Exception as exc:
        event("decisionx_admission_retry_required",job_id=job["id"],error=type(exc).__name__+":"+str(exc)[:240])
        return False
    evidence = [{"kind": "provider_conversation", "ref": conversation_id},
                {"kind": "central_conversation_readback", "ref": conversation_id}]
    evidence.extend({"kind": "chatgpt_sandbox_artifact", "ref": row["sha256"], "path": row["path"],
                     **({"mirrors": row["mirrors"]} if row.get("mirrors") else {})} for row in files)
    evidence.extend(native_evidence)
    if decisionx_result is not None:
        evidence.append({"kind":"decisionx_label_admission","ref":job["id"],**decisionx_result})

    reply = sender.operator_memory_post({"operation": "complete_job", **fence(job),
                                          "conversation_id": conversation_id, "effect_evidence": evidence})
    if reply.get("ok"):
        atomic_json(job_state_path(job["id"]), {"state": "complete", "job_id": job["id"],
                                               "conversation_id": conversation_id, "artifacts": files})
        event("job_completed", job_id=job["id"], conversation_id=conversation_id, artifacts=len(files))
        return True
    event("completion_rejected", job_id=job["id"], error=reply.get("error"))
    return False


def recover(job: dict, device_id: str = DEVICE_ID) -> None:
    value = result_for_job(job["id"])
    if value and definitive_rejection(value):
        requeue_definitive_rejection(job, value)
        return
    if value and complete_legacy_export_match(job, value):
        return
    if value and complete_from_result(job, value):
        return
    if value and validated_result(value, job):
        return  # Central/effect admission can retry without more provider reads.
    if (value and str(job.get("id") or "").startswith("rpe-req-")
            and value.get("assistant_terminal") is True
            and (value.get("central_conversation_store") or {}).get("central_readback_verified") is True):
        # The exact terminal turn already exists locally and centrally. A
        # metadata mismatch is a held custody issue, not a reason to hydrate
        # ChatGPT again. Record one bounded structural diagnosis per change.
        central = value.get("central_conversation_store") or {}
        proof = job.get("rpe_run_receipt") or {}
        answer = value.get("terminal_assistant_text") or ""
        raw_prompt = str(job.get("prompt") or "")
        checks = {
            "rpe_authority": job.get("prompt_author") == "rpe_run",
            "rpe_receipt": proof.get("schema") == "cognilode.rpe.model_request.v1"
                           and job.get("id") == f"rpe-{proof.get('request_id')}",
            "queue_identity": value.get("queue_job_id") == job.get("id"),
            "prompt_hash": (hashlib.sha256(raw_prompt.encode("utf-8")).hexdigest()
                            == job.get("prompt_sha256")
                            and central.get("central_prompt_sha256")
                            == hashlib.sha256(raw_prompt.strip().encode("utf-8")).hexdigest()),
            "response_hash": isinstance(answer, str) and bool(answer.strip())
                             and hashlib.sha256(answer.encode("utf-8")).hexdigest()
                                 == central.get("central_response_sha256"),
            "conversation_identity": central.get("conversation_id") == value.get("conversation_id"),
        }
        state_path = job_state_path(job["id"])
        try:
            previous = json.loads(state_path.read_text(encoding="utf-8")) if state_path.is_file() else {}
        except (OSError, ValueError):
            previous = {}
        if previous.get("rpe_validation_checks") != checks:
            atomic_json(state_path, {**previous, "state": "terminal_rpe_validation_hold",
                                     "job_id": job["id"], "rpe_validation_checks": checks})
            event("terminal_rpe_validation_hold", job_id=job["id"], checks=checks)
        return
    state_path = job_state_path(job["id"])
    try:
        prior_state = json.loads(state_path.read_text(encoding="utf-8")) if state_path.is_file() else {}
    except (OSError, ValueError):
        prior_state = {}
    receipt = sender.DEFAULT_OUTPUT_ROOT / (job_stem(job["id"]) + ".sse.receipt.json")
    if (job.get("migrated_from") == "cloudflare-kv-agent-memory-prompt-job"
        and job.get("migration_hold_reason") == "legacy_job_may_have_started_provider_effect"):
        # The old workers did not use this queue's deterministic user-message
        # ID. Scanning the recent provider index for that invented ID only
        # burns rate limit and can never establish the old turn's identity.
        # Keep D1 effect_pending until a real old receipt/export binds it.
        now = time.time()
        local = {}
        if receipt.is_file():
            try:
                local = json.loads(receipt.read_text(encoding="utf-8"))
            except (OSError, ValueError):
                pass
        export_bound = (local.get("identity_source") == "privacy_export_exact_prompt_message"
                        and local.get("queue_job_id") == job["id"]
                        and local.get("prompt_sha256") == job.get("prompt_sha256")
                        and bool(local.get("user_message_id"))
                        and bool(local.get("conversation_id")))
        if not export_bound and now < float(prior_state.get("legacy_identity_next_check_at") or 0):
            return
        custody = {}
        try:
            custody = (send_custody(job) or {}).get("custody") or {}
        except Exception:
            pass
        expected = stable_user_message_id(str(job["id"]))
        if (not export_bound and custody.get("user_message_id") != expected
            and local.get("user_message_id") != expected):
            atomic_json(state_path, {**prior_state, "state": "legacy_identity_missing",
                "job_id": job["id"], "legacy_identity_next_check_at": now + 6 * 3600,
                "identity_recovery_sources": ["original_worker_receipt", "privacy_export_conversation",
                                              "historical_rollout_provider_stream"],
                "provider_recent_index_skipped": True})
            event("legacy_identity_missing_provider_scan_suppressed", job_id=job["id"])
            return
    if terminal_deliverable_candidate(job, value) and time.time() < float(prior_state.get("deliverable_next_collect_at") or 0):
        return
    if not receipt.exists():
        try:
            custody = (send_custody(job) or {}).get("custody") or {}
        except Exception:
            custody = {}
        conversation_id = str(custody.get("conversation_id") or "")
        if conversation_id and custody.get("user_message_id") == stable_user_message_id(str(job["id"])):
            atomic_json(receipt, {"state": "provider_accepted", "queue_job_id": job["id"],
                "user_message_id": custody["user_message_id"], "conversation_id": conversation_id,
                "transport": "codex_portable_auth_http" if os.environ.get("COGNILODE_CHATMODE_PORTABLE") == "1" else "codex_desktop_auth_http",
                "model": job.get("requested_model") or job.get("model") or "gpt-5-6-thinking",
                "thinking_effort": job.get("reasoning_effort") or "xhigh",
                "attached_context_files": [], "recovered_from_central_custody": True})
            event("cross_device_receipt_reconstructed", job_id=job["id"], conversation_id=conversation_id)
    if receipt.exists():
        collection = subprocess.run([sys.executable, str(COLLECTOR_PATH), "--receipt", str(receipt), "--limit", "1"],
                                    capture_output=True, text=True, timeout=180, check=False)
        outcomes = []
        try:
            body = json.loads(collection.stdout) if collection.returncode == 0 else {}
            outcomes = body.get("outcomes") or []
            fresh_collection = bool(len(outcomes) == 1 and outcomes[0].get("state") == "collected"
                                    and outcomes[0].get("record") == str(receipt.with_name(
                                        receipt.name.removesuffix(".sse.receipt.json") + ".collected.json")))
        except (ValueError, TypeError, AttributeError):
            fresh_collection = False
        value = result_for_job(job["id"])
        if value:
            if complete_legacy_export_match(job, value) or complete_from_result(job, value) or validated_result(value, job):
                return
        if terminal_deliverable_candidate(job, value):
            now = time.time()
            deadline = max(terminal_deliverable_deadline(job, value),
                           float(prior_state.get("deliverable_deadline_at") or 0))
            latest_fresh = now if fresh_collection else float(prior_state.get("deliverable_fresh_collection_at") or 0)
            # A prior successful GET cannot justify failure classification if
            # the current post-deadline collector request hit 403/502/429.
            if now >= deadline and fresh_collection:
                complete_failed_deliverable(job, value, deadline=deadline)
                return
            if not fresh_collection:
                # A gate cooldown, deployment gap, or exact artifact GET still
                # in progress is not a provider deliverable defect. Keep a
                # bounded fresh-observation window after collection recovers.
                deadline = max(deadline, now + TERMINAL_DELIVERABLE_WINDOW_SECONDS)
            next_at = now + TERMINAL_DELIVERABLE_RECHECK_SECONDS
            atomic_json(state_path, {**prior_state, "state": "terminal_deliverable_collection",
                                     "job_id": job["id"], "deliverable_deadline_at": deadline,
                                     "deliverable_deadline_renewed": not fresh_collection,
                                     "deliverable_next_collect_at": next_at,
                                     "deliverable_fresh_collection_at": latest_fresh,
                                     "collector_state": outcomes[0].get("state") if collection.returncode == 0 and outcomes else "collector_error"})
            event("terminal_deliverable_collection_wait", job_id=job["id"], conversation_id=value["conversation_id"],
                  deadline_at=deadline, next_collect_at=next_at, fresh_collection=bool(latest_fresh))
            return
        # The export supplied the original user-message and conversation IDs.
        # A deferred exact GET needs only the collector's Retry-After cadence;
        # broad recent-index reconciliation cannot improve that identity.
        try:
            bound = json.loads(receipt.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            bound = {}
        if (bound.get("identity_source") == "privacy_export_exact_prompt_message"
            and bound.get("queue_job_id") == job["id"]
            and bound.get("prompt_sha256") == job.get("prompt_sha256")):
            event("legacy_export_exact_collection_pending", job_id=job["id"],
                  collector_state=outcomes[0].get("state") if outcomes else "collector_deferred")
            return
    reconcile_ambiguous(job, device_id)


def reconcile_ambiguous(job: dict, device_id: str = DEVICE_ID) -> None:
    """Bounded GET-only lookup after an uncertain provider mutation."""
    job_id = str(job["id"])
    prompt = str(job.get("prompt") or "")
    if not prompt.strip() or hashlib.sha256(prompt.encode()).hexdigest() != job.get("prompt_sha256"):
        event("reconcile_prompt_mismatch", job_id=job_id)
        return
    state_path = job_state_path(job_id)
    try:
        prior = json.loads(state_path.read_text(encoding="utf-8")) if state_path.is_file() else {}
    except (OSError, ValueError):
        prior = {}
    now = time.time()
    if now < float(prior.get("reconcile_next_at") or 0):
        return
    prompt_path = ROOT / "prompts" / (hashlib.sha256(job_id.encode()).hexdigest() + ".txt")
    prompt_path.parent.mkdir(parents=True, exist_ok=True)
    prompt_path.write_text(prompt, encoding="utf-8")
    command = sender_prefix() + ["reconcile", "--queue-job-id", job_id,
               "--prompt-file", str(prompt_path), "--scan-offset",
               str(int(prior.get("reconcile_scan_offset") or 0))]
    ROOT.mkdir(parents=True, exist_ok=True)
    with (ROOT / "recent-index-gate.lock").open("a+") as lock_file:
        fcntl.flock(lock_file, fcntl.LOCK_EX)
        gate_path = recent_index_gate_path()
        try:
            gate = json.loads(gate_path.read_text(encoding="utf-8")) if gate_path.is_file() else {}
        except (OSError, ValueError):
            gate = {}
        if not isinstance(gate, dict):
            gate = {}
        # Every ambiguous job uses the same credential-bearing provider route.
        # A transient GET failure is route evidence, not a reason for the next
        # job to issue the same GET immediately. This fence applies only to
        # readback reconciliation; fresh scheduled sends keep their own gate.
        read_next_at = float(gate.get("next_provider_read_at") or 0)
        if time.time() < read_next_at:
            atomic_json(state_path, {**prior, "state": "effect_pending_read_recovery",
                                     "job_id": job_id, "reconcile_next_at": read_next_at,
                                     "reconcile_provider_state": "provider_read_shared_cooldown"})
            return
        known_conversation_id = known_conversation_for_job(job_id)
        index_next_at = float(gate.get("next_index_at") or 0)
        if time.time() < index_next_at:
            if known_conversation_id:
                command.append("--known-only")
            else:
                atomic_json(state_path, {**prior, "state": "effect_pending_read_recovery", "job_id": job_id,
                                         "reconcile_next_at": index_next_at,
                                         "reconcile_provider_state": "recent_index_shared_cooldown"})
                return
        try:
            response = subprocess.run(command, text=True, capture_output=True, timeout=240, check=False)
            recovered = json.loads(response.stdout) if response.stdout.strip().startswith("{") else {}
        except Exception as exc:
            response = None
            recovered = {"state": "read_transport_failure", "error": f"{type(exc).__name__}: {str(exc)[:180]}"}
        events = (recovered.get("recovery") or {}).get("events") or []
        index_429_event = any(
            event.get("phase") == "recent_index" and event.get("http_status") == 429
            for event in events if isinstance(event, dict)
        )
        if recovered.get("state") in {"read_transient", "read_transport_failure", "rate_limited"}:
            consecutive_reads = min(8, max(0, int(gate.get("consecutive_provider_read_failures") or 0)) + 1)
            provider_delay = float(recovered.get("retry_after_seconds") or 0)
            read_delay = max(provider_delay, min(1800, 120 * 2 ** (consecutive_reads - 1)))
            read_next_at = time.time() + read_delay
            gate.update({"next_provider_read_at": read_next_at,
                         "consecutive_provider_read_failures": consecutive_reads,
                         "provider_read_state": recovered.get("state"),
                         "provider_read_source_job_id": job_id,
                         "provider_read_observed_at": time.time()})
            event("provider_read_shared_backoff", job_id=job_id,
                  state=recovered.get("state"), consecutive_failures=consecutive_reads,
                  retry_after_seconds=read_delay)
        elif (response is not None and response.returncode == 0 and recovered.get("state")
              and recovered.get("state") != "recent_index_deferred"):
            # A successful read ends the shared route outage, including when
            # the exact user-message ID was not found on that page.
            gate.update({"next_provider_read_at": 0, "consecutive_provider_read_failures": 0,
                         "provider_read_state": "healthy", "provider_read_observed_at": time.time()})
            read_next_at = 0
        if recovered.get("state") == "rate_limited" and (not known_conversation_id or index_429_event):
            # A no-CID reconcile can only rate-limit on the recent index. Do not
            # depend on the sender retaining its nested event list to close the
            # gate; that allowed a second pending job to make another index GET.
            consecutive = min(8, max(0, int(gate.get("consecutive_rate_limits") or 0)) + 1)
            provider_delay = float(recovered.get("retry_after_seconds") or 0)
            index_delay = max(provider_delay, min(900, 60 * 2 ** (consecutive - 1)))
            index_delay = min(900, index_delay)
            index_next_at = time.time() + index_delay
            gate.update({"next_index_at": index_next_at,
                         "consecutive_rate_limits": consecutive,
                         "retry_after_seconds": recovered.get("retry_after_seconds"),
                         "source_job_id": job_id, "observed_at": time.time()})
            atomic_json(gate_path, gate)
            event("recent_index_backoff", job_id=job_id, consecutive_rate_limits=consecutive,
                  retry_after_seconds=index_delay)
        elif any(event.get("phase") == "recent_index" and "candidates" in event
                 for event in events if isinstance(event, dict)):
            # A successful list GET breaks the consecutive-429 streak even if a
            # later candidate hydration still needs its own deferred retry.
            gate.update({"next_index_at": 0, "consecutive_rate_limits": 0,
                         "observed_at": time.time()})
            atomic_json(gate_path, gate)
            index_next_at = 0
        else:
            atomic_json(gate_path, gate)
    delay = max(60, min(900, float(recovered.get("retry_after_seconds") or 300)))
    transport_error = re.sub(r"[^a-zA-Z0-9_.:/-]", "_",
                             str(recovered.get("error") or "")[:160])
    atomic_json(state_path, {**prior, "state": "effect_pending_read_recovery", "job_id": job_id,
                             "reconcile_next_at": max(now + delay, read_next_at,
                                                      index_next_at if not known_conversation_id else 0),
                             "reconcile_retry_after_seconds": recovered.get("retry_after_seconds"),
                             "reconcile_scan_offset": int(recovered.get("next_offset") or 0),
                             "reconcile_provider_state": recovered.get("state"),
                             "reconcile_transport_error": transport_error,
                             "reconcile_sender_exit": None if response is None else response.returncode})
    if recovered.get("provider_acceptance_observed") and recovered.get("conversation_id"):
        try:
            record_send_receipt(job, recovered, device_id)
        except Exception as exc:
            event("recovered_send_receipt_record_failed", job_id=job_id,
                  error=type(exc).__name__ + ":" + str(exc)[:180])
        if complete_from_result(job, recovered):
            return
    event("ambiguous_get_reconcile", job_id=job_id, state=recovered.get("state"),
          transport_error=transport_error,
          conversation_id=recovered.get("conversation_id"),
          next_scan_offset=int(recovered.get("next_offset") or 0), retry_after_seconds=delay)


def stable_user_message_id(job_id: str) -> str:
    return str(uuid.uuid5(uuid.NAMESPACE_URL, "cognilode-chatmode-queue:" + job_id))


def sender_command(job: dict, prompt_path: Path, attachments: list[Path]) -> list[str]:
    command = sender_prefix() + ["send", "--prompt-file", str(prompt_path),
               "--queue-job-id", str(job["id"]),
               "--model", str(job.get("requested_model") or job.get("model") or "gpt-5-6-thinking"),
               "--effort", str(job.get("reasoning_effort") or "xhigh"),
               "--timeout", "1800"]
    # DecisionX follow-ups must target the actual existing Chat-mode conversation
    # and its observed parent. The sender performs a read-before-send on that
    # exact provider branch and refuses a stale expected parent.
    conversation_id = str(job.get("conversation_id") or "").strip()
    parent_message_id = str(job.get("parent_message_id") or "").strip()
    if parent_message_id and not conversation_id:
        raise ValueError("Chat-mode parent_message_id without conversation_id")
    if conversation_id:
        command.extend(["--conversation-id", conversation_id])
        if parent_message_id:
            command.extend(["--parent-message-id", parent_message_id])
    for path in attachments:
        command.extend(["--attach", str(path)])
    return command


def send_custody(job: dict) -> dict:
    return sender.operator_memory_post({"operation": "get_chatmode_send_custody", "job_id": job["id"]})


def record_send_intent(job: dict, device_id: str) -> dict:
    return sender.operator_memory_post({"operation": "record_chatmode_send_intent", **fence(job),
        "device_id": device_id, "user_message_id": stable_user_message_id(str(job["id"]))})


def record_send_receipt(job: dict, value: dict, device_id: str) -> None:
    sender.operator_memory_post({"operation": "record_chatmode_provider_receipt", **fence(job),
        "device_id": device_id, "user_message_id": stable_user_message_id(str(job["id"])),
        "conversation_id": value.get("conversation_id"),
        "terminal_assistant_message_id": value.get("terminal_assistant_message_id"),
        "provider_acceptance_observed": bool(value.get("provider_acceptance_observed") or value.get("conversation_id"))})


def definitive_rejection(value: dict | None) -> bool:
    if not isinstance(value, dict) or value.get("provider_acceptance_observed") or value.get("conversation_id"):
        return False
    if (value.get("recovery") or {}).get("ambiguous_replay_suppressed"):
        return False
    status = value.get("http_status")
    state = value.get("state")
    return ((status in (401, 403) and state == "authentication_failed")
            or (status == 429 and state == "rate_limited"))


def requeue_definitive_rejection(job: dict, value: dict) -> bool:
    if not definitive_rejection(value):
        return False
    delays = [float(event.get("delay_seconds") or 0) for event in
              (value.get("recovery") or {}).get("events") or []
              if isinstance(event, dict) and event.get("classification") == "rate_limit"]
    reply = sender.operator_memory_post({"operation": "requeue_definitive_chatmode_rejection", **fence(job),
        "user_message_id": stable_user_message_id(str(job["id"])),
        "http_status": value["http_status"], "provider_state": value["state"],
        "retry_after_ms": int(max(delays, default=0) * 1000)})
    if not reply.get("ok"):
        event("definitive_rejection_requeue_failed", job_id=job["id"], error=reply.get("error"))
        return False
    atomic_json(job_state_path(job["id"]), {"state": "queued_after_definitive_rejection",
                                             "job_id": job["id"], "http_status": value["http_status"]})
    event("definitive_rejection_requeued", job_id=job["id"], http_status=value["http_status"])
    return True


def requeue_prepost_failure(job: dict, device_id: str, value: dict, stderr: str = "") -> bool:
    """Let D1 decide whether a Chat POST boundary was ever crossed.

    The sender commits `post_started` before POST. Only custody still in
    `intent_recorded` may return to a later historical-rhythm slot.
    """
    try:
        error = json.loads(stderr.strip()) if stderr.strip().startswith("{") else {}
    except ValueError:
        error = {}
    reason = str(value.get("state") or error.get("state") or "sender_exited_before_result")[:160]
    # Keep a bounded machine-readable central transport failure in the normal
    # queue receipt. Otherwise every failed slot collapses into the same
    # `central_route_ambiguous` label and operators must repeat manual probes.
    route_error = str(value.get("error") or error.get("error") or "")[:160]
    route_error = re.sub(r"[^a-zA-Z0-9_.:/-]", "_", route_error)
    delay = max(0.0, float(value.get("retry_after_seconds") or error.get("retry_after_seconds") or 0))
    try:
        reply = sender.operator_memory_post({"operation": "requeue_chatmode_prepost_failure", **fence(job),
            "device_id": device_id, "user_message_id": stable_user_message_id(str(job["id"])),
            "reason": reason, "retry_after_ms": int(delay * 1000)})
    except Exception as exc:
        event("prepost_boundary_check_failed", job_id=job["id"], error=type(exc).__name__ + ":" + str(exc)[:180])
        return False
    if not reply.get("ok"):
        event("prepost_requeue_rejected", job_id=job["id"], reason=reply.get("error"))
        return False
    stem = job_stem(str(job["id"]))
    target = ROOT / "prepost-attempts" / str(job["id"]) / str(job.get("lease_generation") or 0)
    target.mkdir(parents=True, exist_ok=True)
    for source in sender.DEFAULT_OUTPUT_ROOT.glob(stem + "*"):
        # Keep finalized provider file IDs for the next rhythm slot.
        if source.is_file() and not source.name.endswith(".uploads.json"):
            source.replace(target / source.name)
    atomic_json(job_state_path(str(job["id"])), {"state": "queued_after_prepost_failure",
                                                "job_id": job["id"], "reason": reason,
                                                "transport_error": route_error})
    event("prepost_requeued", job_id=job["id"], reason=reason,
          transport_error=route_error, retry_after_seconds=delay)
    return True


def prior_rejected_result(job_id: str) -> dict | None:
    value = result_for_job(job_id)
    if value is None:
        receipt = sender.DEFAULT_OUTPUT_ROOT / (job_stem(job_id) + ".sse.receipt.json")
        if receipt.is_file():
            try:
                value = json.loads(receipt.read_text(encoding="utf-8"))
            except (OSError, ValueError):
                value = None
    return value if definitive_rejection(value) else None


def archive_prior_rejected_attempt(job: dict, value: dict) -> None:
    job_id = str(job["id"])
    stem = job_stem(job_id)
    target = ROOT / "rejected-attempts" / job_id / str(job.get("lease_generation") or 0)
    target.mkdir(parents=True, exist_ok=True)
    atomic_json(target / "result.json", value)
    for source in sender.DEFAULT_OUTPUT_ROOT.glob(stem + "*"):
        if source.is_file():
            source.replace(target / source.name)

def execute(job: dict, device_id: str = DEVICE_ID) -> None:
    job_id = str(job["id"])
    try:
        rejected = prior_rejected_result(job_id)
        if rejected:
            archive_prior_rejected_attempt(job, rejected)
        if not rejected and result_for_job(job_id):
            recover(job, device_id)
            return
        receipt = sender.DEFAULT_OUTPUT_ROOT / (job_stem(job_id) + ".sse.receipt.json")
        if receipt.exists() and not rejected:
            recover(job, device_id)
            return
        prompt = str(job.get("prompt") or "")
        if not prompt.strip() or hashlib.sha256(prompt.encode()).hexdigest() != job.get("prompt_sha256"):
            raise ValueError("queue prompt missing or hash mismatch")
        attachments = attachment_paths(job)
        prompt_path = ROOT / "prompts" / (hashlib.sha256(job_id.encode()).hexdigest() + ".txt")
        prompt_path.parent.mkdir(parents=True, exist_ok=True)
        prompt_path.write_text(prompt, encoding="utf-8")
        atomic_json(job_state_path(job_id), {"state": "prepared", "job_id": job_id,
                                            "prompt_sha256": job["prompt_sha256"],
                                            "attachments": [str(p) for p in attachments]})
        begun = sender.operator_memory_post({"operation": "begin_effect", **fence(job)})
        if not begun.get("ok"):
            event("begin_effect_rejected", job_id=job_id, error=begun.get("error"))
            return
        atomic_json(job_state_path(job_id), {"state": "effect_pending", "job_id": job_id,
                                            "prompt_sha256": job["prompt_sha256"]})
        intent = record_send_intent(job, device_id)
        if not intent.get("ok"):
            event("send_intent_rejected", job_id=job_id, error=intent.get("error"))
            return
        command = sender_command(job, prompt_path, attachments)
        send_env = dict(os.environ)
        send_env["COGNILODE_CHATMODE_SEND_FENCE"] = json.dumps({**fence(job), "device_id": device_id})
        try:
            response = subprocess.run(command, text=True, capture_output=True,
                                      timeout=2100, check=False, env=send_env)
        except subprocess.TimeoutExpired:
            if requeue_prepost_failure(job, device_id, {}, ""):
                return
            raise
        value = json.loads(response.stdout) if response.stdout.strip().startswith("{") else {}
        if value:
            try:
                record_send_receipt(job, value, device_id)
            except Exception as exc:
                event("send_receipt_record_failed", job_id=job_id, error=type(exc).__name__+":"+str(exc)[:180])
        if value and requeue_definitive_rejection(job, value):
            return
        if value and complete_from_result(job, value):
            return
        if requeue_prepost_failure(job, device_id, value, response.stderr):
            return
        provider_delay = max(0.0, float(value.get("retry_after_seconds") or 0))
        atomic_json(job_state_path(job_id), {"state": "reconcile_required", "job_id": job_id,
                                            "reconcile_next_at": time.time() + provider_delay,
                                            "sender_exit": response.returncode,
                                            "sender_state": value.get("state"),
                                            "receipt": str(receipt)})
        event("send_reconcile_required", job_id=job_id, sender_exit=response.returncode,
              sender_state=value.get("state"))
    except Exception as exc:
        event("job_error_reconcile_required", job_id=job_id, error=type(exc).__name__ + ":" + str(exc)[:250])


def health_ready() -> bool:
    local_ready = SENDER_PATH.is_file() and os.access(SENDER_PATH, os.R_OK)
    if not local_ready:
        return False
    try:
        unified = Path(os.environ.get("COGNILODE_UNIFIED_PROMPTER", "")).resolve(strict=True)
        source = unified.stat()
        if not _transport_cli_ready(str(unified), source.st_ino, source.st_size, source.st_mtime_ns):
            return False
    except (OSError, ValueError):
        return False
    policy_path = Path(os.environ.get("COGNILODE_HTTP_GATE_POLICY_FILE", ""))
    try:
        policy = json.loads(policy_path.read_text()) if policy_path.is_file() else {}
    except (OSError, ValueError):
        policy = {}
    if not (policy.get("schema") == "cognilode.http_gate_policy.v1"
            and policy.get("purposes", {}).get("observability") is True):
        return local_ready
    try:
        response = subprocess.run(sender_prefix() + ["health"],
                                  capture_output=True, text=True, timeout=30, check=False)
        return response.returncode == 0 and json.loads(response.stdout).get("ok") is True
    except Exception:
        return False


@lru_cache(maxsize=8)
def _transport_cli_ready(path: str, inode: int, size: int, mtime_ns: int) -> bool:
    """Check this synced generation locally; provider observability stays gated."""
    try:
        probe = subprocess.run([sys.executable, path, "transport", "--help"],
                               capture_output=True, text=True, timeout=10, check=False)
        return probe.returncode == 0 and "--provider" in probe.stdout
    except (OSError, subprocess.TimeoutExpired):
        return False


def heartbeat(device_id: str, active: int) -> None:
    ready = health_ready()
    sender.operator_memory_post({"operation": "rhythm_device_heartbeat", "device": {
        "id": device_id, "available": ready, "chatgpt_eligible": True, "priority": DEVICE_PRIORITY,
        "active_turns": active,
        "network_route": os.environ.get("COGNILODE_CHATMODE_NETWORK_ROUTE", "home"),
    }})
    event("heartbeat", device_id=device_id, available=ready, active=active)


def scan_cursor_path(device_id: str) -> Path:
    return ROOT / (device_id + ".job-scan.json")


def _scan_cursors(device_id: str) -> dict:
    try:
        value = json.loads(scan_cursor_path(device_id).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    return value if isinstance(value, dict) else {}


def _save_scan_cursor(device_id: str, state: str, cursor: str) -> None:
    value = _scan_cursors(device_id)
    value[state] = cursor
    atomic_json(scan_cursor_path(device_id), value)


def scan_job_state(device_id: str, state: str) -> tuple[list[dict], str]:
    """Read a bounded slice and carry the keyset position into the next poll.

    A state transition during scanning may defer a row until the next sweep,
    but it cannot permanently bury it behind the first API page. The D1 fence
    and provider send custody remain the authority for exactly-once effects.
    """
    cursor = str(_scan_cursors(device_id).get(state) or "")
    jobs: list[dict] = []
    seen: set[str] = set()
    max_pages = 1 if state == "effect_pending" else JOB_SCAN_PAGES_PER_POLL
    for _ in range(max_pages):
        response = sender.operator_memory_post({"operation": "list_jobs", "provider": "chatgpt.com",
                                                "state": state, "limit": JOB_SCAN_PAGE_SIZE,
                                                "cursor": cursor})
        if not isinstance(response, dict) or not isinstance(response.get("jobs"), list):
            raise RuntimeError("invalid D1 list_jobs page")
        page = response["jobs"]
        if "next_cursor" not in response and len(page) >= JOB_SCAN_PAGE_SIZE:
            raise RuntimeError("D1 list_jobs pagination is unavailable")
        for job in page:
            if not isinstance(job, dict) or not job.get("id"):
                raise RuntimeError("invalid D1 list_jobs job")
            if job["id"] not in seen:
                jobs.append(job)
                seen.add(job["id"])
        next_cursor = response.get("next_cursor")
        if not next_cursor:
            return jobs, ""
        if not isinstance(next_cursor, str) or next_cursor == cursor:
            raise RuntimeError("invalid D1 list_jobs cursor progression")
        cursor = next_cursor
    return jobs, cursor


def poll(device_id: str, active_ids: set[str], lock: threading.Lock) -> None:
    pending, pending_cursor = scan_job_state(device_id, "effect_pending")
    claimed, claimed_cursor = scan_job_state(device_id, "claimed")
    recovery_leader = None
    if pending:
        try:
            gate = sender.operator_memory_post({"operation": "rhythm_read"}).get("gate") or {}
            now = datetime.now(timezone.utc).timestamp()
            devices = []
            for device in gate.get("devices") or []:
                if not device.get("available") or not device.get("chatgpt_eligible", True):
                    continue
                observed = datetime.fromisoformat(str(device.get("observed_at") or "").replace("Z", "+00:00"))
                if 0 <= now - observed.timestamp() <= 300:
                    devices.append(device)
            if devices:
                recovery_leader = max(devices, key=lambda item: (int(item.get("priority") or 0), str(item.get("id") or ""))).get("id")
        except Exception:
            recovery_leader = None
    for job in pending:
        if selected_for_device(job, device_id) or recovery_leader == device_id:
            with lock:
                if str(job.get("id") or "") in active_ids:
                    continue
            try:
                recover(job, device_id)
            except Exception as exc:
                event("recovery_error_retry_next_sweep", job_id=job["id"],
                      error=type(exc).__name__ + ":" + str(exc)[:200])
    _save_scan_cursor(device_id, "effect_pending", pending_cursor)
    for job in claimed:
        if not selected_for_device(job, device_id):
            continue
        job_id = str(job.get("id") or "")
        with lock:
            if job_id in active_ids:
                continue
            active_ids.add(job_id)
        def run(item=job, key=job_id):
            try:
                execute(item, device_id)
            finally:
                with lock:
                    active_ids.discard(key)
        threading.Thread(target=run, daemon=True, name="chatmode-" + job_id[:24]).start()
    _save_scan_cursor(device_id, "claimed", claimed_cursor)


def main() -> int:
    signal.signal(signal.SIGTERM, request_drain)
    signal.signal(signal.SIGINT, request_drain)
    sender.ensure_runtime()
    parser = argparse.ArgumentParser()
    parser.add_argument("--device-id", default=DEVICE_ID)
    parser.add_argument("--interval", type=int, default=60)
    parser.add_argument("--once", action="store_true")
    args = parser.parse_args()
    if not args.device_id or any(c not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-" for c in args.device_id):
        raise SystemExit("invalid device id")
    ROOT.mkdir(parents=True, exist_ok=True)
    with (ROOT / (args.device_id + ".lock")).open("a+") as file:
        try:
            fcntl.flock(file, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
        active_ids: set[str] = set()
        lock = threading.Lock()
        while True:
            if DRAIN:
                with lock:
                    if not active_ids:
                        return 0
                time.sleep(2)
                continue
            try:
                with lock:
                    active = len(active_ids)
                heartbeat(args.device_id, active)
                poll(args.device_id, active_ids, lock)
            except Exception as exc:
                event("loop_error", error=type(exc).__name__ + ":" + str(exc)[:250])
            if args.once:
                return 0
            time.sleep(max(10, args.interval))


if __name__ == "__main__":
    raise SystemExit(main())
