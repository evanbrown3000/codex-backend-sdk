#!/usr/bin/env python3
"""Continuously execute durable B4PT0R batches without provider polling."""
from __future__ import annotations

import json
import os
import fcntl
from pathlib import Path
import subprocess
import signal
import sys
import threading
import time


ROOT = Path(os.environ.get(
    "B4PT0R_BATCH_ROOT",
    str(Path.home() / ".local/share/cognilode/b4pt0r-batches"),
))
HERE = Path(__file__).resolve().parent
CLI = os.environ.get(
    "B4PT0R_CLI",
    str(Path.home() / ".local/share/cognilode/b4pt0r-chatmode/venv-python3.12/bin/b4pt0r"),
)
STOP = False
SUPERVISORS: list[threading.Thread] = []


def stop(_signal, _frame):
    global STOP
    STOP = True


def complete(state: Path) -> bool:
    try:
        rows = json.loads((state / "batch-result.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return False
    return bool(rows) and all(row.get("returncode") == 0 for row in rows)


def supervise(program: list[str], extra_environment: dict[str, str] | None = None) -> None:
    environment = os.environ.copy()
    environment.update(extra_environment or {})
    while not STOP:
        process = subprocess.Popen(program, env=environment)
        while not STOP and process.poll() is None:
            time.sleep(1)
        if process.poll() is None:
            process.terminate()
            try:
                process.wait(timeout=max(300, float(os.environ.get(
                    "COGNILODE_PROVIDER_GENERATION_DRAIN_SECONDS", "2700"
                ))))
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()
        if not STOP:
            time.sleep(5)


def native_provider_workers() -> list[tuple[list[str], dict[str, str]]]:
    """Select domain-owned workers for the independent native .com queues."""
    requested = {
        value.strip().casefold()
        for value in os.environ.get(
            "COGNILODE_HOSTED_RHYTHM_PROVIDERS",
            "chatgpt.com,gemini.com,claude.com,anthropic.com",
        ).split(",")
        if value.strip()
    }
    workers: list[tuple[list[str], dict[str, str]]] = []
    if "chatgpt.com" in requested:
        workers.append(([
            str(CLI.rsplit("/", 1)[0] + "/python"),
            str(HERE / "cognilode-chatmode-queue-worker"),
            "--device-id", os.environ.get("COGNILODE_ENVIRONMENT_ID", "company-container"),
            "--interval", "60",
        ], {}))

    # Gemini belongs to ComputerUseX, not to B4PT0R's ChatGPT transport.  Its
    # historical worker claims only gemini.com jobs from the same central D1
    # queue, uses the zero-cost native Gemini web transport, writes the exact
    # turn to Agent Memory, reads it back centrally, and only then completes
    # the fenced job.  Keeping it under this supervisor makes source cutovers
    # cooperative without copying that implementation into this repository.
    configured_computerusex = os.environ.get("COGNILODE_COMPUTERUSEX_SOURCE", "").strip()
    candidates = [Path(configured_computerusex)] if configured_computerusex else [
        Path("/runtime/source/current/automation-computeruse-vision/src"),
        Path("/company/automation-computeruse-vision/src"),
    ]
    computerusex = next(
        (candidate for candidate in candidates if (candidate / "computerusex").is_dir()),
        candidates[0],
    )
    gemini_worker = computerusex / "computerusex" / "g3_gemini_agent_memory_worker.py"
    if "gemini.com" in requested and gemini_worker.is_file():
        pythonpath = str(computerusex)
        inherited = os.environ.get("PYTHONPATH", "")
        if inherited:
            pythonpath += os.pathsep + inherited
        workers.append(([
            sys.executable,
            "-m", "computerusex.g3_gemini_agent_memory_worker",
            "--token-file", os.environ.get(
                "COGNILODE_OPERATOR_TOKEN_FILE",
                "/home/worker/.config/cognilode/operator-bearer",
            ),
            "--state-root", str(ROOT / "gemini.com"),
            "--loop", "--interval-seconds", "60",
        ], {"PYTHONPATH": pythonpath}))
    return workers


def main() -> int:
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    ROOT.mkdir(parents=True, exist_ok=True)
    daemon_lock = (ROOT / ".batch-daemon.lock").open("a+")
    try:
        fcntl.flock(daemon_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0
    # Provider queues are independent. A long Gemini turn cannot consume or
    # delay a ChatGPT rhythm slot, and neither worker polls the other provider.
    for actuator, extra_environment in native_provider_workers():
        thread = threading.Thread(
            target=supervise,
            args=(actuator, extra_environment),
            daemon=False,
        )
        SUPERVISORS.append(thread)
        thread.start()
    retry: dict[str, tuple[int, float]] = {}
    while not STOP:
        now = time.time()
        for batch in ROOT.glob("*/batch.json"):
            state = batch.parent / "state"
            if complete(state):
                retry.pop(str(batch), None)
                continue
            failures, due = retry.get(str(batch), (0, 0.0))
            if now < due:
                continue
            process = subprocess.Popen([
                str(CLI.rsplit("/", 1)[0] + "/python"),
                str(HERE / "b4pt0r-com-batch"), str(batch),
                "--state-root", str(state), "--cli", CLI,
            ])
            while not STOP and process.poll() is None:
                time.sleep(1)
            if process.poll() is None:
                process.terminate()
                try:
                    process.wait(timeout=30)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait()
            failures = 0 if process.returncode == 0 else failures + 1
            retry[str(batch)] = (failures, time.time() + min(900, 15 * (2 ** min(failures, 6))))
            if STOP:
                break
        if not STOP:
            time.sleep(5)
    for thread in SUPERVISORS:
        thread.join(timeout=max(300, float(os.environ.get(
            "COGNILODE_PROVIDER_GENERATION_DRAIN_SECONDS", "2700"
        ))) + 60)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
