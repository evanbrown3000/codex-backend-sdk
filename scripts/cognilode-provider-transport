#!/usr/bin/env python3
"""Credential holding ChatGPT Chat-mode transport behind a local Unix socket."""
from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import socketserver
import signal
import subprocess
import sys
import threading
import time
import uuid

from codex_backend_sdk.generation_fence import GenerationManifest, require_generation

SENDER = Path(__file__).with_name("cognilode-b4pt0r-chatmode")
COLLECTOR = Path(__file__).with_name("cognilode-b4pt0r-collect")
COUNTER_LOCK = threading.Lock()
ACTIVE_SENDS = 0
ACTIVE_JOB_IDS: set[str] = set()
DRAINING = False


def runtime_python() -> Path:
    manifest = GenerationManifest.load()
    manifest.validate()
    selected = Path(manifest.runtime_python)
    if selected.is_file():
        return selected
    raise RuntimeError("immutable generation runtime unavailable")

def option(args: list[str], name: str, default: str = "") -> str:
    try:
        return args[args.index(name) + 1]
    except (ValueError, IndexError):
        return default


def _broker_call(payload: dict, *, timeout: int) -> tuple[int, dict, str]:
    environment = os.environ.copy()
    # The custody container is intentionally non-root and its image home is
    # read-only. ComputerUseX exposes an explicit runtime-root contract; bind
    # it to the durable shared runtime instead of falling back to ~/.local.
    computerusex_runtime = Path(environment.setdefault(
        "COMPUTERUSEX_RUNTIME_ROOT", "/runtime/computerusex"
    ))
    computerusex_runtime.mkdir(parents=True, exist_ok=True)
    if str(payload.get("provider") or "") in {
        "gemini.com", "anthropic.com", "claude.com"
    }:
        # Some historical ComputerUseX modules still derive auxiliary paths
        # from HOME rather than the runtime-root contract. Keep those paths in
        # the same singular writable custody volume; never the image home.
        provider_home = Path("/runtime/provider-home")
        provider_home.mkdir(parents=True, exist_ok=True)
        environment["HOME"] = str(provider_home)
    source_root = str(Path(__file__).resolve().parent.parent)
    # The custody process is deliberately long lived, while provider adapters
    # converge independently.  Running a new operation against the adapter
    # bundled into the custody process' original immutable Python would keep
    # every browser repair dormant until an operator restarted custody.  Load
    # the converged ComputerUseX source for each newly spawned broker instead;
    # the operation remains generation-fenced by the scheduler and no secret
    # leaves this process.
    current_computerusex = Path("/runtime/source/current/automation-computeruse-vision/src")
    python_roots = [source_root]
    if current_computerusex.is_dir():
        python_roots.insert(0, str(current_computerusex))
    if environment.get("PYTHONPATH"):
        python_roots.append(environment["PYTHONPATH"])
    environment["PYTHONPATH"] = os.pathsep.join(python_roots)
    completed = subprocess.run(
        [str(runtime_python()), "-m", "codex_backend_sdk.provider_broker"],
        input=json.dumps(payload, separators=(",", ":")) + "\n", text=True,
        capture_output=True, timeout=timeout, check=False, env=environment,
    )
    try:
        value = json.loads(completed.stdout.splitlines()[-1])
    except (ValueError, IndexError):
        value = {"ok": False, "error": "custody_broker_invalid_result"}
    return completed.returncode, value, completed.stderr


def b4pt0r_send(args: list[str], send_fence: dict) -> dict:
    prompt_file = Path(option(args, "--prompt-file"))
    job_id = option(args, "--queue-job-id")
    provider_attempt = option(args, "--provider-attempt", "0")
    # The queue's begin_effect response carries the scheduler's real expiry;
    # the actuator passes its remaining budget through this option. Avoid a
    # shorter transport/client timeout that would orphan an accepted turn.
    try:
        turn_timeout = max(60, int(option(args, "--timeout", "1800")))
    except ValueError:
        turn_timeout = 1800
    if not prompt_file.is_file() or not job_id:
        return {"exit_code": 64, "stderr": "queued prompt input unavailable"}
    artifact_root = Path.home() / ".local/share/cognilode/b4pt0r-chatmode" / (
        "b4pt0r-chatmode-job-" + hashlib.sha256(job_id.encode()).hexdigest()[:24] + ".files"
    )
    attachments = [args[index + 1] for index, value in enumerate(args[:-1]) if value == "--attach"]
    attempt_identity = str(send_fence.get("provider_attempt") or provider_attempt or "0")
    lease_generation = str(send_fence.get("lease_generation") or "0")
    operation_id = str(
        send_fence.get("operation_id")
        # A scheduler-authorized retry is a new capability-scoped operation.
        # Reusing the old operation identity leaves the single-use custody
        # lease correctly redeemed and makes every later queue lease fail.
        or f"{job_id}:queue-lease:{lease_generation}:provider-attempt:{attempt_identity}"
    )
    account_id = option(args, "--provider-account-id", "primary")
    lease_code, lease_result, lease_stderr = _broker_call({
        "operation": "provider_lease_issue",
        "provider": "chatgpt.com",
        "account_id": account_id,
        "operation_id": operation_id,
        "ttl_seconds": 180,
    }, timeout=60)
    lease = lease_result.get("lease") if isinstance(lease_result.get("lease"), dict) else {}
    if lease_code or not lease.get("capability"):
        return {"exit_code": lease_code or 70,
                "stdout": json.dumps(lease_result, separators=(",", ":")),
                "stderr": lease_stderr[-1048576:]}
    payload = {
        "operation": "provider_prompt",
        "provider": "chatgpt.com",
        "operation_id": operation_id,
        "capability_lease": lease["capability"],
        "account_id": account_id,
        "prompt": prompt_file.read_text(encoding="utf-8"),
        "conversation_id": option(args, "--conversation-id") or None,
        "parent_message_id": option(args, "--parent-message-id") or None,
        "model": option(args, "--model", "gpt-5-6-thinking"),
        "reasoning_effort": option(args, "--effort", "xhigh"),
        "attachments": attachments,
        "artifact_directory": str(artifact_root),
        "parent_operation": {
            "operation_id": str(send_fence.get("parent_operation_id") or job_id),
            "automation_order": int(send_fence.get("automation_order") or 2),
            "origin": str(send_fence.get("origin") or "provider_queue"),
            "taskflow_node": send_fence.get("taskflow_node"),
        },
        "metadata": {"provider_attempt": provider_attempt, "queue_job_id": job_id,
                     "timeout_seconds": turn_timeout},
    }
    completed_code, value, completed_stderr = _broker_call(payload, timeout=turn_timeout + 120)
    if value.get("accepted") is not True or value.get("terminal") is not True:
        return {"exit_code": completed_code or 70,
                "stdout": json.dumps(value, separators=(",", ":")),
                "stderr": completed_stderr[-1048576:]}
    normalized = {
        "ok": True,
        "state": "collected",
        "provider_acceptance_observed": True,
        "assistant_terminal": True,
        "conversation_id": value.get("conversation_id"),
        "user_message_id": value.get("user_message_id"),
        "terminal_assistant_message_id": value.get("assistant_message_id"),
        "terminal_assistant_text": value.get("assistant_text") or "",
        "provider_model_receipt": value.get("provider_receipt") or {},
        "downloaded_files": value.get("artifacts") or [],
        "central_conversation_store": value.get("agent_memory") or {},
    }
    return {"exit_code": 0, "stdout": json.dumps(normalized, separators=(",", ":")), "stderr": ""}


def transport(args: list[str], send_fence: dict | None = None) -> dict:
    global ACTIVE_SENDS
    if not isinstance(args, list) or len(args) > 150 or any(not isinstance(x, str) or len(x) > 4096 for x in args):
        return {"exit_code": 64, "stderr": "invalid provider arguments"}
    if len(args) < 3 or args[0] != "--auth-source" or args[1] not in {"codex", "chrome"} or args[2] not in {"send", "reconcile", "health"}:
        return {"exit_code": 64, "stderr": "unsupported provider operation"}
    verb = args[2]
    if verb == "reconcile":
        return {"exit_code": 64, "stdout": json.dumps({"ok": False,
                "state": "provider_observability_disabled",
                "provider_acceptance_observed": False})}
    if verb == "health":
        ready = runtime_python().is_file() and (Path.home() / ".codex/auth.json").is_file()
        return {"exit_code": 0 if ready else 69,
                "stdout": json.dumps({"ok": ready, "state": "ready" if ready else "credential_unavailable"})}
    if verb == "send" and (not isinstance(send_fence, dict) or
            not all(send_fence.get(key) for key in
                    ("job_id", "worker_id", "lease_token", "lease_generation", "device_id"))):
        return {"exit_code": 64, "stderr": "queued provider send requires effect fence"}
    if verb == "send":
        require_generation(send_fence)
        with COUNTER_LOCK:
            if DRAINING:
                return {"exit_code": 75, "stdout": json.dumps({"ok": False,
                        "state": "provider_transport_draining",
                        "provider_acceptance_observed": False})}
            ACTIVE_SENDS += 1
            ACTIVE_JOB_IDS.add(str((send_fence or {}).get("job_id") or ""))
    try:
        try:
            child_env = os.environ.copy()
            if send_fence:
                child_env["COGNILODE_CHATMODE_SEND_FENCE"] = json.dumps(send_fence, separators=(",", ":"))
            if verb == "send":
                return b4pt0r_send(args, send_fence)
            return {"exit_code": 64, "stderr": "unsupported provider operation"}
        except subprocess.TimeoutExpired:
            return {"exit_code": 124, "stderr": "provider transport deadline exceeded; reconcile exact mutation"}
    finally:
        if verb == "send":
            with COUNTER_LOCK:
                ACTIVE_SENDS -= 1
                ACTIVE_JOB_IDS.discard(str((send_fence or {}).get("job_id") or ""))


def provider_prompt(request: dict) -> dict:
    """Execute every non-ChatGPT mutation inside the same fenced custody runtime."""
    global ACTIVE_SENDS
    fence = request.get("send_fence") if isinstance(request.get("send_fence"), dict) else {}
    job_id = str(fence.get("job_id") or request.get("operation_id") or "")
    provider = str(request.get("provider") or "")
    operation_id = str(request.get("operation_id") or (
        f"{job_id}:queue-lease:{fence.get('lease_generation') or 0}"
    ))
    timeout = max(60, int(request.get("timeout_seconds") or 1800))
    with COUNTER_LOCK:
        if DRAINING:
            return {"exit_code": 75, "stderr": "provider generation draining"}
        ACTIVE_SENDS += 1
        if job_id:
            ACTIVE_JOB_IDS.add(job_id)
    try:
        lease_code, lease_result, lease_stderr = _broker_call({
            "operation": "provider_lease_issue", "provider": provider,
            "account_id": str(request.get("account_id") or "primary"),
            "operation_id": operation_id, "ttl_seconds": 180,
        }, timeout=60)
        lease = lease_result.get("lease") if isinstance(lease_result.get("lease"), dict) else {}
        if lease_code or not lease.get("capability"):
            return {"exit_code": lease_code or 70, "provider_result": lease_result,
                    "stderr": lease_stderr[-1000:]}
        payload = dict(request)
        payload.update({"operation": "provider_prompt", "operation_id": operation_id,
                        "capability_lease": lease["capability"]})
        payload.pop("send_fence", None)
        code, result, stderr = _broker_call(payload, timeout=timeout + 120)
        return {"exit_code": code, "provider_result": result, "stderr": stderr[-4000:]}
    finally:
        with COUNTER_LOCK:
            ACTIVE_SENDS -= 1
            ACTIVE_JOB_IDS.discard(job_id)


class Handler(socketserver.StreamRequestHandler):
    def handle(self):
        global DRAINING
        try:
            request = json.loads(self.rfile.readline(1048576))
            if request.get("operation") == "active":
                with COUNTER_LOCK:
                    response = {"active": ACTIVE_SENDS, "draining": DRAINING,
                                "job_ids": sorted(value for value in ACTIVE_JOB_IDS if value)}
            elif request.get("operation") == "drain":
                with COUNTER_LOCK:
                    DRAINING = True
                    response = {"active": ACTIVE_SENDS, "draining": True}
            elif request.get("operation") == "transport":
                response = transport(request.get("args"), request.get("send_fence"))
            elif request.get("operation") == "provider_prompt":
                response = provider_prompt(dict(request))
            elif request.get("operation") == "embedding":
                code, result, stderr = _broker_call(dict(request), timeout=180)
                response = result if not code else {
                    "ok": False,
                    "error": str(result.get("error") or "embedding_provider_error"),
                    "message": str(result.get("message") or stderr)[-1000:],
                }
            else:
                response = {"exit_code": 64, "stderr": "unsupported transport operation"}
        except Exception as exc:
            # Return a bounded diagnostic to the queue ledger.  Masking every
            # pre-mutation exception to its class made permanent configuration
            # faults indistinguishable and forced foreground inspection.
            response = {"exit_code": 70, "stderr":
                        (type(exc).__name__ + ":" + str(exc))[:1000]}
        self.wfile.write((json.dumps(response, separators=(",", ":")) + "\n").encode())


class Server(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    daemon_threads = True


def collect_forever():
    root = Path.home() / ".local/share/cognilode"
    while True:
        try:
            result = subprocess.run([sys.executable, str(COLLECTOR),
                                     "--dir", str(root / "b4pt0r-chatmode"),
                                     "--dir", str(root / "handoffs"), "--recursive", "--limit", "40"],
                                    capture_output=True, text=True, timeout=600, check=False)
            print(json.dumps({"kind": "collector_cycle", "returncode": result.returncode,
                              "at": time.time()}), flush=True)
        except (OSError, subprocess.TimeoutExpired) as exc:
            print(json.dumps({"kind": "collector_retry", "error": type(exc).__name__,
                              "at": time.time()}), flush=True)
        # Central grant permits one hydration per conversation per 120 seconds.
        # Agent readers use the shared normalized delta store, never this loop.
        time.sleep(120)


def supervise(command: list[str]) -> None:
    """Keep a modular queue/rhythm child alive without embedding its logic."""
    while True:
        child = subprocess.Popen(command, start_new_session=True)
        code = child.wait()
        print(json.dumps({"kind": "provider_runtime_child_restart",
                          "program": Path(command[1]).name, "exit_code": code}), flush=True)
        time.sleep(5)


def retire_stale_children() -> None:
    """End queue/rhythm children orphaned by an immutable source cutover."""
    names = ("cognilode-chatmode-queue-worker", "cognilode-chatmode-floor-watcher")
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit() or int(entry.name) == os.getpid():
            continue
        try:
            command = (entry / "cmdline").read_bytes().replace(b"\0", b" ").decode()
        except OSError:
            continue
        if any(name in command for name in names):
            try:
                os.kill(int(entry.name), signal.SIGTERM)
            except (OSError, ValueError):
                pass


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--socket", type=Path, required=True)
    args = parser.parse_args()
    GenerationManifest.load().validate()
    args.socket.parent.mkdir(parents=True, exist_ok=True)
    # Only one credential-bearing mutation server may own a custody socket.
    # Hold the lock for the process lifetime; a parallel recovery invocation
    # must not unlink and replace the supervised server while turns are live.
    lock_path = args.socket.with_suffix(args.socket.suffix + ".lock")
    lock_stream = lock_path.open("a+")
    try:
        fcntl.flock(lock_stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 73
    args.socket.unlink(missing_ok=True)
    server = Server(str(args.socket), Handler)
    os.chmod(args.socket, 0o660)
    # Retire only legacy children in this transport container's PID namespace.
    # The authoritative queue clock lives in the separate chatmode container,
    # so it is unaffected. Never start a replacement from this transport.
    retire_stale_children()
    server.serve_forever()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
