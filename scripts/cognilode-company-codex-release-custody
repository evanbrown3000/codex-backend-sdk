#!/usr/bin/env python3
"""Exchange one pinned Codex release through private S3 custody.

The large Rust build runs only on a capable environment. Smaller identical
company containers install the content-verified release from the same pin.
"""
from __future__ import annotations

import base64
import fcntl
import hashlib
import json
import os
from pathlib import Path
import platform
import re
import signal
import shutil
import subprocess
import tempfile
import time


PIN = os.environ["COGNILODE_CODEX_SOURCE_COMMIT"]
if not re.fullmatch(r"[0-9a-f]{40}", PIN):
    raise ValueError("Codex source pin must be a full Git commit")
ROOT = Path(os.environ.get("COGNILODE_CODEX_INSTALL_ROOT", "/codex"))
BUCKET = os.environ.get("COGNILODE_CODEX_RELEASE_BUCKET",
                        "cognilode-ephemeral-artifacts-362928919715-us-west-2")
TARGET = f"{platform.system().lower()}-{platform.machine().lower()}"
PREFIX = f"codex-releases/{PIN}/{TARGET}"
RELEASE = ROOT / "releases" / PIN
LOOKUP = ROOT / "metadata" / f"lookup-{PIN}-{TARGET}.json"
LOCK = ROOT / "metadata" / f"release-{PIN}-{TARGET}.lock"
RELEASE_FILES = ("codex", "codex-code-mode-host", "central-rollouts", "managed-codex")
HOST_READY = "code-mode-host-ready.json"
CENTRAL_LEDGER = Path(os.environ.get(
    "COGNILODE_CODEX_INSTALLATION_LEDGER",
    "/runtime-events/source-convergence.jsonl"))
PUBLISH_RECEIPT = ROOT / "metadata" / f"publication-{PIN}-{TARGET}.json"
AWS_CONNECT_TIMEOUT = 8
AWS_READ_TIMEOUT = 25
AWS_OVERALL_TIMEOUT = 90


def aws(*args: str, timeout: int = AWS_OVERALL_TIMEOUT) -> subprocess.CompletedProcess:
    # The standard workspace puts a brokered shim ahead of the real CLI on
    # PATH. This credential-custody container has its own mounted AWS profile.
    binary = os.environ.get("COGNILODE_AWS_CLI", "/usr/bin/aws")
    if not Path(binary).is_file():
        binary = shutil.which("aws")
    if not binary:
        raise RuntimeError("AWS CLI is unavailable in company container")
    command = [binary, "--cli-connect-timeout", str(AWS_CONNECT_TIMEOUT),
               "--cli-read-timeout", str(AWS_READ_TIMEOUT), "s3api", *args]
    child = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                             text=True, start_new_session=True)
    try:
        stdout, stderr = child.communicate(timeout=min(timeout, AWS_OVERALL_TIMEOUT))
    except subprocess.TimeoutExpired:
        try:
            os.killpg(child.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        try:
            stdout, stderr = child.communicate(timeout=3)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(child.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            stdout, stderr = child.communicate()
        return subprocess.CompletedProcess(command, 124, stdout, stderr or "aws_cli_timeout")
    return subprocess.CompletedProcess(command, child.returncode, stdout, stderr)


def digest(path: Path) -> str:
    value = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            value.update(chunk)
    return value.hexdigest()


def checksum(hexdigest: str) -> str:
    return base64.b64encode(bytes.fromhex(hexdigest)).decode("ascii")


def marker(state: str) -> None:
    LOOKUP.parent.mkdir(parents=True, exist_ok=True)
    temporary = LOOKUP.with_name(LOOKUP.name + f".{os.getpid()}.tmp")
    temporary.write_text(json.dumps({"pin": PIN, "target": TARGET,
                                     "state": state, "at": time.time()}) + "\n")
    temporary.replace(LOOKUP)


def aws_failure(result: subprocess.CompletedProcess) -> str:
    """Keep credential and bucket error text out of recurring service logs."""
    detail = (result.stderr or '').lower()
    if 'expiredtoken' in detail or 'token has expired' in detail:
        return 'session_expired'
    if 'unable to locate credentials' in detail or 'nocredentialproviders' in detail:
        return 'credentials_missing'
    if 'accessdenied' in detail or 'forbidden' in detail or '403' in detail:
        return 'access_denied'
    if 'could not connect' in detail or 'endpointconnectionerror' in detail:
        return 'endpoint_unreachable'
    # Retain only short alphabetic words from an unfamiliar CLI diagnostic.
    # Paths, account numbers, object keys, URLs, and credential values are not
    # copied into the service receipt.
    words = [word.lower() for word in re.findall(r'[A-Za-z]+', result.stderr or '')
             if len(word) <= 24]
    return f'aws_cli_exit_{result.returncode}:' + '_'.join(words[:12])


def remote_manifest() -> dict | None:
    # Missing releases are normal before the first capable builder publishes.
    # A GET for an absent private key can be reported as AccessDenied by S3;
    # HEAD distinguishes that state without blocking the recurring builder.
    probe = aws("head-object", "--bucket", BUCKET, "--key", PREFIX + "/manifest.json",
                "--output", "json")
    if probe.returncode:
        if "404" in probe.stderr or "Not Found" in probe.stderr or "NoSuchKey" in probe.stderr:
            return None
        if aws_failure(probe) == 'access_denied':
            # S3 can answer HEAD for a missing key with 403 when ListBucket is
            # absent. Ask the bucket for this one exact key before concluding
            # that a new build is safe; a denied LIST keeps the build fenced.
            listing = aws('list-objects-v2', '--bucket', BUCKET,
                          '--prefix', PREFIX + '/manifest.json', '--max-keys', '1',
                          '--output', 'json')
            if listing.returncode:
                raise RuntimeError('private Codex release manifest lookup ' + aws_failure(listing))
            keys = [str(item.get('Key') or '') for item in
                    json.loads(listing.stdout or '{}').get('Contents', [])]
            if PREFIX + '/manifest.json' not in keys:
                return None
            raise RuntimeError('private Codex release manifest exists but read is denied')
        raise RuntimeError('private Codex release manifest lookup ' + aws_failure(probe))
    with tempfile.TemporaryDirectory(prefix="codex-release-manifest-") as temporary:
        path = Path(temporary) / "manifest.json"
        result = aws("get-object", "--bucket", BUCKET, "--key", PREFIX + "/manifest.json",
                     str(path), "--output", "json")
        if result.returncode:
            if "NoSuchKey" in result.stderr or "404" in result.stderr:
                return None
            raise RuntimeError('private Codex release manifest download ' + aws_failure(result))
        value = json.loads(path.read_text(encoding="utf-8"))
    if (value.get("schema") != "cognilode.codex-release.v1" or
            value.get("source_commit") != PIN or value.get("target") != TARGET):
        raise RuntimeError("private Codex release manifest identity mismatch")
    for name in RELEASE_FILES:
        item = value.get("files", {}).get(name, {})
        if not re.fullmatch(r"[0-9a-f]{64}", str(item.get("sha256") or "")) or int(item.get("size") or 0) <= 0:
            raise RuntimeError("private Codex release manifest is incomplete")
    return value


def link_release() -> None:
    (ROOT / "bin").mkdir(parents=True, exist_ok=True)
    for name in RELEASE_FILES:
        temporary = ROOT / "bin" / ("." + name + "-next")
        temporary.unlink(missing_ok=True)
        temporary.symlink_to(f"../releases/{PIN}/{name}")
        temporary.replace(ROOT / "bin" / name)
    publish_installation_receipt()


def publish_installation_receipt() -> None:
    """Publish one immutable receipt after every release link is observable."""
    receipts = ROOT / "receipts"
    receipts.mkdir(parents=True, exist_ok=True)
    receipt = receipts / f"{PIN}-{TARGET}.json"
    files = {name: {"sha256": digest(RELEASE / name), "size": (RELEASE / name).stat().st_size}
             for name in RELEASE_FILES}
    value = {
        "schema": "cognilode.codex_installation.v1",
        "environment_id": os.environ.get("COGNILODE_ENVIRONMENT_ID", "unknown"),
        "source_commit": PIN,
        "target": TARGET,
        "files": files,
        "active_binary": str((ROOT / "bin/codex").resolve(strict=True)),
        "installed_at": time.time(),
    }
    _publish_central_installation_event(value)
    if receipt.is_file():
        prior = json.loads(receipt.read_text(encoding="utf-8"))
        comparable = {key: value[key] for key in value if key != "installed_at"}
        if {key: prior.get(key) for key in comparable} == comparable:
            return
    temporary = receipt.with_name(receipt.name + f".{os.getpid()}.tmp")
    temporary.write_text(json.dumps(value, sort_keys=True) + "\n")
    temporary.replace(receipt)
    ledger = ROOT / "events/installations.jsonl"
    ledger.parent.mkdir(parents=True, exist_ok=True)
    descriptor = os.open(ledger, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    try:
        os.write(descriptor, (json.dumps(value, sort_keys=True) + "\n").encode())
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
def _publish_central_installation_event(value: dict) -> None:
    event_id = f"{value['environment_id']}:{PIN}:{TARGET}"
    central = {
        "schema": "cognilode.source_installation.v1",
        "event_id": event_id,
        "authority": "evanbrown3000/cognilode-codex",
        "name": "codex-managed-release",
        "revision": PIN,
        "previous_revision": None,
        "environment_id": value["environment_id"],
        "installed_at": value["installed_at"],
        "kind": "managed_codex_runtime_installation",
        "target": TARGET,
        "files": files,
    }
    try:
        CENTRAL_LEDGER.parent.mkdir(parents=True, exist_ok=True)
        with CENTRAL_LEDGER.open("a+", encoding="utf-8") as stream:
            fcntl.flock(stream.fileno(), fcntl.LOCK_EX)
            stream.seek(0)
            if not any(json.loads(line).get("event_id") == event_id
                       for line in stream if line.strip()):
                stream.seek(0, os.SEEK_END)
                stream.write(json.dumps(central, sort_keys=True) + "\n")
                stream.flush()
                os.fsync(stream.fileno())
    except OSError as error:
        raise RuntimeError("central Codex installation ledger append failed") from error


def install_remote(manifest: dict) -> None:
    if all(RELEASE.joinpath(name).is_file() for name in RELEASE_FILES) and RELEASE.joinpath(HOST_READY).is_file():
        link_release()
        return
    RELEASE.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix=".download-", dir=RELEASE.parent) as temporary:
        stage = Path(temporary) / "release"
        stage.mkdir()
        for name in RELEASE_FILES:
            path = stage / name
            result = aws("get-object", "--bucket", BUCKET, "--key", PREFIX + "/" + name,
                         str(path), "--output", "json", timeout=1800)
            expected = manifest["files"][name]
            if result.returncode or not path.is_file() or path.stat().st_size != expected["size"] or digest(path) != expected["sha256"]:
                raise RuntimeError("private Codex release download checksum mismatch")
            path.chmod(0o755)
        host = stage / "codex-code-mode-host"
        probe = subprocess.run([str(host), "--help"], capture_output=True, timeout=15)
        if probe.returncode:
            raise RuntimeError("private Codex code-mode host executable failed local probe")
        (stage / HOST_READY).write_text(json.dumps({
            "schema": "cognilode.codex-code-mode-host-ready.v1",
            "source_commit": PIN,
            "host_sha256": manifest["files"]["codex-code-mode-host"]["sha256"],
            "probe": "help-exit-0",
            "host_origin": manifest.get("host_origin") or "legacy-unspecified",
        }, separators=(",", ":")) + "\n")
        (stage / "source-commit").write_text(PIN + "\n")
        (stage / "SHA256SUMS").write_text("".join(
            f"{manifest['files'][name]['sha256']}  {name}\n" for name in RELEASE_FILES) +
            f"{digest(stage / HOST_READY)}  {HOST_READY}\n")
        if RELEASE.exists():
            if RELEASE.is_symlink() or not RELEASE.is_dir():
                raise RuntimeError("local Codex release path is not a directory")
            shutil.rmtree(RELEASE)
        stage.rename(RELEASE)
    link_release()
    print(f"Codex release installed from private custody {PIN}", flush=True)


def publish_local() -> None:
    files = {name: RELEASE / name for name in RELEASE_FILES}
    if not all(path.is_file() for path in files.values()) or not RELEASE.joinpath(HOST_READY).is_file():
        return
    ready = json.loads(RELEASE.joinpath(HOST_READY).read_text(encoding="utf-8"))
    if (ready.get("schema") != "cognilode.codex-code-mode-host-ready.v1" or
            ready.get("source_commit") != PIN or
            ready.get("host_sha256") != digest(files["codex-code-mode-host"])):
        raise RuntimeError("local code-mode host provenance does not match release")
    host_origin = str(ready.get("host_origin") or "legacy-unspecified")
    manifest = {"schema": "cognilode.codex-release.v1", "source_commit": PIN,
                "target": TARGET,
                "files": {name: {"sha256": digest(path), "size": path.stat().st_size}
                          for name, path in files.items()}}
    if host_origin != "legacy-unspecified":
        manifest["host_origin"] = host_origin
    existing = remote_manifest()
    if existing:
        if existing != manifest:
            raise RuntimeError("immutable private Codex release differs from local build")
        return
    PUBLISH_RECEIPT.parent.mkdir(parents=True, exist_ok=True)
    try:
        receipt = json.loads(PUBLISH_RECEIPT.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        receipt = {"schema": "cognilode.codex_release_publication.v1",
                   "pin": PIN, "target": TARGET, "artifacts": {}}
    for name, path in files.items():
        hexdigest = manifest["files"][name]["sha256"]
        prior = receipt["artifacts"].get(name, {})
        if prior.get("sha256") == hexdigest and prior.get("state") == "published":
            continue
        if (prior.get("sha256") == hexdigest and prior.get("state") in ("failed", "uploading") and
                time.time() - float(prior.get("attempted_at") or 0) < 900):
            raise RuntimeError("private Codex release publication cooldown")
        prior = {"sha256": hexdigest, "state": "uploading", "attempted_at": time.time()}
        receipt["artifacts"][name] = prior
        _write_publication_receipt(receipt)
        result = aws("put-object", "--bucket", BUCKET, "--key", PREFIX + "/" + name,
                     "--body", str(path), "--server-side-encryption", "AES256",
                     "--checksum-sha256", checksum(hexdigest), "--metadata", "sha256=" + hexdigest,
                     timeout=AWS_OVERALL_TIMEOUT)
        if result.returncode:
            prior.update(state="failed", error=aws_failure(result))
            _write_publication_receipt(receipt)
            raise RuntimeError("private Codex release binary publication failed")
        prior.update(state="published", published_at=time.time())
        _write_publication_receipt(receipt)
    with tempfile.TemporaryDirectory(prefix="codex-release-publish-") as temporary:
        path = Path(temporary) / "manifest.json"
        path.write_text(json.dumps(manifest, sort_keys=True, separators=(",", ":")))
        manifest_hash = digest(path)
        prior = receipt["artifacts"].get("manifest.json", {})
        if prior.get("sha256") == manifest_hash and prior.get("state") == "published":
            result = None
        else:
            result = True
        if (prior.get("sha256") == manifest_hash and prior.get("state") in ("failed", "uploading") and
                time.time() - float(prior.get("attempted_at") or 0) < 900):
            raise RuntimeError("private Codex manifest publication cooldown")
        if result:
            prior = {"sha256": manifest_hash, "state": "uploading", "attempted_at": time.time()}
            receipt["artifacts"]["manifest.json"] = prior
            _write_publication_receipt(receipt)
            uploaded = aws("put-object", "--bucket", BUCKET, "--key", PREFIX + "/manifest.json",
                           "--body", str(path), "--server-side-encryption", "AES256",
                           "--content-type", "application/json", timeout=AWS_OVERALL_TIMEOUT)
            if uploaded.returncode:
                prior.update(state="failed", error=aws_failure(uploaded))
                _write_publication_receipt(receipt)
                raise RuntimeError("private Codex release manifest publication failed")
            prior.update(state="published", published_at=time.time())
            _write_publication_receipt(receipt)
    if remote_manifest() != manifest:
        raise RuntimeError("private Codex release manifest readback mismatch")
    print(f"Codex release published to private custody {PIN}", flush=True)


def _write_publication_receipt(value: dict) -> None:
    temporary = PUBLISH_RECEIPT.with_name(PUBLISH_RECEIPT.name + f".{os.getpid()}.tmp")
    temporary.write_text(json.dumps(value, sort_keys=True) + "\n", encoding="utf-8")
    with temporary.open("rb") as stream:
        os.fsync(stream.fileno())
    temporary.replace(PUBLISH_RECEIPT)


def run_once_unlocked() -> None:
    if LOOKUP.is_file():
        try:
            previous = json.loads(LOOKUP.read_text())
            if (previous.get("pin") == PIN and previous.get("target") == TARGET and
                    previous.get("state") in ("local-ready", "downloaded") and
                    time.time() - float(previous.get("at", 0)) < 86400 and
                    all(RELEASE.joinpath(name).is_file() for name in RELEASE_FILES) and
                    RELEASE.joinpath(HOST_READY).is_file()):
                return
        except (OSError, ValueError, TypeError):
            pass
    if all(RELEASE.joinpath(name).is_file() for name in RELEASE_FILES) and RELEASE.joinpath(HOST_READY).is_file():
        # S3 replication is optional; never hold installation hostage to it.
        link_release()
        try:
            publish_local()
            marker("local-ready")
        except Exception as error:
            marker("publish-pending")
            print(f"Codex release locally installed; optional publication pending: {type(error).__name__}", flush=True)
        return
    try:
        manifest = remote_manifest()
    except RuntimeError as error:
        # S3 is replication/distribution, not a prerequisite for the local
        # immutable release. A bounded remote lookup failure must open the
        # source-pinned local builder path instead of starving it indefinitely.
        message = str(error)
        if "aws_cli_timeout" not in message and "endpoint_unreachable" not in message:
            raise
        marker("missing")
        print(f"Codex remote manifest unavailable; local build/install may proceed: {message}",
              flush=True)
        return
    if manifest:
        install_remote(manifest)
        marker("downloaded")
    else:
        marker("missing")


def run_once() -> None:
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    with LOCK.open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        run_once_unlocked()


if __name__ == "__main__":
    while True:
        try:
            run_once()
        except Exception as error:
            marker("unavailable")
            print(f"Codex release custody pending: {type(error).__name__}: {error}", flush=True)
        time.sleep(max(60, int(os.environ.get("COGNILODE_CODEX_CUSTODY_INTERVAL", "300"))))
