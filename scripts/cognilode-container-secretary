#!/usr/bin/env python3
import os, sys, json
from pathlib import Path
os.environ.setdefault("TOKIO_WORKER_THREADS", "2")
os.environ.setdefault("RAYON_NUM_THREADS", "2")
os.environ.setdefault("UV_THREADPOOL_SIZE", "2")
# This launcher is used only inside the already isolated company container.
if not Path("/.dockerenv").exists():
    raise SystemExit("company container launcher requires Docker isolation")
if "--candidates-json" in sys.argv:
    path=Path(sys.argv[sys.argv.index("--candidates-json")+1])
    candidates=json.loads(path.read_text())
    for candidate in candidates:
        if candidate.get("family") in {"installed_codex", "modified_codex"}:
            candidate.setdefault("metadata", {})["sandbox_mode"]="danger-full-access"
            candidate["metadata"]["outer_isolation"]="company-container"
    path.write_text(json.dumps(candidates, indent=2)+"\n")
if "dispatch" in sys.argv and "--context-note" not in sys.argv:
    sys.argv.extend(["--context-note", "Company execution constraints: use no collaboration subagents. Installed employees perform context collection, runtime integration and external effects only; substantive implementation belongs to ChatGPT Chat-mode native sandboxes through the existing D1/Secretary/TaskFlow workflow. Use central conversation reads/deltas for coordination, keep provider rejection/rate-limit and uncertain-mutation controls, preserve unrelated dirty files, use existing images, and do not touch personal browser state."])
from modified_codex.assignment_secretary import main
raise SystemExit(main())
