#!/usr/bin/env python3
"""Install one project recurrence into the shared D1 TaskFlow queue."""
from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys


ROOT = Path(__file__).resolve().parents[1]
CONTROLLER = ROOT / "scripts/cognilode-taskflow-phase-controller"
UNIT_SOURCE = ROOT / "deploy/systemd/user/cognilode-taskflow-phase-controller@.service"


def _controller():
    loader = importlib.machinery.SourceFileLoader("cognilode_taskflow_controller_install", str(CONTROLLER))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError("cannot load TaskFlow controller")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    loader.exec_module(module)
    return module


def prepare(args: argparse.Namespace) -> dict[str, str]:
    if not re.fullmatch(r"[A-Za-z0-9._-]{1,80}", args.instance):
        raise ValueError("instance must be a systemd-safe identifier")
    if args.research_employee == args.external_employee:
        raise ValueError("research and external-effect employees must differ")
    if not 0 <= args.priority <= 1000:
        raise ValueError("priority must be between 0 and 1000")
    controller = _controller()
    plan = controller.parse_plan(args.plan.resolve())
    controller.verify_plan_revision(plan)
    controller.slack_role_context(args.research_employee)
    controller.slack_role_context(args.external_employee)
    if not args.aws_cli.is_file() or not os.access(args.aws_cli, os.X_OK):
        raise ValueError("AWS CLI is not executable")
    if not args.codex_bin.is_file() or not os.access(args.codex_bin, os.X_OK):
        raise ValueError("installed Codex binary is not executable")
    state_root = args.state_root or Path.home() / ".local/share/cognilode/taskflow" / args.instance
    values = {
        "COGNILODE_TASKFLOW_PLAN": str(args.plan.resolve()),
        "COGNILODE_TASKFLOW_RESEARCH_EMPLOYEE": args.research_employee,
        "COGNILODE_TASKFLOW_EXTERNAL_EMPLOYEE": args.external_employee,
        "COGNILODE_TASKFLOW_PRIORITY": str(args.priority),
        "COGNILODE_TASKFLOW_STATE_ROOT": str(state_root.expanduser().resolve()),
        "COGNILODE_TASKFLOW_ATTACHMENT_S3_BUCKET": args.bucket,
        "COGNILODE_AWS_CLI": str(args.aws_cli),
        "COGNILODE_CODEX_BIN": str(args.codex_bin),
        "COGNILODE_TASKFLOW_INTERVAL_SECONDS": str(args.interval),
    }
    if any("\n" in value or "\r" in value for value in values.values()):
        raise ValueError("service value contains a newline")
    return values


def install(args: argparse.Namespace) -> dict[str, object]:
    values = prepare(args)
    config_root = Path.home() / ".config/cognilode"
    env_path = config_root / f"taskflow-{args.instance}.env"
    unit_path = Path.home() / ".config/systemd/user/cognilode-taskflow-phase-controller@.service"
    if args.dry_run:
        return {"ok": True, "dry_run": True, "instance": args.instance, "plan": values["COGNILODE_TASKFLOW_PLAN"]}
    config_root.mkdir(parents=True, exist_ok=True)
    env_path.write_text("".join(f"{key}={json.dumps(value)}\n" for key, value in values.items()), encoding="utf-8")
    env_path.chmod(0o600)
    unit_path.parent.mkdir(parents=True, exist_ok=True)
    unit_path.write_text(UNIT_SOURCE.read_text(encoding="utf-8").replace(
        "%h/Projects/codex-backend-sdk", str(ROOT)), encoding="utf-8")
    for argv in (["systemctl", "--user", "daemon-reload"],
                 ["systemctl", "--user", "enable", "--now", f"cognilode-taskflow-phase-controller@{args.instance}.service"],
                 ["systemctl", "--user", "is-active", f"cognilode-taskflow-phase-controller@{args.instance}.service"]):
        subprocess.run(argv, check=True, capture_output=True, text=True, timeout=45)
    return {"ok": True, "instance": args.instance, "unit": f"cognilode-taskflow-phase-controller@{args.instance}.service",
            "plan": values["COGNILODE_TASKFLOW_PLAN"], "single_queue": "cloudflare-d1"}


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--instance", required=True)
    parser.add_argument("--plan", required=True, type=Path)
    parser.add_argument("--research-employee", required=True)
    parser.add_argument("--external-employee", required=True)
    parser.add_argument("--priority", type=int, default=50)
    parser.add_argument("--state-root", type=Path)
    parser.add_argument("--bucket", default="cognilode-conversation-visibility-362928919715-us-west-2")
    parser.add_argument("--aws-cli", type=Path, default=Path(shutil.which("aws") or "/usr/bin/aws"))
    parser.add_argument("--codex-bin", type=Path, default=Path(shutil.which("codex") or "/home/evan/.local/bin/codex"))
    parser.add_argument("--interval", type=int, default=60)
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    if not 10 <= args.interval <= 3600:
        parser.error("interval must be 10–3600 seconds")
    print(json.dumps(install(args), sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
