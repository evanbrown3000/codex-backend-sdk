#!/usr/bin/env python3
"""Run the one generic Universe Storage source converger for company domains.

This compatibility entry point exists because the company composition already
names it. Source installation, locking, atomic selection, receipts, and
self-replacement belong exclusively to Universe Storage.
"""
from __future__ import annotations

import json
import os
from pathlib import Path
import sys


ROOT = Path(os.environ.get("COGNILODE_COMPANY_SOURCE_ROOT", "/runtime/source"))
UNIVERSE = ROOT / "current/universe-storage"
MANIFEST = UNIVERSE / "deploy/company-source-authorities.json"


def main() -> None:
    source = UNIVERSE / "src"
    if not source.is_dir() or not MANIFEST.is_file():
        raise RuntimeError("Universe Storage source converger is not installed")
    sys.path.insert(0, str(source))
    from universe_storage.source_convergence import GitHubSourceConverger

    manifest = json.loads(MANIFEST.read_text(encoding="utf-8"))
    if manifest.get("schema") != "cognilode.source_authorities.v1":
        raise RuntimeError("unknown company source-authority manifest")
    config = {
        "root": str(ROOT),
        "credential_ref": "/cognilode/agent-credentials/github/owner",
        # This compatibility container receives a centrally refreshed AWS
        # credential_process. It does not contain or copy a GitHub token.
        "credential_command": [
            "/usr/bin/aws", "secretsmanager", "get-secret-value", "--region", "us-west-2",
            "--secret-id", "/cognilode/agent-credentials/github/owner",
            "--query", "SecretString", "--output", "text",
        ],
        "sources": manifest["sources"],
        "event_log": str(ROOT / "events/source-convergence.jsonl"),
    }
    GitHubSourceConverger(config, operator_password="").forever(
        float(os.environ.get("COGNILODE_SOURCE_SYNC_INTERVAL", "30"))
    )


if __name__ == "__main__":
    main()
