#!/usr/bin/env bash
# Atomically advance the source-sync and custody target. The builder follows
# the synchronized immutable checkout without a Compose config change, so an
# in-flight Rust build can finish before it takes the next pin.
set -euo pipefail

if [[ $# != 1 || ! $1 =~ ^[0-9a-f]{40}$ ]]; then
  echo "usage: $0 FULL_CODEX_SOURCE_SHA" >&2
  exit 64
fi
pin=$1
repo=$(git -C "$(dirname "$0")/.." rev-parse --show-toplevel)
source_url=${COGNILODE_CODEX_GIT_URL:-https://github.com/evanbrown3000/cognilode-codex.git}

# A syntactically valid SHA is not a source revision. Verify the exact remote
# commit before changing any release consumer, so a typo cannot stall the
# always-on builder/source-sync loop.
verify_repo=$(mktemp -d "${TMPDIR:-/tmp}/cognilode-codex-pin-verify.XXXXXXXX")
trap 'rm -rf "$verify_repo"' EXIT
git -C "$verify_repo" init --bare -q
if ! git -C "$verify_repo" fetch -q --filter=blob:none --no-tags "$source_url" "$pin" ||
   [[ $(git -C "$verify_repo" cat-file -t "$pin" 2>/dev/null) != commit ]]; then
  echo "source_commit_unavailable pin=$pin" >&2
  exit 69
fi
rm -rf "$verify_repo"
trap - EXIT

for attempt in 1 2 3; do
  git -C "$repo" fetch --quiet origin main
  base=$(git -C "$repo" rev-parse origin/main)
  worktree=$(mktemp -d "${TMPDIR:-/tmp}/cognilode-codex-pin.XXXXXXXX")
  cleanup() {
    git -C "$repo" worktree remove --force "$worktree" >/dev/null 2>&1 || true
    rmdir "$worktree" >/dev/null 2>&1 || true
  }
  trap cleanup EXIT
  git -C "$repo" worktree add --quiet --detach "$worktree" "$base"
  PIN="$pin" WORKTREE="$worktree" python3 - <<'PY'
import os
import pathlib
import re

path = pathlib.Path(os.environ["WORKTREE"]) / "deploy/compose/company-chatmode.yml"
source = path.read_text()
pattern = r"(?m)^(\s*COGNILODE_CODEX_SOURCE_COMMIT:\s*)[0-9a-f]{40}(\s*)$"
updated, count = re.subn(pattern, lambda m: m[1] + os.environ["PIN"] + m[2], source)
if count != 2:
    raise SystemExit(f"expected two release-target pins, found {count}")
path.write_text(updated)
PY
  if git -C "$worktree" diff --quiet; then
    echo "already_pinned source=$pin head=$base"
    exit 0
  fi
  git -C "$worktree" add deploy/compose/company-chatmode.yml
  git -C "$worktree" commit -q -m "Pin native Codex release source $pin"
  promoted=$(git -C "$worktree" rev-parse HEAD)
  if git -C "$worktree" push --quiet origin HEAD:refs/heads/main; then
    echo "pinned source=$pin head=$promoted"
    exit 0
  fi
  cleanup
  trap - EXIT
done
echo "pin_raced source=$pin attempts=3" >&2
exit 75
