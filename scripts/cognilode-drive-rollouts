#!/usr/bin/env python3
"""Forward immutable rollouts to the sole company Drive writer.

This relay owns no Google credentials and never calls rclone. The memory worker
serializes live rollout writes ahead of historical batches, then uploads and
reads back the object before returning a committed receipt.
"""
from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path
import re
import socket
import socketserver


SOCKET = Path(os.environ.get('COGNILODE_ROLLOUT_SOCKET', '/runtime/drive-rollouts/rollouts.sock'))
WRITER = Path(os.environ.get('COGNILODE_DRIVE_WRITER_SOCKET', '/runtime/worker/drive-writer.sock'))
NAME = re.compile(r'^codex-rollout-[0-9a-fA-F-]{16,80}-[0-9a-f]{64}\.json$')
MAX_FRAME = 34 * 1024 * 1024


def canonical(value):
    return json.dumps(value, ensure_ascii=False, sort_keys=True,
                      separators=(',', ':')).encode('utf-8')


def read_exact(connection, length):
    chunks = []
    while length:
        chunk = connection.recv(min(length, 1048576))
        if not chunk:
            raise ConnectionError('incomplete Drive writer response')
        chunks.append(chunk)
        length -= len(chunk)
    return b''.join(chunks)


def writer(operation, name, value=None, expected_sha=None):
    request = {'schema': 'cognilode.drive-writer.v1',
               'operation': operation, 'name': 'codex-rollouts/' + name}
    if value is not None:
        request['value'] = value
    if expected_sha:
        request['sha256'] = expected_sha
    encoded = json.dumps(request, ensure_ascii=False, separators=(',', ':')).encode()
    if len(encoded) > MAX_FRAME:
        raise ValueError('Drive writer request exceeds bound')
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(30)
        connection.connect(str(WRITER))
        connection.sendall(len(encoded).to_bytes(4, 'big') + encoded)
        length = int.from_bytes(read_exact(connection, 4), 'big')
        if not 1 <= length <= MAX_FRAME:
            raise ValueError('invalid Drive writer response length')
        result = json.loads(read_exact(connection, length))
    if not isinstance(result, dict):
        raise ValueError('invalid Drive writer response')
    return result


def valid_rollout(value, revision):
    return isinstance(value, dict) and value.get('revision') == revision and \
        isinstance(value.get('rollout_jsonl'), str) and \
        hashlib.sha256(value['rollout_jsonl'].encode()).hexdigest() == revision


def handle(payload):
    operation = str(payload.get('operation') or '')
    name = str(payload.get('name') or '')
    if not NAME.fullmatch(name):
        raise ValueError('invalid content-addressed rollout name')
    revision = name[-69:-5]
    if operation == 'write':
        value = payload.get('value')
        if not valid_rollout(value, revision):
            raise ValueError('rollout content does not match immutable filename')
        encoded = canonical(value)
        if len(encoded) > 28_000_000:
            raise ValueError('rollout value exceeds bound')
        expected_sha = hashlib.sha256(encoded).hexdigest()
        result = writer('put', name, value, expected_sha)
    elif operation == 'read':
        value = None
        encoded = None
        expected_sha = None
        result = writer('get', name)
    else:
        raise ValueError('unsupported rollout operation')
    state = str(result.get('state') or '')
    if state == 'held':
        return {'ok': False, 'state': 'held', 'error': 'drive_writer_pending',
                'retry_after_seconds': result.get('retry_after_seconds', 60)}
    if state == 'ambiguous':
        return {'ok': False, 'state': 'ambiguous', 'error': 'drive_effect_pending',
                'retry_after_seconds': result.get('retry_after_seconds', 60)}
    if state != 'committed':
        return {'ok': False, 'state': 'error', 'error': 'drive_writer_unavailable'}
    semantic_duplicate = operation == 'write' and result.get('semantic_duplicate') is True
    stored = result.get('value') if operation == 'read' or semantic_duplicate else value
    if not valid_rollout(stored, revision):
        raise ValueError('committed Drive rollout revision mismatch')
    stored_bytes = canonical(stored)
    stored_sha = hashlib.sha256(stored_bytes).hexdigest()
    if semantic_duplicate:
        # The sole writer retained the original immutable bytes. A retried
        # projection may have different ancillary timestamps or stock cursors;
        # never claim those newly submitted bytes were committed to Drive.
        if result.get('submitted_sha256') != expected_sha or any(
            stored.get(field) != value.get(field)
            for field in ('conversation_id', 'provider', 'revision', 'rollout_jsonl')
        ):
            raise ValueError('committed Drive rollout semantic duplicate mismatch')
    elif operation == 'write' and stored_sha != expected_sha:
        raise ValueError('committed Drive rollout payload mismatch')
    if result.get('sha256') != stored_sha:
        raise ValueError('Drive writer receipt digest mismatch')
    if operation == 'write':
        return {'ok': True, 'file_ref': f'rclone-drive:{name}',
                'sha256': stored_sha, 'bytes': len(stored_bytes)}
    return {'ok': True, 'value': stored, 'sha256': stored_sha}


class Server(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    daemon_threads = True


class Handler(socketserver.BaseRequestHandler):
    def handle(self):
        try:
            length = int.from_bytes(read_exact(self.request, 4), 'big')
            if not 1 <= length <= 30_000_000:
                raise ValueError('invalid rollout request length')
            result = handle(json.loads(read_exact(self.request, length)))
        except Exception as error:
            result = {'ok': False, 'state': 'error', 'error': type(error).__name__}
        encoded = json.dumps(result, separators=(',', ':')).encode()
        self.request.sendall(len(encoded).to_bytes(4, 'big') + encoded)


if __name__ == '__main__':
    SOCKET.parent.mkdir(parents=True, exist_ok=True)
    SOCKET.unlink(missing_ok=True)
    with Server(str(SOCKET), Handler) as server:
        os.chmod(SOCKET, 0o600)
        server.serve_forever()
