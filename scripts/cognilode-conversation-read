#!/usr/bin/env python3
"""Read hosted, Codex and historical conversations through one CLI, with delta cursors.

Hosted agents are read from the conversation service. Codex is read from the
verified Google Drive delta store. This is a logical reader, not another copy
of either corpus. A cursor is bound to the exact visible prefix; a changed
prefix asks the caller to refresh rather than silently omitting history.
"""
from __future__ import annotations

import argparse
import base64
from contextlib import contextmanager, nullcontext
from datetime import UTC, datetime, timedelta
import fcntl
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any


HERE = Path(__file__).resolve().parent
DEFAULT_DRIVE_READER = Path(os.environ.get(
    "COGNILODE_DRIVE_READBACK_SCRIPT",
    "/home/evan/.local/share/cognilode/memory-stock-runtime/deploy/conversation-vacuum/canonical_full_readback.py",
))
DEFAULT_HISTORICAL_READER = Path(os.environ.get(
    "COGNILODE_HISTORICAL_S3_READER",
    "/home/evan/.local/share/cognilode/memory-stock-runtime/scripts/historical_s3_conversation.py",
))
SHA256_RE = re.compile(r"[0-9a-f]{64}\Z")


def _verified_codex_drive_join(capture: dict, conversation_id: str) -> bool:
    """Require the D1 source and Drive readback to name the same complete rollout."""
    source_sha = capture.get("source_sha256")
    return bool(
        capture.get("source_kind") == "codex_rollout"
        and capture.get("source_response_complete") is True
        and capture.get("source_complete") is True
        and capture.get("drive_verified") is True
        and isinstance(source_sha, str) and SHA256_RE.fullmatch(source_sha)
        and capture.get("drive_source_sha256") == source_sha
        and isinstance(capture.get("drive_object_sha256"), str)
        and SHA256_RE.fullmatch(capture["drive_object_sha256"])
        and isinstance(capture.get("drive_verified_at"), str)
        and bool(capture["drive_verified_at"].strip())
        and capture.get("drive_conversation_id") == conversation_id
    )


def _verified_historical_drive_join(capture: dict, conversation_id: str,
                                    event_count: int) -> bool:
    """Keep imported export-format text distinct from authenticated live turns."""
    source_sha = capture.get("source_sha256")
    return bool(
        capture.get("source_kind") == "historical_s3_rendered"
        and capture.get("source_provenance") == "chatgpt_export_render_format_unverified_origin"
        and capture.get("source_complete") is True
        and capture.get("source_response_complete") is True
        and capture.get("drive_verified") is True
        and isinstance(source_sha, str) and SHA256_RE.fullmatch(source_sha)
        and capture.get("drive_source_sha256") == source_sha
        and isinstance(capture.get("s3_compressed_sha256"), str)
        and SHA256_RE.fullmatch(capture["s3_compressed_sha256"])
        and isinstance(capture.get("drive_object_sha256"), str)
        and SHA256_RE.fullmatch(capture["drive_object_sha256"])
        and isinstance(capture.get("drive_readback_rows_sha256"), str)
        and SHA256_RE.fullmatch(capture["drive_readback_rows_sha256"])
        and isinstance(capture.get("drive_verified_at"), str)
        and bool(capture["drive_verified_at"].strip())
        and capture.get("drive_conversation_id") == conversation_id
        and capture.get("source_event_count") == event_count
    )


def _load_script(path: Path, name: str) -> Any:
    if not path.is_file():
        raise FileNotFoundError(f"conversation reader unavailable: {path}")
    # The Drive reader is deployed as a script beside transport helpers, with
    # Memory Stock's package in the checkout's src/ directory. Keep those
    # import roots for its lazy imports when read_full_conversation runs.
    import_roots = [path.parent]
    for parent in path.parents:
        source_root = parent / "src"
        if (source_root / "memory_stock").is_dir():
            import_roots.append(source_root)
            break
    for root in reversed(import_roots):
        location = str(root)
        if location not in sys.path:
            sys.path.insert(0, location)
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


def _codex_d1_messages(raw: list[dict], capture: dict) -> tuple[list[dict], str]:
    """Rejoin D1 transport segments into source messages and check source hashes."""
    try:
        ordered = sorted(raw, key=lambda row: int(row["index"]))
        if [int(row["index"]) for row in ordered] != list(range(len(ordered))):
            raise ValueError("Codex D1 segment indices differ")
        if capture.get("source_event_count") != len(ordered):
            raise ValueError("Codex D1 source segment count differs")
        manifest = capture.get("source_message_segments")
        if manifest is None:
            # Older admissions predate the manifest. Equal source-message and
            # segment counts prove there was no split, but cannot recheck the
            # original message-order hash independently.
            if (capture.get("source_full_message_count") != len(ordered)
                or capture.get("source_has_segmented_messages") is True):
                raise ValueError("Codex D1 legacy admission may contain unjoined segments")
            return ([{"id": str(row.get("id") or index), "role": str(row["role"]),
                      "text": str(row["content"]), "occurred_at_utc": row.get("created_at") or ""}
                     for index, row in enumerate(ordered)],
                    "admitted_codex_rollout_legacy_unsplit_drive_unverified")
        if not isinstance(manifest, list) or len(manifest) != capture.get("source_full_message_count"):
            raise ValueError("Codex D1 source message manifest differs")
        messages = []
        digest_rows = []
        cursor = 0
        for item in manifest:
            if not isinstance(item, dict) or item.get("segment_start") != cursor:
                raise ValueError("Codex D1 source segment order differs")
            count = item.get("segment_count")
            ids = item.get("segment_source_ids")
            role = item.get("role")
            if (not isinstance(count, int) or count < 1 or not isinstance(ids, list)
                or len(ids) != count or any(not isinstance(value, str) or not value for value in ids)
                or role not in {"user", "assistant"}):
                raise ValueError("Codex D1 source segment manifest is malformed")
            pieces = ordered[cursor:cursor + count]
            if len(pieces) != count or any(row.get("role") != role or not isinstance(row.get("content"), str)
                                           for row in pieces):
                raise ValueError("Codex D1 segment role or coverage differs")
            text = "".join(row["content"] for row in pieces)
            full_sha = hashlib.sha256(text.encode("utf-8")).hexdigest()
            if full_sha != item.get("content_sha256"):
                raise ValueError("Codex D1 reconstructed message SHA-256 differs")
            ordinal = item.get("source_ordinal")
            if not isinstance(ordinal, int):
                raise ValueError("Codex D1 source ordinal is malformed")
            messages.append({"id": ids[0], "role": role, "text": text,
                             "occurred_at_utc": pieces[0].get("created_at") or "",
                             "source_segment_ids": ids})
            digest_rows.append([role, text, full_sha, ordinal])
            cursor += count
        if cursor != len(ordered) or capture.get("source_has_segmented_messages") != any(
                item["segment_count"] > 1 for item in manifest):
            raise ValueError("Codex D1 segment coverage differs")
        full_digest = hashlib.sha256(json.dumps(digest_rows, ensure_ascii=False,
            sort_keys=True, separators=(",", ":")).encode("utf-8")).hexdigest()
        if full_digest != capture.get("source_full_messages_sha256"):
            raise ValueError("Codex D1 original message-order SHA-256 differs")
        return messages, "admitted_codex_rollout_messages_drive_unverified"
    except (KeyError, TypeError) as exc:
        raise ValueError("Codex D1 source message manifest is incomplete") from exc


def read_conversation(provider: str, conversation_id: str, *, drive_reader: Path = DEFAULT_DRIVE_READER,
                      historical_reader: Path = DEFAULT_HISTORICAL_READER) -> dict:
    if provider in {"historical-s3", "historical_s3"}:
        if not historical_reader.is_file():
            raise FileNotFoundError(f"historical conversation reader unavailable: {historical_reader}")
        completed = subprocess.run([sys.executable, str(historical_reader), "read", conversation_id, "--json"],
                                   text=True, capture_output=True, check=True, timeout=120)
        result = json.loads(completed.stdout)
        rendered = result.get("rendered_markdown")
        rows = result.get("events")
        if (result.get("schema") != "memory_stock.historical_s3_delta_read.v1"
            or result.get("changed") is not True or result.get("reset_required") is not False
            or result.get("conversation_id") != conversation_id
            or result.get("provider") != "historical-s3" or not isinstance(rendered, str)
            or not isinstance(rows, list) or len(rows) != result.get("message_count")
            or hashlib.sha256(rendered.encode("utf-8")).hexdigest() != result.get("rendered_sha256")):
            raise ValueError("historical S3 readback identity, coverage or hash mismatch")
        events = []
        for row in rows:
            if not isinstance(row, dict) or not row.get("node_id") or row.get("role") not in {
                "user", "assistant", "system", "developer", "tool"} or not isinstance(row.get("text"), str):
                raise ValueError("historical S3 event is malformed")
            events.append({"id": str(row["node_id"]), "role": str(row["role"]),
                           "text": row["text"],
                           "occurred_at_utc": str(row.get("format_and_time") or "").rsplit(" · ", 1)[-1],
                           "parent_node_id": row.get("parent_node_id")})
        return {"provider": "historical-s3", "conversation_id": conversation_id,
                "source": "s3_dynamodb_historical_stock", "events": events,
                "coverage": result["coverage"], "all_provider_events_known": False,
                "source_receipt": result["source_receipt"], "rendered_sha256": result["rendered_sha256"]}
    if provider in {"chatgpt", "chatgpt.com", "chatgpt-export-format", "gemini.com", "anthropic.com", "claude.com", "codex-d1"}:
        hosted_provider = ({"chatgpt": "chatgpt.com", "codex-d1": "openai-codex"}.get(provider, provider))
        sender = _load_script(HERE / "cognilode-b4pt0r-chatmode", "cognilode_conversation_sender_read")
        result = sender.operator_memory_post({
            "operation": "read", "provider": hosted_provider, "conversation_id": conversation_id,
        })
        conversation = result.get("conversation") or {}
        if conversation.get("conversation_id") != conversation_id or conversation.get("provider") != hosted_provider:
            raise ValueError("hosted conversation identity mismatch")
        raw = conversation.get("events")
        if not isinstance(raw, list):
            raise ValueError("hosted conversation has no event list")
        events = []
        for index, row in enumerate(raw):
            if not isinstance(row, dict) or not isinstance(row.get("content"), str):
                raise ValueError("incomplete hosted conversation event")
            events.append({
                "id": str(row.get("id") or index), "role": str(row.get("role") or "unknown"),
                "text": row["content"], "occurred_at_utc": row.get("created_at") or "",
            })
        d1_codex = provider == "codex-d1"
        capture = conversation.get("capture") or {}
        historical_export = provider == "chatgpt-export-format"
        if historical_export and not _verified_historical_drive_join(capture, conversation_id, len(raw)):
            raise ValueError("historical export-format D1 source or Drive join is incomplete")
        if d1_codex and not (
            _verified_codex_drive_join(capture, conversation_id)
            or (capture.get("source_kind") == "codex_rollout"
                and capture.get("drive_verified") is False
                and isinstance(capture.get("source_sha256"), str)
                and SHA256_RE.fullmatch(capture["source_sha256"]))
        ):
            raise ValueError("Codex D1 source receipt or Drive join is incomplete")
        coverage = "admitted_events_only"
        if d1_codex:
            events, coverage = _codex_d1_messages(raw, capture)
            if capture.get("drive_verified") is True:
                coverage = coverage.replace("drive_unverified", "drive_verified")
        elif historical_export:
            coverage = "complete_imported_render_drive_verified_origin_unverified"
        return {"provider": hosted_provider, "conversation_id": conversation_id,
                "source": ("historical_export_format_d1_drive_verified" if historical_export else
                           (("hosted_d1_codex_drive_verified" if capture.get("drive_verified") is True
                             else "hosted_d1_codex_interim") if d1_codex else "hosted_conversation_service")),
                "events": events,
                # This store certifies the admitted prompt/response hashes, but
                # does not claim that every provider-side branch was ingested.
                "coverage": coverage,
                "all_provider_events_known": (False if d1_codex or historical_export else all(row.get("source_content_complete") is True
                                                 for row in raw)),
                **({"source_receipt": capture} if d1_codex or historical_export else {})}

    if provider in {"codex", "openai-codex", "modified_codex", "modified-codex"}:
        # The Drive reader shares the installed Memory Stock reconciliation
        # package, which may not already be on this CLI's PYTHONPATH.
        package_root = drive_reader.resolve().parents[2] / "src"
        if package_root.is_dir() and str(package_root) not in sys.path:
            sys.path.insert(0, str(package_root))
        reader = _load_script(drive_reader, "cognilode_drive_conversation_read")
        result = reader.read_full_conversation(provider, conversation_id)
        if not result.get("complete_text") or result.get("conversation_id") != conversation_id:
            raise ValueError("Drive conversation readback incomplete or identity mismatch")
        events = [{
            "id": str(row["event_id"]), "role": str(row["role"]),
            "text": str(row["text"]), "occurred_at_utc": row.get("occurred_at_utc") or "",
        } for row in result["reconciled_events"]]
        return {"provider": provider, "conversation_id": conversation_id,
                "source": "google_drive_normalized_deltas", "events": events,
                "coverage": "all_admitted_drive_deltas",
                "all_provider_events_known": False,
                "remote_delta_objects": result["remote_delta_objects"]}

    raise ValueError("unsupported conversation provider")


def _prefix_digest(events: list[dict], count: int) -> str:
    rows = [[e["id"], e["role"], hashlib.sha256(e["text"].encode("utf-8")).hexdigest()]
            for e in events[:count]]
    return hashlib.sha256(json.dumps(rows, ensure_ascii=False, separators=(",", ":")).encode("utf-8")).hexdigest()


def _cursor(provider: str, conversation_id: str, events: list[dict], count: int) -> str:
    value = {"v": 1, "provider": provider, "conversation_id": conversation_id,
             "count": count, "prefix_sha256": _prefix_digest(events, count)}
    return base64.urlsafe_b64encode(json.dumps(value, sort_keys=True, separators=(",", ":")).encode()).decode().rstrip("=")


def delta_view(result: dict, since: str = "") -> dict:
    events = result["events"]
    start = 0
    if since:
        try:
            cursor = json.loads(base64.urlsafe_b64decode(since + "=" * (-len(since) % 4)))
        except (ValueError, UnicodeDecodeError) as exc:
            raise ValueError("invalid conversation cursor") from exc
        if (cursor.get("v") != 1 or cursor.get("provider") != result["provider"]
                or cursor.get("conversation_id") != result["conversation_id"]):
            raise ValueError("conversation cursor belongs to another conversation")
        start = cursor.get("count")
        if not isinstance(start, int) or start < 0 or start > len(events):
            raise ValueError("conversation prefix changed; refresh full conversation")
        if cursor.get("prefix_sha256") != _prefix_digest(events, start):
            raise ValueError("conversation prefix changed; refresh full conversation")
    return {**{k: v for k, v in result.items() if k != "events"},
            "total_events": len(events), "new_events": len(events) - start,
            "events": events[start:],
            "next_cursor": _cursor(result["provider"], result["conversation_id"], events, len(events))}


def remembered_cursor_path(root: Path, reader_id: str, provider: str, conversation_id: str) -> Path:
    if not reader_id or len(reader_id) > 160:
        raise ValueError("reader ID must be a nonempty bounded name")
    key = hashlib.sha256(json.dumps([reader_id, provider, conversation_id],
                                    ensure_ascii=False, separators=(",", ":")).encode()).hexdigest()
    return root / (key + ".json")


@contextmanager
def remembered_cursor_lock(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    lock = path.with_suffix(".lock")
    with lock.open("a+b") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(handle, fcntl.LOCK_UN)


def load_remembered_cursor(path: Path, reader_id: str, provider: str, conversation_id: str) -> str:
    if not path.is_file():
        return ""
    row = json.loads(path.read_text(encoding="utf-8"))
    if ([row.get("reader_id"), row.get("provider"), row.get("conversation_id")]
            != [reader_id, provider, conversation_id] or not isinstance(row.get("cursor"), str)):
        raise ValueError("remembered conversation cursor identity mismatch")
    return row["cursor"]


def save_remembered_cursor(path: Path, reader_id: str, provider: str,
                           conversation_id: str, cursor: str) -> None:
    row = {"reader_id": reader_id, "provider": provider,
           "conversation_id": conversation_id, "cursor": cursor}
    payload = json.dumps(row, ensure_ascii=False, sort_keys=True).encode("utf-8")
    with tempfile.NamedTemporaryFile(dir=path.parent, prefix=".cursor-", delete=False) as temp:
        tmp = Path(temp.name)
        os.fchmod(temp.fileno(), 0o600)
        temp.write(payload)
        temp.flush()
        os.fsync(temp.fileno())
    try:
        os.replace(tmp, path)
    finally:
        tmp.unlink(missing_ok=True)


def shared_remembered_cursor(reader_id: str, provider: str, conversation_id: str) -> tuple[str, int]:
    """Read one employee's cursor from the same D1 store on every device."""
    remembered_cursor_path(Path("."), reader_id, provider, conversation_id)
    sender = _load_script(HERE / "cognilode-b4pt0r-chatmode", "cognilode_shared_cursor_reader")
    result = sender.operator_memory_post({"operation":"get_reader_cursor", "reader_id":reader_id,
                                          "provider":provider, "conversation_id":conversation_id})
    if (not result.get("ok") or [result.get("reader_id"), result.get("provider"), result.get("conversation_id")]
        != [reader_id, provider, conversation_id] or not isinstance(result.get("cursor"), str)
        or not isinstance(result.get("generation"), int) or result["generation"] < 0):
        raise ValueError("shared reader cursor identity/readback mismatch")
    return result["cursor"], result["generation"]


def advance_shared_remembered_cursor(reader_id: str, provider: str, conversation_id: str,
                                     expected_generation: int, cursor: str) -> dict:
    sender = _load_script(HERE / "cognilode-b4pt0r-chatmode", "cognilode_shared_cursor_writer")
    result = sender.operator_memory_post({"operation":"advance_reader_cursor", "reader_id":reader_id,
                                          "provider":provider, "conversation_id":conversation_id,
                                          "expected_generation":expected_generation, "next_cursor":cursor})
    if (not result.get("ok") or [result.get("reader_id"), result.get("provider"), result.get("conversation_id")]
        != [reader_id, provider, conversation_id] or not isinstance(result.get("cursor"), str)
        or not isinstance(result.get("generation"), int)):
        raise ValueError("shared reader cursor advance/readback mismatch")
    if result.get("advanced") is True:
        if result["cursor"] != cursor or result["generation"] != expected_generation + 1:
            raise ValueError("shared reader cursor advance did not commit expected state")
    elif result.get("conflict") is not True:
        raise ValueError("shared reader cursor advance has no committed or conflict state")
    return result


def inbox_updates(provider: str = "", *, cursor: str = "", since_at: str = "",
                  limit: int = 100) -> dict:
    """List changed shared conversations without paging an unstable offset."""
    sender = _load_script(HERE / "cognilode-b4pt0r-chatmode", "cognilode_conversation_inbox")
    result = sender.operator_memory_post({"operation": "list_conversation_updates",
                                          "provider": provider, "cursor": cursor,
                                          "since_at": since_at, "limit": limit})
    rows = result.get("rows")
    next_cursor = result.get("next_cursor")
    if not result.get("ok") or not isinstance(rows, list) or not isinstance(next_cursor, str):
        raise ValueError("shared conversation inbox response is incomplete")
    try:
        next_state = json.loads(next_cursor)
    except (TypeError, ValueError) as exc:
        raise ValueError("shared conversation inbox cursor is invalid") from exc
    if (next_state.get("v") != 1 or next_state.get("provider") != provider
            or not isinstance(next_state.get("updated_at"), str)
            or not isinstance(next_state.get("conversation_key"), str)
            or any(not isinstance(row, dict) or not isinstance(row.get("provider"), str)
                   or not isinstance(row.get("conversation_id"), str)
                   or not isinstance(row.get("updated_at"), str) for row in rows)):
        raise ValueError("shared conversation inbox identity is invalid")
    return {"provider_filter": provider, "updates": rows, "new_conversations": len(rows),
            "has_more": result.get("has_more") is True, "next_cursor": next_cursor}


def render_inbox(result: dict, output_format: str) -> None:
    if output_format == "json":
        print(json.dumps(result, ensure_ascii=False))
        return
    print("# Changed conversations\n")
    for row in result["updates"]:
        print(f"- {row['updated_at']} · {row['provider']} · {row['conversation_id']} · {row.get('title') or ''}")
    if not result["updates"]:
        print("No changes in this page.")
    if result["has_more"]:
        print("\nMore updates remain; run this command again with --remember or pass --inbox-cursor.")


def render_inbox_details(result: dict, args: argparse.Namespace) -> None:
    """Read changed threads and acknowledge each only after its delta is printed.

    The inbox cursor is advanced by the caller only after every thread succeeds.
    If a later read fails, already printed threads have their own cursors and a
    retry can safely revisit the same inbox page without rereading them in full.
    """
    for row in result["updates"]:
        provider = row["provider"]
        conversation_id = row["conversation_id"]
        local = args.remember and args.remember_store == "local"
        path = (remembered_cursor_path(args.cursor_root, args.reader_id,
                                       provider, conversation_id) if local else None)
        with remembered_cursor_lock(path) if path else nullcontext():
            if args.remember and args.remember_store == "shared":
                previous, generation = shared_remembered_cursor(
                    args.reader_id, provider, conversation_id)
            else:
                generation = None
                previous = (load_remembered_cursor(path, args.reader_id, provider,
                                                   conversation_id) if local else "")
            source = read_conversation(provider, conversation_id,
                                       drive_reader=args.drive_reader,
                                       historical_reader=args.historical_reader)
            try:
                detail = delta_view(source, previous)
            except ValueError as exc:
                if "prefix changed" not in str(exc):
                    raise
                detail = delta_view(source)
                detail["cursor_reset_reason"] = "source_prefix_changed"
            detail["inbox_updated_at"] = row["updated_at"]
            render_view(detail, args.format)
            sys.stdout.flush()
            if args.remember:
                if args.remember_store == "shared":
                    committed = advance_shared_remembered_cursor(
                        args.reader_id, provider, conversation_id, generation,
                        detail["next_cursor"])
                    if committed.get("conflict"):
                        raise RuntimeError("shared conversation cursor moved concurrently; inbox not acknowledged")
                else:
                    save_remembered_cursor(path, args.reader_id, provider,
                                           conversation_id, detail["next_cursor"])
    if not result["updates"] and args.format == "markdown":
        print("No changed conversations in this page.")


def render_view(result: dict, output_format: str) -> None:
    if output_format == "json":
        print(json.dumps(result, ensure_ascii=False))
    else:
        print(f"# {result['provider']}/{result['conversation_id']}\n")
        print(f"Source: {result['source']} · coverage: {result['coverage']} · "
              f"all provider events known: {result['all_provider_events_known']} · "
              f"new: {result['new_events']} / {result['total_events']}\n")
        for event in result["events"]:
            print(f"## {event['role']} {event['occurred_at_utc']}\n\n{event['text']}\n")
        print(f"<!-- next_cursor: {result['next_cursor']} -->")


def resolve_job_conversation(job_id: str, *, expected_provider: str = "",
                             expected_conversation_id: str = "") -> dict:
    """Resolve a queued prompt to its centrally admitted provider conversation."""
    if not job_id or len(job_id) > 160:
        raise ValueError("job ID must be nonempty and bounded")
    sender = _load_script(HERE / "cognilode-b4pt0r-chatmode", "cognilode_conversation_job_reader")
    result = sender.operator_memory_post({"operation": "get_job", "job_id": job_id})
    job = result.get("job") or {}
    if not result.get("ok") or job.get("id") != job_id:
        raise ValueError("shared queue job readback identity mismatch")
    provider = str(job.get("provider") or "")
    conversation_id = str(job.get("conversation_id") or "")
    codex_taskflow = provider in {"codex.research", "codex.external-effect"}
    normalized_expected = {"chatgpt": "chatgpt.com", "codex-d1": "openai-codex"}.get(
        expected_provider, expected_provider)
    provider_matches = (not normalized_expected or provider == normalized_expected
                        or (codex_taskflow and normalized_expected in {"codex", "openai-codex"}))
    if not provider_matches:
        raise ValueError("queue job provider or conversation identity mismatch")
    state = str(job.get("state") or "")
    if codex_taskflow:
        identities = [row for row in job.get("effect_evidence") or []
                      if isinstance(row, dict) and row.get("kind") == "codex_session_identity"]
        if len(identities) > 1:
            raise ValueError("queue job has multiple Codex session identities")
        identity = identities[0] if identities else None
        if identity:
            cid = identity.get("conversation_id")
            if (not isinstance(cid, str) or not cid or len(cid) > 160
                or identity.get("job_id") != job_id or identity.get("ref") != cid
                or identity.get("conversation_id_source") != "codex_cli_stderr_header"
                or not isinstance(identity.get("run_id"), str) or not identity["run_id"]
                or any(not isinstance(identity.get(key), str)
                       or not SHA256_RE.fullmatch(identity[key])
                       for key in ("compact_receipt_sha256", "codex_stderr_sha256"))
                or (conversation_id and conversation_id != cid)):
                raise ValueError("queue job Codex session identity evidence mismatch")
            conversation_id = cid
        if expected_conversation_id and conversation_id != expected_conversation_id:
            raise ValueError("queue job provider or conversation identity mismatch")
        link = {"job_id": job_id, "state": state, "provider": "codex-d1",
                "job_provider": provider, "conversation_id": conversation_id or None,
                "conversation_ready": False}
        if state != "complete" or not identity:
            return link
        try:
            central = sender.operator_memory_post({"operation": "read", "provider": "openai-codex",
                                                   "conversation_id": conversation_id})
        except (OSError, RuntimeError):
            # Admission/Drive readback may lag job completion or be temporarily
            # unavailable. Preserve the session link; never advance a cursor.
            return link
        stored = central.get("conversation") or {}
        if not stored:
            return link
        if stored.get("provider") != "openai-codex" or stored.get("conversation_id") != conversation_id:
            raise ValueError("central Codex conversation identity mismatch")
        capture = stored.get("capture") or {}
        if (not isinstance(stored.get("events"), list) or not isinstance(capture, dict)
            or not _verified_codex_drive_join(capture, conversation_id)):
            return link
        link["conversation_ready"] = True
        return link
    if expected_conversation_id and conversation_id != expected_conversation_id:
        raise ValueError("queue job provider or conversation identity mismatch")
    if state != "complete":
        return {"job_id": job_id, "state": state, "provider": provider,
                "conversation_id": conversation_id or None, "conversation_ready": False}
    if not provider or not conversation_id:
        raise ValueError("completed queue job has no provider conversation identity")
    evidence = [row for row in job.get("effect_evidence") or [] if isinstance(row, dict)]
    if not all(any(row.get("kind") == kind and row.get("ref") == conversation_id for row in evidence)
               for kind in ("provider_conversation", "central_conversation_readback")):
        raise ValueError("completed queue job lacks matching central provider readback")
    return {"job_id": job_id, "state": state, "provider": provider,
            "conversation_id": conversation_id, "conversation_ready": True}


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--provider", default="")
    parser.add_argument("--conversation-id", default="")
    parser.add_argument("--job-id", default="", help="resolve a shared queue job to its admitted conversation")
    parser.add_argument("--inbox", action="store_true", help="list changed conversations across providers")
    parser.add_argument("--inbox-detail", action="store_true",
                        help="read each changed conversation, full once then deltas with --remember")
    parser.add_argument("--inbox-cursor", default="", help="opaque cursor from a previous inbox page")
    parser.add_argument("--inbox-since", default="", help="ISO timestamp for first inbox page; default is the last 48 hours")
    parser.add_argument("--inbox-limit", type=int, default=100)
    parser.add_argument("--since", default="", help="opaque next_cursor from a prior read")
    parser.add_argument("--drive-reader", type=Path, default=DEFAULT_DRIVE_READER)
    parser.add_argument("--historical-reader", type=Path, default=DEFAULT_HISTORICAL_READER)
    parser.add_argument("--format", choices=("json", "markdown"), default="json")
    parser.add_argument("--remember", action="store_true",
                        help="show the full conversation once, then only unseen events for this reader")
    parser.add_argument("--remember-store", choices=("shared", "local"), default="shared",
                        help="shared D1 cursor follows an employee across devices; local is device-only")
    parser.add_argument("--reader-id", default=os.environ.get("COGNILODE_READER_ID", "default"))
    parser.add_argument("--cursor-root", type=Path, default=Path.home()/".local/state/cognilode/conversation-read-cursors")
    args = parser.parse_args()
    if args.remember and args.since:
        parser.error("--remember and --since cannot be combined")
    if args.remember and args.remember_store == "shared" and args.reader_id == "default":
        parser.error("shared --remember requires --reader-id or COGNILODE_READER_ID for the named employee")
    if args.inbox_detail and not args.inbox:
        parser.error("--inbox-detail requires --inbox")
    if args.inbox:
        if args.job_id or args.conversation_id or args.since or (args.remember and args.inbox_cursor):
            parser.error("--inbox cannot combine with a conversation, job, --since, or remembered explicit cursor")
        if not 1 <= args.inbox_limit <= 500:
            parser.error("--inbox-limit must be between 1 and 500")
        identity = "provider-" + (args.provider or "all")
        cursor = args.inbox_cursor
        generation = None
        path = None
        if args.remember:
            if args.remember_store == "shared":
                cursor, generation = shared_remembered_cursor(args.reader_id, "cognilode-inbox", identity)
            else:
                path = remembered_cursor_path(args.cursor_root,args.reader_id,"cognilode-inbox",identity)
                with remembered_cursor_lock(path):
                    cursor = load_remembered_cursor(path,args.reader_id,"cognilode-inbox",identity)
                    since_at = args.inbox_since or (datetime.now(UTC)-timedelta(hours=48)).isoformat()
                    result = inbox_updates(args.provider,cursor=cursor,since_at=since_at,limit=args.inbox_limit)
                    (render_inbox_details if args.inbox_detail else render_inbox)(result,args if args.inbox_detail else args.format)
                    sys.stdout.flush()
                    save_remembered_cursor(path,args.reader_id,"cognilode-inbox",identity,result["next_cursor"])
                return 0
        since_at = args.inbox_since or (datetime.now(UTC)-timedelta(hours=48)).isoformat()
        result = inbox_updates(args.provider,cursor=cursor,since_at=since_at,limit=args.inbox_limit)
        (render_inbox_details if args.inbox_detail else render_inbox)(result,args if args.inbox_detail else args.format)
        sys.stdout.flush()
        if args.remember:
            if args.remember_store == "shared":
                committed = advance_shared_remembered_cursor(
                    args.reader_id,"cognilode-inbox",identity,generation,result["next_cursor"])
                if committed.get("conflict"):
                    print("shared inbox cursor moved concurrently; reread to reconcile",file=sys.stderr)
        return 0
    job_link = None
    if args.job_id:
        job_link = resolve_job_conversation(args.job_id, expected_provider=args.provider,
                                            expected_conversation_id=args.conversation_id)
        if not job_link["conversation_ready"]:
            if args.format == "json":
                print(json.dumps(job_link, ensure_ascii=False))
            else:
                print(f"# Job {args.job_id}\n\nState: {job_link['state']} · conversation not yet admitted")
            return 0
        args.provider = job_link["provider"]
        args.conversation_id = job_link["conversation_id"]
    elif not args.provider or not args.conversation_id:
        parser.error("supply --job-id or both --provider and --conversation-id")
    def read() -> dict:
        return read_conversation(args.provider, args.conversation_id,
                                 drive_reader=args.drive_reader,
                                 historical_reader=args.historical_reader)
    if args.remember:
        if args.remember_store == "shared":
            previous, generation = shared_remembered_cursor(args.reader_id,args.provider,args.conversation_id)
            source=read()
            try:
                result=delta_view(source,previous)
            except ValueError as exc:
                if "prefix changed" not in str(exc):
                    raise
                result=delta_view(source)
                result["cursor_reset_reason"]="source_prefix_changed"
            if job_link: result["queue_job"] = job_link
            render_view(result,args.format)
            sys.stdout.flush()
            committed=advance_shared_remembered_cursor(args.reader_id,args.provider,args.conversation_id,
                                                        generation,result["next_cursor"])
            if committed.get("conflict"):
                print("shared cursor moved concurrently; reread to reconcile unseen events",file=sys.stderr)
            return 0
        path=remembered_cursor_path(args.cursor_root, args.reader_id, args.provider, args.conversation_id)
        with remembered_cursor_lock(path):
            previous=load_remembered_cursor(path,args.reader_id,args.provider,args.conversation_id)
            source=read()
            try:
                result=delta_view(source,previous)
            except ValueError as exc:
                if "prefix changed" not in str(exc):
                    raise
                result=delta_view(source)
                result["cursor_reset_reason"]="source_prefix_changed"
            if job_link: result["queue_job"] = job_link
            render_view(result,args.format)
            sys.stdout.flush()
            save_remembered_cursor(path,args.reader_id,args.provider,args.conversation_id,
                                   result["next_cursor"])
    else:
        result=delta_view(read(),args.since)
        if job_link: result["queue_job"] = job_link
        render_view(result,args.format)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
