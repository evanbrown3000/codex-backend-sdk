#!/usr/bin/env python3
"""Discover factual Slack roles; install only employees proven by a real D1 turn.

This is a roster reconciler, not a prompt queue. Slack text supplies identity facts,
never instructions. The installed roster is deliberately narrower than candidates.
"""
from __future__ import annotations

import argparse
import base64
from datetime import datetime, timezone
import gzip
import hashlib
import html
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import sys
import tempfile
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
INSTALLED = ROOT / "config/employee-slack-roles.json"
CANDIDATES = ROOT / "config/employee-slack-candidates.json"
ACTIVATIONS = ROOT / "config/employee-route-activations.json"
SENDER = ROOT / "scripts/cognilode-b4pt0r-chatmode"
TASKFLOW = ROOT / "scripts/cognilode-taskflow-phase-controller"
DEFAULT_SNAPSHOTS = (Path.home() / ".local/share/cognilode/"
                     "spine-rpe-decisionx-batches-20261007T223721Z/decisionx-spine/slack")
LANDING_SNAPSHOTS = Path.home() / ".local/share/cognilode/slack-role-snapshots"
ROLE = re.compile(r"^(?P<name>[A-Z][a-z]+(?: [A-Z][a-z]+){1,2}) — "
                  r"(?P<role>[^—\n]{8,100}) — (?P<org>[^\n]{4,180})$")
TITLE = re.compile(r"\b(?:Engineer|Researcher|Scientist|Architect|Manager|Director|Specialist|Lead)\b")
ORG = re.compile(r"^(?:Platform Engineering|Research Engineering|Data Platform|Infrastructure"
                 r"|Provider Integrations|Autonomous Systems|Automation Engineering|AI Research"
                 r"|Operator & Product Experience|Product Experience|Quality Assurance"
                 r"|Security Engineering|Interaction & Execution Platform)\b")
MAX_SNAPSHOTS = 500
MAX_SNAPSHOT_BYTES = 4_000_000


def source_message(channel: str, ts: str) -> str:
    return f"https://everything-ces8532.slack.com/archives/{channel}/p{ts.replace('.', '')}"


def role_from_message(text: str) -> tuple[str, str, str] | None:
    first = html.unescape(text).strip().split("\n", 1)[0].strip()
    match = ROLE.fullmatch(first)
    if not match or not TITLE.search(match["role"]):
        return None
    org = match["org"]
    # Execution status lines are not role declarations.
    if (not ORG.search(org)
        or re.search(r"\b(?:ACTIVE|execution note|changed shared effect|claim-barrier|\d{1,2}:\d{2})\b", org, re.I)):
        return None
    return match["name"], match["role"], org


def discover(snapshot_dirs: list[Path]) -> dict[str, Any]:
    candidates: dict[str, dict[str, Any]] = {}
    projects: dict[str, list[str]] = {}
    for directory in snapshot_dirs:
        files = sorted(directory.glob("*.json")) if directory.is_dir() else []
        if len(files) > MAX_SNAPSHOTS:
            raise ValueError(f"too many Slack snapshots in {directory}")
        for path in files:
            if path.stat().st_size > MAX_SNAPSHOT_BYTES:
                raise ValueError(f"Slack snapshot too large: {path}")
            document = json.loads(path.read_text(encoding="utf-8"))
            channel = str(document.get("channel_id") or "")
            if not re.fullmatch(r"C[A-Z0-9]{8,}", channel):
                continue
            channel_names: set[str] = set()
            for message in document.get("messages") or []:
                if not isinstance(message, dict):
                    continue
                parsed = role_from_message(str(message.get("text") or ""))
                ts = str(message.get("ts") or "")
                if not parsed or not re.fullmatch(r"\d{10}\.\d{1,6}", ts):
                    continue
                name, role, org = parsed
                channel_names.add(name)
                ref = source_message(channel, ts)
                row = candidates.setdefault(name, {"role": role, "org": org,
                                                   "slack_message": ref,
                                                   "sources": [], "role_variants": []})
                row["sources"].append(ref)
                variant = {"role": role, "org": org, "slack_message": ref}
                if variant not in row["role_variants"]:
                    row["role_variants"].append(variant)
                # Prefer the latest valid declaration, never a status update.
                if ts > row.get("latest_ts", ""):
                    row.update(role=role, org=org, slack_message=ref, latest_ts=ts)
            if channel_names:
                projects[path.stem] = sorted(channel_names)
    for row in candidates.values():
        row["sources"] = sorted(set(row["sources"]))
        row.pop("latest_ts", None)
    return {"schema": "cognilode.employee_slack_candidates.v1",
            "sources": [str(p) for p in snapshot_dirs],
            "candidates": dict(sorted(candidates.items())), "channels": projects}


def _sender():
    loader = importlib.machinery.SourceFileLoader("employee_roster_sender", str(SENDER))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    loader.exec_module(module)
    return module


def _taskflow_header_session_id(stderr: str) -> str | None:
    loader = importlib.machinery.SourceFileLoader("employee_roster_taskflow", str(TASKFLOW))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    loader.exec_module(module)
    return module.codex_header_session_id(stderr)


def _drive_capture_verified(capture: dict[str, Any], cid: str) -> bool:
    source_sha = str(capture.get("source_sha256") or "")
    return bool(capture.get("source_kind") == "codex_rollout"
                and capture.get("source_response_complete") is True
                and capture.get("source_complete") is True
                and capture.get("drive_verified") is True
                and re.fullmatch(r"[0-9a-f]{64}", source_sha)
                and capture.get("drive_source_sha256") == source_sha
                and re.fullmatch(r"[0-9a-f]{64}", str(capture.get("drive_object_sha256") or ""))
                and capture.get("drive_verified_at")
                and capture.get("drive_conversation_id") == cid)


def maybe_repair_completed_codex_identity(job: dict[str, Any], post,
                                          header_parser=None) -> dict[str, Any]:
    """Repair one 0.162 startup-warning omission from original bytes, never rerun it."""
    if (job.get("state") != "complete" or job.get("provider") != "codex.research"
        or job.get("prompt_author") != "taskflow_plan"
        or any(isinstance(e, dict) and e.get("kind") == "codex_session_identity"
               for e in job.get("effect_evidence") or [])):
        return job
    evidence = [e for e in job.get("effect_evidence") or [] if isinstance(e, dict)]
    zip_rows = [e for e in evidence if e.get("kind") == "research_zip"]
    invocation = [e for e in evidence if e.get("kind") == "research_invocation"]
    if len(zip_rows) != 1 or len(invocation) != 1:
        return job
    try:
        zip_path = Path(str(zip_rows[0]["path"])).resolve(strict=True)
        if (not zip_path.is_relative_to((ROOT / ".taskflow-state/employee-spine").resolve())
            or zip_path.name != "research.zip" or zip_path.stat().st_size > 20 * 1024 * 1024
            or hashlib.sha256(zip_path.read_bytes()).hexdigest() != zip_rows[0]["ref"]):
            return job
        receipt_path = zip_path.with_name("secretary_receipt.json")
        receipt_text = receipt_path.read_text(encoding="utf-8")
        if hashlib.sha256(receipt_text.encode()).hexdigest() != invocation[0]["ref"]:
            return job
        receipt = json.loads(receipt_text)
        attempts = receipt.get("attempts") or []
        if len(attempts) != 1 or not isinstance(attempts[0], dict):
            return job
        result = attempts[0].get("result") or {}
        if (result.get("conversation_id") is not None
            or result.get("conversation_id_source") is not None
            or receipt.get("completed") is not True
            or receipt.get("taskflow_route_verified") is not True):
            return job
        full_path = Path(str(attempts[0]["full_receipt_ref"])).resolve(strict=True)
        if (not full_path.is_relative_to((Path.home()/".local/state/cognilode/secretary/runs").resolve())
            or full_path.name != "receipt.json"):
            return job
        stderr_path = full_path.with_name("codex.stderr")
        stderr = stderr_path.read_bytes()
        if (len(stderr) > 2_000_000
            or hashlib.sha256(stderr).hexdigest() != result.get("codex_stderr_sha256")):
            return job
        parser = header_parser or _taskflow_header_session_id
        cid = parser(stderr.decode("utf-8"))
        if not cid:
            return job
        try:
            central = post({"operation": "read", "provider": "openai-codex",
                            "conversation_id": cid})
        except Exception:
            return job
        conversation = central.get("conversation") or {}
        capture = conversation.get("capture") or {}
        if (not central.get("ok") or conversation.get("conversation_id") != cid
            or not _drive_capture_verified(capture, cid)
            or conversation.get("response_sha256") != result.get("response_text_sha256")):
            return job
        rollout_path = Path(str(capture["source_stream_id"])).resolve(strict=True)
        if (not rollout_path.is_relative_to((Path.home()/".codex/sessions").resolve())
            or not rollout_path.name.endswith(f"-{cid}.jsonl")
            or rollout_path.stat().st_size > 4_000_000):
            return job
        rollout = rollout_path.read_bytes()
        if hashlib.sha256(rollout).hexdigest() != capture["source_sha256"]:
            return job
        body = {"operation": "repair_completed_codex_identity",
                "job_id": job["id"], "conversation_id": cid,
                "receipt_text": receipt_text,
                "stderr_gzip_base64": base64.b64encode(gzip.compress(stderr, 9, mtime=0)).decode(),
                "rollout_gzip_base64": base64.b64encode(gzip.compress(rollout, 9, mtime=0)).decode()}
        try:
            repaired = post(body)
        except Exception:
            return job
        return repaired.get("job") if repaired.get("ok") and isinstance(repaired.get("job"), dict) else job
    except (OSError, ValueError, KeyError, TypeError, UnicodeError):
        return job


def verified_employee_job(job: dict[str, Any], post) -> dict[str, str] | None:
    name = str(job.get("assigned_employee") or "")
    if (job.get("state") != "complete" or job.get("claimed_by") != name
        or job.get("provider") not in {"codex.research", "codex.external-effect"}
        or job.get("prompt_author") != "taskflow_plan"
        or not isinstance(job.get("taskflow_plan_receipt"), dict)
        or name not in str(job.get("prompt") or "")):
        return None
    evidence = [e for e in job.get("effect_evidence") or [] if isinstance(e, dict)]
    effect_kind = "research_zip" if job["provider"] == "codex.research" else "external_effect"
    if not any(e.get("kind") == effect_kind and e.get("ref") for e in evidence):
        return None
    identities = [e for e in evidence if e.get("kind") == "codex_session_identity"
                  and e.get("job_id") == job.get("id")
                  and e.get("conversation_id_source") == "codex_cli_stderr_header"]
    if len(identities) != 1:
        return None
    cid = str(identities[0].get("conversation_id") or "")
    if not re.fullmatch(r"[0-9a-f-]{36}", cid):
        return None
    if job.get("conversation_id") not in (None, cid):
        return None
    # A completed D1 job alone does not prove that other agents can read the turn.
    try:
        read = post({"operation": "read", "provider": "openai-codex", "conversation_id": cid})
    except Exception:
        # The rollout vacuum may trail the provider terminal. Leave this name
        # staged and retry at the next cycle; one 404 must not stop the roster.
        return None
    conversation = read.get("conversation") or {}
    if not read.get("ok") or conversation.get("conversation_id") != cid:
        return None
    capture = conversation.get("capture") or {}
    if not _drive_capture_verified(capture, cid):
        # D1 interim admission can precede the singular Drive CAS/readback.
        # Do not install a newly named employee until both are complete.
        return None
    # The Codex normalized reader does not set source_content_complete. Its
    # response_sha256 is the hash of the selected assistant text; verify that
    # exact text is present in the central read before installing the name.
    response_sha = str(conversation.get("response_sha256") or "")
    events = conversation.get("events") or []
    if not any(isinstance(e, dict) and e.get("role") == "assistant"
               and isinstance(e.get("content"), str) and e["content"].strip()
               and hashlib.sha256(e["content"].encode()).hexdigest() == response_sha
               for e in events):
        return None
    # The installed route must be backed by the user's actual Codex executable.
    executable = Path.home() / ".local/bin/codex"
    if not executable.is_file() or not os.access(executable, os.X_OK):
        return None
    effect = next(e for e in evidence if e.get("kind") == effect_kind and e.get("ref"))
    return {"provider": str(job["provider"]), "job_id": str(job["id"]),
            "employee": name, "conversation_id": cid,
            "response_sha256": response_sha, "effect_kind": effect_kind,
            "source_sha256": str(capture["source_sha256"]),
            "drive_object_sha256": str(capture["drive_object_sha256"]),
            "drive_verified_at": str(capture["drive_verified_at"]),
            "effect_ref": str(effect["ref"]),
            "completed_at": str(job.get("completed_at") or "")}


def _atomic_json(path: Path, value: dict[str, Any]) -> None:
    raw = (json.dumps(value, indent=2, sort_keys=True, ensure_ascii=False) + "\n").encode()
    if path.is_file() and path.read_bytes() == raw:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile("wb", dir=path.parent,
                                     prefix=".roster-", delete=False) as out:
        tmp = Path(out.name)
        out.write(raw)
        out.flush()
        os.fsync(out.fileno())
    tmp.replace(path)


def reconcile(snapshot_dirs: list[Path], *, activate: bool = True,
              installed_path: Path = INSTALLED, candidates_path: Path = CANDIDATES,
              activations_path: Path = ACTIVATIONS,
              post=None) -> dict[str, Any]:
    facts = discover(snapshot_dirs)
    installed = json.loads(installed_path.read_text(encoding="utf-8"))
    employees = installed.get("employees") or {}
    if not isinstance(employees, dict):
        raise ValueError("installed roster employees invalid")
    # Candidate file may be read by TaskFlow for a one-turn onboarding job;
    # root planning reads only installed employees.
    _atomic_json(candidates_path, facts)
    proofs = json.loads(activations_path.read_text(encoding="utf-8")) if activations_path.is_file() else {"schema": "cognilode.employee_route_activations.v1", "employees": {}}
    route_proofs = proofs.get("employees") or {}
    if not isinstance(route_proofs, dict):
        raise ValueError("employee activation proofs invalid")
    added: list[str] = []
    proven: list[str] = []
    if activate:
        if post is None:
            post = _sender().operator_memory_post
        for provider in ("codex.research", "codex.external-effect"):
            cursor = None
            for _ in range(20):
                request = {"operation": "list_jobs", "provider": provider,
                           "state": "complete", "limit": 100}
                if cursor:
                    request["cursor"] = cursor
                result = post(request)
                if not result.get("ok"):
                    raise RuntimeError(f"D1 {provider} job listing failed")
                for job in result.get("jobs") or []:
                    name = str(job.get("assigned_employee") or "")
                    candidate = facts["candidates"].get(name)
                    if not candidate or name in route_proofs:
                        continue
                    job = maybe_repair_completed_codex_identity(job, post)
                    proof = verified_employee_job(job, post)
                    if proof:
                        proof["slack_message"] = candidate["slack_message"]
                        route_proofs[name] = proof
                        proven.append(name)
                        if name not in employees:
                            employees[name] = {k: candidate[k] for k in
                                               ("role", "org", "slack_message")}
                            added.append(name)
                cursor = result.get("next_cursor")
                if not cursor:
                    break
            else:
                raise RuntimeError("D1 employee job inventory exceeds bounded scan")
    if added:
        installed["employees"] = dict(sorted(employees.items()))
        installed["captured_at"] = datetime.now(timezone.utc).date().isoformat()
        _atomic_json(installed_path, installed)
    if proven:
        proofs["employees"] = dict(sorted(route_proofs.items()))
        _atomic_json(activations_path, proofs)
    return {"candidates": len(facts["candidates"]), "installed": len(employees),
            "activated": sorted(added), "route_proven": sorted(proven),
            "channels": len(facts["channels"])}


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--snapshot-dir", action="append", type=Path,
                        dest="snapshot_dirs")
    parser.add_argument("--candidates-only", action="store_true")
    args = parser.parse_args()
    configured = [Path(p) for p in os.environ.get("COGNILODE_SLACK_SNAPSHOT_DIRS", "").split(":") if p]
    directories = args.snapshot_dirs or configured or [DEFAULT_SNAPSHOTS, LANDING_SNAPSHOTS]
    print(json.dumps(reconcile(directories,
                               activate=not args.candidates_only), sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
