#!/usr/bin/env python3
"""Container-hosted, centrally governed HTTP request gate and audit spool.

The Cognilode.com endpoint stores policy and audit records. This process makes
the decisions on the execution environment and never handles ChatGPT prompts.
"""
from __future__ import annotations

import argparse
from contextlib import contextmanager
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import socketserver
import sqlite3
import subprocess
import tempfile
import threading
import time
from urllib.parse import urlsplit
import uuid

DEFAULT_POLICY = {"schema": "cognilode.http_gate_policy.v1", "revision": 0,
                  "default_allow": True, "purposes": {"observability": False}}


def utc() -> str:
    return datetime.now(timezone.utc).isoformat()


def purpose(method: str, url: str) -> tuple[str, str, str]:
    parsed = urlsplit(url)
    host = (parsed.hostname or "").lower()
    path = parsed.path[:512]
    if host in {"chatgpt.com", "www.chatgpt.com"} or host.endswith(".chatgpt.com"):
        if path.startswith("/api/auth/"):
            return "credential_refresh", host, path
        # Chat-mode creates an input file with POST /backend-api/files before
        # uploading its bytes to the returned URL. The exact create path has
        # no trailing slash, so it must not inherit the observability gate.
        if method in {"POST", "PUT", "PATCH"} and (
            path == "/backend-api/files" or path.startswith("/backend-api/files/")
            or (method == "POST" and path == "/backend-api/sentinel/chat-requirements/prepare")
            or "/conversation" in path or "/uploads" in path
        ):
            return "chatmode_prompt_or_upload", host, path
        if "/interpreter/download" in path or "/files/" in path or (
            method == "GET" and path == "/backend-api/estuary/content"
        ):
            return "artifact_download", host, path
        return "observability", host, path
    if host == "cognilode.com" and path.startswith("/api/operator/http-gate"):
        return "central_gate_control", host, path
    return "external_http", host, path


class Gate:
    def __init__(self, state: Path, endpoint: str, environment: str, secret_id: str, aws: str,
                 region: str,
                 fallback_log: Path | None):
        self.state = state
        self.endpoint = endpoint
        self.environment = environment
        self.secret_id = secret_id
        self.aws = aws
        self.region = region
        self.fallback_log = fallback_log
        self.lock = threading.RLock()
        self.token = ""
        self.policy = DEFAULT_POLICY.copy()
        self.state.mkdir(parents=True, exist_ok=True)
        try:
            stored = json.loads((state / "policy.json").read_text())
            if stored.get("schema") == DEFAULT_POLICY["schema"]:
                self.policy = stored
        except (OSError, ValueError):
            pass
        with self.db() as db:
            db.execute("CREATE TABLE IF NOT EXISTS events (event_id TEXT PRIMARY KEY, at TEXT NOT NULL, environment TEXT NOT NULL, source TEXT NOT NULL, purpose TEXT NOT NULL, method TEXT NOT NULL, host TEXT NOT NULL, path TEXT NOT NULL, allowed INTEGER NOT NULL, outcome TEXT NOT NULL, uploaded INTEGER NOT NULL DEFAULT 0)")
            db.execute("CREATE TABLE IF NOT EXISTS state (key TEXT PRIMARY KEY, value TEXT NOT NULL)")

    @contextmanager
    def db(self):
        db = sqlite3.connect(self.state / "audit.sqlite3", timeout=20)
        db.execute("PRAGMA journal_mode=WAL")
        try:
            yield db
            db.commit()
        finally:
            db.close()

    def record(self, *, source: str, request_purpose: str, method: str, host: str, path: str,
               allowed: bool, outcome: str) -> str:
        event_id = str(uuid.uuid4())
        with self.lock, self.db() as db:
            db.execute("INSERT INTO events(event_id,at,environment,source,purpose,method,host,path,allowed,outcome) VALUES(?,?,?,?,?,?,?,?,?,?)",
                       (event_id, utc(), self.environment, source[:256], request_purpose, method[:12],
                        host[:256], path[:512], int(allowed), outcome[:128]))
        return event_id

    def decide(self, body: dict) -> dict:
        method = str(body.get("method") or "GET").upper()
        url = str(body.get("url") or "")
        request_purpose, host, path = purpose(method, url)
        source = str(body.get("source") or "unknown")[:256]
        if host == "chatgpt.com" or host.endswith(".chatgpt.com"):
            # Queue/rhythm admission is the authority for provider mutations.
            # The gate applies the last centrally synchronized purpose policy
            # locally, so a prompt does not depend on an extra per-request HTTP
            # round trip while forbidden observability remains fail-closed.
            with self.lock:
                policy = dict(self.policy)
            purpose_policy = policy.get("purposes") if isinstance(policy.get("purposes"), dict) else {}
            allowed = bool(purpose_policy.get(request_purpose,
                                               policy.get("default_allow", False)))
            outcome = "cached_central_policy"
            revision = int(policy.get("revision") or 0)
            event_id = self.record(
                source=source, request_purpose=request_purpose, method=method,
                host=host, path=path, allowed=allowed, outcome=outcome,
            )
            return {"ok": True, "allowed": allowed, "purpose": request_purpose,
                    "event_id": event_id, "policy_revision": revision,
                    "central_policy_cached": True}
        with self.lock:
            rule = self.policy.get("purposes", {}).get(request_purpose)
            allowed = bool(self.policy.get("default_allow", False) if rule is None else rule)
            revision = int(self.policy.get("revision") or 0)
        event_id = self.record(source=source, request_purpose=request_purpose, method=method,
                               host=host, path=path, allowed=allowed, outcome="decision")
        return {"ok": True, "allowed": allowed, "purpose": request_purpose,
                "event_id": event_id, "policy_revision": revision}

    def credential(self) -> str:
        command = [self.aws, "secretsmanager", "get-secret-value", "--secret-id", self.secret_id,
                   "--region", self.region, "--query", "SecretString", "--output", "text"]
        result = subprocess.run(command, capture_output=True, text=True, timeout=30, check=True)
        return result.stdout.strip()

    def central(self, method: str, body: dict | None = None, *, view: str = "policy") -> dict:
        if not self.token:
            self.token = self.credential()
        url = self.endpoint + ("?view=" + view if method == "GET" else "")
        config = (f'url = "{url}"\n'
                  f'header = "Authorization: Bearer {self.token}"\n'
                  'header = "Accept: application/json"\n'
                  'user-agent = "Mozilla/5.0"\n')
        temporary = None
        try:
            if method != "GET":
                with tempfile.NamedTemporaryFile("w", dir=self.state, prefix="central-body-",
                                                 delete=False) as stream:
                    json.dump(body, stream, separators=(",", ":"))
                    temporary = Path(stream.name)
                config += (f'request = "{method}"\n'
                           'header = "Content-Type: application/json"\n'
                           f'data-binary = "@{temporary}"\n')
            result = subprocess.run(["/usr/bin/curl", "--http1.1", "-sS", "--max-time", "30",
                                     "-w", "\\n%{http_code}", "--config", "-"], input=config,
                                    capture_output=True, text=True, timeout=35, check=True)
            response_body, status = result.stdout.rsplit("\n", 1)
            if int(status) < 200 or int(status) >= 300:
                raise RuntimeError(f"central HTTP gate store returned {status}")
            return json.loads(response_body)
        finally:
            if temporary:
                temporary.unlink(missing_ok=True)

    def sync_policy(self) -> None:
        try:
            value = self.central("GET")
            document = (value.get("policy") or {}).get("document") or {}
            if document.get("schema") != DEFAULT_POLICY["schema"]:
                raise ValueError("invalid central HTTP gate policy")
            with self.lock:
                self.policy = document
                temp = self.state / "policy.tmp"
                temp.write_text(json.dumps(document, sort_keys=True) + "\n")
                temp.replace(self.state / "policy.json")
            self.record(source="http-gate", request_purpose="central_gate_control", method="GET",
                        host=urlsplit(self.endpoint).hostname or "", path=urlsplit(self.endpoint).path,
                        allowed=True, outcome="policy_synced")
        except Exception as exc:
            self.token = ""
            print(json.dumps({"kind": "policy_sync_retry", "error": type(exc).__name__, "at": utc()}), flush=True)

    def upload_events(self) -> None:
        self.ingest_fallback()
        with self.lock, self.db() as db:
            rows = db.execute("SELECT event_id,at,environment,source,purpose,method,host,path,allowed,outcome FROM events WHERE uploaded=0 ORDER BY at LIMIT 200").fetchall()
        if not rows:
            return
        keys = ("event_id", "at", "environment", "source", "purpose", "method", "host", "path", "allowed", "outcome")
        events = [dict(zip(keys, row)) for row in rows]
        try:
            response = self.central("POST", {"operation": "append_events", "events": events})
            if not response.get("ok"):
                raise RuntimeError("central audit append rejected")
            with self.lock, self.db() as db:
                db.executemany("UPDATE events SET uploaded=1 WHERE event_id=?", [(row[0],) for row in rows])
        except Exception as exc:
            self.token = ""
            print(json.dumps({"kind": "audit_upload_retry", "count": len(rows),
                              "error": type(exc).__name__, "at": utc()}), flush=True)

    def ingest_fallback(self) -> None:
        if not self.fallback_log or not self.fallback_log.is_file():
            return
        with self.lock, self.db() as db:
            prior = db.execute("SELECT value FROM state WHERE key='fallback_offset'").fetchone()
            offset = int(prior[0]) if prior else 0
            size = self.fallback_log.stat().st_size
            if size < offset:
                offset = 0
            with self.fallback_log.open("rb") as stream:
                stream.seek(offset)
                while True:
                    line = stream.readline()
                    if not line:
                        break
                    end = stream.tell()
                    try:
                        row = json.loads(line)
                        db.execute("INSERT OR IGNORE INTO events(event_id,at,environment,source,purpose,method,host,path,allowed,outcome) VALUES(?,?,?,?,?,?,?,?,?,?)",
                                   (str(row["event_id"]), str(row["at"]), str(row["environment"]),
                                    str(row["source"]), str(row["purpose"]), str(row["method"]),
                                    str(row["host"]), str(row["path"]), int(bool(row["allowed"])),
                                    str(row["outcome"])))
                    except (ValueError, KeyError, TypeError):
                        pass
                    offset = end
            db.execute("INSERT INTO state(key,value) VALUES('fallback_offset',?) ON CONFLICT(key) DO UPDATE SET value=excluded.value", (str(offset),))


class Handler(socketserver.StreamRequestHandler):
    def handle(self):
        try:
            body = json.loads(self.rfile.readline(65536))
            response = self.server.gate.decide(body)
        except Exception as exc:
            response = {"ok": False, "allowed": False, "error": type(exc).__name__}
        self.wfile.write((json.dumps(response, separators=(",", ":")) + "\n").encode())


class Server(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    daemon_threads = True


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--socket", type=Path, required=True)
    parser.add_argument("--state", type=Path, required=True)
    parser.add_argument("--environment", required=True)
    parser.add_argument("--endpoint", default="https://cognilode.com/api/operator/http-gate")
    parser.add_argument("--secret-id", default="cognilode/http-gate-operator-token")
    parser.add_argument("--aws", default="/usr/bin/aws")
    parser.add_argument("--region", default="us-west-2")
    parser.add_argument("--fallback-log", type=Path)
    args = parser.parse_args()
    gate = Gate(args.state, args.endpoint, args.environment, args.secret_id, args.aws,
                args.region,
                args.fallback_log)
    args.socket.parent.mkdir(parents=True, exist_ok=True)
    args.socket.unlink(missing_ok=True)
    server = Server(str(args.socket), Handler)
    server.gate = gate
    os.chmod(args.socket, 0o660)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    next_policy = 0.0
    while True:
        if time.monotonic() >= next_policy:
            gate.sync_policy()
            next_policy = time.monotonic() + 300
        gate.upload_events()
        time.sleep(30)


if __name__ == "__main__":
    raise SystemExit(main())
