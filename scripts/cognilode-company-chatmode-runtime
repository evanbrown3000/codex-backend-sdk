#!/usr/bin/env python3
"""Supervise event-driven provider work inside the standard company container."""
from __future__ import annotations

import os
from pathlib import Path
import signal
import subprocess
import sys
import time

HERE = Path(__file__).resolve().parent
STOP = False


def stop(_signal, _frame):
    global STOP
    STOP = True


def active_runner() -> Path:
    """Resolve the runner from the synchronized source frontier.

    The container is intentionally long lived because it owns provider state.
    Source generations are immutable and the ``current`` link advances.  The
    supervisor observes that link and drains the old batch runner before using
    the next generation, avoiding both stale code and interrupted provider
    mutations.
    """
    configured = os.environ.get("COGNILODE_B4PT0R_SDK_ROOT")
    root = Path(configured) if configured else HERE.parent
    return (root / "scripts" / "b4pt0r-com-batch-daemon").resolve()


def main() -> int:
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    runner = active_runner()
    command = [sys.executable, str(runner)]
    process = subprocess.Popen(command, start_new_session=True)
    while not STOP:
        if process.poll() is not None:
            runner = active_runner()
            command = [sys.executable, str(runner)]
            process = subprocess.Popen(command, start_new_session=True)
        else:
            candidate = active_runner()
            if candidate != runner:
                # SIGTERM asks the daemon to finish its active batch and then
                # exit.  No provider turn is killed during a source cutover.
                process.terminate()
                process.wait()
                runner = candidate
                command = [sys.executable, str(runner)]
                process = subprocess.Popen(command, start_new_session=True)
        time.sleep(2)
    if process.poll() is None:
        process.terminate()
        try:
            process.wait(timeout=30)
        except subprocess.TimeoutExpired:
            process.kill()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
