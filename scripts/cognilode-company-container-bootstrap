#!/usr/bin/env python3
"""Start the company container stack, then retire host company user units.

This is the one permitted host company service. Docker itself remains the OS
container engine; company workers run under its restart policy.
"""
from __future__ import annotations

import os
import json
import hashlib
import fcntl
import signal
from pathlib import Path
import shutil
import sqlite3
import socket
import subprocess
import sys
import time
import urllib.request

ROOT = Path(__file__).resolve().parents[1]
COMPOSE = ROOT / "deploy/compose/company-chatmode.yml"
SELF = "cognilode-company-containers.service"
NODE_IMAGE = "node@sha256:0e5f906573693feaa1e21057ebdcfdb5bd5021f050b2dc7c9deceb629c7da2a8"


def notify_service(state: str) -> None:
    """Let the sole host unit restart a reconciliation loop that stops moving."""
    address = os.environ.get("NOTIFY_SOCKET", "")
    if not address:
        return
    if address.startswith("@"):
        address = "\0" + address[1:]
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as channel:
            channel.sendto(state.encode("utf-8"), address)
    except OSError:
        # A container reconciliation can still run outside systemd for recovery.
        pass


def run_with_watchdog(command: list[str], *, env: dict[str, str]) -> None:
    """Run a potentially long Compose handoff without a destructive timeout."""
    child = subprocess.Popen(command, env=env)
    while child.poll() is None:
        notify_service("WATCHDOG=1")
        time.sleep(5)
    if child.returncode:
        raise subprocess.CalledProcessError(child.returncode, command)


def prepare_portable_aws(project: str, image: str, uid: int, gid: int) -> None:
    """Create credential_process custody after one central broker readback.

    No AWS access key or host ~/.aws file enters this volume. The one-time
    operator enrollment token may be supplied by a company registration file.
    """
    volume = f"{project}_company_aws_client"
    operator = f"{project}_company_operator"
    for name in (volume, operator):
        subprocess.run(["docker", "volume", "create", name], stdout=subprocess.DEVNULL,
                       check=True, timeout=30)
    probe = subprocess.run(["docker", "run", "--rm", "--volume", f"{operator}:/operator:ro",
                            image, "cat", "/operator/operator-bearer"],
                           capture_output=True, text=True, check=False, timeout=30)
    token = probe.stdout.strip() if probe.returncode == 0 else ""
    if not token:
        enrollment = Path(os.environ.get("COGNILODE_BOOTSTRAP_OPERATOR_TOKEN_FILE", ""))
        if not enrollment.is_file():
            raise RuntimeError("portable AWS bootstrap requires enrolled operator token custody")
        subprocess.run(["docker", "run", "--rm", "--user", "0",
                        "--mount", f"type=bind,src={enrollment.resolve()},dst=/seed,readonly",
                        "--volume", f"{operator}:/operator", image, "sh", "-c",
                        f"cp /seed /operator/operator-bearer && chmod 600 /operator/operator-bearer && chown {uid}:{gid} /operator/operator-bearer"],
                       stdout=subprocess.DEVNULL, check=True, timeout=30)
        token = enrollment.read_text().strip()
    token = token.removeprefix("Bearer ").strip()
    marker = subprocess.run(["docker", "run", "--rm", "--volume", f"{volume}:/aws:ro",
                             image, "sh", "-c", "test -s /aws/central-broker-ready && test -s /aws/config"],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                            check=False, timeout=30)
    if marker.returncode == 0:
        return
    base = os.environ.get("COGNILODE_OPERATOR_URL", "https://cognilode.com").rstrip("/")
    request = urllib.request.Request(base + "/api/operator/aws-session",
        data=b'{"purpose":"artifact-read"}', method="POST",
        headers={"Authorization": "Bearer " + token, "Content-Type": "application/json",
            "Accept": "application/json,text/plain,*/*",
            "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36",
            "Origin": base, "Referer": base + "/"})
    with urllib.request.urlopen(request, timeout=45) as response:
        readback = json.load(response)
    if not readback.get("ok") or not readback.get("credentials", {}).get("Expiration"):
        raise RuntimeError("central scoped AWS broker has no live STS session")
    config = ("[default]\nregion = us-west-2\n"
        "credential_process = python3 /runtime/source/current/codex-backend-sdk/scripts/cognilode-aws-credential-process\n")
    subprocess.run(["docker", "run", "--rm", "-i", "--user", "0",
                    "--volume", f"{volume}:/aws", image, "sh", "-c",
                    f"cat > /aws/config && touch /aws/central-broker-ready && chmod 600 /aws/config && chown -R {uid}:{gid} /aws"],
                   input=config, text=True, stdout=subprocess.DEVNULL, check=True, timeout=30)


def run(*args: str, check: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(args, text=True, capture_output=True, check=check, timeout=120)


def migrate_previous_state(source: Path, destination: Path) -> None:
    if not source.is_dir() or source.resolve() == destination.resolve():
        return
    target = destination / "worker"
    for name in ("b4pt0r-chatmode", "chatmode-queue-worker", "handoffs", "root-memory-native-cycle"):
        old = source / name
        new = target / name
        marker = new / ".company-container-migration-complete"
        if old.is_dir() and not marker.exists():
            shutil.copytree(old, new, dirs_exist_ok=True, copy_function=shutil.copy2)
            marker.touch()


def migrate_container_browser(project: str, image: str) -> None:
    """Capture the old company container's profile without touching host Chrome."""
    volume = f"{project}_company_browser"
    subprocess.run(["docker", "volume", "create", volume], stdout=subprocess.DEVNULL,
                   check=True, timeout=30)
    # The marker is written only after the initial custody validation succeeds.
    # Rewalking an established browser profile on every container restart is
    # expensive and can stall startup while Docker is under load.
    marker = subprocess.run(["docker", "run", "--rm", "--volume", f"{volume}:/browser:ro",
                             image, "test", "-f", "/browser/profile/.custody-complete"],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                            check=False, timeout=180)
    if marker.returncode == 0:
        return
    source = ["docker", "exec", "cognilode-primary-workspace", "sh", "-c",
              "test -d /workspace/.cognilode/host-chrome-copy && "
              "tar -C /workspace/.cognilode/host-chrome-copy -cf - ."]
    target = ["docker", "run", "--rm", "--user", "0", "-i",
              "--volume", f"{volume}:/browser", image, "sh", "-c",
              "mkdir -p /browser/profile && tar -C /browser/profile -xf - && "
              "test -s '/browser/profile/Local State' && "
              "test -n \"$(find /browser/profile -type f -name Cookies -size +0c -print -quit)\" && "
              "touch /browser/profile/.custody-complete"]
    with subprocess.Popen(source, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL) as reader:
        assert reader.stdout is not None
        with subprocess.Popen(target, stdin=reader.stdout, stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL) as writer:
            reader.stdout.close()
            target_status = writer.wait(timeout=480)
            source_status = reader.wait(timeout=30)
            if target_status != 0 or source_status not in (0, 1):
                raise RuntimeError("company container browser custody transfer failed")


def retired_units() -> list[str]:
    installed = run("systemctl", "--user", "list-unit-files", "--no-legend", "--plain", check=False)
    loaded = run("systemctl", "--user", "list-units", "--all", "--no-legend", "--plain", check=False)
    names = {line.split(maxsplit=1)[0] for result in (installed, loaded)
             for line in result.stdout.splitlines() if line.split()}
    return sorted(name for name in names if name.startswith("cognilode-")
                  and name.endswith((".service", ".timer", ".socket"))
                  and name != SELF and "evan-recorder" not in name and "@." not in name)


def compose_service_hashes(project: str, compose: Path, env: dict[str, str]) -> dict[str, str]:
    """Hash resolved service definitions so unrelated edits do not restart workers."""
    rendered = subprocess.run(
        ["docker", "compose", "--project-name", project, "-f", str(compose),
         "config", "--format", "json"], env=env, capture_output=True, text=True,
        check=True, timeout=60)
    services = json.loads(rendered.stdout)["services"]
    active_profiles = {value.strip() for value in env.get("COMPOSE_PROFILES", "").split(",")
                       if value.strip()}
    return {name: hashlib.sha256(json.dumps(value, sort_keys=True,
            separators=(",", ":")).encode()).hexdigest()
            for name, value in services.items()
            if not value.get("profiles") or active_profiles.intersection(value["profiles"])}


def provider_mutations_active(runtime: Path, *, drain: bool = False) -> int | None:
    """Read or fence local provider custody without observing the provider."""
    # The transport counter is the live-process view; the scheduler's
    # effect-pending rows are the durable mutation view.  Container replacement
    # is safe only when both are empty.  Relying on the socket alone created a
    # race where a generation handoff briefly reported zero while a fenced
    # queue operation was still awaiting its terminal receipt.
    durable_active = 0
    database = runtime / "shared/provider-scheduler/scheduler.sqlite3"
    try:
        with sqlite3.connect(database, timeout=5) as connection:
            # Only a still-live scheduler effect lease fences replacement.
            # Orphaned effect_pending rows whose persisted lease has expired
            # are eligible for receipt recovery/retry in the successor.
            row = connection.execute(
                "SELECT COUNT(*) FROM provider_jobs WHERE state = 'effect_pending' AND lease_until > ?",
                (time.time(),),
            ).fetchone()
        durable_active = int(row[0]) if row else 0
    except (OSError, sqlite3.Error, TypeError, ValueError):
        return None
    path = runtime / "shared/provider.sock"
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as channel:
            channel.settimeout(5)
            channel.connect(str(path))
            operation = b'drain' if drain else b'active'
            channel.sendall(b'{"operation":"' + operation + b'"}\n')
            channel.shutdown(socket.SHUT_WR)
            data = bytearray()
            while b"\n" not in data and len(data) < 4096:
                piece = channel.recv(4096)
                if not piece:
                    break
                data.extend(piece)
        reply = json.loads(data.split(b"\n", 1)[0])
        active = reply.get("active")
        return max(active, durable_active) if type(active) is int else None
    except (OSError, ValueError, IndexError, TypeError):
        return None


def codex_builder_compiling(project: str) -> bool:
    """Defer a config-only builder replacement while its native build runs."""
    result = subprocess.run(["docker", "top", f"{project}-codex-builder-1", "-eo", "pid,comm"],
                            capture_output=True, text=True, check=False, timeout=15)
    if result.returncode:
        # If inspection itself failed, do not assume a live builder is idle.
        # A definitively absent/stopped container may be recreated normally.
        state = subprocess.run(["docker", "inspect", "--format", "{{.State.Running}}",
                                f"{project}-codex-builder-1"], capture_output=True,
                               text=True, check=False, timeout=10)
        return state.returncode == 0 and state.stdout.strip() == "true"
    # docker top prefixes the requested columns with its own PID/elapsed
    # fields; the command is the final token, not the first.
    names = {line.strip().split()[-1] for line in result.stdout.splitlines()[1:]
             if line.strip()}
    return bool(names.intersection({"cargo", "rustc", "build-install-c"}))


def stage_managed_codex_release(container: str, release_pin: str, tree: str,
                               stage: Path) -> bool:
    """Resume a manifest-verified release transfer in bounded chunks.

    docker cp of the 1 GiB CLI binary is a single non-resumable operation and
    has repeatedly exceeded its timeout on the company volume. Stream each
    manifest-listed file as 32 MiB `dd` ranges instead. The durable staging
    directory is safe to resume after process/container restarts; each file is
    renamed only after its streamed bytes match the manifest digest.
    """
    stage.mkdir(parents=True, exist_ok=True)
    base = f"/codex/releases/{release_pin}"
    try:
        manifest = subprocess.run(["docker", "exec", container, "cat", f"{base}/SHA256SUMS"],
                                  capture_output=True, check=True, timeout=30).stdout
        (stage / "SHA256SUMS").write_bytes(manifest)
        entries: list[tuple[str, str]] = []
        allowed = {"codex", "codex-code-mode-host", "central-rollouts", "managed-codex",
                   "launcher", "code-mode-host-ready.json"}
        for raw in manifest.decode("ascii").splitlines():
            fields = raw.split(maxsplit=1)
            if len(fields) != 2:
                raise ValueError("invalid release checksum manifest")
            digest, filename = fields
            filename = filename.lstrip(" *")
            if (len(digest) != 64 or any(ch not in "0123456789abcdef" for ch in digest)
                    or filename not in allowed):
                raise ValueError("unsafe or unsupported release manifest entry")
            entries.append((filename, digest))
        if not {"codex", "launcher", "managed-codex", "codex-code-mode-host",
                "central-rollouts", "code-mode-host-ready.json"}.issubset(
                    {name for name, _ in entries}):
            raise ValueError("release manifest omits a required managed entrypoint")
        chunk_size = 32 * 1024 * 1024
        block = 1024 * 1024
        for filename, expected in entries:
            target = stage / filename
            part = stage / f".{filename}.part"
            if target.is_file():
                existing_digest = hashlib.sha256()
                with target.open("rb") as stream:
                    for data in iter(lambda: stream.read(8 * 1024 * 1024), b""):
                        existing_digest.update(data)
                if existing_digest.hexdigest() == expected:
                    continue
            size_result = subprocess.run(["docker", "exec", container, "stat", "-c", "%s",
                                          f"{base}/{filename}"], capture_output=True, text=True,
                                         check=True, timeout=30)
            size = int(size_result.stdout.strip())
            offset = part.stat().st_size if part.exists() else 0
            # A torn final chunk is discarded; retain all previously fsynced
            # full chunks so the next supervisor pass resumes from that point.
            offset = (offset // chunk_size) * chunk_size
            if part.exists():
                with part.open("r+b") as stream:
                    stream.truncate(offset)
            digest_state = hashlib.sha256()
            if offset:
                with part.open("rb") as stream:
                    for data in iter(lambda: stream.read(8 * 1024 * 1024), b""):
                        digest_state.update(data)
            while offset < size:
                amount = min(chunk_size, size - offset)
                command = ["docker", "exec", container, "dd", f"if={base}/{filename}",
                           f"bs={block}", f"skip={offset}", f"count={amount}",
                           "iflag=skip_bytes,count_bytes", "status=none"]
                process = subprocess.Popen(command, stdout=subprocess.PIPE,
                                           stderr=subprocess.PIPE, start_new_session=True)
                try:
                    chunk, error = process.communicate(timeout=120)
                except subprocess.TimeoutExpired:
                    try:
                        os.killpg(process.pid, signal.SIGTERM)
                    except ProcessLookupError:
                        pass
                    try:
                        process.communicate(timeout=5)
                    except subprocess.TimeoutExpired:
                        try:
                            os.killpg(process.pid, signal.SIGKILL)
                        except ProcessLookupError:
                            pass
                        process.communicate()
                    with part.open("r+b") as stream:
                        stream.truncate(offset)
                    print(f"host managed Codex chunk pending: {filename} offset={offset}",
                          flush=True)
                    return False
                if process.returncode or len(chunk) != amount:
                    with (part.open("r+b") if part.exists() else part.open("wb")) as stream:
                        stream.truncate(offset)
                    print(f"host managed Codex chunk failed: {filename} offset={offset}: "
                          f"{error[-200:].decode(errors='replace')}", flush=True)
                    return False
                with part.open("ab") as stream:
                    stream.write(chunk)
                    stream.flush()
                    os.fsync(stream.fileno())
                digest_state.update(chunk)
                offset += amount
            if digest_state.hexdigest() != expected:
                part.unlink(missing_ok=True)
                raise ValueError(f"release digest mismatch for {filename}")
            part.replace(target)
        for metadata in ("source-commit", "rust-tree", "binary-source-commit"):
            result = subprocess.run(["docker", "exec", container, "cat", f"{base}/{metadata}"],
                                    capture_output=True, check=False, timeout=30)
            if result.returncode == 0:
                (stage / metadata).write_bytes(result.stdout)
        if ((stage / "source-commit").read_text().strip() != release_pin or
                (stage / "rust-tree").read_text().strip() != tree):
            raise ValueError("staged release identity does not match selected source tree")
        for name in ("codex", "codex-code-mode-host", "central-rollouts", "launcher",
                     "managed-codex"):
            (stage / name).chmod(0o755)
        (stage / "code-mode-host-ready.json").chmod(0o644)
        for name in ("source-commit", "rust-tree", "binary-source-commit", "SHA256SUMS"):
            if (stage / name).exists():
                (stage / name).chmod(0o644)
        return True
    except (OSError, ValueError, subprocess.CalledProcessError,
            subprocess.TimeoutExpired) as exc:
        print(f"host managed Codex staging pending: {type(exc).__name__}: {exc}", flush=True)
        return False


def reconcile_host_managed_codex(project: str, runtime: Path) -> None:
    """Adopt an immutable release installed for the selected source tree.

    The host has no AWS credentials and does not build a second binary. It
    copies the already checksum-verified company-volume release via Docker,
    validates the pin, then atomically switches only the managed-Codex links.
    """
    source_link = runtime / "shared/source/current/cognilode-codex"
    try:
        source = source_link.resolve(strict=True)
        pin = source.name
    except OSError:
        return
    if not (len(pin) == 40 and all(ch in "0123456789abcdef" for ch in pin)):
        return
    tree = subprocess.run(["git", "-c", "safe.directory=*", "-C", str(source),
                           "rev-parse", "HEAD:codex-rs"], capture_output=True, text=True,
                          check=False, timeout=20).stdout.strip()
    if not tree:
        return
    container = f"{project}-codex-builder-1"
    # Source can advance for managed-control/packaging-only changes while its
    # Rust tree and verified CLI binary remain identical. Prefer an exact
    # release; otherwise adopt only a locally checksum-verifiable release with
    # the exact selected codex-rs tree. Never build or fetch on the host.
    listed = subprocess.run(
        ["docker", "exec", container, "sh", "-lc",
         "for d in /codex/releases/*; do "
         "[ -x \"$d/codex\" ] && [ -x \"$d/managed-codex\" ] && "
         "[ -f \"$d/source-commit\" ] && [ -f \"$d/rust-tree\" ] && "
         "[ -f \"$d/SHA256SUMS\" ] && "
         "printf '%s %s\\n' \"$(cat \"$d/source-commit\")\" \"$(cat \"$d/rust-tree\")\"; "
         "done; exit 0"], capture_output=True, text=True, check=False, timeout=60)
    if listed.returncode:
        return
    candidates: list[str] = []
    for line in listed.stdout.splitlines():
        parts = line.split()
        if len(parts) == 2 and len(parts[0]) == 40 and parts[1] == tree:
            candidates.append(parts[0])
    release_pin = pin if pin in candidates else (candidates[-1] if candidates else "")
    if not release_pin:
        return
    root = Path(os.environ.get("MODIFIED_CODEX_INSTALL_ROOT",
                              str(Path.home() / ".local/share/cognilode/modified-codex")))
    release = root / "releases" / release_pin
    if not release.is_dir():
        releases = root / "releases"
        releases.mkdir(parents=True, exist_ok=True)
        stage = releases / f".staging-{release_pin}"
        if not stage_managed_codex_release(container, release_pin, tree, stage):
            return
        stage.replace(release)
    else:
        # A previous interrupted install may have streamed exact file bytes
        # but not retained executable mode bits. Verify its immutable manifest
        # once, restore package modes, then record a durable local verification
        # receipt so normal supervisor polls do not re-read the 1 GiB binary.
        try:
            if ((release / "source-commit").read_text().strip() != release_pin or
                    (release / "rust-tree").read_text().strip() != tree):
                print("host managed Codex existing release identity mismatch", flush=True)
                return
            manifest_hash = hashlib.sha256((release / "SHA256SUMS").read_bytes()).hexdigest()
            receipt_dir = root / "receipts"
            receipt = receipt_dir / f"{release_pin}.json"
            expected_receipt = {"source_commit": release_pin, "rust_tree": tree,
                                "manifest_sha256": manifest_hash}
            try:
                verified = json.loads(receipt.read_text(encoding="utf-8")) == expected_receipt
            except (OSError, ValueError):
                verified = False
            if not verified:
                checked = subprocess.run(["sha256sum", "-c", "SHA256SUMS"], cwd=release,
                                         stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
                                         check=False, timeout=900)
                if checked.returncode:
                    print("host managed Codex existing release checksum mismatch", flush=True)
                    return
                receipt_dir.mkdir(parents=True, exist_ok=True)
                temporary_receipt = receipt.with_suffix(".tmp")
                temporary_receipt.write_text(json.dumps(expected_receipt, sort_keys=True) + "\n",
                                             encoding="utf-8")
                temporary_receipt.replace(receipt)
            for name in ("codex", "codex-code-mode-host", "central-rollouts", "launcher",
                         "managed-codex"):
                (release / name).chmod(0o755)
            (release / "code-mode-host-ready.json").chmod(0o644)
        except (OSError, ValueError, subprocess.TimeoutExpired) as exc:
            print(f"host managed Codex existing release validation pending: {exc}", flush=True)
            return
    expected = f"../releases/{release_pin}/"
    links = {"codex-bin": expected + "codex", "codex": expected + "launcher",
             "codex-code-mode-host": expected + "codex-code-mode-host",
             "central-rollouts": expected + "central-rollouts",
             "managed-codex": expected + "managed-codex"}
    (root / "bin").mkdir(parents=True, exist_ok=True)
    for name, target in links.items():
        temp_link = root / "bin" / ("." + name + ".next")
        temp_link.unlink(missing_ok=True)
        temp_link.symlink_to(target)
        temp_link.replace(root / "bin" / name)
    # Readback from the active vanilla launcher and managed-control entrypoint.
    version = subprocess.run([str(root / "bin/codex"), "--version"],
                             capture_output=True, text=True, check=False, timeout=30)
    if version.returncode:
        raise RuntimeError("host managed Codex launcher failed version readback")
    event_id = f"evanpc-host:{release_pin}:linux-x86_64"
    ledger = runtime / "shared/source/events/source-convergence.jsonl"
    event = {"schema": "cognilode.source_installation.v1", "event_id": event_id,
             "authority": "evanbrown3000/cognilode-codex", "name": "codex-managed-host",
             "revision": release_pin, "selected_source_revision": pin,
             "rust_tree": tree, "previous_revision": None, "environment_id": "evanpc-host",
             "installed_at": time.time(), "kind": "managed_codex_runtime_installation",
             "target": "linux-x86_64", "entrypoints": ["codex", "managed-codex"],
             "codex_version": version.stdout.strip()}
    ledger.parent.mkdir(parents=True, exist_ok=True)
    with ledger.open("a+", encoding="utf-8") as stream:
        fcntl.flock(stream.fileno(), fcntl.LOCK_EX)
        stream.seek(0)
        if not any(json.loads(line).get("event_id") == event_id
                   for line in stream if line.strip()):
            stream.seek(0, os.SEEK_END)
            stream.write(json.dumps(event, sort_keys=True) + "\n")
            stream.flush()
            os.fsync(stream.fileno())
    print(f"host managed Codex release active: {release_pin} for selected source {pin} "
          f"({version.stdout.strip()})", flush=True)


def save_service_hashes(path: Path, hashes: dict[str, str]) -> None:
    temporary = path.with_suffix(".tmp")
    temporary.write_text(json.dumps(hashes, sort_keys=True) + "\n", encoding="utf-8")
    temporary.replace(path)


def prepare_volume_ownership(project: str, image: str, uid: int, gid: int,
                             runtime: Path, names: tuple[str, ...]) -> None:
    """Do expensive custody preparation once per named volume, including upgrades."""
    marker = runtime / "shared/container-volume-ownership.json"
    applied_compose = runtime / "shared/compose-config-applied.sha256"
    try:
        prior = json.loads(marker.read_text(encoding="utf-8"))
        owned = set(prior.get("volumes", ())) if (prior.get("schema") ==
                    "cognilode.container-volume-ownership.v1" and
                    prior.get("project") == project and prior.get("uid") == uid and
                    prior.get("gid") == gid) else set()
    except (OSError, ValueError, TypeError, AttributeError):
        # The applied Compose marker was written only after the historical
        # bootstrap had already prepared these established custody volumes.
        owned = set(names) if applied_compose.is_file() else set()

    def save() -> None:
        temporary = marker.with_suffix(".tmp")
        temporary.write_text(json.dumps({
            "schema": "cognilode.container-volume-ownership.v1",
            "project": project, "uid": uid, "gid": gid,
            "volumes": sorted(owned)}, sort_keys=True) + "\n", encoding="utf-8")
        temporary.replace(marker)

    for name in names:
        if name in owned:
            continue
        subprocess.run(["docker", "run", "--rm", "--user", "0",
                        "--volume", f"{project}_{name}:/custody", image,
                        "chown", "-R", f"{uid}:{gid}", "/custody"],
                       stdout=subprocess.DEVNULL, check=True, timeout=180)
        owned.add(name)
        save()
    if not marker.is_file():
        save()


def ensure_chatmode_node(project: str, runtime: Path, workspace_image: str) -> None:
    """Provision the Sentinel VM runtime once, within Docker custody."""
    marker = runtime / "shared/chatmode-node-runtime.json"
    try:
        receipt = json.loads(marker.read_text(encoding="utf-8"))
        if (receipt.get("schema") == "cognilode.chatmode-node-runtime.v1" and
                receipt.get("project") == project and
                receipt.get("node_image") == NODE_IMAGE and
                receipt.get("workspace_image") == workspace_image):
            return
    except (OSError, ValueError, AttributeError):
        pass
    volume = f"{project}_company_node_runtime"
    subprocess.run(["docker", "volume", "create", volume],
                   stdout=subprocess.DEVNULL, check=True, timeout=30)
    subprocess.run(["docker", "run", "--rm", "--user", "0",
                    "--volume", f"{volume}:/node-runtime", NODE_IMAGE,
                    "sh", "-c", "cp /usr/local/bin/node /node-runtime/node && chmod 755 /node-runtime/node"],
                   stdout=subprocess.DEVNULL, check=True, timeout=120)
    probe = subprocess.run(["docker", "run", "--rm", "--user", "1000:1000",
                            "--volume", f"{volume}:/node-runtime:ro", workspace_image,
                            "/node-runtime/node", "--version"],
                           capture_output=True, text=True, check=True, timeout=60)
    version = probe.stdout.strip()
    if not version.startswith("v22."):
        raise RuntimeError("Chatmode Node runtime version probe failed")
    temporary = marker.with_suffix(".tmp")
    temporary.write_text(json.dumps({"schema": "cognilode.chatmode-node-runtime.v1",
                                     "project": project, "node_image": NODE_IMAGE,
                                     "workspace_image": workspace_image,
                                     "version": version}, sort_keys=True) + "\n",
                         encoding="utf-8")
    temporary.replace(marker)


def release_stalled_chatmode_replacement(project: str, runtime: Path) -> bool:
    """Bound an old Chatmode PID1 drain after Compose has made its replacement.

    This only stops the old, exact Compose container. The new Created container
    and its volumes remain under Compose custody. A queued provider mutation is
    fenced by the D1 lease/begin-effect protocol; terminating the old worker
    cannot grant a second send, and uncertain effects remain for reconciliation.
    """
    old_name = f"{project}-chatmode-1"
    result = subprocess.run(
        ["docker", "ps", "--all", "--filter", f"label=com.docker.compose.project={project}",
         "--filter", "label=com.docker.compose.service=chatmode", "--format", "{{json .}}"],
        capture_output=True, text=True, check=True, timeout=20)
    containers = [json.loads(line) for line in result.stdout.splitlines() if line.strip()]
    old = next((item for item in containers if item.get("Names") == old_name
                and item.get("State") == "running"), None)
    replacement = next((item for item in containers
                        if item.get("Names", "").endswith("_" + old_name)
                        and item.get("State") == "created"), None)
    if not old or not replacement:
        return False
    # A failed Compose client timeout is not permission to destroy a provider
    # effect. Leave the old container and Created replacement under the
    # bootstrap supervisor until scheduler and transport custody are quiescent.
    active = provider_mutations_active(runtime)
    if active is None or active != 0:
        print("Chatmode replacement deferred while provider effect is active or unknown", flush=True)
        return False
    old_id = old.get("ID", "")
    replacement_id = replacement.get("ID", "")
    if not old_id or not replacement_id or old_id == replacement_id:
        return False
    receipt = runtime / "shared/chatmode-replacement-stop.json"
    if receipt.is_file():
        try:
            if json.loads(receipt.read_text(encoding="utf-8")).get("old_container_id") == old_id:
                return False
        except (OSError, ValueError):
            pass
    print(f"bounded Chatmode replacement: stopping old={old_id} "
          f"preserving created={replacement_id}", flush=True)
    # Stop only after all provider effects are terminal. Never convert a
    # Compose timeout into a forced container kill.
    try:
        subprocess.run(["docker", "stop", "--time", "7200", old_id],
                       check=True, timeout=7230, stdout=subprocess.DEVNULL)
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as exc:
        print(f"Chatmode graceful stop remains pending: {exc}", flush=True)
        return False
    temporary = receipt.with_suffix(".tmp")
    temporary.write_text(json.dumps({"schema": "cognilode.chatmode-replacement-stop.v1",
                                     "old_container_id": old_id,
                                     "created_container_id": replacement_id,
                                     "at_unix": int(time.time())}, sort_keys=True) + "\n",
                         encoding="utf-8")
    temporary.replace(receipt)
    return True


def retire_standalone_adopter(project: str, compose: Path, runtime: Path,
                             env: dict[str, str]) -> None:
    """Remove the old unfenced adopter once its container replacements run."""
    marker = runtime / "shared/standalone-adopter-retired"
    if marker.exists():
        return
    running = subprocess.run(
        ["docker", "compose", "--project-name", project, "-f", str(compose),
         "ps", "--status", "running", "--services"], env=env,
        capture_output=True, text=True, check=False, timeout=30)
    if running.returncode != 0 or not {"chatmode", "effect-reviewer"}.issubset(
            set(running.stdout.splitlines())):
        return
    name = "cognilode-chatmode-work-adopter"
    inspected = subprocess.run(
        ["docker", "inspect", "--format", "{{json .Config.Labels}}", name],
        capture_output=True, text=True, check=False, timeout=30)
    if inspected.returncode == 0:
        try:
            labels = json.loads(inspected.stdout)
        except ValueError:
            return
        if labels not in ({}, None):
            print("standalone adopter retirement pending: unexpected container labels", flush=True)
            return
        subprocess.run(["docker", "stop", "--time", "30", name],
                       check=True, timeout=60)
        subprocess.run(["docker", "rm", name], check=True, timeout=30)
    marker.touch()
    print("retired standalone chatmode work adopter", flush=True)


def reconcile_compose(project: str, runtime: Path, env: dict[str, str]) -> None:
    """Apply new synchronized Compose configuration from the sole host starter."""
    digest_path = runtime / "shared/compose-config-applied.sha256"
    applied_digest = (digest_path.read_text(encoding="utf-8").strip()
                      if digest_path.is_file() else hashlib.sha256(COMPOSE.read_bytes()).hexdigest())
    applied_compose = COMPOSE
    synced = runtime / "shared/source/current/codex-backend-sdk"
    memory_applied = runtime / "shared/memory-source-applied"
    memory_compose_applied = runtime / "shared/memory-compose-applied.sha256"
    service_hash_path = runtime / "shared/compose-service-digests.json"
    notify_service("READY=1\nSTATUS=Reconciling company containers")
    while True:
        # Adopt accepted bootstrap source generations from this permanent host
        # reconciler without relying on a foreground/systemd restart.
        next_bootstrap = synced / "scripts/cognilode-company-container-bootstrap"
        if next_bootstrap.is_file() and next_bootstrap.resolve() != Path(__file__).resolve():
            selected_revision = subprocess.run(
                ["git", "-C", str(synced), "rev-parse", "HEAD"],
                capture_output=True, text=True, check=False, timeout=20).stdout.strip()
            if selected_revision:
                os.execve(sys.executable, [sys.executable, str(next_bootstrap)],
                          {**os.environ, "COGNILODE_BOOTSTRAP_FROM_SYNC": "1",
                           "COGNILODE_BOOTSTRAP_LOADED_REVISION": selected_revision})
        # Docker may successfully create a replacement container but fail
        # before starting it. Compose hashes do not change in that case, so
        # digest-only reconciliation would strand custody services in Created
        # forever. Reconcile these critical services from the source-driven
        # supervisor whenever that exact state is observed.
        for service in ("provider-transport", "returned-product-actuator"):
            name = f"{project}-{service}-1"
            state = subprocess.run(["docker", "inspect", "--format", "{{.State.Status}}", name],
                                   capture_output=True, text=True, check=False, timeout=10)
            if state.returncode == 0 and state.stdout.strip() == "created":
                try:
                    subprocess.run(["docker", "compose", "--project-name", project,
                                    "-f", str(applied_compose), "up", "-d", "--no-deps", service],
                                   env=env, check=True, timeout=120)
                    print(f"company critical service recovered from Created: {service}", flush=True)
                except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as exc:
                    print(f"company critical service start pending: {service}: {exc}", flush=True)
        try:
            reconcile_host_managed_codex(project, runtime)
        except (OSError, RuntimeError, subprocess.CalledProcessError,
                subprocess.TimeoutExpired, ValueError) as exc:
            print(f"host managed Codex adoption pending: {type(exc).__name__}: {exc}", flush=True)
        notify_service("WATCHDOG=1")
        candidate = synced / "deploy/compose/company-chatmode.yml"
        if candidate.is_file():
            selected = subprocess.run(["git", "-C", str(synced), "rev-parse", "HEAD"],
                                      capture_output=True, text=True, check=False).stdout.strip()
            synced_main = subprocess.run(["git", "-C", str(synced), "rev-parse", "origin/main"],
                                         capture_output=True, text=True, check=False).stdout.strip()
            # Source convergence publishes a shallow, immutable checkout and
            # advances ``current`` only after its selected revision equals that
            # checkout's origin/main. Requiring Git ancestry against the old
            # shallow runtime makes every later revision incomparable and
            # permanently pins this daemon to its bootstrap generation.
            if selected and selected == synced_main:
                synced_starter = synced / "scripts/cognilode-company-container-bootstrap"
                loaded_revision = os.environ.get("COGNILODE_BOOTSTRAP_LOADED_REVISION", "")
                if (synced_starter.is_file() and
                        (synced_starter.resolve() != Path(__file__).resolve()
                         or selected != loaded_revision)):
                    print(f"company starter adopting synchronized source: {selected}", flush=True)
                    os.execve(sys.executable, [sys.executable,
                              str(synced_starter)],
                              {**os.environ, "COGNILODE_BOOTSTRAP_FROM_SYNC": "1",
                               "COGNILODE_BOOTSTRAP_LOADED_REVISION": selected,
                               "COGNILODE_BOOTSTRAP_RECONCILE_ONLY": "1"})
                digest = hashlib.sha256(candidate.read_bytes()).hexdigest()
                if digest != applied_digest:
                    changed: list[str] = []
                    try:
                        current_hashes = compose_service_hashes(project, candidate, env)
                        try:
                            previous_hashes = json.loads(service_hash_path.read_text(encoding="utf-8"))
                        except (OSError, ValueError):
                            previous_hashes = {}
                        changed = sorted(name for name, value in current_hashes.items()
                                         if previous_hashes.get(name) != value)
                        deferred = "codex-builder" in changed and codex_builder_compiling(project)
                        if deferred:
                            changed.remove("codex-builder")
                            print("company Compose deferring active native Codex build", flush=True)
                        # Every service participating in an accepted provider
                        # operation is part of the same custody boundary. In
                        # particular, replacing the queue actuator while its
                        # sender is awaiting a terminal receipt used to bypass
                        # this fence: the transport/chatmode remained alive,
                        # but the accepted job's owner was killed and its
                        # receipt could not be durably joined. The scheduler
                        # also owns the effect lease/receipt ledger, so its
                        # replacement must wait for the same quiescent point.
                        mutation_services = {
                            "chatmode", "provider-transport",
                            "provider-scheduler", "returned-product-actuator",
                        }.intersection(changed)
                        active_mutations = (provider_mutations_active(runtime)
                                            if mutation_services else 0)
                        if mutation_services and active_mutations != 0:
                            # Recreating either side severs the stream between
                            # the actuator and credential transport. Keep the
                            # previous hashes so reconciliation retries after
                            # every admitted provider mutation reaches terminal.
                            value = ("unknown" if active_mutations is None
                                     else str(active_mutations))
                            print("company Compose deferring provider custody replacement: "
                                  + value + " active sends", flush=True)
                            notify_service("WATCHDOG=1")
                            time.sleep(2)
                            continue
                        if mutation_services:
                            # Close admission after observing zero so a rhythm
                            # tick cannot start another turn between the check
                            # and Docker replacement. The scheduler will retain
                            # any rejected claim for the successor transport.
                            fenced = provider_mutations_active(runtime, drain=True)
                            if fenced != 0:
                                print("company Compose provider custody fence pending", flush=True)
                                time.sleep(2)
                                continue
                        if changed:
                            if "provider-transport" in changed:
                                ensure_chatmode_node(
                                    project, runtime,
                                    env.get("COGNILODE_WORKSPACE_IMAGE",
                                            "cognilode-standard-workspace:2026-09-28"))
                                notify_service("WATCHDOG=1")
                            # Each selected service is reconciled against its own
                            # resolved config. Do not cascade through dependencies:
                            # their unchanged long-running work must keep its lease.
                            run_with_watchdog(["docker", "compose", "--project-name", project,
                                               "-f", str(candidate), "up", "-d", "--no-deps",
                                               *changed], env=env)
                        notify_service("WATCHDOG=1")
                        applied_hashes = dict(current_hashes)
                        if deferred and "codex-builder" in previous_hashes:
                            applied_hashes["codex-builder"] = previous_hashes["codex-builder"]
                        elif deferred:
                            applied_hashes.pop("codex-builder", None)
                        save_service_hashes(service_hash_path, applied_hashes)
                    except subprocess.TimeoutExpired as exc:
                        if "chatmode" in changed:
                            try:
                                release_stalled_chatmode_replacement(project, runtime)
                            except (subprocess.CalledProcessError, subprocess.TimeoutExpired,
                                    OSError, ValueError) as recovery_exc:
                                print(f"bounded Chatmode replacement pending: {recovery_exc}",
                                      flush=True)
                        print(f"company Compose reconciliation pending: {exc}", flush=True)
                    except (subprocess.CalledProcessError, KeyError, ValueError) as exc:
                        print(f"company Compose reconciliation pending: {exc}", flush=True)
                    else:
                        if not deferred:
                            applied_digest = digest
                            applied_compose = candidate
                            temporary = digest_path.with_suffix(".tmp")
                            temporary.write_text(digest + "\n", encoding="utf-8")
                            temporary.replace(digest_path)
                            print(f"company Compose configuration applied: {selected}", flush=True)
        try:
            retire_standalone_adopter(project, applied_compose, runtime, env)
        except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as exc:
            print(f"standalone adopter retirement pending: {exc}", flush=True)
        notify_service("WATCHDOG=1")
        memory_source = runtime / "shared/source/current/agent-memory"
        memory_compose = memory_source / "deploy/compose/agent-memory.yml"
        if (memory_source / ".git").exists() and memory_compose.is_file():
            revision = subprocess.run(["git", "-c", "safe.directory=*", "-C", str(memory_source),
                                       "rev-parse", "HEAD"], capture_output=True, text=True,
                                      check=False).stdout.strip()
            previous = memory_applied.read_text(encoding="utf-8").strip() if memory_applied.is_file() else ""
            if revision and revision != previous:
                compose_digest = hashlib.sha256(memory_compose.read_bytes()).hexdigest()
                previous_compose = (memory_compose_applied.read_text(encoding="utf-8").strip()
                                    if memory_compose_applied.is_file() else "")
                services_present = all(subprocess.run(
                    ["docker", "inspect", f"{project}-{service}-1"],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                    check=False, timeout=30,
                ).returncode == 0 for service in ("memory", "source-vacuum"))
                if compose_digest != previous_compose or not services_present:
                    try:
                        # Source-only revisions are adopted by the stable-root
                        # entrypoint itself.  Compose reconciliation is reserved
                        # for changed mounts/environment or missing services;
                        # recreating both writers for every Python commit reset
                        # ingestion and publication frontiers repeatedly.
                        subprocess.run(["docker", "compose", "--project-name", project,
                                        "-f", str(memory_compose), "up", "-d", "--no-deps",
                                        "memory", "source-vacuum"],
                                       env=env, check=True, timeout=180)
                    except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as exc:
                        # Docker Compose can report a rename conflict after it
                        # has already installed and started the new canonical
                        # container. Treat that source-driven replacement as
                        # applied only when both requested services now exist
                        # and are running; otherwise retain the retry frontier.
                        running = all(subprocess.run(
                            ["docker", "inspect", "-f", "{{.State.Running}}",
                             f"{project}-{service}-1"],
                            capture_output=True, text=True, check=False, timeout=30,
                        ).stdout.strip().casefold() == "true"
                            for service in ("memory", "source-vacuum"))
                        if not running:
                            print(f"memory composition restart pending: {exc}", flush=True)
                            notify_service("WATCHDOG=1")
                            time.sleep(30)
                            continue
                        print("memory composition adopted after completed Docker replacement", flush=True)
                    temporary_compose = memory_compose_applied.with_suffix(".tmp")
                    temporary_compose.write_text(compose_digest + "\n", encoding="utf-8")
                    temporary_compose.replace(memory_compose_applied)
                # The running entrypoint observes the stable source pointer and
                # performs a cooperative child cutover without replacing the
                # containers or interrupting the source-vacuum database.
                if compose_digest == (memory_compose_applied.read_text(encoding="utf-8").strip()
                                      if memory_compose_applied.is_file() else compose_digest):
                    temporary = memory_applied.with_suffix(".tmp")
                    temporary.write_text(revision + "\n", encoding="utf-8")
                    temporary.replace(memory_applied)
                    print(f"memory source applied: {revision}", flush=True)
        notify_service("WATCHDOG=1")
        time.sleep(30)


def main() -> int:
    startup_time = time.time()
    if "COGNILODE_BOOTSTRAP_LOADED_REVISION" not in os.environ:
        os.environ["COGNILODE_BOOTSTRAP_LOADED_REVISION"] = subprocess.run(
            ["git", "-C", str(ROOT), "rev-parse", "HEAD"],
            capture_output=True, text=True, check=False).stdout.strip()
    repos = Path(os.environ.get("COMPANY_REPOS_ROOT", str(Path.home() / "Projects"))).resolve()
    runtime = Path(os.environ.get("COMPANY_RUNTIME_ROOT", str(Path.home() / ".local/share/cognilode/company-runtime"))).resolve()
    portable_aws = os.environ.get("COGNILODE_PORTABLE_AWS") == "1"
    aws = Path(os.environ.get("AWS_AUTH_ROOT", str(Path.home() / ".aws"))).resolve()
    for name in ("worker", "shared"):
        (runtime / name).mkdir(parents=True, exist_ok=True)
    # The installed host unit is only a stable launch point. After source-sync
    # has produced a newer pinned Git checkout, run its bootstrap on later
    # starts instead of accumulating host-specific deployment edits.
    if os.environ.get("COGNILODE_BOOTSTRAP_FROM_SYNC") != "1":
        synced = runtime / "shared/source/current/codex-backend-sdk"
        candidate = synced / "scripts/cognilode-company-container-bootstrap"
        if candidate.is_file() and (synced / ".git").exists():
            current = subprocess.run(["git", "-C", str(ROOT), "rev-parse", "HEAD"],
                                     capture_output=True, text=True, check=False).stdout.strip()
            selected = subprocess.run(["git", "-C", str(synced), "rev-parse", "HEAD"],
                                      capture_output=True, text=True, check=False).stdout.strip()
            remote_main = subprocess.run(["git", "-C", str(synced), "rev-parse", "origin/main"],
                                         capture_output=True, text=True, check=False).stdout.strip()
            if (current and selected and selected == remote_main
                    and selected != current
                    and candidate.resolve() != Path(__file__).resolve()):
                os.execve(sys.executable, [sys.executable, str(candidate)],
                          {**os.environ, "COGNILODE_BOOTSTRAP_FROM_SYNC": "1",
                           "COGNILODE_BOOTSTRAP_LOADED_REVISION": selected})
    # This is the sole permitted host company daemon. An interactive bootstrap
    # previously raced the systemd-owned reconciler and replaced the provider
    # containers during a fenced turn. Prefer the service owner when present,
    # then enforce a host-wide singleton on platforms without systemd.
    if not os.environ.get("INVOCATION_ID"):
        owner = subprocess.run(
            ["systemctl", "--user", "show", "cognilode-company-containers.service",
             "--property", "MainPID", "--value"],
            capture_output=True, text=True, check=False, timeout=10,
        )
        try:
            owner_pid = int(owner.stdout.strip() or "0")
        except ValueError:
            owner_pid = 0
        if owner_pid not in (0, os.getpid()):
            print(f"company bootstrap delegated to service-owned pid={owner_pid}", flush=True)
            return 0
    singleton = (runtime / "shared/company-container-bootstrap.lock").open("a+")
    try:
        fcntl.flock(singleton, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print("company bootstrap already active", flush=True)
        return 0
    migrate_previous_state(Path(os.environ.get("COMPANY_LEGACY_DATA_ROOT", str(Path.home() / ".local/share/cognilode"))), runtime)
    env = {**os.environ, "COMPANY_REPOS_ROOT": str(repos), "COMPANY_RUNTIME_ROOT": str(runtime),
           "AWS_AUTH_ROOT": "company_aws_client" if portable_aws else str(aws),
           "COMPANY_UID": str(os.getuid()), "COMPANY_GID": str(os.getgid()),
           "COGNILODE_ENVIRONMENT_ID": os.environ.get("COGNILODE_ENVIRONMENT_ID", "evanpc-company-container")}
    project = "cognilode-company-runtime"
    if os.environ.get("COGNILODE_BOOTSTRAP_RECONCILE_ONLY") == "1":
        reconcile_compose(project, runtime, env)
        return 0
    legacy_relay = Path(os.environ.get("COGNILODE_LEGACY_RELAY_ENV",
                                   str(Path.home() / ".config/cognilode/evanpc-host-node.env")))
    subprocess.run([sys.executable, str(ROOT / "scripts/cognilode-migrate-company-relay-custody")],
                   env=env, check=True, timeout=120)
    image = env.get("COGNILODE_WORKSPACE_IMAGE", "cognilode-standard-workspace:2026-09-28")
    ensure_chatmode_node(project, runtime, image)
    if portable_aws:
        prepare_portable_aws(project, image, os.getuid(), os.getgid())
    migrate_container_browser(project, image)
    volume_names = ("company_auth", "company_operator", "company_deploy_custody",
                    "memory_data", "memory_drive_auth", "company_relay_custody")
    for name in volume_names:
        subprocess.run(["docker", "volume", "create", f"{project}_{name}"],
                       stdout=subprocess.DEVNULL, check=True, timeout=30)
    custody_volumes = tuple(name for name in volume_names if name != "memory_data")
    prepare_volume_ownership(project, image, os.getuid(), os.getgid(), runtime,
                             custody_volumes)
    command = ["docker", "compose", "--project-name", project, "-f", str(COMPOSE), "up", "-d"]
    try:
        subprocess.run(command, env=env, check=True, timeout=180)
    except subprocess.TimeoutExpired:
        if not release_stalled_chatmode_replacement(project, runtime):
            raise
        subprocess.run(command, env=env, check=True, timeout=180)
    save_service_hashes(runtime / "shared/compose-service-digests.json",
                        compose_service_hashes(project, COMPOSE, env))
    (runtime / "shared/compose-config-applied.sha256").write_text(
        hashlib.sha256(COMPOSE.read_bytes()).hexdigest() + "\n", encoding="utf-8")
    memory_source = runtime / "shared/source/current/memory-stock-canonical"
    memory_minimum = "b4a4878d47abe142b75ab23c74f9b6dc1ce67cba"
    memory_shallow_accepted = "cdbe5de43b57e23e10f915185e533b02a4aba636"
    source_deadline = time.monotonic() + 360
    while True:
        script_ready = (memory_source / "deploy/conversation-vacuum/company_memory_cutover.py").is_file()
        ancestry = (subprocess.run(["git", "-C", str(memory_source), "merge-base", "--is-ancestor",
                                   memory_minimum, "HEAD"], stdout=subprocess.DEVNULL,
                                  stderr=subprocess.DEVNULL, check=False).returncode == 0
                    if script_ready else False)
        if script_ready and not ancestry:
            # Source-sync's old depth-one checkout can hide an otherwise known
            # main-branch ancestor. Accept the exact indexed-memory release;
            # source-sync repairs the shallow ancestry for later revisions.
            head = subprocess.run(["git", "-C", str(memory_source), "rev-parse", "HEAD"],
                                  capture_output=True, text=True, check=False).stdout.strip()
            ancestry = head == memory_shallow_accepted
        if script_ready and ancestry:
            break
        print(f"memory source pending: path={memory_source} script={script_ready} lease_revision={ancestry}",
              flush=True)
        if time.monotonic() >= source_deadline:
            raise RuntimeError("memory source synchronization did not complete")
        time.sleep(5)
    memory_env = {**env, "COGNILODE_MEMORY_SOURCE_ROOT": str(memory_source),
                  "COGNILODE_MEMORY_HOST_SOURCE": str(memory_source)}
    subprocess.run(["python3", str(memory_source / "deploy/conversation-vacuum/company_memory_cutover.py")],
                   env=memory_env, check=True)
    deadline = time.monotonic() + 150
    while time.monotonic() < deadline:
        custody_ready = subprocess.run(
            ["docker", "compose", "--project-name", project, "-f", str(COMPOSE),
             "exec", "-T", "credential-sync", "sh", "-c",
             "test -s /home/worker/.codex/auth.json && test -s /home/worker/.config/cognilode/operator-bearer"],
            env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=15, check=False).returncode == 0
        if (custody_ready and (runtime / "shared/http-gate/gate.sock").exists()
                and (runtime / "shared/http-gate/policy.json").is_file()
                and (runtime / "shared/provider.sock").exists()):
            break
        time.sleep(3)
    else:
        raise RuntimeError("container credentials or HTTP gate were not ready; host workers retained")
    if legacy_relay.is_file():
        relay_deadline = time.monotonic() + 150
        heartbeat = runtime / "shared/relay/heartbeat.json"
        while time.monotonic() < relay_deadline:
            try:
                relay_state = json.loads(heartbeat.read_text(encoding="utf-8"))
                ready = relay_state.get("ok") is True and heartbeat.stat().st_mtime >= startup_time
            except (OSError, ValueError):
                ready = False
            if ready:
                break
            time.sleep(3)
        else:
            raise RuntimeError("container relay heartbeat was not ready; legacy company relay custody retained")
    for name in retired_units():
        run("systemctl", "--user", "disable", "--now", name, check=False)
    run("docker", "stop", "cognilode-http-gate-http-gate-1", check=False)
    # These were temporary company-only host bind mounts from the first cutover.
    # Never touch the personal host Codex or browser profiles.
    for name in ("auth", "operator"):
        old = runtime / name
        if old.is_dir() and not old.is_symlink():
            shutil.rmtree(old)
    if legacy_relay.is_file():
        legacy_relay.unlink()
    reconcile_compose(project, runtime, env)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
