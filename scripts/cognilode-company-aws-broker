#!/usr/bin/env python3
"""Issue scoped, short-lived AWS credentials to enrolled company containers.

Only this container holds the upstream AWS identity. The public relay never
stores credentials; it forwards one authenticated request over the local Unix
socket and returns the STS response to the requesting credential_process.
"""
from __future__ import annotations

import json
import os
from pathlib import Path
import socket
import subprocess
import threading
import time
from datetime import datetime, timezone

SOCKET = Path(os.environ.get('COGNILODE_AWS_BROKER_SOCKET', '/runtime/aws-broker/broker.sock'))
ROLE_ARN = os.environ.get('COGNILODE_AWS_BROKER_ROLE_ARN', '').strip()
REGION = os.environ.get('AWS_DEFAULT_REGION', 'us-west-2')
ACCOUNT = os.environ.get('COGNILODE_AWS_ACCOUNT_ID', '').strip()
BUCKET = os.environ.get('COGNILODE_AWS_ARTIFACT_BUCKET', '').strip()
AWS = os.environ.get('COGNILODE_AWS_CLI', '/usr/bin/aws')
ALLOWED_PURPOSES = frozenset({'artifact-read', 'artifact-write', 'secrets-read', 'secrets-write'})
CACHE: dict[str, tuple[float, dict]] = {}
LOCK = threading.RLock()


def policy(purpose: str) -> str:
    if purpose.startswith('artifact-'):
        if not BUCKET or '/' in BUCKET:
            raise RuntimeError('artifact bucket is not configured')
        actions = ['s3:GetObject', 's3:ListBucket']
        if purpose == 'artifact-write':
            actions.append('s3:PutObject')
        statements = [{'Effect': 'Allow', 'Action': actions,
            'Resource': [f'arn:aws:s3:::{BUCKET}', f'arn:aws:s3:::{BUCKET}/*']}]
    else:
        if not ACCOUNT.isdigit() or len(ACCOUNT) != 12:
            raise RuntimeError('AWS account is not configured')
        actions = ['secretsmanager:GetSecretValue', 'secretsmanager:DescribeSecret']
        if purpose == 'secrets-write':
            actions.append('secretsmanager:PutSecretValue')
        statements = [{'Effect': 'Allow', 'Action': actions,
            'Resource': [f'arn:aws:secretsmanager:{REGION}:{ACCOUNT}:secret:cognilode/*',
                         f'arn:aws:secretsmanager:{REGION}:{ACCOUNT}:secret:/cognilode/*']}]
    return json.dumps({'Version': '2012-10-17', 'Statement': statements}, separators=(',', ':'))


def credentials(purpose: str) -> dict:
    if purpose not in ALLOWED_PURPOSES:
        raise ValueError('unsupported AWS credential purpose')
    if not ROLE_ARN.startswith('arn:aws:iam::'):
        raise RuntimeError('scoped AWS broker role is not configured')
    with LOCK:
        cached = CACHE.get(purpose)
        if cached and cached[0] - time.time() > 300:
            return cached[1]
        command = [AWS, 'sts', 'assume-role', '--region', REGION,
            '--role-arn', ROLE_ARN, '--role-session-name', f'cognilode-{purpose}',
            '--duration-seconds', '3600', '--policy', policy(purpose), '--output', 'json']
        result = subprocess.run(command, capture_output=True, text=True, timeout=30)
        if result.returncode:
            # stderr can contain provider details or credential identifiers.
            raise RuntimeError(f'aws_sts_assume_role_failed:{result.returncode}')
        value = json.loads(result.stdout)['Credentials']
        expiry = datetime.fromisoformat(value['Expiration'].replace('Z', '+00:00')).timestamp()
        if expiry <= time.time() + 300:
            raise RuntimeError('AWS STS credential expiration is too near')
        output = {'Version': 1, 'AccessKeyId': value['AccessKeyId'],
            'SecretAccessKey': value['SecretAccessKey'],
            'SessionToken': value['SessionToken'],
            'Expiration': datetime.fromtimestamp(expiry, timezone.utc).isoformat().replace('+00:00', 'Z')}
        CACHE[purpose] = (expiry, output)
        return output


def exchange(conn: socket.socket) -> None:
    with conn:
        conn.settimeout(35)
        prefix = bytearray()
        while len(prefix) < 4:
            chunk = conn.recv(4 - len(prefix))
            if not chunk:
                return
            prefix.extend(chunk)
        length = int.from_bytes(prefix, 'big')
        if length < 2 or length > 4096:
            return
        raw = bytearray()
        while len(raw) < length:
            chunk = conn.recv(length - len(raw))
            if not chunk:
                return
            raw.extend(chunk)
        try:
            request = json.loads(raw)
            response = {'ok': True, 'credentials': credentials(str(request.get('purpose') or ''))}
        except Exception as error:
            response = {'ok': False, 'error': str(error)[:100]}
        body = json.dumps(response, separators=(',', ':')).encode()
        conn.sendall(len(body).to_bytes(4, 'big') + body)


def main() -> None:
    SOCKET.parent.mkdir(parents=True, exist_ok=True)
    SOCKET.unlink(missing_ok=True)
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as server:
        server.bind(str(SOCKET))
        SOCKET.chmod(0o660)
        server.listen(16)
        while True:
            conn, _ = server.accept()
            threading.Thread(target=exchange, args=(conn,), daemon=True).start()


if __name__ == '__main__':
    main()
