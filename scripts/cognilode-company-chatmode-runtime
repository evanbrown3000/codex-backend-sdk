#!/usr/bin/env python3
"""Supervise event-driven provider work inside the standard company container."""
from __future__ import annotations

import os
import fcntl
from pathlib import Path
import signal
import shutil
import subprocess
import sys
import time

HERE = Path(__file__).resolve().parent
STOP = False


def stop(_signal, _frame):
    global STOP
    STOP = True


def active_source() -> Path:
    """Resolve the runner from the synchronized source frontier.

    The container is intentionally long lived because it owns provider state.
    Source generations are immutable and the ``current`` link advances.  The
    supervisor observes that link and drains the old batch runner before using
    the next generation, avoiding both stale code and interrupted provider
    mutations.
    """
    configured = os.environ.get("COGNILODE_B4PT0R_SDK_ROOT")
    root = Path(configured) if configured else HERE.parent
    return root.resolve()


def release_for(source: Path) -> tuple[Path, Path]:
    """Build one immutable CLI environment for a synchronized SDK revision."""
    release_root = Path(os.environ.get(
        # Keep the lock-aware immutable releases in their own generation.
        # Bootstrap containers may still be draining a pre-lock supervisor
        # against the legacy root; sharing paths with those processes lets an
        # old supervisor remove a newly completed environment.
        "COGNILODE_B4PT0R_RELEASE_ROOT", "/runtime/b4pt0r-releases/locked-v3-computerusex"
    ))
    release = release_root / source.name
    cli = release / "bin" / "b4pt0r"
    marker = release / ".complete"
    release_root.mkdir(parents=True, exist_ok=True)
    with (release_root / ".release-build.lock").open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if cli.is_file() and marker.is_file():
            return source / "scripts" / "b4pt0r-com-batch-daemon", cli
        # Python virtual environments are not relocatable: generated console
        # scripts retain the absolute interpreter path.  Build directly at the
        # immutable revision path and publish only by writing ``.complete``.
        # The surrounding lock prevents readers from observing a concurrent
        # build, while absence of the marker makes interrupted builds disposable.
        if release.exists():
            shutil.rmtree(release)
        builder = Path(os.environ.get("COGNILODE_VENV_PYTHON", "/usr/local/bin/python3"))
        if not builder.is_file():
            builder = Path(sys.executable)
        subprocess.run([str(builder), "-m", "venv", "--clear", str(release)],
                       check=True, timeout=300)
        install = [str(release / "bin" / "python"), "-m", "pip", "install", "--no-cache-dir", str(source)]
        universe = Path(os.environ.get(
            "COGNILODE_UNIVERSE_STORAGE_ROOT", "/runtime/source/current/universe-storage"
        )).resolve()
        if universe.is_dir():
            install.append(str(universe))
        computerusex = Path(os.environ.get(
            "COGNILODE_COMPUTERUSEX_PROJECT_ROOT",
            "/runtime/source/current/automation-computeruse-vision",
        )).resolve()
        if computerusex.is_dir():
            install.append(str(computerusex))
        subprocess.run(install, check=True, timeout=900)
        (release / ".complete").write_text(source.name + "\n", encoding="utf-8")
    return source / "scripts" / "b4pt0r-com-batch-daemon", release / "bin" / "b4pt0r"


def launch_prepared(runner: Path, cli: Path) -> subprocess.Popen:
    environment = os.environ.copy()
    environment["B4PT0R_CLI"] = str(cli)
    return subprocess.Popen(
        [sys.executable, str(runner)], env=environment, start_new_session=True
    )


def replace_supervisor(source: Path) -> None:
    """Continue supervision with the synchronized generation's own code."""
    supervisor = (source / "scripts" / "cognilode-company-chatmode-runtime").resolve()
    current = Path(__file__).resolve()
    if supervisor == current:
        return
    os.execve(sys.executable, [sys.executable, str(supervisor)], os.environ.copy())


def launch(source: Path) -> subprocess.Popen:
    return launch_prepared(*release_for(source))


def latest_complete_cli() -> Path | None:
    """Return an already published CLI so cold starts keep custody live.

    Building the moving source frontier can take minutes.  A container restart
    must not leave the provider queue without an actuator during that build.
    Completed immutable releases are safe bootstrap executables; the normal
    frontier preparation below replaces them after the current release exists.
    """
    root = Path(os.environ.get(
        "COGNILODE_B4PT0R_RELEASE_ROOT", "/runtime/b4pt0r-releases/locked-v2"
    ))
    candidates = []
    for marker in root.glob("*/.complete"):
        cli = marker.parent / "bin" / "b4pt0r"
        if cli.is_file():
            candidates.append((marker.stat().st_mtime_ns, cli))
    return max(candidates, default=(0, None))[1]


def prepare_frontier() -> tuple[Path, Path, Path]:
    """Build toward the moving source frontier without stopping provider work.

    Several agents may publish close together.  Intermediate revisions remain
    valid immutable history, but custody must not drain and restart once per
    commit.  Keep the incumbent worker live while releases build and only
    return when the prepared revision is still the current frontier.
    """
    while True:
        candidate = active_source()
        runner, cli = release_for(candidate)
        if active_source() == candidate:
            return candidate, runner, cli


def drain(process: subprocess.Popen) -> None:
    """Let admitted turns finish, but never let an obsolete generation wedge custody."""
    if process.poll() is not None:
        return
    # Signal the supervisor only.  It owns a cooperative drain protocol for
    # the queue actuator and its streamed provider children; signalling the
    # whole process group would kill those children before they could finish.
    process.terminate()
    timeout = float(os.environ.get("COGNILODE_PROVIDER_GENERATION_DRAIN_SECONDS", "2700"))
    try:
        process.wait(timeout=max(300.0, timeout))
    except subprocess.TimeoutExpired:
        # Jobs are deterministic queue operations.  The next generation will
        # submit unresolved work through the singular queue rather than leave
        # provider custody permanently pinned to obsolete code.
        os.killpg(process.pid, signal.SIGKILL)
        process.wait()


def main() -> int:
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    source = active_source()
    bootstrap_cli = latest_complete_cli()
    target_cli = Path(os.environ.get(
        "COGNILODE_B4PT0R_RELEASE_ROOT", "/runtime/b4pt0r-releases/locked-v2"
    )) / source.name / "bin" / "b4pt0r"
    if bootstrap_cli is not None and not target_cli.is_file():
        process = launch_prepared(source / "scripts" / "b4pt0r-com-batch-daemon", bootstrap_cli)
        source, runner, cli = prepare_frontier()
        drain(process)
        process = launch_prepared(runner, cli)
    else:
        source, runner, cli = prepare_frontier()
        process = launch_prepared(runner, cli)
    while not STOP:
        if process.poll() is not None:
            source, runner, cli = prepare_frontier()
            process = launch_prepared(runner, cli)
        else:
            candidate = active_source()
            if candidate != source:
                candidate, runner, cli = prepare_frontier()
                drain(process)
                # A source cutover includes the supervisor itself, not only its
                # children.  Otherwise an old bootstrap process can keep stale
                # release/install semantics forever while merely launching new
                # worker scripts beneath it.  Candidate preparation happens
                # before the drain, so provider custody remains live during the
                # potentially slow immutable-release build.
                replace_supervisor(candidate)
                source = candidate
                process = launch_prepared(runner, cli)
        time.sleep(2)
    if process.poll() is None:
        drain(process)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
