#!/usr/bin/env python3
"""Attach the deployed DecisionX source revision to an unclaimed D1 research job.

This is repeatable as Site/SDK code changes while a rhythm-slot job waits. It
uses the existing queue amendment operation, never sends an off-rhythm prompt.
"""
from __future__ import annotations

import argparse
from hashlib import sha256
import importlib.machinery
import importlib.util
import json
from pathlib import Path
import subprocess
import sys
import time
import urllib.error
import urllib.request
import zipfile

HERE = Path(__file__).resolve().parent
DEFAULT_SITE = Path('/home/evan/Projects/cognilode-cloudflare-pages-site')
DEFAULT_OUTPUT = Path.home() / '.local/share/cognilode/taskflow-launchpad/decisionx'
RELEASE_URL = 'https://cognilode.pages.dev/.well-known/cognilode-release.json'
SITE_PATHS = (
    'functions/api/operator/agent-memory/segments.js',
    'functions/api/operator/agent-memory/d1_api.js',
    'tests/operator-agent-memory-decisionx-candidates.test.mjs',
)
SDK_PATHS = (
    'scripts/cognilode-chatmode-queue-worker',
    'scripts/decisionx_native_batch.py',
    'scripts/cognilode-decisionx-successor',
    'scripts/decisionx_successor_native.py',
    'scripts/cognilode-decisionx-advice-handoff',
    'tests/test_chatmode_queue_worker.py',
)


def digest(raw: bytes) -> str:
    return sha256(raw).hexdigest()


def packed(value: object) -> bytes:
    return json.dumps(value, sort_keys=True, ensure_ascii=False,
                      separators=(',', ':')).encode('utf-8') + b'\n'


def load(path: Path, name: str):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


def git(repo: Path, *args: str) -> bytes:
    return subprocess.run(['git', '-C', str(repo), *args], check=True,
                          capture_output=True, timeout=30).stdout


def source(repo: Path, revision: str, path: str) -> bytes:
    return git(repo, 'show', revision + ':' + path)


def zip_write(archive: zipfile.ZipFile, name: str, raw: bytes) -> None:
    info = zipfile.ZipInfo(name, (1980, 1, 1, 0, 0, 0))
    info.compress_type = zipfile.ZIP_DEFLATED
    info.external_attr = 0o644 << 16
    archive.writestr(info, raw)


def build_packet(sdk: Path, site: Path, release: dict, output_root: Path) -> dict:
    sdk_revision = git(sdk, 'rev-parse', 'HEAD').decode().strip()
    site_revision = str(release.get('source_sha') or '')
    if len(site_revision) != 40 or any(c not in '0123456789abcdef' for c in site_revision):
        raise ValueError('public Site release lacks exact source commit')
    git(site, 'cat-file', '-e', site_revision + '^{commit}')
    members = {
        'source/site/' + path: source(site, site_revision, path)
        for path in SITE_PATHS
    }
    members.update({'source/sdk/' + path: source(sdk, sdk_revision, path)
                    for path in SDK_PATHS})
    members['DEPLOYED_SITE_RELEASE.json'] = packed(release)
    members['README.md'] = (
        'This packet supplements the existing DecisionX TaskFlow research ZIP.\n'
        'The Site files are from the exact public Pages release; the SDK files\n'
        'are from the installed home-network queue worker revision. Compare the\n'
        'historical implementations and human-authored requirements in the\n'
        'original ZIPs. Index only historical instruction/action antecedents\n'
        'before revealing outcome/evaluation; source-ground double triplets\n'
        'against adjacent turns. Do all heavy work in your Chat-mode native\n'
        'sandbox. Return a complete ZIP and report; the Codex external-effect\n'
        'employee will install and check real outcomes.\n'
    ).encode()
    manifest = {'schema': 'cognilode.decisionx.current_source_packet.v1',
                'sdk_revision': sdk_revision, 'deployed_site_revision': site_revision,
                'members': {name: digest(raw) for name, raw in sorted(members.items())}}
    output_root.mkdir(parents=True, exist_ok=True)
    path = output_root / ('DecisionX_current_source_' + sdk_revision[:12] + '_'
                          + site_revision[:12] + '.zip')
    with zipfile.ZipFile(path, 'w') as archive:
        zip_write(archive, 'MANIFEST.json', packed(manifest))
        for name, raw in sorted(members.items()):
            zip_write(archive, name, raw)
    if path.stat().st_size > 20 * 1024 * 1024:
        path.unlink()
        raise ValueError('DecisionX current-source ZIP exceeds 20MiB')
    return {'path': str(path), 'sha256': digest(path.read_bytes()),
            'sdk_revision': sdk_revision, 'site_revision': site_revision}


def public_release() -> dict:
    request = urllib.request.Request(RELEASE_URL, headers={
        'user-agent': 'Mozilla/5.0', 'cache-control': 'no-cache'})
    for attempt in range(4):
        try:
            with urllib.request.urlopen(request, timeout=25) as response:
                return json.load(response)
        except (urllib.error.HTTPError, urllib.error.URLError):
            if attempt == 3:
                raise
            time.sleep(0.5 * 2**attempt)
    raise AssertionError('unreachable')


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument('job_id')
    parser.add_argument('--site-root', type=Path, default=DEFAULT_SITE)
    parser.add_argument('--output-root', type=Path, default=DEFAULT_OUTPUT)
    args = parser.parse_args()
    sender = load(HERE / 'cognilode-b4pt0r-chatmode', 'dx_packet_sender')
    builder = load(HERE / 'cognilode-root-memory-native-cycle', 'dx_packet_publisher')
    post = sender.operator_memory_post
    job = (post({'operation': 'get_job', 'job_id': args.job_id}).get('job') or {})
    if (job.get('id') != args.job_id or job.get('state') != 'queued'
            or job.get('provider') != 'chatgpt.com'
            or job.get('prompt_author') != 'taskflow_plan'
            or not str(job.get('project') or '').lower().startswith('decisionx')
            or job.get('rhythm_slot_index') is not None):
        raise ValueError('target must be an unclaimed DecisionX TaskFlow Chat-mode job')
    release = public_release()
    packet = build_packet(HERE.parent, args.site_root, release, args.output_root)
    mirror = builder.publish_private(packet)
    refs = job.get('attachment_refs') or []
    if not refs:
        raise ValueError('DecisionX research job lacks original source attachment')
    result = post({'operation': 'amend_queued_job_attachments',
                   'job_id': args.job_id,
                   'expected_prompt_sha256': job['prompt_sha256'],
                   'expected_plan_revision': job['plan_revision'],
                   'expected_attachment_sha256': refs[0]['sha256'],
                   'attachment_ref': {'ref': 'file:' + packet['path'],
                                      'sha256': packet['sha256'], 'mirrors': [mirror],
                                      'name': 'DecisionX deployed source and native indexer revision'}})
    if not result.get('ok'):
        raise RuntimeError('D1 attachment amendment failed: ' + str(result.get('error')))
    reread = (post({'operation': 'get_job', 'job_id': args.job_id}).get('job') or {})
    if packet['sha256'] not in [item.get('sha256') for item in reread.get('attachment_refs') or []]:
        raise RuntimeError('D1 queued attachment exact-SHA readback failed')
    print(json.dumps({'ok': True, 'job_id': args.job_id, 'state': reread.get('state'),
                      'packet_sha256': packet['sha256'], 'private_mirror': mirror,
                      'sdk_revision': packet['sdk_revision'],
                      'site_revision': packet['site_revision']}, sort_keys=True))
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
