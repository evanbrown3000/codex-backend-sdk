#!/usr/bin/env python3
"""Idempotently provision the dedicated, resource-scoped company STS role.

Run from an already authorized AWS environment. It prints only the resulting
role ARN. The trust principal must be an existing EC2 instance profile role;
this script never provisions or exports long-lived access keys.
"""
from __future__ import annotations

import json
import os
import re
import subprocess

AWS = os.environ.get('COGNILODE_AWS_CLI', '/usr/bin/aws')
REGION = os.environ.get('AWS_DEFAULT_REGION', 'us-west-2')
ACCOUNT = os.environ.get('COGNILODE_AWS_ACCOUNT_ID', '362928919715')
BUCKET = os.environ.get('COGNILODE_AWS_ARTIFACT_BUCKET',
    'cognilode-ephemeral-artifacts-362928919715-us-west-2')
MEMORY_BUCKET = os.environ.get('COGNILODE_AWS_MEMORY_BUCKET',
    'cognilode-conversation-visibility-362928919715-us-west-2')
TRUST = os.environ.get('COGNILODE_AWS_BROKER_TRUST_PRINCIPAL', '').strip()
ROLE = 'CognilodeCompanyScopedBroker'


def aws(*args: str, allowed_missing: bool = False) -> dict:
    result = subprocess.run([AWS, *args, '--output', 'json'],
        capture_output=True, text=True, timeout=60)
    if result.returncode:
        if allowed_missing and 'NoSuchEntity' in result.stderr:
            return {}
        raise RuntimeError(f'AWS role provisioning failed at {args[0]}:{args[1]}')
    return json.loads(result.stdout or '{}')


def main() -> None:
    if (not re.fullmatch(r'arn:aws:iam::\d{12}:role/[A-Za-z0-9+=,.@_/-]+', TRUST)
            or not TRUST.startswith(f'arn:aws:iam::{ACCOUNT}:role/')):
        raise RuntimeError('COGNILODE_AWS_BROKER_TRUST_PRINCIPAL must identify one IAM role')
    if not re.fullmatch(r'\d{12}', ACCOUNT) or any(
        not re.fullmatch(r'[a-z0-9.-]+', bucket) for bucket in (BUCKET, MEMORY_BUCKET)):
        raise RuntimeError('invalid scoped AWS account or artifact bucket')
    trust = json.dumps({'Version': '2012-10-17', 'Statement': [{
        'Effect': 'Allow', 'Principal': {'AWS': TRUST}, 'Action': 'sts:AssumeRole'}]},
        separators=(',', ':'))
    policy = json.dumps({'Version': '2012-10-17', 'Statement': [
        {'Effect': 'Allow', 'Action': ['s3:ListBucket'],
            'Resource': [f'arn:aws:s3:::{bucket}' for bucket in (BUCKET, MEMORY_BUCKET)]},
        {'Effect': 'Allow', 'Action': ['s3:GetObject', 's3:PutObject'],
            'Resource': [f'arn:aws:s3:::{bucket}/*' for bucket in (BUCKET, MEMORY_BUCKET)]},
        {'Effect': 'Allow', 'Action': ['secretsmanager:GetSecretValue',
            'secretsmanager:DescribeSecret', 'secretsmanager:PutSecretValue'],
            'Resource': [f'arn:aws:secretsmanager:{REGION}:{ACCOUNT}:secret:cognilode/*',
                         f'arn:aws:secretsmanager:{REGION}:{ACCOUNT}:secret:/cognilode/*']},
    ]}, separators=(',', ':'))
    existing = aws('iam', 'get-role', '--role-name', ROLE, allowed_missing=True)
    if existing:
        aws('iam', 'update-assume-role-policy', '--role-name', ROLE,
            '--policy-document', trust)
    else:
        aws('iam', 'create-role', '--role-name', ROLE,
            '--assume-role-policy-document', trust,
            '--description', 'Short-lived company container sessions constrained by per-purpose session policy')
    aws('iam', 'put-role-policy', '--role-name', ROLE,
        '--policy-name', 'CognilodeCompanyScopedResources', '--policy-document', policy)
    # The instance role needs an identity-side grant to assume exactly this
    # broker role. Do not grant wildcards or access keys to the node itself.
    source_role_name = TRUST.rsplit('/', 1)[-1]
    assume_policy = json.dumps({'Version': '2012-10-17', 'Statement': [{
        'Effect': 'Allow', 'Action': 'sts:AssumeRole',
        'Resource': f'arn:aws:iam::{ACCOUNT}:role/{ROLE}'}]}, separators=(',', ':'))
    aws('iam', 'put-role-policy', '--role-name', source_role_name,
        '--policy-name', 'CognilodeAssumeScopedBrokerOnly',
        '--policy-document', assume_policy)
    print(f'arn:aws:iam::{ACCOUNT}:role/{ROLE}')


if __name__ == '__main__':
    main()
