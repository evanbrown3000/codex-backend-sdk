#!/usr/bin/env python3
"""Keep the single hosted Chat-mode queue filled without a local turn ceiling."""
from __future__ import annotations

import importlib.machinery
import importlib.util
import json
from pathlib import Path
import subprocess
import sys
import threading
import time


def load(path: Path, name: str):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def emit(kind: str, **fields):
    print(json.dumps({"kind": kind, "at": time.time(), **fields}, sort_keys=True), flush=True)


def live_sender_count() -> int | None:
    """Count provider send processes, rather than stale D1 effect-pending rows."""
    try:
        result = subprocess.run(
            ["pgrep", "-fc", "cognilode-b4pt0r-chatmode --auth-source codex send"],
            capture_output=True, text=True, timeout=5, check=False,
        )
        count = int(result.stdout.strip())
        return count if 0 <= count <= 1000 else None
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def main() -> int:
    here = Path(__file__).resolve().parent
    sender = load(here / "cognilode-b4pt0r-chatmode", "cognilode_floor_sender")
    worker = load(here / "cognilode-chatmode-queue-worker", "cognilode_floor_worker")
    next_batch_scan = 0.0
    batch_thread = None

    def scan_batches():
        try:
            worker.decisionx_batch_pump()
        except Exception as exc:
            emit("decisionx_batch_retry", error=f"{type(exc).__name__}:{str(exc)[:200]}")

    while True:
        try:
            observed = live_sender_count()
            request = {"operation": "rhythm_tick"}
            if observed is not None:
                request["provider_active_turns"] = observed
            result = sender.operator_memory_post(request, timeout=90)
            claims = result.get("claims") or []
            if claims or result.get("stop_status") not in (None, "not_due"):
                emit("hosted_queue_fill", status=result.get("status"), claims=len(claims),
                     active_before=result.get("active_before"), active_after=result.get("active_after"),
                     provider_active_observed=result.get("provider_active_observed"),
                     stop_status=result.get("stop_status"), stop_reason=result.get("stop_reason"))
        except Exception as exc:
            emit("hosted_queue_fill_retry", error=f"{type(exc).__name__}:{str(exc)[:200]}")
        if time.monotonic() >= next_batch_scan and (batch_thread is None or not batch_thread.is_alive()):
            next_batch_scan = time.monotonic() + 600
            batch_thread = threading.Thread(target=scan_batches, daemon=True, name="decisionx-batch-pump")
            batch_thread.start()
        time.sleep(10)


if __name__ == "__main__":
    sys.exit(main())
