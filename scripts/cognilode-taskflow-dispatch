#!/usr/bin/env python3
"""Call the domain-owned TaskFlow dispatcher from converged source."""
from __future__ import annotations

import os
from pathlib import Path
import runpy
import sys

root = Path(os.environ.get("COGNILODE_COMPANY_SOURCE_ROOT", "/runtime/source"))
sys.path.insert(0, str(root / "current/taskflow-orchestration-history/src"))
runpy.run_module("taskflow.dispatch", run_name="__main__")
