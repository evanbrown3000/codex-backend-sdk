#!/usr/bin/env python3
"""Operator-custody broker for the B4PT0R desktop bridge.

Run this command only inside the credential-owning container.  The desktop
passes operations on stdin and never receives provider or operator secrets.
"""
from __future__ import annotations

import json
import os
from pathlib import Path
import sys
from urllib.parse import urlencode
from urllib.request import Request, urlopen


def token() -> str:
    path = Path(os.environ.get("COGNILODE_OPERATOR_TOKEN_FILE", "/home/worker/.config/cognilode/operator-bearer"))
    return path.read_text(encoding="utf-8").strip().removeprefix("Bearer ").strip()


def request(url: str, method: str, body=None, params=None):
    if params:
        url += ("&" if "?" in url else "?") + urlencode(params)
    data = None if body is None else json.dumps(body, separators=(",", ":")).encode()
    headers = {"Accept": "application/json", "Authorization": "Bearer " + token()}
    if data is not None:
        headers["Content-Type"] = "application/json"
    with urlopen(Request(url, data=data, headers=headers, method=method), timeout=180) as response:
        return json.load(response)


def provider_send(payload: dict) -> dict:
    # This compatibility broker is an admission boundary only.  Provider HTTP
    # remains exclusively inside the rhythm-claimed queue actuator.
    source_root = Path(__file__).resolve().parent.parent
    if str(source_root) not in sys.path:
        sys.path.insert(0, str(source_root))
    from codex_backend_sdk.bridge_provider import ProviderCommandClient

    return ProviderCommandClient(token=token(), timeout=120).send_chatgpt(
        prompt=str(payload.get("prompt") or ""),
        conversation_id=payload.get("conversation_id"),
        parent_message_id=payload.get("parent_message_id"),
        model=str(payload.get("model") or "gpt-5-6-thinking"),
        effort=str(payload.get("effort") or "xhigh"),
        attachments=tuple(str(value) for value in payload.get("attachments") or ()),
        request_id=str(payload.get("request_id") or payload.get("user_message_id") or "") or None,
        project=str(payload.get("project") or "unified-b4pt0r"),
        role=str(payload.get("role") or "desktop-operator"),
        source="b4pt0r-provider-broker",
        prompt_authority=str(payload.get("prompt_authority") or "interactive_operator"),
        priority=payload.get("priority"),
        decisionx=payload.get("decisionx") if isinstance(payload.get("decisionx"), dict) else None,
    )


def main() -> int:
    payload = json.loads(sys.stdin.readline())
    operation = payload.pop("operation", "")
    if operation == "agent_memory_request":
        base = os.environ.get("AGENT_MEMORY_ENDPOINT", "https://cognilode.com/api/operator/agent-memory").rstrip("/")
        result = request(base + "/" + str(payload.get("path") or "").lstrip("/"),
                         str(payload.get("method") or "GET"), payload.get("body"), payload.get("params"))
    elif operation == "remote_shell_request":
        body = {"jsonrpc": "2.0", "id": "b4pt0r-broker", "method": "tools/call",
                "params": {"name": payload.get("name"), "arguments": payload.get("arguments") or {}}}
        raw = request(os.environ.get("COGNILODE_REMOTE_SHELL_ENDPOINT", "https://cognilode.com/api/operator/remote-shell/mcp"), "POST", body)
        result = raw.get("result", raw)
        if isinstance(result, dict) and result.get("structuredContent") is not None:
            result = result["structuredContent"]
    elif operation == "chatgpt_continue":
        result = provider_send(payload)
    else:
        result = {"ok": False, "error": "unsupported broker operation: " + operation}
    print(json.dumps(result, ensure_ascii=False, separators=(",", ":")))
    return 0 if not isinstance(result, dict) or result.get("ok") is not False else 2


if __name__ == "__main__":
    raise SystemExit(main())
