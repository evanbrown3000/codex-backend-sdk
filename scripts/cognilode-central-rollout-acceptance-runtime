#!/usr/bin/env python3
"""Run rollout acceptance once per synchronized SDK and Codex release generation."""
from __future__ import annotations

import os
from pathlib import Path
import signal
import subprocess
import sys
import time

SCRIPTS = Path(os.environ.get('COGNILODE_COMPANY_SOURCE_ROOT', '/runtime/source')) / 'current/codex-backend-sdk/scripts'
CODEX = Path(os.environ.get('COGNILODE_CODEX_BIN', '/codex/bin/codex'))
BOOT_WRAPPER = Path(__file__).resolve()
STOP = False


def stop(_signum, _frame):
    global STOP
    STOP = True


def generation():
    script = (SCRIPTS / 'cognilode-central-rollout-acceptance').resolve()
    binary = CODEX.resolve()
    return script, binary


def main():
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    previous = None
    while not STOP:
        selected = generation()
        if not selected[0].is_file() or not selected[1].is_file():
            time.sleep(5)
            continue
        if selected == previous:
            time.sleep(5)
            continue
        previous = selected
        print(f'central rollout acceptance generation sdk={selected[0]} codex={selected[1]}', flush=True)
        child = subprocess.Popen([sys.executable, str(selected[0]), '--daemon'], env=os.environ.copy())
        while not STOP and child.poll() is None and generation() == selected:
            time.sleep(5)
        if child.poll() is None:
            child.terminate()
            try:
                child.wait(timeout=15)
            except subprocess.TimeoutExpired:
                child.kill()
                child.wait(timeout=10)
        if STOP:
            return
        wrapper = (SCRIPTS / 'cognilode-central-rollout-acceptance-runtime').resolve()
        if wrapper.is_file() and wrapper != BOOT_WRAPPER:
            os.execv(sys.executable, [sys.executable, str(wrapper)])


if __name__ == '__main__':
    main()
