#!/usr/bin/env python3
"""Read-only recovery of Chat-mode turns and their linked sandbox artifacts.

This scans durable send receipts. It never posts a conversation mutation. A turn is
admitted only after the exact submitted user message has a final assistant child.
"""
from __future__ import annotations

import argparse
from datetime import datetime, timezone
import email.utils
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import sys
import time


SENDER_PATH = Path(__file__).with_name("cognilode-b4pt0r-chatmode")
loader = importlib.machinery.SourceFileLoader("cognilode_b4pt0r_sender", str(SENDER_PATH))
spec = importlib.util.spec_from_loader(loader.name, loader)
assert spec is not None
sender = importlib.util.module_from_spec(spec)
loader.exec_module(sender)


class RateLimited(RuntimeError):
    def __init__(self, seconds: float):
        self.seconds = max(60.0, seconds)
        super().__init__(f"provider rate limit; retry after {self.seconds:.0f} seconds")


def retry_after_seconds(value: str) -> float:
    try:
        return max(60.0, float(value))
    except ValueError:
        try:
            date = email.utils.parsedate_to_datetime(value)
            return max(60.0, date.timestamp() - time.time())
        except (TypeError, ValueError):
            return 120.0


def artifact_matches(item: dict) -> bool:
    path = Path(str(item.get("path") or ""))
    expected = str(item.get("sha256") or "").lower()
    if not path.is_file() or not re.fullmatch(r"[0-9a-f]{64}", expected):
        return False
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest() == expected


def has_collected_zip(result: dict) -> bool:
    return any(isinstance(item, dict) and str(item.get("name") or item.get("path") or "").lower().endswith(".zip")
               and artifact_matches(item) for item in result.get("downloaded_files") or [])


def atomic_json(path: Path, value: dict) -> None:
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n")
    temporary.replace(path)


def conversation_id_from_sse(path: Path) -> str:
    if not path.is_file():
        return ""
    raw = path.read_bytes()
    hits = re.findall(rb'"conversation_id"\s*:\s*"([0-9a-f-]{36})"', raw)
    return hits[-1].decode("ascii") if hits else ""


def exact_terminal(conversation: dict, user_message_id: str) -> tuple[dict, dict] | None:
    branch = sender.branch_messages(conversation)
    user_index = next((i for i, message in enumerate(branch)
                       if str(message.get("id") or "") == user_message_id), None)
    if user_index is None:
        return None
    for assistant in reversed(branch[user_index + 1:]):
        author = assistant.get("author") or {}
        if author.get("role") == "assistant" and assistant.get("end_turn") is True:
            return branch[user_index], assistant
    return None


def get_conversation(conversation_id: str, preferred: str):
    local_source = os.environ.get("COGNILODE_CHATMODE_AUTH_SOURCE", "").strip().lower()
    candidates = (("chrome", "codex") if local_source == "chrome" or preferred == "host_chrome_state_http"
                  else ("codex", "chrome"))
    failures = []
    for source in candidates:
        try:
            if source == "codex":
                session, auth, device_id = sender.codex_identity()
            else:
                local_profile = os.environ.get("COGNILODE_CHATMODE_CHROME_PROFILE", "").strip()
                profile = Path(local_profile).expanduser() if local_profile else sender.DEFAULT_PROFILE
                session = sender.new_session(profile, sender.DEFAULT_IMPERSONATE)
                auth = sender.identity(session)
                device_id = sender.device_id_from_cookies(session)
            response = session.get(sender.BASE + "conversation/" + conversation_id,
                                   headers=sender.app_headers(auth, device_id=device_id), timeout=90)
            if response.status_code == 200:
                return response.json(), session, auth, device_id
            failures.append(f"{source}:HTTP {response.status_code}")
            if response.status_code in (401, 403):
                continue
            if response.status_code == 429:
                raise RateLimited(retry_after_seconds(response.headers.get("Retry-After", "")))
            if response.status_code in (500, 502, 503, 504):
                raise RuntimeError(f"transient HTTP {response.status_code}")
            if response.status_code == 404:
                raise RuntimeError("conversation not visible yet (HTTP 404)")
        except RateLimited:
            raise
        except Exception as exc:
            failures.append(f"{source}:{type(exc).__name__}:{str(exc)[:150]}")
    raise RuntimeError("; ".join(failures))


def collect(receipt_path: Path, *, allow_provider_read: bool = False) -> dict:
    receipt = json.loads(receipt_path.read_text())
    if not isinstance(receipt, dict) or not receipt.get("user_message_id"):
        return {"state": "ignored", "receipt": str(receipt_path)}
    stem = receipt_path.name.removesuffix(".sse.receipt.json")
    collected_path = receipt_path.with_name(stem + ".collected.json")
    prior_terminal_at = None
    if collected_path.is_file():
        existing = json.loads(collected_path.read_text())
        if existing.get("complete") is True:
            prior_result = existing.get("result") if isinstance(existing.get("result"), dict) else {}
            prior_terminal_at = prior_result.get("completed_at")
            prior_central = prior_result.get("central_conversation_store") if isinstance(prior_result.get("central_conversation_store"), dict) else {}
            source = prior_central.get("central_raw_sse_source") if isinstance(prior_central.get("central_raw_sse_source"), dict) else {}
            files = [item for item in (prior_result.get("downloaded_files") or []) if isinstance(item, dict)]
            central_files = [item for item in (prior_central.get("central_artifacts") or []) if isinstance(item, dict)]
            needs_artifact_custody = bool(files) and {str(x.get("sha256")) for x in files} != {
                str(x.get("sha256")) for x in central_files if x.get("readback_verified") is True}
            needs_tool_history = bool(prior_result.get("raw_sha256")) and (
                prior_central.get("central_tool_event_count") is None or
                source.get("readback_verified") is not True)
            linked = set(sender.sandbox_artifact_paths(str(prior_result.get("terminal_assistant_text") or "")))
            collected_links = {str(item.get("sandbox_path") or "") for item in files
                               if artifact_matches(item)}
            needs_linked_artifact = bool(linked - collected_links)
            if ((needs_tool_history or needs_artifact_custody) and existing.get("prompt") and
                    prior_result.get("terminal_assistant_text") and
                    (not needs_artifact_custody or all(artifact_matches(item) for item in files))):
                source_path = str(prior_result.get("raw_path_host") or receipt.get("raw_path_host") or receipt.get("raw_path") or receipt_path.with_name(stem + ".sse"))
                if not prior_result.get("raw_sha256") or Path(source_path).is_file():
                    upgraded_result = {**prior_result, "raw_path_host": source_path}
                    central = sender.admit_central_conversation(result_id=stem, prompt=str(existing["prompt"]),
                        result=upgraded_result, attachments=list(receipt.get("attached_context_files") or []))
                    upgraded_result["central_conversation_store"] = central
                    atomic_json(collected_path, {**existing, "result": upgraded_result})
                    if not allow_provider_read or has_collected_zip(upgraded_result):
                        return {"state": "central_custody_upgraded", "receipt": str(receipt_path),
                                "tool_events": central.get("central_tool_event_count", 0), "central_ok": central.get("ok") is True}
            if not needs_linked_artifact and (not allow_provider_read or has_collected_zip(prior_result)):
                return {"state": "already_collected", "receipt": str(receipt_path)}
    record_path = receipt_path.with_name(stem + ".json")
    if record_path.is_file():
        try:
            local_record = json.loads(record_path.read_text())
        except (OSError, ValueError):
            local_record = {}
        local_result = local_record.get("result") if isinstance(local_record.get("result"), dict) else {}
        local_prompt = str(local_record.get("prompt") or "")
        local_text = str(local_result.get("terminal_assistant_text") or "")
        links = set(sender.sandbox_artifact_paths(local_text))
        files = list(local_result.get("downloaded_files") or [])
        collected_links = {str(item.get("sandbox_path") or "") for item in files
                           if isinstance(item, dict) and artifact_matches(item)}
        files_complete = not (links - collected_links)
        if local_prompt and local_text and local_result.get("assistant_terminal") and not files_complete:
            conversation_id = str(local_result.get("conversation_id") or receipt.get("conversation_id") or "")
            assistant_id = str(local_result.get("terminal_assistant_message_id") or "")
            if not conversation_id or not assistant_id:
                return {"state": "artifact_identity_pending", "receipt": str(receipt_path)}
            if not (Path.home() / ".codex/auth.json").is_file():
                # Queue workers can admit saved terminal text but do not hold
                # provider credentials. Leave exact-file recovery to the
                # credential-bearing transport collector without imposing a
                # shared retry delay on it.
                return {"state": "artifact_recovery_delegated", "receipt": str(receipt_path)}
            try:
                # The credential-bearing provider-transport collector performs
                # only the exact linked-file GET. It does not hydrate or poll
                # the conversation again after the saved SSE terminal.
                sender.ensure_runtime()
                session, auth, device_id = sender.codex_identity()
                files = sender.download_interpreter_artifacts(
                    session, auth, conversation_id=conversation_id,
                    assistant_message_id=assistant_id, assistant_text=local_text,
                    output_dir=receipt_path.with_name(stem + ".files"),
                    device_id=device_id,
                )
            except Exception as exc:
                return {"state": "artifact_download_pending", "receipt": str(receipt_path),
                        "reason": f"{type(exc).__name__}: {str(exc)[:240]}"}
            local_result["downloaded_files"] = files
            local_record["result"] = local_result
            atomic_json(record_path, local_record)
            collected_links = {str(item.get("sandbox_path") or "") for item in files
                               if isinstance(item, dict) and artifact_matches(item)}
            files_complete = not (links - collected_links)
        if local_prompt and local_text and local_result.get("assistant_terminal") and files_complete and (has_collected_zip(local_result) or not allow_provider_read):
            central = local_result.get("central_conversation_store") or {}
            if not central.get("ok") or (files and not central.get("central_artifacts")):
                central = sender.admit_central_conversation(
                    result_id=stem, prompt=local_prompt, result=local_result,
                    attachments=list(receipt.get("attached_context_files") or []),
                )
                local_result["central_conversation_store"] = central
            complete = bool(central.get("ok"))
            atomic_json(collected_path, {**local_record, "result": local_result, "complete": complete})
            return {"state": "collected_from_local_terminal" if complete else "central_ingest_pending",
                    "record": str(collected_path), "artifact_count": len(files), "central_ok": complete}
    if receipt.get("state") in ("provider_rejected", "missing_conversation"):
        return {"state": "provider_rejected", "receipt": str(receipt_path)}
    raw_path = Path(str(receipt.get("raw_path_host") or receipt.get("raw_path") or receipt_path.with_name(stem + ".sse")))
    conversation_id = str(receipt.get("conversation_id") or (receipt.get("provider_summary") or {}).get("conversation_id") or "") or conversation_id_from_sse(raw_path)
    if not conversation_id:
        return {"state": "awaiting_conversation_id", "receipt": str(receipt_path)}
    if not allow_provider_read:
        return {"state": "provider_read_deferred", "receipt": str(receipt_path)}
    conversation, session, auth, device_id = get_conversation(conversation_id, str(receipt.get("transport") or ""))
    turn = exact_terminal(conversation, str(receipt["user_message_id"]))
    if turn is None:
        return {"state": "awaiting_terminal", "conversation_id": conversation_id}
    user, assistant = turn
    provider_metadata = assistant.get("metadata") if isinstance(assistant.get("metadata"), dict) else {}
    prompt = sender.message_text(user)
    response_text = sender.message_text(assistant)
    if not prompt or not response_text:
        return {"state": "awaiting_text", "conversation_id": conversation_id}
    expected_prompt_sha = str(receipt.get("prompt_sha256") or "")
    if expected_prompt_sha and hashlib.sha256(prompt.encode()).hexdigest() != expected_prompt_sha:
        return {"state": "prompt_identity_mismatch", "conversation_id": conversation_id}
    downloads = sender.download_interpreter_artifacts(
        session, auth, conversation_id=conversation_id,
        assistant_message_id=str(assistant.get("id") or ""),
        assistant_text=response_text, output_dir=receipt_path.with_name(stem + ".downloads"),
        device_id=device_id,
    )
    raw_exists = raw_path.is_file()
    raw = raw_path.read_bytes() if raw_exists else b""
    now = time.time()
    result = {
        **receipt,
        "ok": True,
        "state": "provider_accepted",
        "conversation_id": conversation_id,
        "provider_acceptance_observed": True,
        "assistant_terminal": True,
        "terminal_assistant_text": response_text,
        "terminal_assistant_message_id": assistant.get("id"),
        "provider_model_observed": provider_metadata.get("model_slug"),
        "provider_thinking_effort_observed": provider_metadata.get("thinking_effort"),
        "downloaded_files": downloads,
        "completed_at": prior_terminal_at or now,
        "raw_sha256": hashlib.sha256(raw).hexdigest() if raw_exists else "",
        "raw_bytes": len(raw),
        "raw_path_host": str(raw_path) if raw_exists else "",
        "provider_summary": {"conversation_id": conversation_id},
        "collection_method": "read_only_exact_branch_hydration",
    }
    record_id = stem
    central = sender.admit_central_conversation(
        result_id=record_id, prompt=prompt, result=result,
        attachments=list(receipt.get("attached_context_files") or []),
    )
    result["central_conversation_store"] = central
    record = {
        "schema": "cognilode.b4pt0r_chatmode_collected.v1",
        "record_id": record_id,
        "created_at": datetime.now(timezone.utc).isoformat(),
        "prompt_sha256": hashlib.sha256(prompt.encode()).hexdigest(),
        "prompt": prompt,
        "result": result,
        "complete": bool(central.get("ok")),
    }
    atomic_json(collected_path, record)
    return {"state": "collected" if record["complete"] else "central_ingest_pending",
            "conversation_id": conversation_id, "artifact_count": len(downloads),
            "record": str(collected_path), "central_ok": bool(central.get("ok"))}


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--dir", action="append", default=[])
    parser.add_argument("--limit", type=int, default=40)
    parser.add_argument("--recursive", action="store_true",
                        help="include nested project handoff receipt directories")
    parser.add_argument("--receipt", type=Path, default=None,
                        help="recover one exact send receipt without scanning unrelated turns")
    args = parser.parse_args()
    roots = [Path(p).expanduser() for p in args.dir] or [sender.DEFAULT_OUTPUT_ROOT]
    global_state_path = roots[0] / "collector_global_state.json"
    try:
        global_state = json.loads(global_state_path.read_text())
    except (OSError, ValueError):
        global_state = {}
    global_cooldown_until = float(global_state.get("cooldown_until_epoch") or 0)
    recent_paths = sorted((p for root in roots if root.is_dir()
                           for p in (root.rglob("*.sse.receipt.json") if args.recursive
                                     else root.glob("*.sse.receipt.json"))),
                          key=lambda p: p.stat().st_mtime, reverse=True)
    paths = [args.receipt] if args.receipt and args.receipt.is_file() else ([] if args.receipt else recent_paths)
    # The container-hosted gate synchronizes this policy from Cognilode.com.
    # Keep provider read recovery available, but never use it when the central
    # observability switch is off.
    policy_path = Path(os.environ.get("COGNILODE_HTTP_GATE_POLICY_FILE", ""))
    try:
        policy = json.loads(policy_path.read_text()) if policy_path.is_file() else {}
    except (OSError, ValueError):
        policy = {}
    observability_enabled = policy.get("schema") == "cognilode.http_gate_policy.v1" and policy.get("purposes", {}).get("observability") is True
    active_mutation = False
    for path in recent_paths[:10]:
        try:
            recent = json.loads(path.read_text())
        except (OSError, ValueError):
            continue
        if recent.get("state") == "send_started" and time.time() - float(recent.get("started_at") or 0) < 7200:
            active_mutation = True
            break
    outcomes = []
    provider_reads = 0
    source_generation = str(Path(__file__).resolve().parent)
    for path in paths[:max(1, args.limit)]:
        state_path = path.with_name(path.name.removesuffix(".sse.receipt.json") + ".collection_state.json")
        try:
            state = json.loads(state_path.read_text()) if state_path.is_file() else {}
        except (OSError, ValueError):
            state = {}
        prior_result = state.get("last_result") if isinstance(state.get("last_result"), dict) else {}
        prior_reason = str(prior_result.get("reason") or "")
        repaired_local_blocker = (
            (Path.home() / ".codex/auth.json").is_file()
            and state.get("state") == "artifact_download_pending"
            and state.get("collector_source_generation") != source_generation
            and ("No module named 'curl_cffi'" in prior_reason
                 or "central HTTP gate denied observability" in prior_reason
                 or "central HTTP gate denied artifact_download" in prior_reason)
        )
        if float(state.get("next_poll_epoch") or 0) > time.time() and not repaired_local_blocker:
            continue
        allow_provider_read = (observability_enabled and not active_mutation
                               and provider_reads == 0 and time.time() >= global_cooldown_until)
        try:
            outcome = collect(path, allow_provider_read=allow_provider_read)
        except RateLimited as exc:
            global_cooldown_until = time.time() + exc.seconds
            atomic_json(global_state_path, {"cooldown_until_epoch": global_cooldown_until,
                                            "reason": "provider_retry_after"})
            outcome = {"state": "provider_rate_limited", "receipt": str(path),
                       "retry_after_seconds": exc.seconds}
        except Exception as exc:
            outcome = {"state": "retryable_collection_error", "receipt": str(path),
                       "error": f"{type(exc).__name__}: {str(exc)[:400]}"}
        outcomes.append(outcome)
        status = outcome.get("state")
        if allow_provider_read and status not in ("collected_from_local_terminal", "already_collected",
                                                  "provider_rejected", "awaiting_conversation_id"):
            provider_reads += 1
        if status in ("provider_read_deferred", "artifact_recovery_delegated"):
            continue
        attempts = 0 if status in ("collected", "already_collected") else int(state.get("attempts") or 0) + 1
        delay = 0 if status in ("collected", "already_collected") else min(1800, 60 * 2 ** min(attempts - 1, 5))
        # The local admission socket may briefly refuse connections while its
        # source generation changes. No provider request passed that gate, so
        # retry this saved-terminal file on the next collector cadence rather
        # than inheriting an unrelated exponential provider backoff.
        reason = str(outcome.get("reason") or "")
        if status == "artifact_download_pending" and "central HTTP gate unavailable for artifact_download" in reason:
            delay = 120
        atomic_json(state_path, {"state": status, "attempts": attempts,
                                 "next_poll_epoch": time.time() + delay,
                                 "collector_source_generation": source_generation,
                                 "last_result": outcome})
    print(json.dumps({"processed": len(outcomes), "outcomes": outcomes}, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
