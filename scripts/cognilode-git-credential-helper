#!/usr/bin/env python3
"""Ephemeral GitHub credential helper backed by central secret custody."""
from __future__ import annotations

import json
import os
from pathlib import Path
import sys


def main() -> int:
    operation = sys.argv[1] if len(sys.argv) > 1 else ""
    request = dict(
        line.rstrip("\n").split("=", 1)
        for line in sys.stdin
        if "=" in line
    )
    if operation != "get" or request.get("host") not in {"github.com", "api.github.com"}:
        return 0
    custody_file = Path(os.environ.get(
        "COGNILODE_GITHUB_CREDENTIAL_FILE", "/deploy/github-owner.json"
    ))
    try:
        value = json.loads(custody_file.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return 1
    token = value.get("api_key", "") if isinstance(value, dict) else ""
    if not isinstance(token, str) or not token or len(token) > 4096:
        return 1
    sys.stdout.write("username=x-access-token\npassword=" + token + "\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
