#!/usr/bin/env python3
"""Authorize this physical phone's Codex identity with the official device flow."""
from __future__ import annotations

import json
from pathlib import Path

from codex_backend_sdk.oauth import complete_device_code_login, request_device_code


def main() -> int:
    auth_path = Path.home() / ".codex/auth.json"
    if auth_path.exists():
        raise SystemExit("Phone auth already exists; refusing to replace it silently")
    pending = request_device_code()
    print(json.dumps({"verification_url": pending.verification_url, "user_code": pending.user_code,
                      "next_step": "Approve this code in the phone browser, then wait for completion"}), flush=True)
    store = complete_device_code_login(pending, timeout=15 * 60, persist=True)
    if not store.account_id or not auth_path.is_file() or auth_path.stat().st_mode & 0o077:
        raise SystemExit("Phone authorization did not persist a private account identity")
    print(json.dumps({"ok": True, "account_id": store.account_id,
                      "auth_path_private": True}), flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
