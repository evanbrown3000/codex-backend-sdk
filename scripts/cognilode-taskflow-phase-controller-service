#!/usr/bin/env python3
"""Bounded recurrence host for the TaskFlow phase controller.

This is deliberately not a prompt scheduler. It periodically lets the controller
reconcile/materialize non-ChatGPT phases in the single D1 queue; the hosted
historical rhythm remains the sole clock/claim path for chatgpt.com jobs.
"""
from __future__ import annotations
from datetime import UTC, datetime
import fcntl
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import time

HERE = Path(__file__).resolve().parent
CONTROLLER = HERE / "cognilode-taskflow-phase-controller"
SENDER = HERE / "cognilode-b4pt0r-chatmode"
STATE_ROOT = Path(os.environ.get("COGNILODE_TASKFLOW_STATE_ROOT", str(Path.home()/".local/share/cognilode/taskflow-phase-controller"))).expanduser()
LOG = STATE_ROOT / "recurrence.jsonl"
LOCK = STATE_ROOT / "recurrence.lock"
INTERVAL = max(10, min(3600, int(os.environ.get("COGNILODE_TASKFLOW_INTERVAL_SECONDS", "30"))))
RUN_TIMEOUT = max(30, min(7200, int(os.environ.get("COGNILODE_TASKFLOW_RUN_TIMEOUT_SECONDS", "3900"))))
STOP = False


def _time(value):
    try:
        result = datetime.fromisoformat(str(value).replace("Z", "+00:00"))
        return result.astimezone(UTC) if result.tzinfo else None
    except (ValueError, TypeError):
        return None


def _project_id():
    with Path(_required("COGNILODE_TASKFLOW_PLAN")).open(encoding="utf-8") as plan:
        for _, line in zip(range(100), plan):
            if line.startswith("id "):
                return line.removeprefix("id ").strip()
    raise ValueError("TaskFlow plan has no project id")


def _queue_post(body):
    loader = importlib.machinery.SourceFileLoader("taskflow_capacity_sender", str(SENDER))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module.operator_memory_post(body)


def capacity_gate(*, now=None, post=None, status_path=None):
    """Admit one new Codex phase by measured quota and active D1 occupancy.

    Only opt-in TaskFlow instances use this; D1 still owns the queue/leases.
    Unknown quota permits one worker if no other Codex phase is active.
    """
    now = now or datetime.now(UTC)
    post = post or _queue_post
    status_path = status_path or Path.home()/".local/share/live/worlds/v1/cognilode/modified_codex/llm_governance/status.json"
    project = _project_id()
    remaining = None
    try:
        status = json.loads(status_path.read_text(encoding="utf-8"))
        observed = _time(status.get("observed_at"))
        if (status.get("schema") == "cognilode.modified_codex.llm_governance.v1"
            and observed and -300 <= (now-observed).total_seconds() <= 900):
            values = [float(q["remaining_percent"]) for q in status.get("quotas") or []
                      if isinstance(q, dict) and q.get("provider") == "codex_backend"
                      and _time(q.get("observed_at"))
                      and -300 <= (now-_time(q["observed_at"])).total_seconds() <= 3600
                      and isinstance(q.get("remaining_percent"), (int, float))
                      and 0 <= q["remaining_percent"] <= 100]
            if values:
                remaining = min(values)
    except (OSError, ValueError, KeyError):
        pass
    jobs = {}
    try:
        for provider in ("codex.research", "codex.external-effect"):
            for state in ("claimed", "effect_pending"):
                result = post({"operation": "list_jobs", "provider": provider,
                               "state": state, "limit": 100})
                if not result.get("ok") or result.get("next_cursor"):
                    raise RuntimeError("active Codex D1 inventory incomplete")
                for job in result.get("jobs") or []:
                    jobs[str(job["id"])] = job
    except Exception as exc:
        return {"admit": False, "reason": f"active D1 inventory unavailable: {type(exc).__name__}",
                "quota_remaining_percent": remaining}
    own_pending = [j for j in jobs.values() if j.get("project") == project
                   and j.get("state") == "effect_pending" and j.get("taskflow_step")]
    if own_pending:
        # Reconcile an already-begun effect without claiming a different step.
        step = str(sorted(own_pending, key=lambda j: j.get("claimed_at") or "")[0]["taskflow_step"])
        return {"admit": True, "reason": "reconcile_existing_effect", "seed_step": step,
                "quota_remaining_percent": remaining, "other_active": len(jobs)-len(own_pending)}
    other = sum(j.get("project") != project for j in jobs.values())
    if remaining is not None and remaining <= 5:
        return {"admit": False, "reason": "observed Codex quota reserve", "quota_remaining_percent": remaining,
                "other_active": other}
    capacity = (1 if remaining is None or remaining <= 20 else
                2 if remaining <= 40 else 3)
    admit = other < capacity
    return {"admit": admit, "reason": "capacity_available" if admit else "observed Codex concurrency cap",
            "quota_remaining_percent": remaining, "other_active": other,
            "max_active_codex": capacity}

def _stop(_sig, _frame):
    global STOP
    STOP = True

def _emit(value):
    STATE_ROOT.mkdir(parents=True, exist_ok=True)
    line = json.dumps(value, sort_keys=True, ensure_ascii=False)
    with LOG.open("a", encoding="utf-8") as out:
        out.write(line + "\n")
        out.flush()
        os.fsync(out.fileno())
    print(line, flush=True)

def _required(name):
    value = os.environ.get(name, "").strip()
    if not value:
        raise SystemExit(f"required environment variable missing: {name}")
    return value

def command():
    plan = _required("COGNILODE_TASKFLOW_PLAN")
    role = _required("COGNILODE_TASKFLOW_RESEARCH_EMPLOYEE")
    external = _required("COGNILODE_TASKFLOW_EXTERNAL_EMPLOYEE")
    if role == external:
        raise SystemExit("research and external-effect employees must be distinct named employees")
    argv = [str(CONTROLLER), "--plan", plan, "--role", role,
            "--external-employee", external,
            "--state-root", str(STATE_ROOT)]
    for env, flag in [
        ("COGNILODE_TASKFLOW_SECRETARY", "--secretary"),
        ("COGNILODE_TASKFLOW_MANAGER", "--manager"),
        ("COGNILODE_TASKFLOW_SEED_STEP", "--seed-step"),
        ("COGNILODE_TASKFLOW_WORKER_ID", "--worker-id"),
        ("COGNILODE_TASKFLOW_PRIORITY", "--priority"),
    ]:
        v=os.environ.get(env," ").strip()
        if v: argv.extend([flag,v])
    return argv

def run_once():
    started=time.time(); argv=command()
    if os.environ.get("COGNILODE_TASKFLOW_CODEX_CAPACITY_GATE", "").strip() == "1":
        gate=capacity_gate()
        if not gate["admit"]:
            _emit({"schema":"cognilode.taskflow.recurrence.v1","at":time.time(),
                   "state":"capacity_deferred", **gate})
            return
        if gate.get("seed_step"):
            argv.extend(["--seed-step", gate["seed_step"]])
    try:
        cp=subprocess.run(argv,text=True,capture_output=True,timeout=RUN_TIMEOUT,check=False)
        row={"schema":"cognilode.taskflow.recurrence.v1","at":time.time(),"duration_s":round(time.time()-started,3),
             "returncode":cp.returncode,"stdout_tail":cp.stdout[-12000:],"stderr_tail":cp.stderr[-8000:]}
    except subprocess.TimeoutExpired as exc:
        row={"schema":"cognilode.taskflow.recurrence.v1","at":time.time(),"duration_s":round(time.time()-started,3),
             "returncode":124,"timeout":True,"stdout_tail":(exc.stdout or "")[-12000:] if isinstance(exc.stdout,str) else "",
             "stderr_tail":(exc.stderr or "")[-8000:] if isinstance(exc.stderr,str) else ""}
    _emit(row)


def main():
    signal.signal(signal.SIGTERM,_stop); signal.signal(signal.SIGINT,_stop)
    STATE_ROOT.mkdir(parents=True,exist_ok=True)
    with LOCK.open("a+") as lock:
        try: fcntl.flock(lock.fileno(), fcntl.LOCK_EX|fcntl.LOCK_NB)
        except BlockingIOError:
            _emit({"schema":"cognilode.taskflow.recurrence.v1","at":time.time(),"state":"already_running"})
            return 0
        _emit({"schema":"cognilode.taskflow.recurrence.v1","at":time.time(),"state":"started","interval_seconds":INTERVAL})
        while not STOP:
            run_once()
            deadline=time.monotonic()+INTERVAL
            while not STOP and time.monotonic()<deadline:
                time.sleep(min(1.0,deadline-time.monotonic()))
        _emit({"schema":"cognilode.taskflow.recurrence.v1","at":time.time(),"state":"stopped"})
    return 0

if __name__=="__main__": raise SystemExit(main())
