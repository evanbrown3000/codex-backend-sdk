#!/usr/bin/env python3
"""Keep the existing single-queue Chat-mode actuator and collector in one container.

Scheduling belongs to the shared rhythm queue. This supervisor contains no
prompt selection, provider HTTP implementation, or TaskFlow logic.
"""
from __future__ import annotations

import os
from pathlib import Path
import signal
import subprocess
import sys
import time

HERE = Path(__file__).resolve().parent
THIS_GENERATION = Path(__file__).resolve()
CURRENT = Path("/runtime/source/current/codex-backend-sdk/scripts/cognilode-company-chatmode-runtime")
STOP = False


def stop(_signal, _frame):
    global STOP
    STOP = True


def spawn(name: str, argv: list[str]) -> subprocess.Popen:
    print(f"starting {name}", flush=True)
    return subprocess.Popen(argv, start_new_session=True)


def stop_children(children: dict[str, tuple[list[str], subprocess.Popen]], *, drain_queue: bool = False) -> None:
    for _, process in children.values():
        if process.poll() is None:
            process.terminate()
    for name, (_, process) in children.items():
        try:
            process.wait(timeout=None if drain_queue and name == "queue" else 20)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()


def main() -> int:
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    state = Path.home() / ".local/share/cognilode"
    state.mkdir(parents=True, exist_ok=True)
    provider_socket = Path(os.environ["COGNILODE_PROVIDER_SOCKET"])
    operator_token = Path(os.environ["COGNILODE_OPERATOR_TOKEN_FILE"])
    gate_policy = Path(os.environ["COGNILODE_HTTP_GATE_POLICY_FILE"])
    while not STOP and not (provider_socket.exists() and operator_token.is_file()
                            and gate_policy.is_file()):
        time.sleep(2)
    if STOP:
        return 0
    children: dict[str, tuple[list[str], subprocess.Popen]] = {}
    programs = {
        "queue": [sys.executable, str(HERE / "cognilode-chatmode-queue-worker"),
                  "--device-id", os.environ.get("COGNILODE_ENVIRONMENT_ID", "company-container"),
                  "--interval", "60"],
        "rhythm": [sys.executable, str(HERE / "cognilode-chatmode-floor-watcher")],
    }
    for name, argv in programs.items():
        children[name] = (argv, spawn(name, argv))
    while not STOP:
        if CURRENT.is_file() and CURRENT.resolve() != THIS_GENERATION:
            print(f"source generation changed to {CURRENT.resolve()}; restarting children", flush=True)
            stop_children(children, drain_queue=True)
            os.execv(sys.executable, [sys.executable, str(CURRENT)])
        for name, (argv, process) in list(children.items()):
            if process.poll() is not None:
                print(f"restarting {name} exit={process.returncode}", flush=True)
                children[name] = (argv, spawn(name, argv))
        time.sleep(2)
    stop_children(children)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
