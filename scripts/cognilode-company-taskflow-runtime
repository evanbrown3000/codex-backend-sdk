#!/usr/bin/env python3
"""Run source-converged hierarchical TaskFlow plans inside company custody."""
from __future__ import annotations

import os
from pathlib import Path
import subprocess
import sys
import time


SOURCE = Path(os.environ.get("COGNILODE_COMPANY_SOURCE_ROOT", "/runtime/source")) / "current"
PLAN_ROOT = Path(os.environ.get("COGNILODE_TASKFLOW_PLAN_ROOT", "/runtime/worker/rpe-runs"))


def run_once() -> None:
    runtime = SOURCE / "modified-codex-runtime" / "src"
    taskflow = SOURCE / "taskflow-orchestration-history" / "src"
    codex = Path(os.environ.get("COGNILODE_CODEX_BIN", "/codex/bin/codex"))
    if not runtime.is_dir() or not taskflow.is_dir() or not codex.is_file():
        print("TaskFlow runtime waiting for converged sources and Codex release", flush=True)
        return
    env = os.environ.copy()
    env["PYTHONPATH"] = os.pathsep.join((str(runtime), str(taskflow), env.get("PYTHONPATH", "")))
    env["COGNILODE_TASKFLOW_DISPATCH_BIN"] = str(
        SOURCE / "codex-backend-sdk" / "scripts" / "cognilode-taskflow-dispatch"
    )
    env["COGNILODE_REPOSITORIES_ROOT"] = str(SOURCE)
    env["COGNILODE_AWS_CLI"] = "/usr/bin/aws"
    subprocess.run(
        [sys.executable, "-m", "modified_codex.taskflow_secretary", "reconcile"],
        env=env, check=False, timeout=240,
    )
    for plan in sorted(PLAN_ROOT.glob("**/project.dispatch.plan")):
        if plan.is_file():
            subprocess.run(
                [sys.executable, "-m", "taskflow.dispatch", str(plan),
                 "--handler", "secretary=python3 -m modified_codex.taskflow_secretary submit",
                 "--parallel", "8"],
                env=env, check=False, timeout=240,
            )


if __name__ == "__main__":
    while True:
        try:
            run_once()
        except Exception as error:
            print(f"TaskFlow worker pending: {type(error).__name__}: {error}", flush=True)
        time.sleep(max(30, int(os.environ.get("COGNILODE_TASKFLOW_SCAN_INTERVAL", "60"))))
