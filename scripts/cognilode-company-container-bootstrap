#!/usr/bin/env python3
"""Start the company container stack, then retire host company user units.

This is the one permitted host company service. Docker itself remains the OS
container engine; company workers run under its restart policy.
"""
from __future__ import annotations

import os
import json
import hashlib
from pathlib import Path
import shutil
import subprocess
import sys
import time
import urllib.request

ROOT = Path(__file__).resolve().parents[1]
COMPOSE = ROOT / "deploy/compose/company-chatmode.yml"
SELF = "cognilode-company-containers.service"


def prepare_portable_aws(project: str, image: str, uid: int, gid: int) -> None:
    """Create credential_process custody after one central broker readback.

    No AWS access key or host ~/.aws file enters this volume. The one-time
    operator enrollment token may be supplied by a company registration file.
    """
    volume = f"{project}_company_aws_client"
    operator = f"{project}_company_operator"
    for name in (volume, operator):
        subprocess.run(["docker", "volume", "create", name], stdout=subprocess.DEVNULL,
                       check=True, timeout=30)
    probe = subprocess.run(["docker", "run", "--rm", "--volume", f"{operator}:/operator:ro",
                            image, "cat", "/operator/operator-bearer"],
                           capture_output=True, text=True, check=False, timeout=30)
    token = probe.stdout.strip() if probe.returncode == 0 else ""
    if not token:
        enrollment = Path(os.environ.get("COGNILODE_BOOTSTRAP_OPERATOR_TOKEN_FILE", ""))
        if not enrollment.is_file():
            raise RuntimeError("portable AWS bootstrap requires enrolled operator token custody")
        subprocess.run(["docker", "run", "--rm", "--user", "0",
                        "--mount", f"type=bind,src={enrollment.resolve()},dst=/seed,readonly",
                        "--volume", f"{operator}:/operator", image, "sh", "-c",
                        f"cp /seed /operator/operator-bearer && chmod 600 /operator/operator-bearer && chown {uid}:{gid} /operator/operator-bearer"],
                       stdout=subprocess.DEVNULL, check=True, timeout=30)
        token = enrollment.read_text().strip()
    token = token.removeprefix("Bearer ").strip()
    marker = subprocess.run(["docker", "run", "--rm", "--volume", f"{volume}:/aws:ro",
                             image, "sh", "-c", "test -s /aws/central-broker-ready && test -s /aws/config"],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                            check=False, timeout=30)
    if marker.returncode == 0:
        return
    base = os.environ.get("COGNILODE_OPERATOR_URL", "https://cognilode.com").rstrip("/")
    request = urllib.request.Request(base + "/api/operator/aws-session",
        data=b'{"purpose":"artifact-read"}', method="POST",
        headers={"Authorization": "Bearer " + token, "Content-Type": "application/json",
            "Accept": "application/json,text/plain,*/*",
            "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36",
            "Origin": base, "Referer": base + "/"})
    with urllib.request.urlopen(request, timeout=45) as response:
        readback = json.load(response)
    if not readback.get("ok") or not readback.get("credentials", {}).get("Expiration"):
        raise RuntimeError("central scoped AWS broker has no live STS session")
    config = ("[default]\nregion = us-west-2\n"
        "credential_process = python3 /runtime/source/current/codex-backend-sdk/scripts/cognilode-aws-credential-process\n")
    subprocess.run(["docker", "run", "--rm", "-i", "--user", "0",
                    "--volume", f"{volume}:/aws", image, "sh", "-c",
                    f"cat > /aws/config && touch /aws/central-broker-ready && chmod 600 /aws/config && chown -R {uid}:{gid} /aws"],
                   input=config, text=True, stdout=subprocess.DEVNULL, check=True, timeout=30)


def run(*args: str, check: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(args, text=True, capture_output=True, check=check, timeout=120)


def migrate_previous_state(source: Path, destination: Path) -> None:
    if not source.is_dir() or source.resolve() == destination.resolve():
        return
    target = destination / "worker"
    for name in ("b4pt0r-chatmode", "chatmode-queue-worker", "handoffs", "root-memory-native-cycle"):
        old = source / name
        new = target / name
        marker = new / ".company-container-migration-complete"
        if old.is_dir() and not marker.exists():
            shutil.copytree(old, new, dirs_exist_ok=True, copy_function=shutil.copy2)
            marker.touch()


def migrate_container_browser(project: str, image: str) -> None:
    """Capture the old company container's profile without touching host Chrome."""
    volume = f"{project}_company_browser"
    subprocess.run(["docker", "volume", "create", volume], stdout=subprocess.DEVNULL,
                   check=True, timeout=30)
    # The marker is written only after the initial custody validation succeeds.
    # Rewalking an established browser profile on every container restart is
    # expensive and can stall startup while Docker is under load.
    marker = subprocess.run(["docker", "run", "--rm", "--volume", f"{volume}:/browser:ro",
                             image, "test", "-f", "/browser/profile/.custody-complete"],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                            check=False, timeout=180)
    if marker.returncode == 0:
        return
    source = ["docker", "exec", "cognilode-primary-workspace", "sh", "-c",
              "test -d /workspace/.cognilode/host-chrome-copy && "
              "tar -C /workspace/.cognilode/host-chrome-copy -cf - ."]
    target = ["docker", "run", "--rm", "--user", "0", "-i",
              "--volume", f"{volume}:/browser", image, "sh", "-c",
              "mkdir -p /browser/profile && tar -C /browser/profile -xf - && "
              "test -s '/browser/profile/Local State' && "
              "test -n \"$(find /browser/profile -type f -name Cookies -size +0c -print -quit)\" && "
              "touch /browser/profile/.custody-complete"]
    with subprocess.Popen(source, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL) as reader:
        assert reader.stdout is not None
        with subprocess.Popen(target, stdin=reader.stdout, stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL) as writer:
            reader.stdout.close()
            target_status = writer.wait(timeout=480)
            source_status = reader.wait(timeout=30)
            if target_status != 0 or source_status not in (0, 1):
                raise RuntimeError("company container browser custody transfer failed")


def retired_units() -> list[str]:
    installed = run("systemctl", "--user", "list-unit-files", "--no-legend", "--plain", check=False)
    loaded = run("systemctl", "--user", "list-units", "--all", "--no-legend", "--plain", check=False)
    names = {line.split(maxsplit=1)[0] for result in (installed, loaded)
             for line in result.stdout.splitlines() if line.split()}
    return sorted(name for name in names if name.startswith("cognilode-")
                  and name.endswith((".service", ".timer", ".socket"))
                  and name != SELF and "evan-recorder" not in name and "@." not in name)


def compose_service_hashes(project: str, compose: Path, env: dict[str, str]) -> dict[str, str]:
    """Hash resolved service definitions so unrelated edits do not restart workers."""
    rendered = subprocess.run(
        ["docker", "compose", "--project-name", project, "-f", str(compose),
         "config", "--format", "json"], env=env, capture_output=True, text=True,
        check=True, timeout=60)
    services = json.loads(rendered.stdout)["services"]
    active_profiles = {value.strip() for value in env.get("COMPOSE_PROFILES", "").split(",")
                       if value.strip()}
    return {name: hashlib.sha256(json.dumps(value, sort_keys=True,
            separators=(",", ":")).encode()).hexdigest()
            for name, value in services.items()
            if not value.get("profiles") or active_profiles.intersection(value["profiles"])}


def save_service_hashes(path: Path, hashes: dict[str, str]) -> None:
    temporary = path.with_suffix(".tmp")
    temporary.write_text(json.dumps(hashes, sort_keys=True) + "\n", encoding="utf-8")
    temporary.replace(path)


def retire_standalone_adopter(project: str, compose: Path, runtime: Path,
                             env: dict[str, str]) -> None:
    """Remove the old unfenced adopter once its container replacements run."""
    marker = runtime / "shared/standalone-adopter-retired"
    if marker.exists():
        return
    running = subprocess.run(
        ["docker", "compose", "--project-name", project, "-f", str(compose),
         "ps", "--status", "running", "--services"], env=env,
        capture_output=True, text=True, check=False, timeout=30)
    if running.returncode != 0 or not {"chatmode", "effect-reviewer"}.issubset(
            set(running.stdout.splitlines())):
        return
    name = "cognilode-chatmode-work-adopter"
    inspected = subprocess.run(
        ["docker", "inspect", "--format", "{{json .Config.Labels}}", name],
        capture_output=True, text=True, check=False, timeout=30)
    if inspected.returncode == 0:
        try:
            labels = json.loads(inspected.stdout)
        except ValueError:
            return
        if labels not in ({}, None):
            print("standalone adopter retirement pending: unexpected container labels", flush=True)
            return
        subprocess.run(["docker", "stop", "--time", "30", name],
                       check=True, timeout=60)
        subprocess.run(["docker", "rm", name], check=True, timeout=30)
    marker.touch()
    print("retired standalone chatmode work adopter", flush=True)


def reconcile_compose(project: str, runtime: Path, env: dict[str, str]) -> None:
    """Apply new synchronized Compose configuration from the sole host starter."""
    digest_path = runtime / "shared/compose-config-applied.sha256"
    applied_digest = (digest_path.read_text(encoding="utf-8").strip()
                      if digest_path.is_file() else hashlib.sha256(COMPOSE.read_bytes()).hexdigest())
    applied_compose = COMPOSE
    synced = runtime / "shared/source/current/codex-backend-sdk"
    memory_applied = runtime / "shared/memory-source-applied"
    service_hash_path = runtime / "shared/compose-service-digests.json"
    while True:
        candidate = synced / "deploy/compose/company-chatmode.yml"
        if candidate.is_file():
            selected = subprocess.run(["git", "-C", str(synced), "rev-parse", "HEAD"],
                                      capture_output=True, text=True, check=False).stdout.strip()
            synced_main = subprocess.run(["git", "-C", str(synced), "rev-parse", "origin/main"],
                                         capture_output=True, text=True, check=False).stdout.strip()
            known_main = subprocess.run(["git", "-C", str(ROOT), "rev-parse", "origin/main"],
                                        capture_output=True, text=True, check=False).stdout.strip()
            current_enough = (known_main and subprocess.run(
                ["git", "-C", str(synced), "merge-base", "--is-ancestor", known_main, selected],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False).returncode == 0)
            if selected and selected == synced_main and current_enough:
                synced_starter = synced / "scripts/cognilode-company-container-bootstrap"
                loaded_revision = os.environ.get("COGNILODE_BOOTSTRAP_LOADED_REVISION", "")
                if (synced_starter.is_file() and
                        (synced_starter.resolve() != Path(__file__).resolve()
                         or selected != loaded_revision)):
                    print(f"company starter adopting synchronized source: {selected}", flush=True)
                    os.execve(sys.executable, [sys.executable,
                              str(synced_starter)],
                              {**os.environ, "COGNILODE_BOOTSTRAP_FROM_SYNC": "1",
                               "COGNILODE_BOOTSTRAP_LOADED_REVISION": selected,
                               "COGNILODE_BOOTSTRAP_RECONCILE_ONLY": "1"})
                digest = hashlib.sha256(candidate.read_bytes()).hexdigest()
                if digest != applied_digest:
                    try:
                        current_hashes = compose_service_hashes(project, candidate, env)
                        try:
                            previous_hashes = json.loads(service_hash_path.read_text(encoding="utf-8"))
                        except (OSError, ValueError):
                            previous_hashes = {}
                        changed = sorted(name for name, value in current_hashes.items()
                                         if previous_hashes.get(name) != value)
                        if changed:
                            # Each selected service is reconciled against its own
                            # resolved config. Do not cascade through dependencies:
                            # their unchanged long-running work must keep its lease.
                            subprocess.run(["docker", "compose", "--project-name", project,
                                            "-f", str(candidate), "up", "-d", "--no-deps",
                                            *changed], env=env, check=True, timeout=300)
                        save_service_hashes(service_hash_path, current_hashes)
                    except (subprocess.CalledProcessError, subprocess.TimeoutExpired,
                            KeyError, ValueError) as exc:
                        print(f"company Compose reconciliation pending: {exc}", flush=True)
                    else:
                        applied_digest = digest
                        applied_compose = candidate
                        temporary = digest_path.with_suffix(".tmp")
                        temporary.write_text(digest + "\n", encoding="utf-8")
                        temporary.replace(digest_path)
                        print(f"company Compose configuration applied: {selected}", flush=True)
        try:
            retire_standalone_adopter(project, applied_compose, runtime, env)
        except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as exc:
            print(f"standalone adopter retirement pending: {exc}", flush=True)
        memory_source = runtime / "shared/source/current/memory-stock-canonical"
        if (memory_source / ".git").exists():
            revision = subprocess.run(["git", "-c", "safe.directory=*", "-C", str(memory_source),
                                       "rev-parse", "HEAD"], capture_output=True, text=True,
                                      check=False).stdout.strip()
            previous = memory_applied.read_text(encoding="utf-8").strip() if memory_applied.is_file() else ""
            if revision and revision != previous:
                try:
                    subprocess.run(["docker", "compose", "--project-name", project,
                                    "-f", str(applied_compose), "restart", "memory"],
                                   env=env, check=True, timeout=180)
                except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as exc:
                    print(f"memory source restart pending: {exc}", flush=True)
                else:
                    temporary = memory_applied.with_suffix(".tmp")
                    temporary.write_text(revision + "\n", encoding="utf-8")
                    temporary.replace(memory_applied)
                    print(f"memory source applied: {revision}", flush=True)
        time.sleep(30)


def main() -> int:
    startup_time = time.time()
    if "COGNILODE_BOOTSTRAP_LOADED_REVISION" not in os.environ:
        os.environ["COGNILODE_BOOTSTRAP_LOADED_REVISION"] = subprocess.run(
            ["git", "-C", str(ROOT), "rev-parse", "HEAD"],
            capture_output=True, text=True, check=False).stdout.strip()
    repos = Path(os.environ.get("COMPANY_REPOS_ROOT", str(Path.home() / "Projects"))).resolve()
    runtime = Path(os.environ.get("COMPANY_RUNTIME_ROOT", str(Path.home() / ".local/share/cognilode/company-runtime"))).resolve()
    portable_aws = os.environ.get("COGNILODE_PORTABLE_AWS") == "1"
    aws = Path(os.environ.get("AWS_AUTH_ROOT", str(Path.home() / ".aws"))).resolve()
    for name in ("worker", "shared"):
        (runtime / name).mkdir(parents=True, exist_ok=True)
    # The installed host unit is only a stable launch point. After source-sync
    # has produced a newer pinned Git checkout, run its bootstrap on later
    # starts instead of accumulating host-specific deployment edits.
    if os.environ.get("COGNILODE_BOOTSTRAP_FROM_SYNC") != "1":
        synced = runtime / "shared/source/current/codex-backend-sdk"
        candidate = synced / "scripts/cognilode-company-container-bootstrap"
        if candidate.is_file() and (synced / ".git").exists():
            current = subprocess.run(["git", "-C", str(ROOT), "rev-parse", "HEAD"],
                                     capture_output=True, text=True, check=False).stdout.strip()
            selected = subprocess.run(["git", "-C", str(synced), "rev-parse", "HEAD"],
                                      capture_output=True, text=True, check=False).stdout.strip()
            remote_main = subprocess.run(["git", "-C", str(synced), "rev-parse", "origin/main"],
                                         capture_output=True, text=True, check=False).stdout.strip()
            # A promoted checkout can lag a newer origin/main already known to
            # this starter. Never hand startup back to that stale checkout.
            known_main = subprocess.run(["git", "-C", str(ROOT), "rev-parse", "origin/main"],
                                        capture_output=True, text=True, check=False).stdout.strip()
            current_enough = (known_main and selected and subprocess.run(
                ["git", "-C", str(synced), "merge-base", "--is-ancestor", known_main, selected],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False).returncode == 0)
            if (current and selected and selected == remote_main and current_enough
                    and selected != current
                    and candidate.resolve() != Path(__file__).resolve()):
                os.execve(sys.executable, [sys.executable, str(candidate)],
                          {**os.environ, "COGNILODE_BOOTSTRAP_FROM_SYNC": "1",
                           "COGNILODE_BOOTSTRAP_LOADED_REVISION": selected})
    migrate_previous_state(Path(os.environ.get("COMPANY_LEGACY_DATA_ROOT", str(Path.home() / ".local/share/cognilode"))), runtime)
    env = {**os.environ, "COMPANY_REPOS_ROOT": str(repos), "COMPANY_RUNTIME_ROOT": str(runtime),
           "AWS_AUTH_ROOT": "company_aws_client" if portable_aws else str(aws),
           "COMPANY_UID": str(os.getuid()), "COMPANY_GID": str(os.getgid()),
           "COGNILODE_ENVIRONMENT_ID": os.environ.get("COGNILODE_ENVIRONMENT_ID", "evanpc-company-container")}
    project = "cognilode-company-runtime"
    if os.environ.get("COGNILODE_BOOTSTRAP_RECONCILE_ONLY") == "1":
        reconcile_compose(project, runtime, env)
        return 0
    legacy_relay = Path(os.environ.get("COGNILODE_LEGACY_RELAY_ENV",
                                   str(Path.home() / ".config/cognilode/evanpc-host-node.env")))
    subprocess.run([sys.executable, str(ROOT / "scripts/cognilode-migrate-company-relay-custody")],
                   env=env, check=True, timeout=120)
    image = env.get("COGNILODE_WORKSPACE_IMAGE", "cognilode-standard-workspace:2026-09-28")
    if portable_aws:
        prepare_portable_aws(project, image, os.getuid(), os.getgid())
    migrate_container_browser(project, image)
    for name in ("company_auth", "company_operator", "company_deploy_custody",
                 "memory_data", "memory_drive_auth", "company_relay_custody"):
        subprocess.run(["docker", "volume", "create", f"{project}_{name}"],
                       stdout=subprocess.DEVNULL, check=True, timeout=30)
    subprocess.run(["docker", "run", "--rm", "--user", "0",
                    "--volume", f"{project}_company_auth:/auth",
                    "--volume", f"{project}_company_operator:/operator",
                    "--volume", f"{project}_company_deploy_custody:/deploy",
                    "--volume", f"{project}_memory_drive_auth:/memory-auth",
                    "--volume", f"{project}_company_relay_custody:/relay",
                    image,
                    "chown", "-R", f"{os.getuid()}:{os.getgid()}",
                    "/auth", "/operator", "/deploy", "/memory-auth", "/relay"],
                   stdout=subprocess.DEVNULL, check=True, timeout=60)
    command = ["docker", "compose", "--project-name", project, "-f", str(COMPOSE), "up", "-d"]
    subprocess.run(command, env=env, check=True, timeout=180)
    save_service_hashes(runtime / "shared/compose-service-digests.json",
                        compose_service_hashes(project, COMPOSE, env))
    (runtime / "shared/compose-config-applied.sha256").write_text(
        hashlib.sha256(COMPOSE.read_bytes()).hexdigest() + "\n", encoding="utf-8")
    memory_source = runtime / "shared/source/current/memory-stock-canonical"
    memory_minimum = "b4a4878d47abe142b75ab23c74f9b6dc1ce67cba"
    memory_shallow_accepted = "cdbe5de43b57e23e10f915185e533b02a4aba636"
    source_deadline = time.monotonic() + 360
    while True:
        script_ready = (memory_source / "deploy/conversation-vacuum/company_memory_cutover.py").is_file()
        ancestry = (subprocess.run(["git", "-C", str(memory_source), "merge-base", "--is-ancestor",
                                   memory_minimum, "HEAD"], stdout=subprocess.DEVNULL,
                                  stderr=subprocess.DEVNULL, check=False).returncode == 0
                    if script_ready else False)
        if script_ready and not ancestry:
            # Source-sync's old depth-one checkout can hide an otherwise known
            # main-branch ancestor. Accept the exact indexed-memory release;
            # source-sync repairs the shallow ancestry for later revisions.
            head = subprocess.run(["git", "-C", str(memory_source), "rev-parse", "HEAD"],
                                  capture_output=True, text=True, check=False).stdout.strip()
            ancestry = head == memory_shallow_accepted
        if script_ready and ancestry:
            break
        print(f"memory source pending: path={memory_source} script={script_ready} lease_revision={ancestry}",
              flush=True)
        if time.monotonic() >= source_deadline:
            raise RuntimeError("memory source synchronization did not complete")
        time.sleep(5)
    memory_env = {**env, "COGNILODE_MEMORY_SOURCE_ROOT": str(memory_source),
                  "COGNILODE_MEMORY_HOST_SOURCE": str(memory_source)}
    subprocess.run(["python3", str(memory_source / "deploy/conversation-vacuum/company_memory_cutover.py")],
                   env=memory_env, check=True)
    deadline = time.monotonic() + 150
    while time.monotonic() < deadline:
        custody_ready = subprocess.run(
            ["docker", "compose", "--project-name", project, "-f", str(COMPOSE),
             "exec", "-T", "credential-sync", "sh", "-c",
             "test -s /home/worker/.codex/auth.json && test -s /home/worker/.config/cognilode/operator-bearer"],
            env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=15, check=False).returncode == 0
        if (custody_ready and (runtime / "shared/http-gate/gate.sock").exists()
                and (runtime / "shared/http-gate/policy.json").is_file()
                and (runtime / "shared/provider.sock").exists()):
            break
        time.sleep(3)
    else:
        raise RuntimeError("container credentials or HTTP gate were not ready; host workers retained")
    if legacy_relay.is_file():
        relay_deadline = time.monotonic() + 150
        heartbeat = runtime / "shared/relay/heartbeat.json"
        while time.monotonic() < relay_deadline:
            try:
                relay_state = json.loads(heartbeat.read_text(encoding="utf-8"))
                ready = relay_state.get("ok") is True and heartbeat.stat().st_mtime >= startup_time
            except (OSError, ValueError):
                ready = False
            if ready:
                break
            time.sleep(3)
        else:
            raise RuntimeError("container relay heartbeat was not ready; legacy company relay custody retained")
    for name in retired_units():
        run("systemctl", "--user", "disable", "--now", name, check=False)
    run("docker", "stop", "cognilode-http-gate-http-gate-1", check=False)
    # These were temporary company-only host bind mounts from the first cutover.
    # Never touch the personal host Codex or browser profiles.
    for name in ("auth", "operator"):
        old = runtime / name
        if old.is_dir() and not old.is_symlink():
            shutil.rmtree(old)
    if legacy_relay.is_file():
        legacy_relay.unlink()
    reconcile_compose(project, runtime, env)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
