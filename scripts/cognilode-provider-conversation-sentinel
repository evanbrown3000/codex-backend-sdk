TARGETS = [
    {"id": "chatgpt.com", "kind": "agent", "label": "ChatGPT.com", "agent_id": "chatgpt.web.default"},
    {"id": "codex", "kind": "operator_conversations", "label": "Codex", "query": "codex"},
