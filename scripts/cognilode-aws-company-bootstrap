#!/usr/bin/env python3
"""Fail-closed, one-command company-container bootstrap on an AWS t3.nano.

This uses the same pinned Compose/bootstrap source as EvanPC. It never reads a
host AWS config, copies a browser profile, builds an image, or installs Docker.
An IAM administrator provisions the dedicated scoped role with the companion
``cognilode-provision-aws-broker-role`` script before activation.
"""
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import urllib.request


ROOT = Path(__file__).resolve().parents[1]
EXPECTED_REGION = "us-west-2"
EXPECTED_TYPE = "t3.nano"
IMAGE = os.environ.get("COGNILODE_WORKSPACE_IMAGE", "cognilode-standard-workspace:2026-09-28")


def metadata() -> tuple[dict, str]:
    base = "http://169.254.169.254/latest/"
    token_request = urllib.request.Request(base + "api/token", method="PUT",
        headers={"X-aws-ec2-metadata-token-ttl-seconds": "60"})
    token = urllib.request.urlopen(token_request, timeout=3).read().decode()
    headers = {"X-aws-ec2-metadata-token": token}

    def read(path: str) -> str:
        return urllib.request.urlopen(urllib.request.Request(base + path, headers=headers),
                                      timeout=3).read().decode().strip()

    identity = json.loads(read("dynamic/instance-identity/document"))
    identity["instanceId"] = read("meta-data/instance-id")
    role_name = read("meta-data/iam/security-credentials/")
    return identity, role_name


def command_ok(*args: str, timeout: int = 20) -> bool:
    try:
        return subprocess.run(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                              timeout=timeout, check=False).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def available_memory() -> int:
    for line in Path("/proc/meminfo").read_text().splitlines():
        if line.startswith("MemAvailable:"):
            return int(line.split()[1]) * 1024
    return 0


def central_broker_ready(enrollment: str) -> bool:
    token = Path(enrollment).read_text(encoding="utf-8").strip().removeprefix("Bearer ").strip()
    if not token:
        return False
    base = os.environ.get("COGNILODE_OPERATOR_URL", "https://cognilode.com").rstrip("/")
    request = urllib.request.Request(base + "/api/operator/aws-session",
        data=b'{"purpose":"artifact-read"}', method="POST",
        headers={"Authorization": "Bearer " + token, "Content-Type": "application/json"})
    try:
        response = json.load(urllib.request.urlopen(request, timeout=15))
        return response.get("ok") is True and isinstance(response.get("credentials"), dict)
    except (OSError, ValueError):
        return False


def preflight() -> tuple[dict, list[str], str]:
    blockers: list[str] = []
    facts: dict = {"schema": "cognilode.aws-company-bootstrap.v1", "image": IMAGE,
                   "portable_aws": True, "static_host_aws_mount": False}
    try:
        identity, role_name = metadata()
        account = str(identity.get("accountId") or "")
        instance = str(identity.get("instanceId") or "")
        region = str(identity.get("region") or "")
        kind = str(identity.get("instanceType") or "")
        role_arn = f"arn:aws:iam::{account}:role/{role_name}"
        target_role = f"arn:aws:iam::{account}:role/CognilodeCompanyScopedBroker"
        facts.update(instance_id=instance, region=region, instance_type=kind,
                     instance_role_arn=role_arn, scoped_broker_role_arn=target_role)
        if region != EXPECTED_REGION:
            blockers.append("region_must_be_us_west_2")
        if kind != EXPECTED_TYPE:
            blockers.append("instance_must_be_t3_nano")
        if not account.isdigit() or len(account) != 12 or not role_name:
            blockers.append("instance_role_missing")
    except Exception as error:
        facts["metadata_error_class"] = type(error).__name__
        blockers.append("imds_v2_identity_unavailable")
        target_role = ""

    free_disk = shutil.disk_usage("/").free
    free_memory = available_memory()
    facts.update(root_free_bytes=free_disk, memory_available_bytes=free_memory)
    if free_disk < 2 * 1024**3:
        blockers.append("root_capacity_below_2_gib")
    if free_memory < 256 * 1024**2:
        blockers.append("available_memory_below_256_mib")
    if not shutil.which("docker"):
        blockers.append("docker_not_installed")
    elif not command_ok("docker", "info", "--format", "{{.ServerVersion}}"):
        blockers.append("docker_daemon_unavailable")
    elif not command_ok("docker", "image", "inspect", IMAGE):
        blockers.append("pinned_workspace_image_unavailable")

    enrollment = os.environ.get("COGNILODE_BOOTSTRAP_OPERATOR_TOKEN_FILE", "")
    if not enrollment or not Path(enrollment).is_file():
        blockers.append("company_operator_enrollment_missing")
    elif not central_broker_ready(enrollment):
        blockers.append("central_scoped_broker_unavailable")
    if target_role and shutil.which("aws"):
        if not command_ok("aws", "sts", "assume-role", "--region", EXPECTED_REGION,
                          "--role-arn", target_role, "--role-session-name", "cognilode-bootstrap-check",
                          "--duration-seconds", "900", "--query", "AssumedRoleUser.Arn",
                          "--output", "text", timeout=30):
            blockers.append("scoped_broker_role_not_assumable")
    else:
        blockers.append("aws_cli_or_scoped_role_unavailable")
    return facts, blockers, target_role


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--activate", action="store_true",
                        help="Run the existing Compose bootstrap only after every preflight gate passes")
    args = parser.parse_args()
    facts, blockers, role = preflight()
    facts.update(ready=not blockers, blockers=blockers)
    print(json.dumps(facts, sort_keys=True), flush=True)
    if blockers:
        return 2
    if not args.activate:
        return 0
    env = {**os.environ, "COGNILODE_PORTABLE_AWS": "1",
           "COGNILODE_AWS_BROKER_ROLE_ARN": role,
           "COGNILODE_ENVIRONMENT_ID": os.environ.get("COGNILODE_ENVIRONMENT_ID")
               or f"aws-company-{facts['instance_id']}"}
    return subprocess.run([sys.executable, str(ROOT / "scripts/cognilode-company-container-bootstrap")],
                          env=env, check=False).returncode


if __name__ == "__main__":
    raise SystemExit(main())
