#!/usr/bin/env python3
"""Ephemeral GitHub credential helper backed by central secret custody."""
from __future__ import annotations

import json
import subprocess
import sys


def main() -> int:
    operation = sys.argv[1] if len(sys.argv) > 1 else ""
    request = dict(
        line.rstrip("\n").split("=", 1)
        for line in sys.stdin
        if "=" in line
    )
    if operation != "get" or request.get("host") not in {"github.com", "api.github.com"}:
        return 0
    result = subprocess.run(
        ["/usr/bin/aws", "secretsmanager", "get-secret-value", "--region", "us-west-2",
         "--secret-id", "/cognilode/agent-credentials/github/owner",
         "--query", "SecretString", "--output", "text"],
        text=True, capture_output=True, timeout=30, check=False,
    )
    if result.returncode:
        return 1
    value = json.loads(result.stdout)
    token = value.get("api_key", "") if isinstance(value, dict) else ""
    if not isinstance(token, str) or not token or len(token) > 4096:
        return 1
    sys.stdout.write("username=x-access-token\npassword=" + token + "\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
