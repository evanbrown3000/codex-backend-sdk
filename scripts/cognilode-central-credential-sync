#!/usr/bin/env python3
"""Keep company runtime credentials in centrally encrypted custody.

Only the selected writer environment publishes refreshes. Other identical
environments read the same Secrets Manager objects for failover.
"""
from __future__ import annotations

import argparse
from datetime import UTC, datetime, timedelta
import hashlib
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
import os
from pathlib import Path
import subprocess
import tempfile
import threading
import time


def sha(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def aws(command: list[str], *, timeout: int = 60) -> str:
    result = subprocess.run(command, capture_output=True, text=True, timeout=timeout, check=True)
    return result.stdout.strip()


def pull(cli: str, region: str, secret_id: str, target: Path, field: str | None = None) -> str:
    value = aws([cli, "secretsmanager", "get-secret-value", "--region", region,
                 "--secret-id", secret_id, "--query", "SecretString", "--output", "text"])
    if field:
        record = json.loads(value)
        data = record[field].encode()
        if (field == "rclone_config" and
                (record.get("schema") != "cognilode.memory-drive-auth.v1" or
                 record.get("sha256") != sha(data))):
            raise ValueError("memory Drive credential envelope is invalid")
    else:
        data = value.encode()
    target.parent.mkdir(parents=True, exist_ok=True)
    if not target.is_file() or target.read_bytes() != data:
        with tempfile.NamedTemporaryFile(dir=target.parent, delete=False) as tmp:
            os.fchmod(tmp.fileno(), 0o600)
            tmp.write(data)
            name = tmp.name
        os.replace(name, target)
    return sha(data)


def publish(cli: str, region: str, secret_id: str, target: Path,
            field: str | None = None) -> str:
    data = target.read_bytes()
    if not data:
        raise ValueError("refusing empty credential publication")
    if field:
        if field != "rclone_config":
            raise ValueError("unsupported credential field publication")
        body = json.dumps({"schema": "cognilode.memory-drive-auth.v1",
                           "rclone_config": data.decode(), "sha256": sha(data)})
        with tempfile.NamedTemporaryFile(mode="w", delete=False) as tmp:
            os.fchmod(tmp.fileno(), 0o600)
            tmp.write(body)
            source = tmp.name
        try:
            aws([cli, "secretsmanager", "put-secret-value", "--region", region,
                 "--secret-id", secret_id, "--secret-string", "file://" + source], timeout=90)
        finally:
            Path(source).unlink(missing_ok=True)
    else:
        aws([cli, "secretsmanager", "put-secret-value", "--region", region,
             "--secret-id", secret_id, "--secret-string", "file://" + str(target)], timeout=90)
    return sha(data)


def serve_leases(host: str, port: int, *, mappings: list[tuple[str, Path, str | None]],
                 operator_password_file: Path) -> None:
    """Serve short-lived, authenticated leases from singular mounted custody.

    The synchronizer remains the only process that owns writable secret files.
    Consumers receive an in-memory operation lease over the private company
    network instead of discovering or copying node-local credentials.
    """
    by_reference = {secret_id: (path, field) for secret_id, path, field in mappings}

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, _format, *_args):
            return

        def reply(self, status: int, value: dict) -> None:
            body = json.dumps(value, separators=(",", ":")).encode()
            self.send_response(status)
            self.send_header("content-type", "application/json")
            self.send_header("content-length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_POST(self):  # noqa: N802
            if self.path.rstrip("/") != "/v1/credentials/lease":
                return self.reply(404, {"error": "not_found"})
            try:
                expected = operator_password_file.read_text(encoding="utf-8").strip()
            except OSError:
                expected = ""
            if not expected or self.headers.get("x-cognilode-password", "") != expected:
                return self.reply(401, {"error": "unauthorized"})
            try:
                length = min(65536, max(0, int(self.headers.get("content-length", "0"))))
                request = json.loads(self.rfile.read(length))
                reference = str(request.get("reference") or "")
                path, field = by_reference[reference]
                raw = path.read_bytes()
                if not raw:
                    raise ValueError("credential is empty")
                if field:
                    credential = {field: raw.decode()}
                else:
                    try:
                        credential = json.loads(raw)
                    except (UnicodeDecodeError, json.JSONDecodeError):
                        credential = {"token": raw.decode().strip()}
                if not isinstance(credential, dict):
                    credential = {"token": str(credential)}
                expires = (datetime.now(UTC) + timedelta(minutes=5)).isoformat().replace("+00:00", "Z")
                self.reply(200, {"credential": credential, "expires_at": expires})
            except KeyError:
                self.reply(404, {"error": "unknown_credential_reference"})
            except Exception as exc:
                self.reply(503, {"error": type(exc).__name__})

    ThreadingHTTPServer((host, port), Handler).serve_forever()


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--credential", action="append", required=True,
                        help="Secrets Manager ID=container-local target file")
    parser.add_argument("--writer-secret", action="append", default=[],
                        help="Allow this environment to publish refreshes for this secret ID")
    parser.add_argument("--aws", default="/usr/bin/aws")
    parser.add_argument("--region", default="us-west-2")
    parser.add_argument("--interval", type=int, default=300)
    parser.add_argument("--serve-host", default="0.0.0.0")
    parser.add_argument("--serve-port", type=int, default=18892)
    parser.add_argument("--operator-password-file")
    args = parser.parse_args()
    mappings = []
    for item in args.credential:
        if "=" not in item:
            parser.error("credential mapping must be ID=PATH")
        spec, path = item.split("=", 1)
        secret_id, _, field = spec.partition("#")
        mappings.append((secret_id, Path(path), field or None))
    writers = set(args.writer_secret)
    if args.operator_password_file:
        threading.Thread(
            target=serve_leases,
            args=(args.serve_host, args.serve_port),
            kwargs={"mappings": mappings,
                    "operator_password_file": Path(args.operator_password_file)},
            name="credential-lease-broker",
            daemon=True,
        ).start()
    known: dict[str, str] = {}
    while True:
        for secret_id, path, field in mappings:
            try:
                local = sha(path.read_bytes()) if path.is_file() else ""
                previous = known.get(secret_id, "")
                if secret_id in writers and previous and local and local != previous:
                    known[secret_id] = publish(args.aws, args.region, secret_id, path, field)
                    action = "published_refresh"
                else:
                    known[secret_id] = pull(args.aws, args.region, secret_id, path, field)
                    action = "synchronized"
                print(json.dumps({"kind": action, "secret_id": secret_id,
                                  "at": time.time()}), flush=True)
            except Exception as exc:
                print(json.dumps({"kind": "credential_sync_retry", "secret_id": secret_id,
                                  "error": type(exc).__name__, "at": time.time()}), flush=True)
        time.sleep(max(30, args.interval))


if __name__ == "__main__":
    raise SystemExit(main())

