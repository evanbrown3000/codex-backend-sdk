#!/usr/bin/env python3
"""Break a source-sync credential-cache deadlock without moving source or secrets.

Run from an exact, locally available SDK main checkout. This changes only the
existing source-sync container's Compose configuration. The sole company
starter resumes normal reconciliation once source-sync fetches the new source.
"""
from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path
import subprocess
import tempfile


ROOT = Path(__file__).resolve().parents[1]
COMPOSE = ROOT / "deploy/compose/company-chatmode.yml"
PROJECT = "cognilode-company-runtime"
CACHE = "/home/worker/.aws/cli/cache"


def _run(command: list[str], *, env: dict[str, str] | None = None,
         timeout: int = 60) -> str:
    completed = subprocess.run(command, env=env, capture_output=True, text=True,
                               timeout=timeout, check=False)
    if completed.returncode:
        raise RuntimeError(f"bootstrap command failed: {command[0]} {command[1]}")
    return completed.stdout.strip()


def main() -> int:
    selected = _run(["git", "-C", str(ROOT), "rev-parse", "HEAD"])
    known_main = _run(["git", "-C", str(ROOT), "rev-parse", "origin/main"])
    if selected != known_main:
        raise RuntimeError("bootstrap requires an exact pinned origin/main checkout")
    if not COMPOSE.is_file() or CACHE not in COMPOSE.read_text(encoding="utf-8"):
        raise RuntimeError("selected Compose lacks private AWS CLI cache")
    runtime = Path(os.environ.get("COMPANY_RUNTIME_ROOT",
                                  str(Path.home() / ".local/share/cognilode/company-runtime"))).resolve()
    repos = Path(os.environ.get("COMPANY_REPOS_ROOT", str(Path.home() / "Projects"))).resolve()
    auth = Path(os.environ.get("AWS_AUTH_ROOT", str(Path.home() / ".aws"))).resolve()
    if not runtime.is_dir() or not repos.is_dir() or not auth.is_dir():
        raise RuntimeError("existing company runtime or AWS auth bind unavailable")
    env = {**os.environ, "COMPANY_REPOS_ROOT": str(repos),
           "COMPANY_RUNTIME_ROOT": str(runtime), "AWS_AUTH_ROOT": str(auth),
           "COMPANY_UID": str(os.getuid()), "COMPANY_GID": str(os.getgid()),
           "COGNILODE_ENVIRONMENT_ID": os.environ.get(
               "COGNILODE_ENVIRONMENT_ID", "evanpc-company-container")}
    rendered = json.loads(_run(["docker", "compose", "--project-name", PROJECT,
                                "-f", str(COMPOSE), "config", "--format", "json"], env=env))
    source = (rendered.get("services") or {}).get("source-sync") or {}
    configured = source.get("tmpfs") or []
    if not any(str(item).startswith(CACHE + ":") for item in configured):
        raise RuntimeError("source-sync has no isolated writable CLI cache")
    service_hash = hashlib.sha256(json.dumps(source, sort_keys=True,
                                              separators=(",", ":")).encode()).hexdigest()
    marker = runtime / "shared/source-sync-cache-bootstrap.json"
    expected = {"schema": "cognilode.source_sync_cache_bootstrap.v1",
                "selected_sha": selected, "service_config_sha256": service_hash}
    if marker.is_file():
        try:
            prior = json.loads(marker.read_text(encoding="utf-8"))
        except ValueError:
            prior = {}
        if all(prior.get(key) == value for key, value in expected.items()):
            print("source-sync cache bootstrap already applied", flush=True)
            return 0
    _run(["docker", "compose", "--project-name", PROJECT, "-f", str(COMPOSE),
          "up", "-d", "--no-deps", "source-sync"], env=env, timeout=300)
    container = _run(["docker", "compose", "--project-name", PROJECT,
                      "-f", str(COMPOSE), "ps", "-q", "source-sync"], env=env)
    if not container:
        raise RuntimeError("source-sync container did not start")
    inspected = json.loads(_run(["docker", "inspect", container]))[0]
    if CACHE not in ((inspected.get("HostConfig") or {}).get("Tmpfs") or {}):
        raise RuntimeError("source-sync cache mount absent after Compose apply")
    marker.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=marker.parent,
                                     prefix=marker.name + ".", delete=False) as handle:
        json.dump({**expected, "container_id": container}, handle, sort_keys=True)
        handle.flush()
        os.fsync(handle.fileno())
        temporary = Path(handle.name)
    temporary.replace(marker)
    print(f"source-sync cache bootstrap applied: {selected[:12]} {service_hash[:12]}",
          flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
